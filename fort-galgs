    @staticmethod
    def _pounding(cr, t, seed, y):
        """A musket swung butt-first at a wall in front of him, at height
        y; t is the seconds he has been at it."""
        thrust = max(0.0, math.sin(t * 5.5 + seed)) ** 3
        bx = 18 + 14 * thrust
        cr.set_source_rgb(*RIFLE_WOOD_RGB)
        cr.set_line_width(5)
        cr.move_to(bx, y)
        cr.line_to(bx - 26, y - 3)
        cr.stroke()
        cr.set_source_rgb(*STEEL_RGB)
        cr.set_line_width(2.2)
        cr.move_to(bx - 26, y - 3)
        cr.line_to(bx - 80, y - 9)
        cr.stroke()
        cr.set_source_rgb(*COAT_RGB)
        cr.set_line_width(6)
        for hx in (bx - 8, bx - 36):
            cr.move_to(3, y - 13)
            cr.line_to(hx, y - (1 if hx > bx - 20 else 5))
        cr.stroke()
        if thrust > 0.6:
            # Dust and splinters off the logs.
            a = (thrust - 0.6) / 0.4
            cr.set_source_rgba(*WOOD_HI_RGB, 0.8 * a)
            for k in range(3):
                ang = -0.9 + k * 0.9
                cr.arc(bx + 6 + math.cos(ang) * 8 * a,
                       y + math.sin(ang) * 8 * a, 2.2, 0, 2 * math.pi)
                cr.fill()

    @staticmethod
    def _redcoat(cr, x, feet, s, facing, step, fall, pound=-1.0, seed=0.0):
        """A redcoat on the march, musket at the shoulder, in the same
        100-unit model as the mountain man. fall runs 0..1 as he topples
        backward and fades once he is shot; pound is the seconds he has
        been beating on the fort's wall, or negative on the march."""
        if s < 1.5:
            return
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        if fall > 0:
            cr.rotate(-1.45 * min(1.0, fall * 1.8))
            cr.push_group()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)

        def leg(swing):
            fx = math.sin(swing) * 36
            cr.set_source_rgb(*KIT_RGB)
            cr.set_line_width(8)
            cr.move_to(0, -46)
            cr.line_to(fx, -2)
            cr.stroke()
            cr.set_source_rgb(*HAT_RGB)
            cr.save()
            cr.translate(fx + 3, -1.5)
            cr.scale(6, 2.6)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()

        leg(-step)
        # Coat tails behind, then the coat, its white cross-belts on top.
        cr.set_source_rgb(*COAT_DARK_RGB)
        cr.move_to(-10, -52)
        cr.line_to(-17, -30)
        cr.line_to(-6, -36)
        cr.close_path()
        cr.fill()
        leg(step)
        CpuView._rc_upper(cr)

        if pound >= 0:
            CpuView._pounding(cr, pound, seed, -62)
            if fall > 0:
                cr.pop_group_to_source()
                cr.paint_with_alpha(max(0.0, 1.0 - fall))
            cr.restore()
            return

        # Musket at the shoulder, bayonet fixed.
        cr.set_source_rgb(*RIFLE_WOOD_RGB)
        cr.set_line_width(5)
        cr.move_to(7, -46)
        cr.line_to(4, -72)
        cr.stroke()
        cr.set_source_rgb(*STEEL_RGB)
        cr.set_line_width(2.2)
        cr.move_to(4, -72)
        cr.line_to(-3, -124)
        cr.stroke()
        cr.set_line_width(1.2)
        cr.move_to(-2, -122)
        cr.line_to(-4, -138)
        cr.stroke()
        cr.set_source_rgb(*COAT_RGB)
        cr.set_line_width(6)
        cr.move_to(3, -75)
        cr.line_to(7, -50)
        cr.stroke()
        cr.set_source_rgb(*SKIN_RGB)
        cr.arc(7, -48, 3, 0, 2 * math.pi)
        cr.fill()

        if fall > 0:
            cr.pop_group_to_source()
            cr.paint_with_alpha(max(0.0, 1.0 - fall))
        cr.restore()

    @staticmethod
    def _cavalry(cr, x, feet, s, facing, gallop, fall, pound=-1.0,
                 seed=0.0):
        """A redcoat on horseback, saber out, in the same 100-unit model;
        gallop is the phase of the stride, and pound as for a redcoat."""
        if s < 1.5:
            return
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        if fall > 0:
            cr.rotate(-1.2 * min(1.0, fall * 1.8))
            cr.push_group()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        moving = pound < 0 and fall <= 0
        bob = math.sin(gallop * 2) * 2.5 if moving else 0.0

        def legs(far):
            cr.set_source_rgb(*(HORSE_DARK_RGB if far else HORSE_RGB))
            cr.set_line_width(5)
            for hx in ((-24, 14) if far else (-18, 20)):
                ph = gallop + (0.0 if hx < 0 else 2.0) + (0.5 if far else 0)
                swing = math.sin(ph) * 0.6 if moving else 0.0
                lift = max(0.0, math.cos(ph)) * 6 if moving else 0.0
                cr.move_to(hx, -40 + bob)
                cr.line_to(hx + math.sin(swing) * 12, -20 - lift)
                cr.line_to(hx + math.sin(swing) * 20, -2 - lift)
            cr.stroke()

        # The horse is drawn in its own units, scaled up to stand as high
        # at the withers as a man's shoulder.
        cr.save()
        cr.scale(1.35, 1.35)
        legs(True)
        cr.set_source_rgb(*HORSE_DARK_RGB)
        cr.set_line_width(5)
        cr.move_to(-30, -52 + bob)
        cr.curve_to(-40, -50, -44, -40, -42 - bob, -28)
        cr.stroke()
        cr.set_source_rgb(*HORSE_RGB)
        cr.save()
        cr.translate(0, -48 + bob)
        cr.scale(30, 12)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        cr.move_to(18, -54 + bob)
        cr.line_to(30, -80 + bob)
        cr.line_to(48, -68 + bob)
        cr.line_to(45, -62 + bob)
        cr.line_to(34, -66 + bob)
        cr.line_to(30, -44 + bob)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*HORSE_DARK_RGB)
        cr.set_line_width(3)
        cr.move_to(19, -58 + bob)
        cr.line_to(29, -80 + bob)
        cr.stroke()
        legs(False)
        cr.restore()

        # The rider, sitting the saddle.
        cr.save()
        cr.translate(-3, (-60 + bob) * 1.35 + 42)
        cr.set_source_rgb(*KIT_RGB)
        cr.set_line_width(7)
        cr.move_to(0, -44)
        cr.line_to(8, -30)
        cr.line_to(6, -18)
        cr.stroke()
        CpuView._rc_upper(cr)
        if pound >= 0:
            CpuView._pounding(cr, pound, seed, -62)
        else:
            cr.set_source_rgb(*COAT_RGB)
            cr.set_line_width(6)
            cr.move_to(3, -74)
            cr.line_to(16, -64)
            cr.stroke()
            cr.set_source_rgb(*STEEL_RGB)
            cr.set_line_width(1.8)
            cr.move_to(16, -64)
            cr.line_to(44, -84)
            cr.stroke()
            cr.set_source_rgb(*SKIN_RGB)
            cr.arc(16, -64, 3, 0, 2 * math.pi)
            cr.fill()
        cr.restore()

        if fall > 0:
            cr.pop_group_to_source()
            cr.paint_with_alpha(max(0.0, 1.0 - fall))
        cr.restore()

    @staticmethod
    def _cannon(cr, x, feet, s, facing, roll, fall, struck, boom, elev=0.12,
                crank=None):
        """A field gun on its carriage, in the same 100-unit model. roll
        turns the wheel; struck and boom are the seconds since it was hit
        and since it fired, or negative. elev is the barrel's angle above
        level; crank, if given, is the angle of the handle on its elevating
        gear. Returns the muzzle in the model's units."""
        if s < 1.5:
            return
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        if fall > 0:
            # Knocked off its wheel: it slumps nose-down and fades.
            cr.rotate(0.35 * min(1.0, fall * 2))
            cr.push_group()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)

        cr.set_source_rgb(*WOOD_RGB)
        cr.move_to(-36, -2)
        cr.line_to(-34, -9)
        cr.line_to(6, -27)
        cr.line_to(10, -19)
        cr.close_path()
        cr.fill()
        cr.save()
        cr.translate(-2, -27)
        cr.rotate(-elev)
        cr.set_source_rgb(*IRON_RGB)
        cr.move_to(-12, -6)
        cr.line_to(36, -4)
        cr.line_to(36, 4)
        cr.line_to(-12, 6)
        cr.close_path()
        cr.fill()
        cr.rectangle(33, -5.5, 5, 11)
        cr.fill()
        cr.arc(-14, 0, 3.5, 0, 2 * math.pi)
        cr.fill()
        cr.restore()
        muzzle = (-2 + 38 * math.cos(elev), -27 - 38 * math.sin(elev))
        if crank is not None:
            # The elevating gear on the carriage cheek, and its handle.
            cr.set_source_rgb(*STEEL_RGB)
            cr.set_line_width(2)
            cr.arc(-10, -34, 6, 0, 2 * math.pi)
            cr.stroke()
            hx, hy = -10 + math.cos(crank) * 9, -34 + math.sin(crank) * 9
            cr.move_to(-10, -34)
            cr.line_to(hx, hy)
            cr.stroke()
            cr.arc(hx, hy, 2, 0, 2 * math.pi)
            cr.fill()

        cr.set_source_rgb(*SEAM_RGB)
        cr.set_line_width(3.5)
        cr.arc(0, -15, 14, 0, 2 * math.pi)
        cr.stroke()
        cr.set_line_width(2)
        for k in range(6):
            a = roll + k * math.pi / 3
            cr.move_to(0, -15)
            cr.line_to(math.cos(a) * 13, -15 + math.sin(a) * 13)
        cr.stroke()
        cr.arc(0, -15, 3, 0, 2 * math.pi)
        cr.fill()

        if 0 <= struck < 0.35:
            # Splinters off the carriage where the ball struck.
            u = struck / 0.35
            cr.set_source_rgba(*WOOD_HI_RGB, 1 - u)
            cr.set_line_width(2)
            for k in range(5):
                a = -math.pi * (0.15 + 0.17 * k)
                r0, r1 = 6 + 18 * u, 11 + 22 * u
                cr.move_to(math.cos(a) * r0, -22 + math.sin(a) * r0)
                cr.line_to(math.cos(a) * r1, -22 + math.sin(a) * r1)
            cr.stroke()
        if 0 <= boom < 2.0:
            mx, my = muzzle
            dx, dy = math.cos(elev), -math.sin(elev)
            u = boom / 2.0
            for j in range(3):
                reach = 8 + 30 * math.sqrt(u) + 8 * j
                cr.set_source_rgba(*SMOKE_RGB, 0.6 * (1 - u))
                cr.arc(mx + dx * reach, my + dy * reach - 10 * u - 4 * j,
                       6 + 14 * math.sqrt(u) + 3 * j, 0, 2 * math.pi)
                cr.fill()
            if boom < 0.15:
                CpuView._glow(cr, mx + 6 * dx, my + 6 * dy, 34, FLASH_RGB,
                              1 - boom / 0.15)

        if fall > 0:
            cr.pop_group_to_source()
            cr.paint_with_alpha(max(0.0, 1.0 - fall))
        cr.restore()
        return muzzle

    def _draw_fort(self, cr, x, y, w, h, t):
        """The stockade around the yard (x, y, w, h), its gate and towers;
        returns where sentries may stand."""
        wall = t * 0.3
        stake = max(6.0, t * 0.16)
        X, Y, W, H = x - wall, y - wall, w + 2 * wall, h + 2 * wall

        self._rounded(cr, X, Y, W, H, wall * 0.4)
        cr.set_source_rgba(*YARD_RGB, 0.75)
        cr.fill()

        # Side walls are seen from the front, like the rest: a column of
        # stakes each side, standing full height.
        for sx in (X, X + W - wall):
            self._wall(cr, sx, sx + wall, Y + H, Y - wall * 0.6, stake, True)
        # Back wall, sharpened against the sky; front wall, with the gate.
        self._wall(cr, X + wall, X + W - wall, y, Y - wall * 0.9, stake, True)
        gate_w = min(t * 0.9, w * 0.35)
        cx = X + W / 2
        self._wall(cr, X + wall, cx - gate_w / 2, Y + H, y + h, stake, True)
        self._wall(cr, cx + gate_w / 2, X + W - wall, Y + H, y + h, stake,
                   True)
        self._gate(cr, cx, Y + H, y + h - wall * 0.2, gate_w)

        tower_w = wall * 2.4
        tower_h = t * 0.5
        floor = Y - tower_h
        towers = []
        for tx in (X - tower_w * 0.35, X + W - tower_w * 0.65):
            self._blockhouse(cr, tx, floor, tower_w, tower_h + wall)
            towers.append(tx + tower_w / 2)
        # Clickable: the stockade and towers, and the sentries above them.
        self.fort_box = (X - tower_w * 0.35, floor - t * 1.1,
                         X + W + tower_w * 0.35, Y + H)
        return towers, floor, (X + tower_w, X + W - tower_w), Y - wall * 0.9

    DRILL_LEN = 4.6     # from kneeling to the last of the smoke
    SHOT_AT = 2.0       # he fires this far into it

    BUGLE_LEN = 2.0     # from raising the bugle to lowering it
    BUGLE_HEARD = 1.2   # the tower sentry starts his drill this far in

    @staticmethod
    def _ramp(tau, a, b):
        u = min(1.0, max(0.0, (tau - a) / (b - a)))
        return u * u * (3 - 2 * u)

    def _drill_t(self, i):
        """Seconds into tower sentry i's drill; negative while he waits on
        the bugle, DRILL_LEN or more once he is done."""
        start = self.drill_start[i]
        return self.DRILL_LEN if start is None else self.phase - start

    def _busy(self, i):
        return self._drill_t(i) < self.DRILL_LEN

    def _drilling(self, i):
        return 0 <= self._drill_t(i) < self.DRILL_LEN

    def _drill(self, i):
        """Tower sentry i kneels, takes aim and fires. Returns (kneel, aim,
        seconds since the shot or -1)."""
        tau = self._drill_t(i)
        kneel = self._ramp(tau, 0.0, 0.6) - self._ramp(tau, 3.2, 3.8)
        aim = self._ramp(tau, 0.4, 1.1) - self._ramp(tau, 2.8, 3.4)
        shot = tau - self.SHOT_AT if self.SHOT_AT <= tau < self.DRILL_LEN \
            else -1.0
        return kneel, aim, shot

    def _bugle_t(self):
        if self.bugle_at is None:
            return self.BUGLE_LEN
        return self.phase - self.bugle_at

    def _bugling(self):
        return self._bugle_t() < self.BUGLE_LEN

    def _horn(self, tau):
        """A call tau seconds in. Returns (how far the horn is raised,
        seconds since he began to blow or -1)."""
        raised = self._ramp(tau, 0.0, 0.35) - self._ramp(tau, 1.6, 1.95)
        toot = tau - 0.45 if 0.45 <= tau < 1.6 else -1.0
        return raised, toot

    def _bugle(self):
        """The walker's call."""
        return self._horn(self._bugle_t())

    @staticmethod
    def _bezier(pts, p):
        (x0, y0), (x1, y1), (x2, y2), (x3, y3) = pts
        q = 1 - p
        a, b, c, d = q * q * q, 3 * q * q * p, 3 * q * p * p, p * p * p
        return (a * x0 + b * x1 + c * x2 + d * x3,
                a * y0 + b * y1 + c * y2 + d * y3)

    def _depth_scale(self, p):
        """Size at screen position p on a trail, 1 at the near end."""
        far = self.MARCH_NEAR / self.MARCH_FAR
        return far + (1 - far) * p

    # How far from the wall each kind stands to reach it, and how much room
    # it takes in the line there, both as a fraction of its size.
    STANDOFF = {"foot": 0.0, "horse": 0.3, "cannon": 0.45}
    BREADTH = {"foot": 0.5, "horse": 0.95, "cannon": 0.8}
    CHEST = {"foot": 0.6, "horse": 0.75, "cannon": 0.2}

    def _at_wall(self, rc):
        """At the wall itself, rather than waiting in the queue behind."""
        return rc["at_wall"] is not None and rc["slot"] < self.AT_WALL

    def _redcoat_at(self, rc):
        """Where a redcoat stands: (x, feet, size)."""
        p = self._trail_p(rc["d"])
        x, y = self._bezier(self.trails[rc["side"]], p)
        size = self.redcoat_s * self._depth_scale(p)
        if self._at_wall(rc):
            outward = -1 if rc["side"] == 0 else 1
            x += outward * size * (self.STANDOFF[rc["kind"]]
                                   + rc["slot"] * 0.7)
        return x, y, size

    def _draw_trails(self, cr):
        """Two dirt trails winding in from the far corners, narrowing with
        distance."""
        for pts in self.trails:
            n = 48
            edge_a, edge_b = [], []
            for k in range(n + 1):
                p = k / n
                x, y = self._bezier(pts, p)
                x2, y2 = self._bezier(pts, min(1.0, p + 0.01))
                x1, y1 = self._bezier(pts, max(0.0, p - 0.01))
                tx, ty = x2 - x1, y2 - y1
                norm = math.hypot(tx, ty) or 1.0
                half = self.redcoat_s * 0.5 * self._depth_scale(p)
                nx, ny = -ty / norm * half, tx / norm * half
                edge_a.append((x + nx, y + ny))
                edge_b.append((x - nx, y - ny))
            cr.move_to(*edge_a[0])
            for pt in edge_a[1:] + edge_b[::-1]:
                cr.line_to(*pt)
            cr.close_path()
            grad = cairo.LinearGradient(*pts[0], *pts[3])
            grad.add_color_stop_rgba(0.0, *PATH_RGB, 0.35)
            grad.add_color_stop_rgba(1.0, *PATH_RGB, 0.75)
            cr.set_source(grad)
            cr.fill()

    def _draw_barracks(self, cr, i):
        """A brick barracks with lit windows and a pennant, its door on the
        far end of trail i; the door stands open while a redcoat comes
        out."""
        x, y = self.trails[i][0]
        B = self.redcoat_s * 0.8
        x0, top = x - B / 2, y - 0.42 * B
        peak = top - 0.24 * B
        cr.set_source_rgb(*BRICK_RGB)
        cr.rectangle(x0, top, B, y - top)
        cr.fill_preserve()
        cr.set_source_rgb(*BRICK_DARK_RGB)
        cr.set_line_width(max(0.6, B * 0.02))
        cr.stroke()
        cr.set_source_rgb(*ROOF_RGB)
        cr.move_to(x0 - 0.06 * B, top)
        cr.line_to(x, peak)
        cr.line_to(x0 + B * 1.06, top)
        cr.close_path()
        cr.fill()
        cr.set_source_rgba(*WINDOW_RGB, 0.85)
        for fx in (0.1, 0.27, 0.61, 0.78):
            cr.rectangle(x0 + fx * B, top + 0.1 * B, 0.11 * B, 0.12 * B)
        cr.fill()
        opening = any(rc["side"] == i
                      and self.phase - rc["born"] < self.DOOR_OPEN_S
                      for rc in self.redcoats)
        cr.set_source_rgb(*((0.05, 0.03, 0.03) if opening else WOOD_RGB))
        cr.rectangle(x - 0.08 * B, y - 0.27 * B, 0.16 * B, 0.27 * B)
        cr.fill()
        # The pennant on its pole, streaming out over the roof.
        cr.set_source_rgb(*STEEL_RGB)
        cr.set_line_width(max(0.6, B * 0.02))
        cr.move_to(x, peak)
        cr.line_to(x, peak - 0.36 * B)
        cr.stroke()
        wave = math.sin(self.phase * 3.0 + i) * 0.04 * B
        cr.set_source_rgb(*COAT_RGB)
        cr.move_to(x, peak - 0.36 * B)
        cr.line_to(x + 0.24 * B, peak - 0.31 * B + wave)
        cr.line_to(x, peak - 0.25 * B)
        cr.close_path()
        cr.fill()
        self.barracks_box[i] = (x0 - 3, peak - 0.36 * B - 3, x0 + B + 3,
                                y + 3)

    STAIN_S = 8.0       # a pool of blood fades out over this long

    def _draw_stains(self, cr):
        """Pools of blood where redcoats fell, spreading, then fading."""
        self.stains = [st for st in self.stains
                       if self.phase - st[3] < self.STAIN_S]
        for x, y, size, born in self.stains:
            age = self.phase - born
            fade = 1.0 - max(0.0, age - self.STAIN_S * 0.6) \
                / (self.STAIN_S * 0.4)
            r = size * 0.38 * min(1.0, 0.3 + age * 1.2)
            cr.save()
            cr.translate(x, y)
            cr.scale(1.0, 0.3)
            cr.arc(0, 0, r, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgba(*BLOOD_RGB, 0.8 * fade)
            cr.fill()

    def _spray(self, cr, x, y, size, back, e, seed):
        """Blood flung from a wound at (x, y), back the way the shot came
        from, e seconds after it."""
        if e >= 0.7:
            return
        cr.set_source_rgba(*BLOOD_RGB, 1.0 - e / 0.7)
        for k in range(9):
            a = 0.25 + 0.9 * ((k * 0.618 + seed) % 1.0)
            v = size * (0.9 + 0.5 * ((k * 0.382 + seed) % 1.0))
            px = x + back * math.cos(a) * v * e
            py = y - math.sin(a) * v * e + size * 3.0 * e * e
            cr.arc(px, py, max(0.6, size * 0.035), 0, 2 * math.pi)
            cr.fill()

    def _draw_redcoats(self, cr):
        self._draw_stains(cr)
        for rc in sorted(self.redcoats, key=lambda rc: -rc["d"]):
            x, feet, size = self._redcoat_at(rc)
            p = self._trail_p(rc["d"])
            pts = self.trails[rc["side"]]
            toward = 1 if rc["side"] == 0 else -1
            ahead = self._bezier(pts, min(1.0, p + 0.02))[0] - x
            facing = (1 if ahead > 0 else -1) \
                if abs(ahead) > 0.3 and not self._at_wall(rc) else toward
            alive = rc["hit"] is None
            marching = alive and rc["at_wall"] is None
            fall = 0.0 if alive else (self.phase - rc["hit"]) / self.FALL_S
            pound = self.phase - rc["at_wall"] \
                if alive and self._at_wall(rc) else -1.0
            kind = rc["kind"]
            if kind == "horse":
                self._cavalry(cr, x, feet, size, facing,
                              self.phase * 11 + rc["n"], fall, pound,
                              rc["n"] * 1.3)
            elif kind == "cannon":
                # Its crewman pushes from behind.
                step = math.sin(self.phase * 4 + rc["n"]) * 0.3 \
                    if marching else 0.0
                self._redcoat(cr, x - facing * size * 0.55, feet,
                              size * 0.95, facing, step, fall)
                struck = -1.0 if rc["struck"] is None \
                    else self.phase - rc["struck"]
                boom = pound % 4.0 if pound >= 0 else -1.0
                self._cannon(cr, x, feet, size, facing,
                             (self.MARCH_FAR - rc["d"]) * 9, fall, struck,
                             boom)
            else:
                step = math.sin(self.phase * 6.5 + rc["n"] * 1.7) * 0.35 \
                    if marching else 0.0
                self._redcoat(cr, x, feet, size, facing, step, fall, pound,
                              rc["n"] * 1.3)
            if not alive:
                # The man bleeds, whether rider, gunner or foot.
                bx = x - facing * size * 0.55 if kind == "cannon" else x
                chest = 0.75 if kind == "horse" else 0.6
                if not rc.get("stained"):
                    rc["stained"] = True
                    self.stains.append((bx - toward * size * 0.35, feet, size,
                                        self.phase))
                self._spray(cr, bx, feet - size * chest, size, -toward,
                            self.phase - rc["hit"], rc["n"] * 0.37)

    def _draw_sentries(self, cr, towers, floor, walk, walk_y, t):
        if not self.on:
            return  # Nobody on the walls while the fort stands down.
        s = t * 0.85
        for i, tx in enumerate(towers):
            outward = -1 if i == 0 else 1
            if self._calling(i):
                # Turned toward the middle, blowing for the gun.
                raised, toot = self._horn(self._relief_t())
                self._mountain_man(cr, tx, floor, s, -outward, bugle=raised,
                                   toot=toot)
                continue
            kneel, aim, shot = self._drill(i)
            if self._drilling(i):
                elev = 0.04
                target = self.drill_target[i]
                if target is not None and self.trails:
                    rx, feet, size = self._redcoat_at(target)
                    chest = feet - size * self.CHEST[target["kind"]]
                    rise = (floor - s * 0.52) - chest
                    elev = min(1.3, max(-0.6, math.atan2(
                        rise, max(1.0, abs(rx - tx)))))
                self._mountain_man(cr, tx, floor, s, outward, kneel=kneel,
                                   aim=aim, shot=shot, elev=elev)
                continue
            # Each looks out, and now and then glances back into the yard.
            glance = int(self.phase / 3.1 + i * 1.7) % 4 == 0
            glint = max(0.0, math.sin(self.phase * 1.3 + i * 2.0)) ** 30
            self._mountain_man(cr, tx, floor, s, -outward if glance
                               else outward, glint=glint)
        x0, x1 = walk
        self.has_walker = x1 - x0 > s * 0.6
        if not self.has_walker:
            return
        # One more walks the wall from tower to tower and back, and stands
        # still while he sounds his bugle or works the gun.
        walked = self.phase - self.walker_halted
        u = (walked / 9.0) % 2.0
        pos = u if u < 1.0 else 2.0 - u
        patrol = x0 + (x1 - x0) * (0.5 - 0.5 * math.cos(pos * math.pi))
        self.walker_facing = 1 if u < 1.0 else -1
        ws = s * 0.92

        # The fort's gun stands on the wall walk where it was last wheeled.
        gun_x, gs = x0 + (x1 - x0) * self._gun_frac(), s * 1.25
        rt = self._relief_t()
        if rt is not None:
            self.gun_facing = -1 if self.relief["side"] == 0 else 1
        gf = self.gun_facing
        pivot = (gun_x - gf * 2 * gs / 100, walk_y - 27 * gs / 100)
        elev, crank, boom, ball = 0.12, None, -1.0, None
        if rt is not None:
            side = self.relief["side"]
            nx, ny = self.trails[side][3]
            land = (nx + gf * self.redcoat_s * 0.4, ny)
            # A high lob, steep enough that coming down it still clears the
            # tower sentry's head and his rifle with room to spare.
            reach = abs(land[0] - pivot[0])
            lift = 1.4 * reach
            # Over his middle, and again past his outward side, where the
            # ball has least room left to fall.
            outward = -1 if side == 0 else 1
            for dx, above in ((0.0, 2.0), (0.55, 1.1)):
                over = abs(towers[side] + outward * dx * s - pivot[0]) \
                    / max(1.0, reach)
                if 0 < over < 1:
                    line = pivot[1] + (land[1] - pivot[1]) * over
                    clear = floor - s * above
                    lift = max(lift,
                               (line - clear) / (4 * over * (1 - over)))
            # A lighter charge from closer in: the arc tops out inside the
            # picture, even if that means a closer pass over his head.
            drop = land[1] - pivot[1]

            def top(lift):
                u = min(1.0, max(0.0, (1 - drop / (4 * lift)) / 2))
                return pivot[1] + drop * u - 4 * lift * u * (1 - u)

            lift = min(lift, 3.0 * reach)
            if top(lift) < self.redcoat_s * 0.2:
                lo, hi = reach * 0.25, lift
                for _ in range(30):
                    mid = (lo + hi) / 2
                    lo, hi = (mid, hi) if top(mid) >= self.redcoat_s * 0.2 \
                        else (lo, mid)
                lift = lo
            aim = math.atan2(4 * lift - drop, reach)
            cranked = self._ramp(rt, self.CRANK_AT, self.FIRE_AT)
            lowered = self._ramp(rt, self.RELIEF_LEN - 0.8, self.RELIEF_LEN)
            elev = 0.12 + (aim - 0.12) * (cranked - lowered)
            if self.CRANK_AT <= rt < self.FIRE_AT:
                crank = rt * 9.0
            boom = rt - self.FIRE_AT
            fly = (rt - self.FIRE_AT) / self.FLIGHT_S
            if 0 <= fly < 1:
                ball = (pivot[0] + (land[0] - pivot[0]) * fly,
                        pivot[1] + (land[1] - pivot[1]) * fly
                        - 4 * lift * fly * (1 - fly))
        handle = None
        if crank is not None:
            handle = (gun_x + gf * (-10 + math.cos(crank) * 9) * gs / 100,
                      walk_y + (-34 + math.sin(crank) * 9) * gs / 100)
        elif rt is not None and self.WHEEL_AT <= rt < self.CRANK_AT:
            # Both hands on the end of the trail, pushing.
            handle = (gun_x - gf * 34 * gs / 100, walk_y - 9 * gs / 100)
        self._cannon(cr, gun_x, walk_y, gs, gf, gf * gun_x / (0.14 * gs),
                     0.0, -1.0, boom, elev,
                     crank if crank is not None else 0.0)

        if rt is None:
            raised, toot = self._bugle()
            step = 0.0 if self._bugling() \
                else math.sin(walked * 7.0) * 0.38
            self._mountain_man(cr, patrol, walk_y, ws, self.walker_facing,
                               step=step, shouldered=True, bugle=raised,
                               toot=toot)
        else:
            # He runs to his place behind the gun, wheels it toward the
            # wall in trouble, kneels to crank it up, and once it has fired
            # runs back to where he left off.
            station = gun_x - gf * gs * (
                0.45 - 0.15 * self._ramp(rt, self.CRANK_AT,
                                         self.CRANK_AT + 0.3))
            there = self.WHEEL_AT
            back = self.FIRE_AT + 0.5
            pushing = there <= rt < self.CRANK_AT
            if rt < self.HEARD_AT or rt >= back + self.RUN_S:
                wx, facing, run = patrol, self.walker_facing, False
            elif rt < there:
                k = self._ramp(rt, self.HEARD_AT, there)
                wx, run = patrol + (station - patrol) * k, True
                facing = 1 if station >= patrol else -1
            elif rt < back:
                wx, facing, run = station, gf, False
            else:
                k = self._ramp(rt, back, back + self.RUN_S)
                wx, run = station + (patrol - station) * k, True
                facing = 1 if patrol >= station else -1
            kneel = self._ramp(rt, self.CRANK_AT, self.CRANK_AT + 0.3) \
                - self._ramp(rt, back - 0.3, back)
            step = math.sin(self.phase * 14.0) * 0.55 if run \
                else math.sin(self.phase * 8.0) * 0.35 if pushing else 0.0
            self._mountain_man(cr, wx, walk_y, ws, facing, step=step,
                               shouldered=kneel == 0 and not handle,
                               kneel=kneel)
            if handle is not None:
                # His near arm on the crank handle.
                sx = wx + facing * 6 * ws / 100
                sy = walk_y + (-75 + 20 * kneel) * ws / 100
                cr.set_source_rgb(*BUCK_RGB)
                cr.set_line_width(6 * ws / 100)
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                cr.move_to(sx, sy)
                cr.line_to(*handle)
                cr.stroke()
                cr.set_source_rgb(*SKIN_RGB)
                cr.arc(*handle, 3 * ws / 100, 0, 2 * math.pi)
                cr.fill()

        if ball is not None:
            r = max(2.5, gs * 0.045)
            for j in range(4):
                back_u = max(0.0, fly - 0.03 * (j + 1))
                tx_ = pivot[0] + (land[0] - pivot[0]) * back_u
                ty_ = pivot[1] + (land[1] - pivot[1]) * back_u \
                    - 4 * lift * back_u * (1 - back_u)
                cr.set_source_rgba(*SMOKE_RGB, 0.25 - 0.05 * j)
                cr.arc(tx_, ty_, r * (0.9 - 0.15 * j), 0, 2 * math.pi)
                cr.fill()
            # Light enough to see against the night sky.
            cr.arc(*ball, r, 0, 2 * math.pi)
            cr.set_source_rgb(*BALL_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*HAT_RGB)
            cr.set_line_width(max(0.8, r * 0.3))
            cr.stroke()
        if rt is not None and 0 <= rt - self.FIRE_AT - self.FLIGHT_S < 1.0:
            self._blast(cr, land, rt - self.FIRE_AT - self.FLIGHT_S)

    def _blast(self, cr, at, e):
        """The ball landing at the foot of the wall, e seconds on."""
        x, y = at
        size = self.redcoat_s
        self._glow(cr, x, y - size * 0.2, size * (0.6 + 0.8 * e), FLASH_RGB,
                   max(0.0, 1.0 - e * 1.4))
        for k in range(9):
            a = -math.pi * (0.1 + 0.8 * k / 8)
            v = size * (1.1 + 0.3 * (k % 3))
            px = x + math.cos(a) * v * e
            py = y + math.sin(a) * v * e + size * 2.2 * e * e
            cr.set_source_rgba(*PATH_RGB, max(0.0, 1.0 - e))
            cr.arc(px, py, size * 0.05, 0, 2 * math.pi)
            cr.fill()
        cr.set_source_rgba(*SMOKE_RGB, 0.5 * max(0.0, 1.0 - e))
        cr.arc(x, y - size * (0.3 + 0.4 * e), size * (0.25 + 0.4 * e), 0,
               2 * math.pi)
        cr.fill()

    # -- the grove, where the fort stands when it is down ------------------

    def _pine(self, cr, x, base, h, sway):
        """A conifer: trunk and three tiers, its tip swaying by sway."""
        w = h * 0.5
        cr.set_source_rgb(*TRUNK_RGB)
        cr.rectangle(x - w * 0.07, base - h * 0.2, w * 0.14, h * 0.2)
        cr.fill()
        for i, (lo, hi, frac) in enumerate(((0.12, 0.62, 1.0),
                                            (0.38, 0.84, 0.78),
                                            (0.60, 1.0, 0.55))):
            dx = sway * (hi - 0.1)
            cr.move_to(x - w / 2 * frac + sway * lo, base - h * lo)
            cr.line_to(x + dx, base - h * hi)
            cr.line_to(x + w / 2 * frac + sway * lo, base - h * lo)
            cr.close_path()
            cr.set_source_rgb(*(PINE_RGB if i % 2 == 0 else PINE_HI_RGB))
            cr.fill()

    def _round_tree(self, cr, x, base, h, sway):
        """A broadleaf: trunk and a canopy of three overlapping puffs."""
        r = h * 0.26
        cr.set_source_rgb(*TRUNK_RGB)
        cr.rectangle(x - h * 0.04, base - h * 0.45, h * 0.08, h * 0.45)
        cr.fill()
        cy = base - h + r
        for dx, dy, rr, rgb in ((-0.55, 0.35, 0.85, LEAF_RGB),
                                (0.55, 0.35, 0.85, LEAF_RGB),
                                (0.0, 0.0, 1.0, LEAF_HI_RGB)):
            cr.set_source_rgb(*rgb)
            cr.arc(x + dx * r + sway, cy + dy * r, r * rr, 0, 2 * math.pi)
            cr.fill()

    @staticmethod
    def _bush(cr, x, base, s):
        for dx, dy, rr, rgb in ((-0.5, 0.0, 0.55, LEAF_RGB),
                                (0.5, 0.0, 0.55, LEAF_RGB),
                                (0.0, -0.3, 0.65, LEAF_HI_RGB)):
            cr.set_source_rgb(*rgb)
            cr.arc(x + dx * s, base - s * 0.45 + dy * s, s * rr,
                   0, 2 * math.pi)
            cr.fill()

    def _draw_grove(self, cr, x, y, w, h, t):
        """Trees and bushes where the stockade stands while it is up: the
        same ground, but nothing on it is held for anyone."""
        edge = t * 0.3
        X, Y, W, H = x - edge, y - edge, w + 2 * edge, h + 2 * edge

        self._rounded(cr, X, Y, W, H, edge)
        grad = cairo.LinearGradient(0, Y, 0, Y + H)
        grad.add_color_stop_rgba(0.0, *MEADOW_RGB, 0.55)
        grad.add_color_stop_rgba(1.0, *MEADOW_RGB, 0.30)
        cr.set_source(grad)
        cr.fill()

        # A row of trees along the back, taller ones at the corners where
        # the towers stand. Sizes vary but stay the same from frame to frame.
        n = max(4, round(W / (t * 0.5)))
        for i in range(n + 1):
            tx = X + W * i / n
            corner = i in (0, n)
            th = t * (1.45 if corner else 0.95 + 0.4 * ((i * 0.618) % 1.0))
            sway = math.sin(self.phase * 0.9 + i * 1.3) * t * 0.03
            if corner or i % 3 != 1:
                self._pine(cr, tx, y + edge * 0.2, th, sway)
            else:
                self._round_tree(cr, tx, y + edge * 0.2, th * 0.9, sway)

        # Bushes down the sides and along the front, with a gap for a path.
        s = t * 0.16
        rows = max(1, round(h / (s * 2.2)))
        for j in range(rows):
            by = y + h * (j + 0.8) / rows
            self._bush(cr, X + edge * 0.5, by, s)
            self._bush(cr, X + W - edge * 0.5, by, s)
        path = min(t * 0.9, w * 0.35)
        cr.set_source_rgba(*PATH_RGB, 0.6)
        cr.rectangle(X + W / 2 - path / 2, y + h, path, Y + H - (y + h))
        cr.fill()
        k = max(2, round((W - path) / 2 / (s * 2.1)))
        for side in (-1, 1):
            for j in range(k):
                bx = X + W / 2 + side * (path / 2 + s + j * (W - path) / 2 / k)
                self._bush(cr, bx, Y + H, s)

    # -- the picture ------------------------------------------------------

    def _draw(self, _area, cr, width, height):
        self.fort_box = None
        if not self.cores:
            return
        fort = [c for c in self.cores
                if any(cpu in self.reserved for cpu in c["cpus"])]
        rest = [c for c in self.cores if c not in fort]
        gap = max(10.0, width * 0.025)
        label_h = max(16.0, height * 0.05)
        cols_f = max(1, min(self.COLS, len(fort)))
        rows_f = math.ceil(len(fort) / cols_f) if fort else 1
        cols_o = max(1, len(rest))

        # Every size is a multiple of a tile width, plus fixed gaps. Top to
        # bottom: the rest of the chip in one row of tiles t_o wide, 0.2t of
        # open ground, towers and sentries taking 1.6t above the fort's
        # wall, and the wall 0.3t a side. The fort's tiles t are sized on
        # their own, so a long row of the rest does not shrink the fort.
        # The outer fifth of the width each side is left to the trails.
        inner = width * 0.62
        t_o_max = (inner - (cols_o + 1.6) * gap) / cols_o if rest else 0.0
        die_h = 1.05 * t_o_max + label_h + 2.6 * gap if rest else 0.0
        a = 1.6 + 0.6 + 1.05 * rows_f + (0.2 if rest else 0)
        b = rows_f * label_h + (rows_f - 1) * gap + die_h + gap
        t = max(20.0, min((inner - (cols_f + 1) * gap) / (cols_f + 1.4),
                          (height - b) / a))
        t_o = max(12.0, min(t, t_o_max))
        die_h = 1.05 * t_o + label_h + 2.6 * gap if rest else 0.0
        tile_h = t * 1.05
        spare = max(0.0, height - (a * t + b - (
            1.05 * (t_o_max - t_o) if rest else 0)))
        # Most of any height to spare goes to open ground between the chip
        # and the fort, which lengthens the redcoats' march.
        ground = spare * 0.6 if rest else 0.0
        y = (spare - ground) / 2 + gap / 2

        fw = cols_f * t + (cols_f - 1) * gap
        ow = cols_o * t_o + (cols_o - 1) * gap
        # The yard is as wide as the land outside it, so the fort reads as
        # a fort and the wall has room for a man to walk.
        yw = max(fw, ow if rest else fw)
        fh = rows_f * (tile_h + label_h) + (rows_f - 1) * gap
        yx = (width - yw) / 2
        ox = (width - ow) / 2
        oy = y + 1.3 * gap
        fy = y + die_h + (0.2 * t + ground if rest else 0) + 1.6 * t + 0.3 * t

        self.trails = None
        self.barracks_box = [None, None]
        if self.on:
            # Each trail runs from a barracks in a top corner, clear of the
            # chip, down to the foot of the fort's side wall.
            self.redcoat_s = t * 0.9
            near = (yx - 0.3 * t - 0.32 * t, fy + fh + 0.3 * t)
            far = (width * 0.1, self.redcoat_s * 0.8 + 4)
            bend = min(ox - 0.8 * gap - 0.2 * t, width * 0.19)
            pts = (far, (bend, far[1] + (near[1] - far[1]) * 0.35),
                   (width * 0.04, far[1] + (near[1] - far[1]) * 0.7), near)
            self.trails = [pts, tuple((width - px, py) for px, py in pts)]
            self._draw_trails(cr)
            for i in (0, 1):
                self._draw_barracks(cr, i)
            self._draw_redcoats(cr)

        if rest:
            self._draw_die(cr, ox, oy, ow, t_o * 1.05 + label_h, gap)
            self._tiles(cr, rest, ox, oy, cols_o, t_o, t_o * 1.05, label_h,
                        gap, False)

        if self.on:
            towers, floor, walk, walk_y = self._draw_fort(cr, yx, fy, yw, fh,
                                                          t)
        else:
            self._draw_grove(cr, yx, fy, yw, fh, t)
        # Orange only while the fort holds them; down, they are like any other.
        self._tiles(cr, fort, yx + (yw - fw) / 2, fy, cols_f, t, tile_h,
                    label_h, gap, self.on)

        # Last, so a pacing sentry passes in front of the tower roofs.
        if self.on:
            self._draw_sentries(cr, towers, floor, walk, walk_y, t)

    def _tiles(self, cr, cores, x0, y0, cols, t, tile_h, label_h, gap, mine):
        for i, core in enumerate(cores):
            col, row = i % cols, i // cols
            x = x0 + col * (t + gap)
            y = y0 + row * (tile_h + label_h + gap)
            self._draw_tile(cr, x, y, t, tile_h, core, mine)
            label = " · ".join(str(c) for c in core["cpus"])
            self._text(cr, x + t / 2, y + tile_h + label_h * 0.78,
                       label, max(9.0, label_h * 0.6),
                       0.85 if mine else 0.45, bold=mine)

    def _draw_die(self, cr, x, y, w, h, gap):
        """The package outline with pins, so the tiles read as one chip."""
        pad = gap * 0.8
        X, Y, W, H = x - pad, y - pad, w + 2 * pad, h + 2 * pad
        cr.set_line_width(2.0)
        cr.set_source_rgba(*DIM_RGB, 0.18)
        pin = pad * 0.55
        step = max(14.0, W / 24)
        px = X + step / 2
        while px < X + W:
            cr.move_to(px, Y)
            cr.line_to(px, Y - pin)
            cr.move_to(px, Y + H)
            cr.line_to(px, Y + H + pin)
            px += step
        cr.stroke()
        self._rounded(cr, X, Y, W, H, pad)
        grad = cairo.LinearGradient(X, Y, X + W, Y + H)
        grad.add_color_stop_rgba(0.0, 0.16, 0.17, 0.32, 0.55)
        grad.add_color_stop_rgba(1.0, 0.07, 0.09, 0.20, 0.55)
        cr.set_source(grad)
        cr.fill_preserve()
        cr.set_source_rgba(*DIM_RGB, 0.25)
        cr.set_line_width(1.4)
        cr.stroke()

    def _draw_tile(self, cr, x, y, w, h, core, mine):
        pulse = 0.5 + 0.5 * math.sin(self.phase * 2.2)
        live = mine and self.on
        rgb = FORT_RGB if mine else REST_RGB
        r = w * 0.16

        if live:
            self._glow(cr, x + w / 2, y + h / 2, w * (0.95 + 0.12 * pulse),
                       FORT_RGB, 0.30 + 0.12 * pulse)

        self._rounded(cr, x, y, w, h, r)
        cr.set_source_rgba(0.05, 0.06, 0.14, 0.92)
        cr.fill()

        # One bar per thread, filled from the bottom by its live load.
        cpus = core["cpus"]
        inner = w * 0.14
        bar_top = y + inner
        bar_h = y + h - inner - bar_top
        bar_gap = w * 0.08
        bar_w = (w - 2 * inner - bar_gap * (len(cpus) - 1)) / len(cpus)
        for j, cpu in enumerate(cpus):
            bx = x + inner + j * (bar_w + bar_gap)
            self._rounded(cr, bx, bar_top, bar_w, bar_h, bar_w * 0.25)
            cr.set_source_rgba(1, 1, 1, 0.06)
            cr.fill()
            load = self.shown.get(cpu, 0.0)
            fill = bar_h * load
            if fill < 1.0:
                continue
            self._rounded(cr, bx, bar_top + bar_h - fill, bar_w, fill,
                          min(bar_w * 0.25, fill / 2))
            grad = cairo.LinearGradient(0, bar_top + bar_h, 0, bar_top)
            if mine:
                grad.add_color_stop_rgba(0.0, *FORT_RGB, 0.95)
                grad.add_color_stop_rgba(1.0, *FORT_HOT_RGB, 0.95)
            else:
                grad.add_color_stop_rgba(0.0, *REST_RGB, 0.85)
                grad.add_color_stop_rgba(1.0, 0.55, 0.45, 1.0, 0.85)
            cr.set_source(grad)
            cr.fill()

        if live:
            self._sparks(cr, x, bar_top, w, bar_h, core["core"])

        # The frame. Its dash pattern, not its colour, is what says "fort".
        self._rounded(cr, x, y, w, h, r)
        if mine:
            cr.set_line_width(2.4 if live else 1.6)
            cr.set_dash([7.0, 5.0], -self.phase * 18.0 if live else 0.0)
            cr.set_source_rgba(*rgb, 0.95 if live else 0.55)
        else:
            cr.set_line_width(1.2)
            cr.set_dash([])
            cr.set_source_rgba(*DIM_RGB, 0.22)
        cr.stroke()
        cr.set_dash([])

    def _sparks(self, cr, x, top, w, h, seed):
        """Campfire embers rising through the reserved tile."""
        for k in range(4):
            t = (self.phase * 0.55 + k / 4 + seed * 0.37) % 1.0
            sx = x + w * (0.25 + 0.5 * ((k * 0.618 + seed * 0.29) % 1.0))
            sx += math.sin(t * 6.0 + k) * w * 0.04
            sy = top + h * (1.0 - t)
            edge = math.sin(t * math.pi)
            self._glow(cr, sx, sy, w * 0.07, FORT_HOT_RGB, 0.6 * edge)
            cr.set_source_rgba(1, 0.95, 0.85, 0.9 * edge)
            cr.arc(sx, sy, max(1.2, w * 0.012), 0, 2 * math.pi)
            cr.fill()


