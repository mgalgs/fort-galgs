            cr.stroke()
        cr.restore()

    def _draw_fort(self, cr, x, y, w, h, t):
        """The stockade around the yard (x, y, w, h), its gate and towers;
        returns where sentries may stand."""
        wall = t * 0.3
        stake = max(6.0, t * 0.16)
        X, Y, W, H = x - wall, y - wall, w + 2 * wall, h + 2 * wall

        self._rounded(cr, X, Y, W, H, wall * 0.4)
        cr.set_source_rgba(*YARD_RGB, 0.75)
        cr.fill()

        # Side walls are seen from the front, like the rest: a column of
        # stakes each side, standing full height.
        for sx in (X, X + W - wall):
            self._wall(cr, sx, sx + wall, Y + H, Y - wall * 0.6, stake, True)
        # Back wall, sharpened against the sky; front wall, with the gate.
        self._wall(cr, X + wall, X + W - wall, y, Y - wall * 0.9, stake, True)
        gate_w = min(t * 0.9, w * 0.35)
        cx = X + W / 2
        self._wall(cr, X + wall, cx - gate_w / 2, Y + H, y + h, stake, True)
        self._wall(cr, cx + gate_w / 2, X + W - wall, Y + H, y + h, stake,
                   True)
        self._gate(cr, cx, Y + H, y + h - wall * 0.2, gate_w)

        tower_w = wall * 2.4
        tower_h = t * 0.5
        floor = Y - tower_h
        towers = []
        for tx in (X - tower_w * 0.35, X + W - tower_w * 0.65):
            self._blockhouse(cr, tx, floor, tower_w, tower_h + wall)
            towers.append(tx + tower_w / 2)
        return towers, floor, (X + tower_w, X + W - tower_w), Y - wall * 0.9

    def _draw_sentries(self, cr, towers, floor, walk, walk_y, t):
        if not self.on:
            return  # Nobody on the walls while the fort stands down.
        s = t * 0.85
        for i, tx in enumerate(towers):
            outward = -1 if i == 0 else 1
            # Each looks out, and now and then glances back into the yard.
            glance = int(self.phase / 3.1 + i * 1.7) % 4 == 0
            glint = max(0.0, math.sin(self.phase * 1.3 + i * 2.0)) ** 30
            self._mountain_man(cr, tx, floor, s, -outward if glance
                               else outward, glint=glint)
        x0, x1 = walk
        if x1 - x0 > s * 0.6:
            # One more walks the wall from tower to tower and back.
            u = (self.phase / 9.0) % 2.0
            pos = u if u < 1.0 else 2.0 - u
            ease = 0.5 - 0.5 * math.cos(pos * math.pi)
            step = math.sin(self.phase * 7.0) * 0.38
            self._mountain_man(cr, x0 + (x1 - x0) * ease, walk_y, s * 0.92,
                               1 if u < 1.0 else -1, step=step,
                               shouldered=True)

    # -- the grove, where the fort stands when it is down ------------------

    def _pine(self, cr, x, base, h, sway):
        """A conifer: trunk and three tiers, its tip swaying by sway."""
        w = h * 0.5
        cr.set_source_rgb(*TRUNK_RGB)
        cr.rectangle(x - w * 0.07, base - h * 0.2, w * 0.14, h * 0.2)
        cr.fill()
        for i, (lo, hi, frac) in enumerate(((0.12, 0.62, 1.0),
                                            (0.38, 0.84, 0.78),
                                            (0.60, 1.0, 0.55))):
            dx = sway * (hi - 0.1)
            cr.move_to(x - w / 2 * frac + sway * lo, base - h * lo)
            cr.line_to(x + dx, base - h * hi)
            cr.line_to(x + w / 2 * frac + sway * lo, base - h * lo)
            cr.close_path()
            cr.set_source_rgb(*(PINE_RGB if i % 2 == 0 else PINE_HI_RGB))
            cr.fill()

    def _round_tree(self, cr, x, base, h, sway):
        """A broadleaf: trunk and a canopy of three overlapping puffs."""
        r = h * 0.26
        cr.set_source_rgb(*TRUNK_RGB)
        cr.rectangle(x - h * 0.04, base - h * 0.45, h * 0.08, h * 0.45)
        cr.fill()
        cy = base - h + r
        for dx, dy, rr, rgb in ((-0.55, 0.35, 0.85, LEAF_RGB),
                                (0.55, 0.35, 0.85, LEAF_RGB),
                                (0.0, 0.0, 1.0, LEAF_HI_RGB)):
            cr.set_source_rgb(*rgb)
            cr.arc(x + dx * r + sway, cy + dy * r, r * rr, 0, 2 * math.pi)
            cr.fill()

    @staticmethod
    def _bush(cr, x, base, s):
        for dx, dy, rr, rgb in ((-0.5, 0.0, 0.55, LEAF_RGB),
                                (0.5, 0.0, 0.55, LEAF_RGB),
                                (0.0, -0.3, 0.65, LEAF_HI_RGB)):
            cr.set_source_rgb(*rgb)
            cr.arc(x + dx * s, base - s * 0.45 + dy * s, s * rr,
                   0, 2 * math.pi)
            cr.fill()

    def _draw_grove(self, cr, x, y, w, h, t):
        """Trees and bushes where the stockade stands while it is up: the
        same ground, but nothing on it is held for anyone."""
        edge = t * 0.3
        X, Y, W, H = x - edge, y - edge, w + 2 * edge, h + 2 * edge

        self._rounded(cr, X, Y, W, H, edge)
        grad = cairo.LinearGradient(0, Y, 0, Y + H)
        grad.add_color_stop_rgba(0.0, *MEADOW_RGB, 0.55)
        grad.add_color_stop_rgba(1.0, *MEADOW_RGB, 0.30)
        cr.set_source(grad)
        cr.fill()

        # A row of trees along the back, taller ones at the corners where
        # the towers stand. Sizes vary but stay the same from frame to frame.
        n = max(4, round(W / (t * 0.5)))
        for i in range(n + 1):
            tx = X + W * i / n
            corner = i in (0, n)
            th = t * (1.45 if corner else 0.95 + 0.4 * ((i * 0.618) % 1.0))
            sway = math.sin(self.phase * 0.9 + i * 1.3) * t * 0.03
            if corner or i % 3 != 1:
                self._pine(cr, tx, y + edge * 0.2, th, sway)
            else:
                self._round_tree(cr, tx, y + edge * 0.2, th * 0.9, sway)

        # Bushes down the sides and along the front, with a gap for a path.
        s = t * 0.16
        rows = max(1, round(h / (s * 2.2)))
        for j in range(rows):
            by = y + h * (j + 0.8) / rows
            self._bush(cr, X + edge * 0.5, by, s)
            self._bush(cr, X + W - edge * 0.5, by, s)
        path = min(t * 0.9, w * 0.35)
        cr.set_source_rgba(*PATH_RGB, 0.6)
        cr.rectangle(X + W / 2 - path / 2, y + h, path, Y + H - (y + h))
        cr.fill()
        k = max(2, round((W - path) / 2 / (s * 2.1)))
        for side in (-1, 1):
            for j in range(k):
                bx = X + W / 2 + side * (path / 2 + s + j * (W - path) / 2 / k)
                self._bush(cr, bx, Y + H, s)

    # -- the picture ------------------------------------------------------

    def _draw(self, _area, cr, width, height):
        if not self.cores:
            return
        fort = [c for c in self.cores
                if any(cpu in self.reserved for cpu in c["cpus"])]
        rest = [c for c in self.cores if c not in fort]
        gap = max(10.0, width * 0.025)
        label_h = max(16.0, height * 0.05)
        cols_f = max(1, min(self.COLS, len(fort)))
        rows_f = math.ceil(len(fort) / cols_f) if fort else 1
        cols_o = max(1, min(self.COLS, len(rest)))
        rows_o = math.ceil(len(rest) / cols_o) if rest else 0

        # Every size is a multiple of the tile width t, plus fixed gaps:
        # towers and sentries above the wall take 1.6t, the wall 0.3t a
        # side, and 0.5t of open ground lies between the fort and the rest.
        t_by_w = min((width - (cols_f + 1) * gap) / (cols_f + 1.4),
                     (width - (cols_o + 2.6) * gap) / cols_o)
        a = 1.6 + 0.6 + 1.05 * rows_f + (0.5 + 1.05 * rows_o if rest else 0)
        b = (rows_f * label_h + (rows_f - 1) * gap
             + (rows_o * label_h + (rows_o - 1) * gap + 2.6 * gap
                if rest else 0) + gap)
        t = max(20.0, min(t_by_w, (height - b) / a))
        tile_h = t * 1.05
        y = (height - (a * t + b)) / 2 + gap / 2

        fw = cols_f * t + (cols_f - 1) * gap
        ow = cols_o * t + (cols_o - 1) * gap
        # The yard is as wide as the land outside it, so the fort reads as
        # a fort and the wall has room for a man to walk.
        yw = max(fw, ow if rest else fw)
        fh = rows_f * (tile_h + label_h) + (rows_f - 1) * gap
        yx = (width - yw) / 2
        fy = y + 1.6 * t + 0.3 * t
        if self.on:
            towers, floor, walk, walk_y = self._draw_fort(cr, yx, fy, yw, fh,
                                                          t)
        else:
            self._draw_grove(cr, yx, fy, yw, fh, t)
        # Orange only while the fort holds them; down, they are like any other.
        self._tiles(cr, fort, yx + (yw - fw) / 2, fy, cols_f, t, tile_h,
                    label_h, gap, self.on)

        if rest:
            ox = (width - ow) / 2
            oy = fy + fh + 0.3 * t + 0.5 * t + 0.8 * gap
            oh = rows_o * (tile_h + label_h) + (rows_o - 1) * gap
            self._draw_die(cr, ox, oy, ow, oh, gap)
            self._tiles(cr, rest, ox, oy, cols_o, t, tile_h, label_h, gap,
                        False)

        # Last, so a pacing sentry passes in front of the tower roofs.
        if self.on:
            self._draw_sentries(cr, towers, floor, walk, walk_y, t)

    def _tiles(self, cr, cores, x0, y0, cols, t, tile_h, label_h, gap, mine):
        for i, core in enumerate(cores):
            col, row = i % cols, i // cols
            x = x0 + col * (t + gap)
            y = y0 + row * (tile_h + label_h + gap)
            self._draw_tile(cr, x, y, t, tile_h, core, mine)
            label = " · ".join(str(c) for c in core["cpus"])
            self._text(cr, x + t / 2, y + tile_h + label_h * 0.78,
                       label, max(9.0, label_h * 0.6),
                       0.85 if mine else 0.45, bold=mine)

    def _draw_die(self, cr, x, y, w, h, gap):
        """The package outline with pins, so the tiles read as one chip."""
        pad = gap * 0.8
        X, Y, W, H = x - pad, y - pad, w + 2 * pad, h + 2 * pad
        cr.set_line_width(2.0)
        cr.set_source_rgba(*DIM_RGB, 0.18)
        pin = pad * 0.55
        step = max(14.0, W / 24)
        px = X + step / 2
        while px < X + W:
            cr.move_to(px, Y)
            cr.line_to(px, Y - pin)
            cr.move_to(px, Y + H)
            cr.line_to(px, Y + H + pin)
            px += step
        cr.stroke()
        self._rounded(cr, X, Y, W, H, pad)
        grad = cairo.LinearGradient(X, Y, X + W, Y + H)
        grad.add_color_stop_rgba(0.0, 0.16, 0.17, 0.32, 0.55)
        grad.add_color_stop_rgba(1.0, 0.07, 0.09, 0.20, 0.55)
        cr.set_source(grad)
        cr.fill_preserve()
        cr.set_source_rgba(*DIM_RGB, 0.25)
        cr.set_line_width(1.4)
        cr.stroke()

    def _draw_tile(self, cr, x, y, w, h, core, mine):
        pulse = 0.5 + 0.5 * math.sin(self.phase * 2.2)
        live = mine and self.on
        rgb = FORT_RGB if mine else REST_RGB
        r = w * 0.16

        if live:
            self._glow(cr, x + w / 2, y + h / 2, w * (0.95 + 0.12 * pulse),
                       FORT_RGB, 0.30 + 0.12 * pulse)

        self._rounded(cr, x, y, w, h, r)
        cr.set_source_rgba(0.05, 0.06, 0.14, 0.92)
        cr.fill()

        # One bar per thread, filled from the bottom by its live load.
        cpus = core["cpus"]
        inner = w * 0.14
        bar_top = y + inner
        bar_h = y + h - inner - bar_top
        bar_gap = w * 0.08
        bar_w = (w - 2 * inner - bar_gap * (len(cpus) - 1)) / len(cpus)
        for j, cpu in enumerate(cpus):
            bx = x + inner + j * (bar_w + bar_gap)
            self._rounded(cr, bx, bar_top, bar_w, bar_h, bar_w * 0.25)
            cr.set_source_rgba(1, 1, 1, 0.06)
            cr.fill()
            load = self.shown.get(cpu, 0.0)
            fill = bar_h * load
            if fill < 1.0:
                continue
            self._rounded(cr, bx, bar_top + bar_h - fill, bar_w, fill,
                          min(bar_w * 0.25, fill / 2))
            grad = cairo.LinearGradient(0, bar_top + bar_h, 0, bar_top)
            if mine:
                grad.add_color_stop_rgba(0.0, *FORT_RGB, 0.95)
                grad.add_color_stop_rgba(1.0, *FORT_HOT_RGB, 0.95)
            else:
                grad.add_color_stop_rgba(0.0, *REST_RGB, 0.85)
                grad.add_color_stop_rgba(1.0, 0.55, 0.45, 1.0, 0.85)
            cr.set_source(grad)
            cr.fill()

        if live:
            self._sparks(cr, x, bar_top, w, bar_h, core["core"])

        # The frame. Its dash pattern, not its colour, is what says "fort".
        self._rounded(cr, x, y, w, h, r)
        if mine:
            cr.set_line_width(2.4 if live else 1.6)
            cr.set_dash([7.0, 5.0], -self.phase * 18.0 if live else 0.0)
            cr.set_source_rgba(*rgb, 0.95 if live else 0.55)
        else:
            cr.set_line_width(1.2)
            cr.set_dash([])
            cr.set_source_rgba(*DIM_RGB, 0.22)
        cr.stroke()
        cr.set_dash([])

    def _sparks(self, cr, x, top, w, h, seed):
        """Campfire embers rising through the reserved tile."""
        for k in range(4):
            t = (self.phase * 0.55 + k / 4 + seed * 0.37) % 1.0
            sx = x + w * (0.25 + 0.5 * ((k * 0.618 + seed * 0.29) % 1.0))
            sx += math.sin(t * 6.0 + k) * w * 0.04
            sy = top + h * (1.0 - t)
            edge = math.sin(t * math.pi)
            self._glow(cr, sx, sy, w * 0.07, FORT_HOT_RGB, 0.6 * edge)
            cr.set_source_rgba(1, 0.95, 0.85, 0.9 * edge)
            cr.arc(sx, sy, max(1.2, w * 0.012), 0, 2 * math.pi)
            cr.fill()


