            break
    assert not view.boats, "the empty boat drifts off"
    assert len(landed) == view.BOAT_MEN, landed
    for rc, p in landed:
        assert rc["kind"] == "foot" and rc["side"] == 0, rc
        assert view.fords[0] - 0.1 < p <= view.fords[0], (p, view.fords)

    def afloat(side, lands, men=view.BOAT_MEN):
        view.siege.redcoats, view.boats, view.overboard = [], [], []
        view._launch_boat(side)
        view.boats[0].update(lands=lands, men=men)
        return view.boats[0]

    def until(cond, seconds):
        for _ in range(int(seconds * 30)):
            if cond():
                return True
            run(1 / 30, 3)
        return cond()

    def ashore(b, seconds=120):
        """Who steps out of boat b before it is gone downstream."""
        out = set()
        for _ in range(int(seconds * 3)):
            run(1 / 3, 5)
            out |= {rc["n"] for rc in view.siege.redcoats if rc.get("boat")}
            if not any(o is b for o in view.boats):
                return len(out)
        assert False, "the boat never left"

    # The rest row on past both fords with their crews aboard.
    boat = afloat(0, False)
    assert ashore(boat) == 0 and boat["men"] == view.BOAT_MEN, boat
    assert boat["landed"] is None, boat

    # On patrol, the walker shoots at a boat in sight: he halts, and his
    # shot takes one man out of it, who goes over the side; the boat
    # lands one fewer. He patrols a while before shooting again.
    view.potshot_after = 0.0
    boat = afloat(1, True)
    assert until(lambda: view.potshot is not None, 30), "he shoots"
    assert view.potshot["boat"] is boat and view._clear_shot(boat)
    halted = view.siege.patrol_u
    assert until(lambda: view.potshot["fired"], Siege.SHOT_AT + 0.5)
    assert boat["men"] == view.BOAT_MEN - 1, boat
    assert len(view.overboard) == 1, view.overboard
    assert until(lambda: view.potshot is None, Siege.DRILL_LEN)
    assert abs(view.siege.patrol_u - halted) < 0.1, "he halts"
    view.potshot_after = 1e9
    assert ashore(boat) == view.BOAT_MEN - 1
    view.potshot_after = 0.0
    boat = afloat(1, True)
    assert until(lambda: view.potshot is not None, 30)
    run(Siege.DRILL_LEN / view.siege.pace(2) + 0.1, 3)
    assert view.potshot is None and boat["men"] == view.BOAT_MEN - 1
    run(view.POTSHOT_REST - 0.5, 3)
    assert view.potshot is None, "he patrols between shots"

    # A boat whose crew is all shot lands no one, and drifts off.
    boat = afloat(1, True, men=1)
    assert until(lambda: boat["men"] == 0, 30), boat
    assert boat["adrift"] is not None and ashore(boat) == 0, boat

    # He does not take aim at a boat that will be out of sight before he
    # fires; the man he hits goes over in the picture.
    boat = afloat(1, False)
    boat["x"] = view.river["w"] - view.redcoat_s * 0.45 * Siege.SHOT_AT
    view.potshot, view.potshot_after = None, 0.0
    run(1 / 30, 1)
    assert view.potshot is None, "not at a boat about to leave"
    boat = afloat(1, False)
    assert until(lambda: view.overboard and view.overboard[0]["at"], 30)
    assert 0 <= view.overboard[0]["at"][0] <= view.river["w"], \
        view.overboard

    # Not while he sounds his bugle; and a call for the gun raised while
    # he is at it waits for his shot, then is answered.
    boat = afloat(1, False)
    view.potshot_after = 0.0
    run(2, 3)
    assert view.potshot is not None
    view.potshot = None
    x0, y0, x1, y1 = view.fort_box
    view._on_click(None, 1, (x0 + x1) / 2, (y0 + y1) / 2)
    assert view.siege.bugling()
    while view.siege.bugling():
        run(1 / 30, 3)
        assert view.potshot is None or view.potshot["t0"] \
            >= view.siege.bugle_at + Siege.BUGLE_LEN, "not during the bugle"
    assert until(lambda: view.potshot is not None, 20)
    view._on_click(None, 1, (x0 + x1) / 2, (y0 + y1) / 2)
    assert not view.siege.bugling(), "nor the bugle during his shot"
    view.siege.redcoats = [{"side": 0, "d": Siege.MARCH_NEAR, "hit": None, "n": 98,
                      "born": view.phase, "kind": "cannon", "hp": 99,
                      "struck": None, "at_wall": view.phase, "slot": 0}]
    while view.potshot is not None:
        run(1 / 30, 3)
        assert view.siege.relief is None, "the gun waits on his shot"
    assert until(lambda: view.siege.relief, 5), "then the gun"
    assert view.siege.relief["side"] == 0, view.siege.relief
    view.potshot_after = 0.0
    while view.siege.relief is not None:
        run(1 / 30, 3)
        assert view.potshot is None or view.siege.relief is None, \
            "not while he works the gun"
    assert view.siege.redcoats[0]["hit"] is not None, "the gun fired"

    # With no room on the wall for him, nobody shoots at the boats.
    boat = afloat(1, False)
    view.potshot, view.potshot_after = None, 0.0
    view.siege.has_walker = False
    for _ in range(10 * 30):
        view.phase += 1 / 30
        view._advance(1 / 30)
        assert view.potshot is None
    assert boat["men"] == view.BOAT_MEN

    # A click on the river sends a boat, while the fort is up; the pointer
    # shows there.
    view.siege.redcoats, view.boats = [], []
    view.siege.bugle_at, view.siege.pending_call = None, None
    view._draw(view, cr, 1024, 680)
    spot = None
    for x in range(8, 1024, 8):
        y = view._river_y(x)
        if not view._on_fort(x, y) and view._barracks_at(x, y) is None:
            spot = (x, y)
            break
    assert spot and view._on_river(*spot), "some river to click"
    assert not view._on_river(spot[0], spot[1]
                              + 3 * view._river_half(spot[0]) + 10)
    view._on_click(None, 1, *spot)
    assert len(view.boats) == 1 and not view.siege.bugling() \
        and view.siege.pending_call is None, view.boats

    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    assert not view.siege.redcoats and not view.siege.called[0], "standing down clears"
    assert not view.boats, "and sinks the boats"
    view._draw(view, cr, 1024, 680)
    view._on_click(None, 1, *spot)
    assert not view.boats, "no boats while the fort is down"

    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
    siege_tests(view, cr)
    assert len(siege_pictures(view)) == len(SIEGE_PICTURES)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    assert view.siege.wall == [1.0, 1.0], "standing down mends everything"

    win.apply_state(SAMPLE_STATE)
    assert win.banner.get_revealed() and win.banner_action is None
    stray = [dict(a, inside=False) if a["always"] else a
             for a in SAMPLE_STATE["apps"]]
    win.apply_state(dict(SAMPLE_STATE, apps=stray))
    assert win.banner.get_revealed() and win.banner_action == "on"
    win.apply_state(dict(SAMPLE_STATE, mode="off"))
    assert not win.banner.get_revealed()
    assert win.toggle_title.get_label() == "Raise the fort"

    groups = group_apps(SAMPLE_STATE["apps"])
    assert any(groups[0]["inside"]), "apps in the fort sort first"
    assert not any(groups[-1]["inside"]), groups[-1]
    rows = win.app_list.rows
    assert len(rows) == len(groups), (len(rows), len(groups))
    assert any(g["always"] for g in groups)
    for row in rows.values():
        assert row.pin.get_sensitive(), row.group["title"]
        assert row.pin.get_active() == row.group["always"]

    lst = win.app_list
    for box in (lst.main, lst.others):
        shown = lst._shown(box)
        if not shown:
            continue  # no .desktop entry for the sample apps on this machine
        busy = shown[-1]
        lst.cpu = {key: 0.0 for key in lst.rows}
        lst.cpu[busy.group["key"]] = 9.0
        lst._sort()
        after = lst._shown(box)
        inside = [any(r.group["inside"]) for r in after]
        assert inside == sorted(inside, reverse=True), "the fort's apps lead"
        assert [r for r in after if any(r.group["inside"])
                == any(busy.group["inside"])][0] is busy, "busiest first"
        win.apply_state(SAMPLE_STATE)
        assert lst._shown(box) == after, "a status read keeps the order"

    loads = win.cpus.sample()
    loads = win.cpus.sample()
    assert all(0.0 <= v <= 1.0 for v in loads.values())
    assert ranges([3, 4, 13, 14]) == "3, 4, 13 and 14"

    win.show_error("t", "body")
    assert win.stack.get_visible_child_name() == "error"
    print("self-test ok: pages build, CSS parses, every state draws")


def snapshot(path):
    """Draw the chip down, then up, into one PNG -- no window is shown.

    Uses this machine's live per-CPU load, so it is a real picture of the
    moment rather than a mock-up.
    """
    view = CpuView()
    sampler = CpuSampler()
    sampler.sample()
    GLib.usleep(400_000)
    view.shown = sampler.sample()
    w, h = 1024, 680  # the window's own shape, at 2x
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w * 2, h)
    cr = cairo.Context(surface)
    bg = cairo.LinearGradient(0, 0, w * 2, h)
    bg.add_color_stop_rgb(0.0, 0.04, 0.06, 0.13)
    bg.add_color_stop_rgb(1.0, 0.05, 0.10, 0.20)
    cr.set_source(bg)
    cr.paint()
    for i, on in enumerate((False, True)):
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], on)
        view.phase = 0.0
        while view.phase < 21.0:  # long enough for a siege to be under way
            view.phase += 1 / 30
            view._advance(1 / 30)
        cr.save()
        cr.translate(i * w, 0)
        view._draw(view, cr, w, h)
        cr.restore()
    surface.write_to_png(path)
    print(f"wrote {path}")


USAGE = ("usage: fort-galgs [--time-scale <x>] | --self-test"
         " | --snapshot <png> | --almanac <years> [--seed N]"
         " | --siege <minutes> [--seed N]")


def almanac(years, seed=1, out=None):
    """Run a fresh valley headless for so many years and print one row a
    season: how it stands as the season ends, and what the season saw;
    fights is the season's fights with bears, then the bears slain."""
    out = out or sys.stdout
    w = World(seed)
    print(f"{'season':<14}{'beavers':>8}{'dams':>5}{'lodges':>7}"
          f"{'trappers':>9}{'bears':>6}{'cabins':>7}{'pelts':>6}"
          f"{'trees':>6}  {'deaths':<34}{'arrivals':>8}{'fights':>7}",
          file=out)
    for n in range(int(years) * 4):
        w.run((n + 1) * World.SEASON_S - 0.5 - w.time)
        st = w.stats()
        tally = st["tally"]
        died = ", ".join([f"{k} {c}" for c, k in
                          sorted(tally["deaths"].items())]
                         + [f"{tally[k]} {k}" for k in ("trapped",
                                                        "starved")
                            if tally[k]]) or "-"
        when = f"{World.SEASONS[st['season']]} {st['year']}"
        bears = tally["bears"]
        fights = f"{bears['fights']}/{bears['slain']}"
        print(f"{when:<14}{st['beavers']:>8}{st['dams']:>5}"
              f"{st['lodges']:>7}{st['trappers']:>9}{st['bears']:>6}"
              f"{st['cabins']:>7}{st['pelts']:>6}{st['trees']:>6}  "
              f"{died:<34}{tally['arrivals']:>8}{fights:>7}", file=out)
        w.run(0.5)


def _tally_minus(t, last):
    """The siege's tally less an earlier copy of it, whatever its shape."""
    if isinstance(t, dict):
        return {k: _tally_minus(t[k], last[k]) for k in t}
    if isinstance(t, list):
        return [_tally_minus(a, b) for a, b in zip(t, last)]
    return t - last


def _pair(v):
    """A per-side tally as 'left/right', walls in whole percents."""
    return "/".join(str(round(100 * x)) if isinstance(x, float) else str(x)
                    for x in v)


# The siege report's columns: heading, width, and what to show of a tally.
SIEGE_COLUMNS = (
    ("sent f/h/c", 12, lambda t: "/".join(
        str(t["sent"][k]) for k in ("foot", "horse", "cannon"))),
    ("shot", 5, lambda t: t["shot"]),
    ("at wall", 8, lambda t: t["reached"]),
    ("blasted", 8, lambda t: t["blasted"]),
    ("gun calls", 10, lambda t: t["calls"]),
    ("hurt %", 9, lambda t: _pair(t["hurt"])),
    ("mended %", 10, lambda t: _pair(t["mended"])),
    ("breaches", 9, lambda t: t["breaches"]),
    ("eating min", 11, lambda t: f"{t['eating_s'] / 60:.1f}"),
)


def siege_report(minutes, seed=1, out=None):
    """Run a fresh siege headless for so many minutes and print one row a
    minute, then the total: the redcoats sent (foot/horse/cannon), those
    shot by the sentries, those who reached the wall, those the gun's blast
    took, the calls for the gun, and the walls' story. No boats: they row
    on the river as drawn, which a headless run has not got."""
    out = out or sys.stdout
    siege = Siege(seed)
    print(f"siege, seed {seed}, no boats (they need the drawn river)",
          file=out)
    print(f"{'minute':>6}" + "".join(f"{name:>{w}}"
                                     for name, w, _ in SIEGE_COLUMNS),
          file=out)

    def row(label, t):
        print(f"{label:>6}" + "".join(f"{str(get(t)):>{w}}"
                                      for _, w, get in SIEGE_COLUMNS),
              file=out)

    last = copy.deepcopy(siege.tally)
    for n in range(int(minutes)):
        siege.run(60.0)
        row(n + 1, _tally_minus(siege.tally, last))
        last = copy.deepcopy(siege.tally)
    row("total", siege.tally)


def parse_args(argv):
    """The command line as a dict; a usage error exits 2."""
    opts = {"self_test": False, "snapshot": None, "help": False,
            "time_scale": 1.0, "almanac": None, "siege": None,
            "seed": 1}
    args = list(argv)

    def fail():
        print(USAGE, file=sys.stderr)
        raise SystemExit(2)

    while args:
        a = args.pop(0)
        if a == "--self-test":
            opts["self_test"] = True
        elif a in ("--help", "-h"):
            opts["help"] = True
        elif a == "--snapshot" and len(args) == 1:
            opts["snapshot"] = args.pop(0)
        elif a == "--time-scale" and args:
            try:
                x = float(args.pop(0))
            except ValueError:
                fail()
            if not 0 < x < float("inf"):
                fail()
            opts["time_scale"] = x
        elif a == "--time-scale":
            fail()
        elif a in ("--almanac", "--siege", "--seed"):
            try:
                n = int(args.pop(0))
            except (IndexError, ValueError):
                fail()
            if a in ("--almanac", "--siege") and n < 1:
                fail()
            opts[a[2:]] = n
    return opts


def main():
    opts = parse_args(sys.argv[1:])
    if opts["almanac"]:
        almanac(opts["almanac"], opts["seed"])
        return 0
    if opts["siege"]:
        siege_report(opts["siege"], opts["seed"])
        return 0
    if opts["self_test"]:
        self_test()
        return 0
    if opts["snapshot"]:
        snapshot(opts["snapshot"])
        return 0
    if opts["help"]:
        print(__doc__)
        return 0
    return FortApp(opts["time_scale"]).run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
