        weights = w.season_weights(k * 0.5 + World.SEASON_S - 200)
        assert abs(sum(weights) - 1) < 1e-9, weights
        if prev:
            assert max(abs(a - b) for a, b in zip(weights, prev)) <= 0.05
        prev = weights
    assert w.season_weights(800.0) == [1.0, 0.0, 0.0, 0.0]
    weights = w.season_weights(World.SEASON_S - World.BLEND_S / 2)
    assert abs(weights[0] - 0.5) < 1e-9 and abs(weights[1] - 0.5) < 1e-9
    for on in (False, True):
