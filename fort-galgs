        cr.restore()

    @staticmethod
    def _cannon(cr, x, feet, s, facing, roll, fall, struck, boom, elev=0.12,
                crank=None):
        """A field gun on its carriage, in the same 100-unit model. roll
        turns the wheel; struck and boom are the seconds since it was hit
        and since it fired, or negative. elev is the barrel's angle above
        level; crank, if given, is the angle of the handle on its elevating
        gear. Returns the muzzle in the model's units."""
        if s < 1.5:
            return
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        if fall > 0:
            # Knocked off its wheel: it slumps nose-down and fades.
            cr.rotate(0.35 * min(1.0, fall * 2))
            cr.push_group()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)

        cr.set_source_rgb(*WOOD_RGB)
        cr.move_to(-36, -2)
        cr.line_to(-34, -9)
        cr.line_to(6, -27)
        cr.line_to(10, -19)
        cr.close_path()
        cr.fill()
        cr.save()
        cr.translate(-2, -27)
        cr.rotate(-elev)
        cr.set_source_rgb(*IRON_RGB)
        cr.move_to(-12, -6)
        cr.line_to(36, -4)
        cr.line_to(36, 4)
        cr.line_to(-12, 6)
        cr.close_path()
        cr.fill()
        cr.rectangle(33, -5.5, 5, 11)
        cr.fill()
        cr.arc(-14, 0, 3.5, 0, 2 * math.pi)
        cr.fill()
        cr.restore()
        muzzle = (-2 + 38 * math.cos(elev), -27 - 38 * math.sin(elev))
        if crank is not None:
            # The elevating gear on the carriage cheek, and its handle.
            cr.set_source_rgb(*STEEL_RGB)
            cr.set_line_width(2)
            cr.arc(-10, -34, 6, 0, 2 * math.pi)
            cr.stroke()
            hx, hy = -10 + math.cos(crank) * 9, -34 + math.sin(crank) * 9
            cr.move_to(-10, -34)
            cr.line_to(hx, hy)
            cr.stroke()
            cr.arc(hx, hy, 2, 0, 2 * math.pi)
            cr.fill()

        cr.set_source_rgb(*SEAM_RGB)
        cr.set_line_width(3.5)
        cr.arc(0, -15, 14, 0, 2 * math.pi)
        cr.stroke()
        cr.set_line_width(2)
        for k in range(6):
            a = roll + k * math.pi / 3
            cr.move_to(0, -15)
            cr.line_to(math.cos(a) * 13, -15 + math.sin(a) * 13)
        cr.stroke()
        cr.arc(0, -15, 3, 0, 2 * math.pi)
        cr.fill()

        if 0 <= struck < 0.35:
            # Splinters off the carriage where the ball struck.
            u = struck / 0.35
            cr.set_source_rgba(*WOOD_HI_RGB, 1 - u)
            cr.set_line_width(2)
            for k in range(5):
                a = -math.pi * (0.15 + 0.17 * k)
                r0, r1 = 6 + 18 * u, 11 + 22 * u
                cr.move_to(math.cos(a) * r0, -22 + math.sin(a) * r0)
                cr.line_to(math.cos(a) * r1, -22 + math.sin(a) * r1)
            cr.stroke()
        if 0 <= boom < 2.0:
            mx, my = muzzle
            dx, dy = math.cos(elev), -math.sin(elev)
            u = boom / 2.0
            for j in range(3):
                reach = 8 + 30 * math.sqrt(u) + 8 * j
                cr.set_source_rgba(*SMOKE_RGB, 0.6 * (1 - u))
                cr.arc(mx + dx * reach, my + dy * reach - 10 * u - 4 * j,
                       6 + 14 * math.sqrt(u) + 3 * j, 0, 2 * math.pi)
                cr.fill()
            if boom < 0.15:
                CpuView._glow(cr, mx + 6 * dx, my + 6 * dy, 34, FLASH_RGB,
                              1 - boom / 0.15)

        if fall > 0:
            cr.pop_group_to_source()
            cr.paint_with_alpha(max(0.0, 1.0 - fall))
        cr.restore()
        return muzzle

    def _draw_fort(self, cr, x, y, w, h, t):
        """The stockade around the yard (x, y, w, h), its gate and towers;
        returns where sentries may stand."""
        wall = t * 0.3
        stake = max(6.0, t * 0.16)
        X, Y, W, H = x - wall, y - wall, w + 2 * wall, h + 2 * wall

        self._rounded(cr, X, Y, W, H, wall * 0.4)
        cr.set_source_rgba(*YARD_RGB, 0.75)
        cr.fill()

        # Side walls are seen from the front, like the rest: a column of
        # stakes each side, standing full height.
        for side, sx in enumerate((X, X + W - wall)):
            self._side_wall(cr, side, sx, wall, Y - wall * 0.6, Y + H)
        # Back wall, sharpened against the sky; front wall, with the gate.
        self._wall(cr, X + wall, X + W - wall, y, Y - wall * 0.9, stake, True)
        gate_w = min(t * 0.9, w * 0.35)
        cx = X + W / 2
        self._wall(cr, X + wall, cx - gate_w / 2, Y + H, y + h, stake, True)
        self._wall(cr, cx + gate_w / 2, X + W - wall, Y + H, y + h, stake,
                   True)
        self._gate(cr, cx, Y + H, y + h - wall * 0.2, gate_w)

        tower_w = wall * 2.4
        tower_h = t * 0.5
        floor = Y - tower_h

        towers = []
        for tx in (X - tower_w * 0.35, X + W - tower_w * 0.65):
            self._blockhouse(cr, tx, floor, tower_w, tower_h + wall)
            towers.append(tx + tower_w / 2)
        # Clickable: the stockade and towers, and the sentries above them.
        self.fort_box = (X - tower_w * 0.35, floor - t * 1.1,
                         X + W + tower_w * 0.35, Y + H)
        return towers, floor, (X + tower_w, X + W - tower_w), Y - wall * 0.9

    _ramp = staticmethod(Siege.ramp)

    def _horn(self, tau):
        """A call tau seconds in. Returns (how far the horn is raised,
        seconds since he began to blow or -1)."""
        raised = self._ramp(tau, 0.0, 0.35) - self._ramp(tau, 1.6, 1.95)
        toot = tau - 0.45 if 0.45 <= tau < 1.6 else -1.0
        return raised, toot

    def _bugle(self):
        """The walker's call."""
        return self._horn(self.siege.bugle_t())

    @staticmethod
    def _bezier(pts, p):
        (x0, y0), (x1, y1), (x2, y2), (x3, y3) = pts
        q = 1 - p
        a, b, c, d = q * q * q, 3 * q * q * p, 3 * q * p * p, p * p * p
        return (a * x0 + b * x1 + c * x2 + d * x3,
                a * y0 + b * y1 + c * y2 + d * y3)

    def _depth_scale(self, p):
        """Size at screen position p on a trail, 1 at the near end."""
        far = Siege.MARCH_NEAR / Siege.MARCH_FAR
        return far + (1 - far) * p

    # How far from the wall each kind stands to reach it, and how much room
    # it takes in the line there, both as a fraction of its size.
    STANDOFF = {"foot": 0.0, "horse": 0.3, "cannon": 0.45}
    BREADTH = {"foot": 0.5, "horse": 0.95, "cannon": 0.8}
    CHEST = {"foot": 0.6, "horse": 0.75, "cannon": 0.2}

    def _redcoat_at(self, rc):
        """Where a redcoat stands: (x, feet, size)."""
        p = Siege.trail_p(rc["d"])
        x, y = self._bezier(self.trails[rc["side"]], p)
        size = self.redcoat_s * self._depth_scale(p)
        ashore = self.siege.phase - rc["born"]
        if rc.get("boat") and ashore < self.ASHORE_S:
            # A hop from the bow up onto the bank.
            u = self._ramp(ashore, 0.0, self.ASHORE_S)
            bx, by = rc["boat"]
            x, y = bx + (x - bx) * u, by + (y - by) * u \
                - math.sin(u * math.pi) * size * 0.25
        cover = self.siege.cover(rc)
        if cover > 0:
            rock = self.rocks[rc["rock"]]
            x += (rock["x"] + rock["inward"] * rock["w"] * 0.08 - x) * cover
        drive = rc.get("drive")
        if drive and self.hrocks[rc["side"]]:
            # He steps off the trail toward the man's rock to fire on it.
            rock = self.hrocks[rc["side"]][drive["rock"] - 1]
            x += (rock["x"] - x) * 0.5 * self._ramp(
                self.siege.phase - drive["born"], 0.0, 1.0)
        if self.siege.at_wall(rc):
            outward = -1 if rc["side"] == 0 else 1
            x += outward * size * (self.STANDOFF[rc["kind"]]
                                   + rc["slot"] * 0.7)
        return x, y, size

    def _draw_trails(self, cr):
        """Two dirt trails winding in from the far corners, narrowing with
        distance."""
        for pts in self.trails:
            n = 48
            edge_a, edge_b = [], []
            for k in range(n + 1):
                p = k / n
                x, y = self._bezier(pts, p)
                x2, y2 = self._bezier(pts, min(1.0, p + 0.01))
                x1, y1 = self._bezier(pts, max(0.0, p - 0.01))
                tx, ty = x2 - x1, y2 - y1
                norm = math.hypot(tx, ty) or 1.0
                half = self.redcoat_s * 0.5 * self._depth_scale(p)
                nx, ny = -ty / norm * half, tx / norm * half
                edge_a.append((x + nx, y + ny))
                edge_b.append((x - nx, y - ny))
            cr.move_to(*edge_a[0])
            for pt in edge_a[1:] + edge_b[::-1]:
                cr.line_to(*pt)
            cr.close_path()
            grad = cairo.LinearGradient(*pts[0], *pts[3])
            grad.add_color_stop_rgba(0.0, *PATH_RGB, 0.35)
            grad.add_color_stop_rgba(1.0, *PATH_RGB, 0.75)
            cr.set_source(grad)
            cr.fill()

    def _draw_barracks(self, cr, i):
        """A brick barracks with lit windows and a pennant, its door on the
        far end of trail i; the door stands open while a redcoat comes
        out."""
        x, y = self.trails[i][0]
        B = self.redcoat_s * 0.8
        x0, top = x - B / 2, y - 0.42 * B
        peak = top - 0.24 * B
        cr.set_source_rgb(*BRICK_RGB)
        cr.rectangle(x0, top, B, y - top)
        cr.fill_preserve()
        cr.set_source_rgb(*BRICK_DARK_RGB)
        cr.set_line_width(max(0.6, B * 0.02))
        cr.stroke()
        cr.set_source_rgb(*ROOF_RGB)
        cr.move_to(x0 - 0.06 * B, top)
        cr.line_to(x, peak)
        cr.line_to(x0 + B * 1.06, top)
        cr.close_path()
        cr.fill()
        cr.set_source_rgba(*WINDOW_RGB, 0.85)
        for fx in (0.1, 0.27, 0.61, 0.78):
            cr.rectangle(x0 + fx * B, top + 0.1 * B, 0.11 * B, 0.12 * B)
        cr.fill()
        opening = self.siege.door_open(i)
        cr.set_source_rgb(*((0.05, 0.03, 0.03) if opening else WOOD_RGB))
        cr.rectangle(x - 0.08 * B, y - 0.27 * B, 0.16 * B, 0.27 * B)
        cr.fill()
        # The pennant on its pole, streaming out over the roof.
        cr.set_source_rgb(*STEEL_RGB)
        cr.set_line_width(max(0.6, B * 0.02))
        cr.move_to(x, peak)
        cr.line_to(x, peak - 0.36 * B)
        cr.stroke()
        wave = math.sin(self.phase * 3.0 + i) * 0.04 * B
        cr.set_source_rgb(*COAT_RGB)
        cr.move_to(x, peak - 0.36 * B)
        cr.line_to(x + 0.24 * B, peak - 0.31 * B + wave)
        cr.line_to(x, peak - 0.25 * B)
        cr.close_path()
        cr.fill()
        self.barracks_box[i] = (x0 - 3, peak - 0.36 * B - 3, x0 + B + 3,
                                y + 3)

    STAIN_S = 8.0       # a pool of blood fades out over this long

    def _draw_stains(self, cr):
        """Pools of blood where redcoats fell, spreading, then fading."""
        self.stains = [st for st in self.stains
                       if self.phase - st[3] < self.STAIN_S]
        for x, y, size, born in self.stains:
            age = self.phase - born
            fade = 1.0 - max(0.0, age - self.STAIN_S * 0.6) \
                / (self.STAIN_S * 0.4)
            r = size * 0.38 * min(1.0, 0.3 + age * 1.2)
            cr.save()
            cr.translate(x, y)
            cr.scale(1.0, 0.3)
            cr.arc(0, 0, r, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgba(*BLOOD_RGB, 0.8 * fade)
            cr.fill()

    def _spray(self, cr, x, y, size, back, e, seed):
        """Blood flung from a wound at (x, y), back the way the shot came
        from, e seconds after it."""
        if e >= 0.7:
            return
        cr.set_source_rgba(*BLOOD_RGB, 1.0 - e / 0.7)
        for k in range(9):
            a = 0.25 + 0.9 * ((k * 0.618 + seed) % 1.0)
            v = size * (0.9 + 0.5 * ((k * 0.382 + seed) % 1.0))
            px = x + back * math.cos(a) * v * e
            py = y - math.sin(a) * v * e + size * 3.0 * e * e
            cr.arc(px, py, max(0.6, size * 0.035), 0, 2 * math.pi)
            cr.fill()

    def _lay_rocks(self):
        """A boulder at the outer edge of each trail at COVER_P, unless
        the trail is in the river there. Between the fort's wall and the
        trail there is no room for one."""
        self.rocks = [None, None]
        mud = self.river["half"] * 0.35 + 1
        for side, pts in enumerate(self.trails):
            x, y = self._bezier(pts, Siege.COVER_P)
            size = self.redcoat_s * self._depth_scale(Siege.COVER_P)
            inward = 1 if side == 0 else -1
            x -= inward * size * 0.75
            base, h = y + 0.12 * size, 0.55 * size
            if abs(base - self._river_y(x)) < self._river_half(x) + mud + h:
                continue
            self.rocks[side] = {
                "x": x, "base": base, "w": 1.1 * size, "h": h,
                "inward": inward, "d": Siege.trail_d(Siege.COVER_P),
                "side": side}
        self.siege.boulders = [bool(r) for r in self.rocks]

    def _lay_hiding_rocks(self, key, width, height, t, die):
        """Three rocks in the woods outside each side wall, one behind the
        other, each farther from the wall's foot, laid out apart from the
        siege's scenery: clear of the trail, the barracks, the chip, the
        fort and the river, and on the outward side of the wall."""
        g = self.fort_geo
        if g is None:
            self.hrocks = [[], []]
            return
        key = (key, round(g["X"]), round(g["Y"]), round(g["H"]),
               round(self.redcoat_s), round(self.trails[0][3][0]))
        if key == self.hrocks_key:
            return
        self.hrocks_key = key
        mud = self.river["half"] * 0.35 + 1
        wall = g["wall"]
        tower = wall * 2.4 * 0.35
        fort = (g["X"] - tower, g["floor"] - t * 1.1, g["X"] + g["W"] + tower,
                g["Y"] + g["H"])
        grow = [(fort, 0.1 * t), (die, 0.3 * t)] + [
            (box, 0.3 * t) for box in self.barracks_box]
        avoid = [(b[0] - m, b[1] - m, b[2] + m, b[3] + m)
                 for b, m in grow if b is not None]
        path = []
        for pts in self.trails:
            for k in range(49):
                p = k / 48
                x, y = self._bezier(pts, p)
                path.append((x, y, self.redcoat_s * self._depth_scale(p)))
        top, bottom = g["Y"], g["Y"] + g["H"]
        self.hrocks = [[], []]
        for side in (0, 1):
            inward = 1 if side == 0 else -1
            foot = self._ladder_ends(side)[0]
            size_at = lambda y: self.redcoat_s * (0.7 + 0.3 * min(
                1.0, max(0.0, (y - top) / max(1.0, bottom - top))))
            near_rocks = [r for r in self.rocks if r]

            def clear(x, base, tier):
                size = size_at(base)
                w, h = 0.62 * size, 0.4 * size
                if x - w / 2 < 2 or x + w / 2 > width - 2 or base - h < 2:
                    return False
                box = (x - w * 0.6, base - h - 0.3 * size, x + w * 0.6,
                       base + 2)
                if any(self._overlaps(box, a) for a in avoid):
                    return False
                if abs(base - self._river_y(x)) < self._river_half_max(x) \
                        + mud + 0.4 * h:
                    return False
                margin = (0.5, 0.3, 0.1)[tier] if tier < 3 else None
                if margin is not None and any(
                        abs(x - px) < w * 0.5 + psize * margin + 4
                        and base - h - psize * 0.3 < py < base + psize * 0.5
                        for px, py, psize in path):
                    return False
                if any(abs(x - r["x"]) < (w + r["w"]) * 0.6
                       and abs(base - r["base"]) < size for r in near_rocks):
                    return False
                return True

            # Every spot outside the wall, a step apart, nearest the foot
            # of the wall first.
            cands = []
            step = 0.1 * t
            x = foot[0] - inward * 0.3 * t
            while 0 < x < width:
                for j in range(60):
                    base = bottom - 0.3 * t - j * step
                    if base < top - 0.6 * t:
                        break
                    cands.append((x, base))
                x -= inward * step
            cands.sort(key=lambda c: math.hypot(c[0] - foot[0],
                                                c[1] - foot[1]))
            chosen = []
            for tier in (0, 1, 2, 3):
                chosen = []
                for k in range(3):
                    pick = next((c for c in cands
                                 if self._ok_rock_dist(
                                     c, foot, chosen, 0.5 * size_at(c[1]))
                                 and clear(c[0], c[1], tier)), None)
                    if pick is None:
                        break
                    chosen.append(pick)
                if len(chosen) == 3:
                    break
            # Whatever happens, three: stood up the outside of the wall.
            while len(chosen) < 3:
                k = len(chosen)
                chosen.append((foot[0] - inward * 0.9 * t,
                               bottom - (1.0 + 1.1 * k) * t))
            for k, (x, base) in enumerate(chosen):
                size = size_at(base)
                self.hrocks[side].append({
                    "x": x, "base": base, "w": 0.62 * size, "h": 0.4 * size,
                    "inward": inward, "side": side, "k": k + 1,
                    "size": size})

    @staticmethod
    def _ok_rock_dist(c, foot, chosen, gap):
        """A candidate spot for the next hiding rock: farther from the
        foot of the wall than the last, and a gap from every other."""
        d = math.hypot(c[0] - foot[0], c[1] - foot[1])
        if d < gap:
            return False
        for o in chosen:
            if math.hypot(c[0] - o[0], c[1] - o[1]) < gap or d <= math.hypot(
                    o[0] - foot[0], o[1] - foot[1]):
                return False
        return True

    @staticmethod
    def _rock(cr, x, base, w, h, seed):
        """A lumpy boulder sitting on the ground at base, w wide, h high,
        lit from the upper left. seed shapes its lumps, the same each
        frame."""
        n = 7
        pts = []
        for k in range(n + 1):
            a = math.pi * k / n
            lump = 0.85 + 0.25 * ((seed * 0.37 + k * 0.618) % 1.0)
            r = 1.0 if k in (0, n) else lump
            pts.append((x - math.cos(a) * w / 2 * r,
                        base - math.sin(a) * h * r))
        cr.move_to(*pts[0])
        for pt in pts[1:]:
            cr.line_to(*pt)
        cr.close_path()
        cr.set_source_rgb(*STONE_RGB)
        cr.fill_preserve()
        cr.save()
        cr.clip()
        cr.set_source_rgb(*STONE_DARK_RGB)
        cr.move_to(x - w * 0.1, base + 1)
        cr.curve_to(x + w * 0.1, base - h * 0.45, x + w * 0.3,
                    base - h * 0.7, x + w * 0.6, base - h * 0.9)
        cr.line_to(x + w * 0.6, base + 1)
        cr.close_path()
        cr.fill()
        cr.set_source_rgba(*ROCK_HI_RGB, 0.8)
        cr.save()
        cr.translate(x - w * 0.18, base - h * 0.78)
        cr.scale(w * 0.18, h * 0.12)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        cr.restore()
        cr.set_source_rgba(0, 0, 0, 0.3)
        cr.set_line_width(max(0.6, h * 0.04))
        cr.move_to(x - w * 0.55, base + 0.5)
        cr.line_to(x + w * 0.55, base + 0.5)
        cr.stroke()

    @staticmethod
    def _chips(cr, x, y, size, e):
        """A ball striking stone at (x, y), e seconds on: a puff of dust
        and chips of rock flying."""
        if not 0 <= e < 0.6:
            return
        u = e / 0.6
        cr.set_source_rgba(*SMOKE_RGB, 0.55 * (1 - u))
        for k in range(3):
            cr.arc(x + (k - 1) * size * 0.12 * (0.5 + u),
                   y - size * (0.05 + 0.2 * u) - k % 2 * size * 0.06,
                   size * (0.1 + 0.18 * u), 0, 2 * math.pi)
            cr.fill()
        cr.set_source_rgba(*FLASH_RGB, max(0.0, 1 - u * 6))
        cr.arc(x, y, size * 0.05, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgba(*ROCK_HI_RGB, 1 - u)
        for k in range(5):
            a = -math.pi * (0.15 + 0.17 * k)
            v = size * (0.9 + 0.3 * (k % 2))
            cr.rectangle(x + math.cos(a) * v * e - size * 0.025,
                         y + math.sin(a) * v * e + size * 2.5 * e * e,
                         size * 0.05, size * 0.05)
            cr.fill()

    def _draw_rock(self, cr, rock):
        self._rock(cr, rock["x"], rock["base"], rock["w"], rock["h"],
                   rock["inward"])
        chip = self.siege.chipped[rock["side"]]
        if chip is not None:
            # The ball comes in from the fort's side of the boulder.
            self._chips(cr, rock["x"] + rock["inward"] * rock["w"] * 0.15,
                        rock["base"] - rock["h"] * 0.85, rock["h"] * 1.6,
                        self.siege.phase - chip)

    def _draw_hiding_rock(self, cr, rock):
        self._rock(cr, rock["x"], rock["base"], rock["w"], rock["h"],
                   rock["k"] + 3 * rock["side"])
        chip = self.siege.rock_chip[rock["side"]][rock["k"]]
        if chip is not None:
            # Fired on from the trail, which is up and outward of it.
            self._chips(cr, rock["x"] - rock["inward"] * rock["w"] * 0.2,
                        rock["base"] - rock["h"] * 0.85, rock["h"] * 1.6,
                        self.siege.phase - chip)

    def _draw_redcoats(self, cr):
        self._draw_stains(cr)
        # Each boulder is drawn just after anyone crouched behind it, and
        # before anyone nearer the fort.
        items = [(-rc["d"], 0, rc) for rc in self.siege.redcoats]
        items += [(-rock["d"], 1, rock) for rock in self.rocks if rock]
        # Whoever is outside is as far down the picture as his feet, with
        # his rock just after him; the hiding rocks go in by the same rule.
        items += [(-self._depth_of_y(r["base"]), 3, r)
                  for side in self.hrocks for r in side]
        ground = self._ground_man()
        if ground is not None and self.fort_geo is not None \
                and self.hrocks[self.siege.men[ground]["side"]]:
            items.append((-self._depth_of_y(self._ground_xy(ground)[1]),
                          2, ground))
        for _, is_rock, rc in sorted(items, key=lambda it: it[:2]):
            if is_rock == 2:
                self._draw_ground_man(cr, rc)
                continue
            if is_rock == 3:
                self._draw_hiding_rock(cr, rc)
                continue
            if is_rock:
                self._draw_rock(cr, rc)
                continue
            x, feet, size = self._redcoat_at(rc)
            p = Siege.trail_p(rc["d"])
            pts = self.trails[rc["side"]]
            toward = 1 if rc["side"] == 0 else -1
            ahead = self._bezier(pts, min(1.0, p + 0.02))[0] - x
            facing = (1 if ahead > 0 else -1) \
                if abs(ahead) > 0.3 and not self.siege.at_wall(rc) else toward
            alive = rc["hit"] is None
            marching = alive and rc["at_wall"] is None
            fall = 0.0 if alive else (self.siege.phase - rc["hit"]) / Siege.FALL_S
            pound = self.siege.phase - rc["at_wall"] \
                if alive and self.siege.at_wall(rc) else -1.0
            kind = rc["kind"]
            if kind == "horse" and not alive:
                # The rider drops from the saddle and dies where he lands;
                # his horse bolts riderless off the side of the picture.
                e = self.siege.phase - rc["hit"]
                away = -toward
                self._cavalry(cr, x + away * size * 2.4 * e ** 1.4, feet,
                              size, away, self.phase * 16 + rc["n"], 0.0,
                              rider=False)
                drop = size * 0.55 * (1 - min(1.0, e / 0.35))
                self._redcoat(cr, x, feet - drop, size, facing, 0.0,
                              min(1.0, e / Siege.FALL_S))
            elif kind == "horse":
                self._cavalry(cr, x, feet, size, facing,
                              self.phase * 11 + rc["n"], fall, pound,
                              rc["n"] * 1.3)
            elif kind == "cannon":
                # Its crewman pushes from behind.
                step = math.sin(self.phase * 4 + rc["n"]) * 0.3 \
                    if marching else 0.0
                self._redcoat(cr, x - facing * size * 0.55, feet,
                              size * 0.95, facing, step, fall)
                struck = -1.0 if rc["struck"] is None \
                    else self.siege.phase - rc["struck"]
                boom = pound % 4.0 if pound >= 0 else -1.0
                self._cannon(cr, x, feet, size, facing,
                             (Siege.MARCH_FAR - rc["d"]) * 9, fall, struck,
                             boom)
            else:
                cover = self.siege.cover(rc)
                step = math.sin(self.phase * 6.5 + rc["n"] * 1.7) * 0.35 \
                    if marching and rc.get("hid") is None \
                    and not rc.get("drive") else 0.0
                if cover > 0:
                    facing = toward  # he keeps his eyes on the fort
                kneel = aim = 0.0
                shot = -1.0
                if rc.get("drive") and alive and self.hrocks[rc["side"]]:
                    rock = self.hrocks[rc["side"]][rc["drive"]["rock"] - 1]
                    facing = 1 if rock["x"] >= x else -1
                    kneel, aim, shot = self.siege.volley(rc)
                self._redcoat(cr, x, feet, size, facing, step, fall, pound,
                              rc["n"] * 1.3, crouch=max(cover, kneel),
                              aim=aim, shot=shot)
            if not alive:
                # The man bleeds, whether rider, gunner or foot.
                bx = x - facing * size * 0.55 if kind == "cannon" else x
                chest = 0.75 if kind == "horse" else 0.6
                if not rc.get("stained"):
                    rc["stained"] = True
                    self.stains.append((bx - toward * size * 0.35, feet, size,
                                        self.phase))
                self._spray(cr, bx, feet - size * chest, size, -toward,
                            self.siege.phase - rc["hit"], rc["n"] * 0.37)

    def _ladder_ends(self, side):
        """Where the ladder at side's wall stands on the ground and
        touches the wall's top: ((x, y), (x, y))."""
        g = self.fort_geo
        wall = g["wall"]
        if side == 0:
            x0, x1 = g["X"] - 0.7 * wall, g["X"] + 0.05 * wall
        else:
            x0, x1 = g["X"] + g["W"] + 0.7 * wall, \
                g["X"] + g["W"] - 0.05 * wall
        return (x0, g["Y"] + g["H"]), (x1, g["Y"] + 0.2 * wall)

    def _ladder_at(self, side, u):
        """The point a fraction u up the ladder at side's wall."""
        (bx, by), (tx, ty) = self._ladder_ends(side)
        return bx + (tx - bx) * u, by + (ty - by) * u

    def _draw_ladder(self, cr):
        """The fort's ladder, where it hangs or lies."""
        lad = self.siege.ladder
        if lad["state"] == "up" or self.fort_geo is None:
            return
        side = lad["side"]
        (bx, by), (tx, ty) = self._ladder_ends(side)
        wall = self.fort_geo["wall"]
        half = wall * 0.22
        if lad["state"] == "standing":
            bx, by = self._ladder_at(side, 1.0 - lad["ext"])
        n = max(3, int(math.hypot(tx - bx, ty - by) / (wall * 0.5)))
        cr.save()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        for rail, rgb, lw in ((-1, SEAM_RGB, wall * 0.17),
                              (1, SEAM_RGB, wall * 0.17),
                              (-1, WOOD_HI_RGB, wall * 0.09),
                              (1, WOOD_HI_RGB, wall * 0.09)):
            cr.set_source_rgb(*rgb)
            cr.set_line_width(lw)
            cr.move_to(bx + rail * half, by)
            cr.line_to(tx + rail * half, ty)
            cr.stroke()
        cr.set_source_rgb(*WOOD_HI_RGB)
        cr.set_line_width(wall * 0.1)
        for k in range(n + 1):
            u = k / n
            x, y = bx + (tx - bx) * u, by + (ty - by) * u
            cr.move_to(x - half, y)
            cr.line_to(x + half, y)
        cr.stroke()
        cr.restore()

    GROUND_MODES = ("mend", "run", "hide", "home", "raise")

    def _ground_man(self):
        """The man, if any, on the ground outside the fort."""
        for i in (2, 0, 1):
            if self.siege.men[i]["mode"] in self.GROUND_MODES:
                return i
        return None

    def _draw_mender(self, cr, i, x, floor, ws, walk_y):
        """Man i going down to mend, or back up: on the wall walk, or his
        tower, lowering or hauling; on the ladder; or at its foot, at the
        wall with a mallet."""
        m = self.siege.men[i]
        mode, side = m["mode"], m["side"]
        inward = 1 if side == 0 else -1
        if mode in ("descend", "ascend"):
            lx, ly = self._ladder_at(side, m["h"])
            self._mountain_man(cr, lx, ly, ws, inward,
                               step=math.sin(m["h"] * 40) * 0.5)
        else:
            # Leaning out over the wall to work the ladder.
            work = self.siege.ladder["ext"]
            self._mountain_man(cr, x, walk_y if i == 2 else floor, ws,
                               -inward, kneel=0.3,
                               step=math.sin(work * 30) * 0.2)

    def _ground_pos(self, i):
        """Where man i stands on the ground outside, (x, feet, size)."""
        m = self.siege.men[i]
        (bx, by), _ = self._ladder_ends(m["side"])
        s = self.fort_geo["t"] * 0.85 * (0.92 if i == 2 else 1.0)
        # Beside the ladder's foot, not behind it.
        return bx - (1 if m["side"] == 0 else -1) * self.fort_geo["wall"] \
            * 0.9, by, s

    def _ground_xy(self, i):
        """Where man i stands on the ground outside: (x, feet, size),
        from the ladder's foot out through the three rocks."""
        m = self.siege.men[i]
        pts = [self._ground_pos(i)] + [
            (r["x"] + r["inward"] * r["w"] * 0.1, r["base"],
             r["size"] * 0.94) for r in self.hrocks[m["side"]]]
        g = min(3.0, max(0.0, m["g"]))
        k = min(int(g), len(pts) - 2)
        u = g - k
        a, b = pts[k], pts[min(k + 1, len(pts) - 1)]
        return tuple(a[j] + (b[j] - a[j]) * u for j in range(3))

    def _depth_of_y(self, y):
        """The distance on the trail that stands as far down the picture
        as y, for ordering whatever is on the ground by its feet."""
        far, near = self.trails[0][0][1], self.trails[0][3][1]
        return Siege.trail_d(min(1.0, max(0.0, (y - far) / (near - far))))

    def _draw_ground_man(self, cr, i):
        """Man i out in the grass: at the wall's foot with a mallet,
        running for the woods, crouched behind a rock rising to shoot,
        walking home, or raising the ladder."""
        siege = self.siege
        m = siege.men[i]
        mode, side = m["mode"], m["side"]
        inward = 1 if side == 0 else -1
        x, y, s = self._ground_xy(i)
        if mode == "mend":
            swing = 0.5 + 0.5 * math.sin(siege.phase * 6.0)
            self._mountain_man(cr, x, y, s, inward, axe=swing)
        elif mode == "raise":
            lift = 0.5 + 0.5 * math.sin(siege.phase * 3.0)
            self._mountain_man(cr, x, y, s, inward, kneel=0.5 * lift,
                               shouldered=True)
        elif mode in ("run", "home"):
            facing = -inward if mode == "run" else inward
            fast = mode == "run"
            self._mountain_man(cr, x, y, s, facing, shouldered=True,
                               step=math.sin(self.phase * (14.0 if fast
                                                           else 8.0))
                               * (0.55 if fast else 0.38))
        else:
            duck, kneel, aim, shot = siege.hide_pose(i)
            elev = 0.04
            target = siege._pot_target(i)
            facing = -inward
            if target is not None:
                tx, tfeet, tsize = self._redcoat_at(target)
                facing = 1 if tx >= x else -1
                elev = min(1.3, max(-0.6, math.atan2(
                    (y - s * 0.52) - (tfeet - tsize * self.CHEST[
                        target["kind"]]), max(1.0, abs(tx - x)))))
            self._mountain_man(cr, x, y + duck * s * 0.34, s, facing,
                               kneel=kneel, aim=aim, shot=shot, elev=elev)

    def _draw_sentries(self, cr, towers, floor, walk, walk_y, t):
        if not self.on:
            return  # Nobody on the walls while the fort stands down.
        s = t * 0.85
        self.sentries_at = (towers, floor, s)
        for i, tx in enumerate(towers):
            outward = -1 if i == 0 else 1
            mode = self.siege.men[i]["mode"]
            if mode not in ("post", "eat"):
                if mode not in self.GROUND_MODES:
                    self._draw_mender(cr, i, tx, floor, s, floor)
                continue
            if self.siege.calling(i):
                # Turned toward the middle, blowing for the gun.
                raised, toot = self._horn(self.siege.relief_t())
                self._mountain_man(cr, tx, floor, s, -outward, bugle=raised,
                                   toot=toot)
                continue
            sit = self.siege.sit(i)
            if sit > 0:
                self._mountain_man(cr, tx, floor, s, outward, sit=sit,
                                   eat=self.phase if self.siege.eating(i)
                                   else -1.0)
                continue
            kneel, aim, shot = self.siege.drill(i)
            if self.siege.drilling(i):
                elev = 0.04
                target = self.siege.drill_target[i]
                if target is not None and self.trails:
                    rx, feet, size = self._redcoat_at(target)
                    chest = feet - size * self.CHEST[target["kind"]]
                    rise = (floor - s * 0.52) - chest
                    elev = min(1.3, max(-0.6, math.atan2(
                        rise, max(1.0, abs(rx - tx)))))
                self._mountain_man(cr, tx, floor, s, outward, kneel=kneel,
                                   aim=aim, shot=shot, elev=elev)
                continue
            # Each looks out, and now and then glances back into the yard.
            glance = int(self.phase / 3.1 + i * 1.7) % 4 == 0
            glint = max(0.0, math.sin(self.phase * 1.3 + i * 2.0)) ** 30
            self._mountain_man(cr, tx, floor, s, -outward if glance
                               else outward, glint=glint)
        x0, x1 = walk
        self.siege.has_walker = x1 - x0 > s * 0.6
        if not self.siege.has_walker:
            self.walker_at = None
            return
        # One more walks the wall from tower to tower and back, and stands
        # still while he sounds his bugle or works the gun.
        walked = self.siege.patrol_u * Siege.PATROL_LEG_S
        frac, facing_now = self.siege.walker_x()
        patrol = x0 + (x1 - x0) * frac
        ws = s * 0.92
        wm = self.siege.men[2]["mode"]
        self.walker_at = (patrol, walk_y)

        # The fort's gun stands on the wall walk where it was last wheeled.
        gun_x, gs = x0 + (x1 - x0) * self.siege.gun_frac(), s * 1.25
        rt = self.siege.relief_t()
        if rt is not None:
            self.gun_facing = -1 if self.siege.relief["side"] == 0 else 1
        gf = self.gun_facing
        pivot = (gun_x - gf * 2 * gs / 100, walk_y - 27 * gs / 100)
        elev, crank, boom, ball = 0.12, None, -1.0, None
        if rt is not None:
            side = self.siege.relief["side"]
            nx, ny = self.trails[side][3]
            land = (nx + gf * self.redcoat_s * 0.4, ny)
            # A high lob, steep enough that coming down it still clears the
            # tower sentry's head and his rifle with room to spare.
            reach = abs(land[0] - pivot[0])
            lift = 1.4 * reach
            # Over his middle, and again past his outward side, where the
            # ball has least room left to fall.
            outward = -1 if side == 0 else 1
            for dx, above in ((0.0, 2.0), (0.55, 1.1)):
                over = abs(towers[side] + outward * dx * s - pivot[0]) \
                    / max(1.0, reach)
                if 0 < over < 1:
                    line = pivot[1] + (land[1] - pivot[1]) * over
                    clear = floor - s * above
                    lift = max(lift,
                               (line - clear) / (4 * over * (1 - over)))
            # A lighter charge from closer in: the arc tops out inside the
            # picture, even if that means a closer pass over his head.
            drop = land[1] - pivot[1]

            def top(lift):
                u = min(1.0, max(0.0, (1 - drop / (4 * lift)) / 2))
                return pivot[1] + drop * u - 4 * lift * u * (1 - u)

            lift = min(lift, 3.0 * reach)
            if top(lift) < self.redcoat_s * 0.2:
                lo, hi = reach * 0.25, lift
                for _ in range(30):
                    mid = (lo + hi) / 2
                    lo, hi = (mid, hi) if top(mid) >= self.redcoat_s * 0.2 \
                        else (lo, mid)
                lift = lo
            aim = math.atan2(4 * lift - drop, reach)
            cranked = self._ramp(rt, Siege.CRANK_AT, Siege.FIRE_AT)
            lowered = self._ramp(rt, Siege.RELIEF_LEN - 0.8, Siege.RELIEF_LEN)
            elev = 0.12 + (aim - 0.12) * (cranked - lowered)
            if Siege.CRANK_AT <= rt < Siege.FIRE_AT:
                crank = rt * 9.0
            boom = rt - Siege.FIRE_AT
            fly = (rt - Siege.FIRE_AT) / Siege.FLIGHT_S
            if 0 <= fly < 1:
                ball = (pivot[0] + (land[0] - pivot[0]) * fly,
                        pivot[1] + (land[1] - pivot[1]) * fly
                        - 4 * lift * fly * (1 - fly))
        handle = None
        if crank is not None:
            handle = (gun_x + gf * (-10 + math.cos(crank) * 9) * gs / 100,
                      walk_y + (-34 + math.sin(crank) * 9) * gs / 100)
        elif rt is not None and Siege.WHEEL_AT <= rt < Siege.CRANK_AT:
            # Both hands on the end of the trail, pushing.
            handle = (gun_x - gf * 34 * gs / 100, walk_y - 9 * gs / 100)
        self._cannon(cr, gun_x, walk_y, gs, gf, gf * gun_x / (0.14 * gs),
                     0.0, -1.0, boom, elev,
                     crank if crank is not None else 0.0)

        if rt is None and self.potshot is not None:
            # Halted, he kneels and fires up at the boat.
            ps = self.potshot
            kneel, aim, shot = Siege.drill_pose(ps["tau"])
            bx, by, _ = self._boat_at(ps["boat"])
            by -= self._boat_m(ps["boat"]["side"]) * 0.3
            rise = (walk_y - ws * 0.52) - by
            elev = min(1.3, max(-0.6, math.atan2(
                rise, max(1.0, abs(bx - patrol)))))
            self._mountain_man(cr, patrol, walk_y, ws,
                               1 if bx >= patrol else -1, kneel=kneel,
                               aim=aim, shot=shot, elev=elev)
        elif wm not in ("patrol", "eat"):
            if wm == "to_wall":
                self._mountain_man(cr, patrol, walk_y, ws, facing_now,
                                   step=math.sin(self.phase * 7.0) * 0.38,
                                   shouldered=True)
            elif wm not in self.GROUND_MODES:
                self._draw_mender(cr, 2, patrol, floor, ws, walk_y)
        elif rt is None:
            raised, toot = self._bugle()
            step = 0.0 if self.siege.bugling() \
                else math.sin(walked * 7.0) * 0.38
            sit = self.siege.sit(2)
            self._mountain_man(cr, patrol, walk_y, ws, facing_now,
                               step=step, shouldered=not sit, bugle=raised,
                               toot=toot, sit=sit,
                               eat=self.phase if self.siege.eating(2)
                               else -1.0)
        else:
            # He runs to his place behind the gun, wheels it toward the
            # wall in trouble, kneels to crank it up, and once it has fired
            # runs back to where he left off.
            station = gun_x - gf * gs * (
                0.45 - 0.15 * self._ramp(rt, Siege.CRANK_AT,
                                         Siege.CRANK_AT + 0.3))
            there = Siege.WHEEL_AT
            back = Siege.FIRE_AT + 0.5
            pushing = there <= rt < Siege.CRANK_AT
            if rt < Siege.HEARD_AT or rt >= back + Siege.RUN_S:
                wx, facing, run = patrol, facing_now, False
            elif rt < there:
                k = self._ramp(rt, Siege.HEARD_AT, there)
                wx, run = patrol + (station - patrol) * k, True
                facing = 1 if station >= patrol else -1
            elif rt < back:
                wx, facing, run = station, gf, False
            else:
                k = self._ramp(rt, back, back + Siege.RUN_S)
                wx, run = station + (patrol - station) * k, True
                facing = 1 if patrol >= station else -1
            kneel = self._ramp(rt, Siege.CRANK_AT, Siege.CRANK_AT + 0.3) \
                - self._ramp(rt, back - 0.3, back)
            step = math.sin(self.phase * 14.0) * 0.55 if run \
                else math.sin(self.phase * 8.0) * 0.35 if pushing else 0.0
            self._mountain_man(cr, wx, walk_y, ws, facing, step=step,
                               shouldered=kneel == 0 and not handle,
                               kneel=kneel)
            if handle is not None:
                # His near arm on the crank handle.
                sx = wx + facing * 6 * ws / 100
                sy = walk_y + (-75 + 20 * kneel) * ws / 100
                cr.set_source_rgb(*BUCK_RGB)
                cr.set_line_width(6 * ws / 100)
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                cr.move_to(sx, sy)
                cr.line_to(*handle)
                cr.stroke()
                cr.set_source_rgb(*SKIN_RGB)
                cr.arc(*handle, 3 * ws / 100, 0, 2 * math.pi)
                cr.fill()

        if ball is not None:
            r = max(2.5, gs * 0.045)
            for j in range(4):
                back_u = max(0.0, fly - 0.03 * (j + 1))
                tx_ = pivot[0] + (land[0] - pivot[0]) * back_u
                ty_ = pivot[1] + (land[1] - pivot[1]) * back_u \
                    - 4 * lift * back_u * (1 - back_u)
                cr.set_source_rgba(*SMOKE_RGB, 0.25 - 0.05 * j)
                cr.arc(tx_, ty_, r * (0.9 - 0.15 * j), 0, 2 * math.pi)
                cr.fill()
            # Light enough to see against the night sky.
            cr.arc(*ball, r, 0, 2 * math.pi)
            cr.set_source_rgb(*BALL_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*HAT_RGB)
            cr.set_line_width(max(0.8, r * 0.3))
            cr.stroke()
        if rt is not None and 0 <= rt - Siege.FIRE_AT - Siege.FLIGHT_S < 1.0:
            self._blast(cr, land, rt - Siege.FIRE_AT - Siege.FLIGHT_S)

    def _blast(self, cr, at, e):
        """The ball landing at the foot of the wall, e seconds on."""
        x, y = at
        size = self.redcoat_s
        self._glow(cr, x, y - size * 0.2, size * (0.6 + 0.8 * e), FLASH_RGB,
                   max(0.0, 1.0 - e * 1.4))
        for k in range(9):
            a = -math.pi * (0.1 + 0.8 * k / 8)
            v = size * (1.1 + 0.3 * (k % 3))
            px = x + math.cos(a) * v * e
            py = y + math.sin(a) * v * e + size * 2.2 * e * e
            cr.set_source_rgba(*PATH_RGB, max(0.0, 1.0 - e))
            cr.arc(px, py, size * 0.05, 0, 2 * math.pi)
            cr.fill()
        cr.set_source_rgba(*SMOKE_RGB, 0.5 * max(0.0, 1.0 - e))
        cr.arc(x, y - size * (0.3 + 0.4 * e), size * (0.25 + 0.4 * e), 0,
               2 * math.pi)
        cr.fill()

    # -- the land, and the river across it --------------------------------

    @staticmethod
    def _mix(weights, rgbs):
        return tuple(sum(w * c[k] for w, c in zip(weights, rgbs))
                     for k in range(3))

    def _season_look(self):
        """The season's colours and weights, mixed once a frame from the
        world's clock so every season blends into the next."""
        w = self.world.season_weights()
        mix = self._mix
        return {
            "w": w, "spring": w[0], "autumn": w[2], "winter": w[3],
            "grass": mix(w, (SPRING_GRASS_RGB, GRASS_RGB, AUTUMN_GRASS_RGB,
                             WINTER_GRASS_RGB)),
            "grass_low": mix(w, (GRASS_LOW_RGB, GRASS_LOW_RGB, GRASS_LOW_RGB,
                                 WINTER_GRASS_LOW_RGB)),
            "tuft": mix(w, (SPRING_TUFT_RGB, GRASS_HI_RGB, AUTUMN_TUFT_RGB,
                            WINTER_TUFT_RGB)),
            "water": mix(w, (SPRING_WATER_RGB, WATER_RGB, AUTUMN_WATER_RGB,
                             WINTER_WATER_RGB)),
            "leaf": [mix(w, (SPRING_LEAF_RGB, LEAF_RGB, AUTUMN_LEAF_RGBS[k],
                             BARE_LEAF_RGB)) for k in range(3)],
            "leaf_hi": [mix(w, (SPRING_LEAF_HI_RGB, LEAF_HI_RGB,
                                AUTUMN_LEAF_HI_RGBS[k], BARE_LEAF_RGB))
                        for k in range(3)],
        }

    def _draw_land(self, cr, width, height):
        """Grass over the whole picture, fading out at the foot into the
        window below it, coloured by the season; worn browner while the
        redcoats are marching, though snow covers even that."""
        look = self.look
        grass = look["grass"]
        if self.on:
            grass = self._mix((1 - look["winter"] * 0.8,
                               look["winter"] * 0.8),
                              (TRODDEN_RGB, WINTER_GRASS_RGB))
        grad = cairo.LinearGradient(0, 0, 0, height)
        grad.add_color_stop_rgba(0.0, *grass, 0.95)
        grad.add_color_stop_rgba(0.82, *look["grass_low"], 0.9)
        grad.add_color_stop_rgba(1.0, *look["grass_low"], 0.0)
        cr.rectangle(0, 0, width, height)
        cr.set_source(grad)
        cr.fill()
        # Tufts scattered evenly (an R2 sequence), the same every frame.
        n = int(min(220, width * height / 1100))
        cr.set_line_width(1.0)
        cr.set_source_rgba(*look["tuft"], 0.30 if self.on else 0.45)
        for i in range(n):
            x = (0.5 + i * 0.7548777) % 1.0 * width
            y = (0.5 + i * 0.5698403) % 1.0 * height * 0.88
            h = 3.0 + 2.0 * ((i * 0.618) % 1.0)
            for dx in (-1.6, 0.0, 1.6):
                cr.move_to(x + dx * 0.5, y)
                cr.line_to(x + dx, y - h * (1.0 - abs(dx) * 0.2))
        cr.stroke()

    HIGH_WATER = 0.25   # the spring melt widens the river by this much

    def _lay_river(self, width, top, bottom, t):
        """Run the river from left to right inside the band (top, bottom),
        meandering as far as the band allows, with room left for it to
        rise."""
        room = max(0.0, bottom - top)
        half = max(3.0, min(t * 0.3, room * 0.14))
        amp = max(0.0, min(t * 0.6, room / 2 - half * self._swell_max() - 2))
        world = self.world
        self.river = {"w": width, "y": (top + bottom) / 2, "amp": amp,
                      "half": half, "ponds": [
                          ((u - world.POND_LEN) * width, u * width,
                           world.dam_k(f))
                          for f, u in enumerate(world.DAM_U)]}

    def _river_y(self, x):
        r = self.river
        u = x / r["w"]
        return r["y"] + r["amp"] * (math.sin(u * 8.2 + 0.5) * 0.8
                                    + math.sin(u * 15.1 + 2.0) * 0.2)

    POND_WIDEN = 0.5    # a finished dam pools the river this much wider

    def _river_half(self, x):
        """Half the river's width at x; it narrows and widens a little,
        runs high in spring, and pools wider above a beaver dam."""
        pond = max(self._pond(x, lo, hi) * k
                   for lo, hi, k in self.river["ponds"])
        return self._river_base(x) * (1.0 + self.HIGH_WATER
                                      * self.look["spring"]) \
            * (1.0 + self.POND_WIDEN * pond)

    def _pond(self, x, lo, hi):
        """How much of a full pond stands at x, for one between lo and
        the dam at hi: swelling from upstream, held back at the dam."""
        ln = hi - lo
        return self._ramp(x, lo, lo + 0.45 * ln) \
            * (1 - self._ramp(x, hi - 0.04 * ln, hi + 0.1 * ln))

    def _river_base(self, x):
        r = self.river
        return r["half"] * (1.0 + 0.15 * math.sin(x / r["w"] * 11.0 + 1.0))

    def _swell_max(self):
        return (1.0 + self.HIGH_WATER) * (1.0 + self.POND_WIDEN)

    def _river_half_max(self, x):
        """The most _river_half(x) can ever be, in any season and behind
        any dam: what the layout keeps the land clear of."""
        pond = max(self._pond(x, lo, hi) for lo, hi, _ in
                   self.river["ponds"])
        return self._river_base(x) * (1.0 + self.HIGH_WATER) \
            * (1.0 + self.POND_WIDEN * pond)

    def _river_edge(self, x, side):
        """The river's far (side -1) or near (side 1) bank at x."""
        return self._river_y(x) + side * self._river_half(x)

    def _draw_river(self, cr):
        """Muddy banks, the water between them, and glints drifting
        downstream."""
        w = self.river["w"]
        xs = [-10 + k * 6.0 for k in range(int((w + 20) / 6) + 2)]

        def band(grow):
            cr.move_to(xs[0], self._river_edge(xs[0], -1) - grow)
            for x in xs[1:]:
                cr.line_to(x, self._river_edge(x, -1) - grow)
            for x in reversed(xs):
                cr.line_to(x, self._river_edge(x, 1) + grow)
            cr.close_path()

        band(self.river["half"] * 0.35 + 1)
        cr.set_source_rgba(*MUD_RGB, 0.9)
        cr.fill()
        band(0)
        cr.set_source_rgb(*self.look["water"])
        cr.fill()
        ice = self.look["winter"]
        if ice > 0.01:
            # Shelves of ice grow in from both banks.
            cr.set_source_rgba(*ICE_RGB, 0.85 * ice)
            for side in (-1, 1):
                cr.move_to(xs[0], self._river_edge(xs[0], side))
                for x in xs[1:]:
                    cr.line_to(x, self._river_edge(x, side))
                for k, x in enumerate(reversed(xs)):
                    jag = 0.25 + 0.12 * math.sin(k * 1.7) ** 2
                    cr.line_to(x, self._river_edge(x, side)
                               - side * self._river_half(x) * jag * ice)
                cr.close_path()
                cr.fill()
        # Shallows along the near bank.
        cr.set_source_rgba(*WATER_HI_RGB, 0.18)
        cr.set_line_width(self.river["half"] * 0.4)
        cr.move_to(xs[0], self._river_edge(xs[0], 1)
                   - self.river["half"] * 0.2)
        for x in xs[1:]:
            cr.line_to(x, self._river_edge(x, 1) - self.river["half"] * 0.2)
        cr.stroke()

        # Glints carried along on the current, each fading in and out.
        span = w + 40
        n = max(6, int(w / 26))
        cr.set_line_width(1.2)
        for i in range(n):
            u = ((i * 0.618034) + self.current) % 1.0
            x = -20 + u * span + (i * 37) % 23
            lane = ((i * 0.381966) % 1.0) * 1.3 - 0.65
            y = self._river_y(x) + lane * self._river_half(x)
            fade = math.sin(u * math.pi * 7 % math.pi)
            ln = self.river["half"] * 0.9
            dy = self._river_y(x + ln) - self._river_y(x)
            cr.set_source_rgba(*WATER_HI_RGB, 0.55 * fade)
            cr.move_to(x, y)
            cr.line_to(x + ln, y + dy)
            cr.stroke()

    def _find_fords(self):
        """Where each trail crosses the river, as p along the trail, or
        None where it does not."""
        self.fords = [None, None]
        if self.trails is None or self.river is None:
            return
        for side, pts in enumerate(self.trails):
            prev = None
            for k in range(201):
                p = k / 200
                x, y = self._bezier(pts, p)
                d = y - self._river_y(x)
                if prev is not None and (prev[1] < 0) != (d < 0):
                    self.fords[side] = prev[0] + (p - prev[0]) * (
                        -prev[1] / (d - prev[1]))
                    break
                prev = (p, d)

    def _draw_fords(self, cr):
        """Stepping stones across the water where a trail fords it."""
        for side, p in enumerate(self.fords):
            if p is not None:
                x = self._bezier(self.trails[side], p)[0]
                self._draw_ford(cr, x, self.redcoat_s * 0.5
                                * self._depth_scale(p), side)

    def _draw_ford(self, cr, x, half, seed):
        """Three stepping stones across the water at x, and the current
        breaking white over them."""
        rh = self._river_half(x)
        for j in range(3):
            sx = x + (j - 1) * half * 0.6
            sy = self._river_y(sx) + (j - 1) * rh * 0.5
            foam = 0.4 + 0.3 * math.sin(self.phase * 5 + j * 2 + seed)
            cr.set_source_rgba(1, 1, 1, foam)
            cr.set_line_width(1.0)
            cr.move_to(sx + half * 0.3, sy - rh * 0.2)
            cr.line_to(sx + half * 0.6, sy)
            cr.line_to(sx + half * 0.3, sy + rh * 0.2)
            cr.stroke()
            cr.save()
            cr.translate(sx, sy)
            cr.scale(half * 0.28, rh * 0.32)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgb(*STONE_RGB)
            cr.fill()

    # -- the beavers' works on the river ----------------------------------

    def _water_xy(self, place):
        """Where in the water a beaver bound for place swims to: off the
        bank below a tree, at the dam, beside the lodge, or out in the
        stream."""
        world = self.world
        w = self.river["w"]
        u, side = world.place_u(place)
        x = u * w
        if place[0] == "tree" and self.wild is not None and not self.on:
            spot = self.wild["tree_at"].get(place[1])
            if spot is not None:
                x = spot[0]
        lane = {"dam": -0.1, "lodge": 0.35}.get(place[0], 0.0)
        if side:
            lane = 0.65 * side
        return x, self._river_y(x) + lane * self._river_half(x)

    def _bank_xy(self, b):
        """A beaver at its tree, on the bank in the idle picture: (x, feet,
        facing), or None if the tree is not in the picture."""
        if self.wild is None or b["to"][0] != "tree":
            return None
        spot = self.wild["tree_at"].get(b["to"][1])
        if spot is None:
            return None
        x, base, h = spot[:3]
        facing = 1 if b["id"] % 2 else -1
        return x - facing * (0.12 * h + 0.2 * self.wild["s"]), base, facing

    def _beaver_pose(self, b):
        """What one beaver is doing as drawn now: (pose, x, y, facing,
        dive), pose one of "swim", "dive" (tail up, going under), "under"
        (a string of bubbles), "bank" (at a tree), "work" (at the dam) or
        "inside" (in the lodge, not drawn)."""
        t = self.world.time
        if t < b["t1"]:
            ax, ay = self._water_xy(b["at"])
            bx, by = self._water_xy(b["to"])
            span = b["t1"] - b["t0"]
            p = (t - b["t0"]) / span if span > 0 else 1.0
            e = self._ramp(p, 0.0, 1.0)
            x, y = ax + (bx - ax) * e, ay + (by - ay) * e
            facing = 1 if bx >= ax else -1
            # On a long swim he slaps his tail and dives in the middle
            # fifth, coming up further on.
            if span >= 6 and 0.4 <= p < 0.6:
                if p < 0.46:
                    return "dive", x, y, facing, (p - 0.4) * span
                return "under", x, y, facing, (p - 0.4) * span
            return "swim", x, y, facing, -1.0
        job, to = b["job"], b["to"]
        if to[0] == "tree":
            bank = self._bank_xy(b)
            if bank is not None and not self.on:
                return ("bank",) + bank + (-1.0,)
            if self.on:
                return "inside", 0.0, 0.0, 1, -1.0
            x, y = self._water_xy(to)
            return "swim", x, y, 1, -1.0
        if job == "lodge" or (job == "feed" and to[0] == "lodge"
                              and int(t / 7 + b["id"]) % 2):
            return "inside", 0.0, 0.0, 1, -1.0
        x, y = self._water_xy(to)
        if job == "swim":
            # Paddling about, turning now and then.
            x += math.sin(t * 0.4 + b["id"]) * self.river["half"] * 1.5
        facing = 1 if math.cos(t * 0.4 + b["id"]) > 0 else -1
        return ("work" if to[0] == "dam" else "swim"), x, y, facing, -1.0

    def _works_items(self):
        """The river's works as drawn: each colony's dam and lodge, and
        every beaver in the water, as (kind, args)."""
        world, w = self.world, self.river["w"]
        items = []
        for f, c in enumerate(world.colonies):
            if c["dam"] > 0:
                items.append(("dam", (world.DAM_U[f] * w,
                                      world.dam_k(f))))
            if c["lodge"] > 0:
                x, y = self._water_xy(["lodge", f])
                items.append(("lodge", (x, y, world.lodge_k(f))))
        for b in world.beavers:
            pose = self._beaver_pose(b)
            if pose[0] not in ("bank", "inside"):
                items.append(("beaver", (b,) + pose))
        return items

    def _draw_works(self, cr):
        s = self.river["half"] * 1.5
        snow = self.look["winter"]
        for kind, args in self._works_items():
            if kind == "dam":
                self._dam(cr, *args)
            elif kind == "lodge":
                x, y, k = args
                self._lodge(cr, x, y, s * 1.6, k, snow)
            else:
                self._draw_swimmer(cr, s, *args)

    def _draw_swimmer(self, cr, s, b, pose, x, y, facing, dive):
        """A beaver swimming with a V of ripples behind him, a stick in
        his teeth if he carries one; diving, he slaps his tail and goes
        under, leaving a string of bubbles."""
        if pose in ("dive", "under") and dive < 1.6:
            self._splash(cr, x - facing * s * 0.4, y, s, dive)
        if pose == "under":
            cr.set_source_rgba(*WATER_HI_RGB, 0.6)
            for k in range(3):
                u = (self.phase * 1.7 + k / 3) % 1.0
                cr.arc(x - facing * k * s * 0.3, y - u * 2,
                       max(0.6, s * 0.05), 0, 2 * math.pi)
                cr.fill()
            return
        moving = pose != "work"
        if moving:
            ln = s * (1.6 + 0.2 * math.sin(self.phase * 3 + b["id"]))
            nose = x + facing * s * 0.5
            cr.set_line_width(1.1)
            for side in (-1, 1):
                grad = cairo.LinearGradient(nose, y, nose - facing * ln, y)
                grad.add_color_stop_rgba(0.0, *WATER_HI_RGB, 0.8)
                grad.add_color_stop_rgba(1.0, *WATER_HI_RGB, 0.0)
                cr.set_source(grad)
                cr.move_to(nose - facing * s * 0.1, y)
                cr.line_to(nose - facing * ln, y + side * ln * 0.32)
                cr.stroke()
        else:
            # Working the dam: bobbing as he tucks sticks in.
            y += math.sin(self.phase * 4 + b["id"]) * s * 0.06
        self._beaver(cr, x, y, s, facing, swim=True, stick=b["stick"],
                     dive=min(1.0, dive / 0.5) if pose == "dive" else 0.0)

    def _dam(self, cr, x, k):
        """Sticks and mud laid across the river at x, growing in from both
        banks as k runs 0..1; a notch is left mid-stream, where the water
        spills white over it."""
        half = self._river_half(x)
        y = self._river_y(x)
        th = max(3.0, self.river["half"] * 0.7)
        reach = 1.15 * half * min(1.0, k * 1.15)
        mud = self.river["half"] * 0.35 + 1
        for side in (-1, 1):
            y0 = y + side * (half + mud * 0.6)
            y1 = y0 - side * (reach + mud * 0.6)
            cr.set_source_rgb(*MUD_RGB)
            self._rounded(cr, x - th / 2, min(y0, y1), th,
                          abs(y1 - y0), th * 0.4)
            cr.fill()
            n = max(2, int(abs(y1 - y0) / max(1.5, th * 0.35)))
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            for j in range(n):
                sy = y0 + (y1 - y0) * (j + 0.5) / n
                tilt = (0.6 if j % 2 else -0.6) * th
                cr.set_source_rgb(*(TRUNK_RGB if j % 3 else WOOD_HI_RGB))
                cr.set_line_width(max(0.8, th * 0.22))
                cr.move_to(x - th * 0.75, sy - tilt * 0.3)
                cr.line_to(x + th * 0.75, sy + tilt * 0.3)
                cr.stroke()
        if k > 0.6:
            # The spill through the notch, and foam below it.
            cr.set_line_width(1.0)
            for j in range(3):
                fy = y + (j - 1) * half * 0.12
                u = (self.phase * 1.3 + j / 3) % 1.0
                cr.set_source_rgba(1, 1, 1, 0.7 * (1 - u) * (k - 0.6) / 0.4)
                cr.move_to(x + th * 0.6, fy)
                cr.line_to(x + th * (0.9 + 1.6 * u), fy + half * 0.05)
                cr.stroke()

    def _lodge(self, cr, x, y, s, k, snow):
        """A beavers' lodge: a dome of sticks and mud out in the pond, s
        across when finished, rising as k runs 0..1, under snow in
        winter."""
        if k <= 0:
            return
        w = s * (0.5 + 0.5 * k)
        h = s * 0.55 * k
        cr.save()
        cr.translate(x, y)
        cr.move_to(-w / 2, 0)
        cr.curve_to(-w * 0.45, -h * 0.9, -w * 0.2, -h, 0, -h)
        cr.curve_to(w * 0.2, -h, w * 0.45, -h * 0.9, w / 2, 0)
        cr.close_path()
        cr.set_source_rgb(*BEAVER_DARK_RGB)
        cr.fill_preserve()
        cr.save()
        cr.clip()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(max(0.8, s * 0.04))
        n = max(4, int(14 * k))
        for j in range(n):
            a = (j * 0.618034) % 1.0
            b = (j * 0.381966) % 1.0
            cr.set_source_rgb(*(TRUNK_RGB if j % 2 else WOOD_RGB))
            cx, cy = (a - 0.5) * w, -b * h
            cr.move_to(cx - s * 0.14, cy + (0.05 if j % 2 else -0.05) * s)
            cr.line_to(cx + s * 0.14, cy - (0.05 if j % 2 else -0.05) * s)
            cr.stroke()
        cr.restore()
        if snow > 0.01:
            cr.set_source_rgba(*SNOW_RGB, 0.95 * snow)
            cr.save()
            cr.translate(0, -h * 0.82)
            cr.scale(w * 0.36, h * 0.3)
            cr.arc(0, 0, 1, math.pi, 2 * math.pi)
            cr.restore()
            cr.fill()
        # Where it meets the water.
        cr.set_source_rgba(*WATER_HI_RGB, 0.5)
        cr.set_line_width(1.0)
        cr.move_to(-w * 0.6, 0.5)
        cr.line_to(w * 0.6, 0.5)
        cr.stroke()
        cr.restore()

    def _splash(self, cr, x, y, s, e):
        """Rings and drops where a tail slapped the water, e seconds on."""
        cr.set_line_width(1.0)
        for k in range(3):
            u = e / 1.6 - k * 0.15
            if u <= 0:
                continue
            cr.set_source_rgba(1, 1, 1, 0.7 * (1 - u))
            cr.save()
            cr.translate(x, y)
            cr.scale(1.0, 0.35)
            cr.arc(0, 0, s * (0.2 + 0.9 * u), 0, 2 * math.pi)
            cr.restore()
            cr.stroke()
        if e < 0.7:
            cr.set_source_rgba(1, 1, 1, 0.9 * (1 - e / 0.7))
            for k in range(5):
                a = math.pi * (0.2 + 0.15 * k)
                v = s * (1.6 + 0.4 * (k % 2))
                cr.arc(x + math.cos(a) * v * e,
                       y - math.sin(a) * v * e + s * 5 * e * e,
                       max(0.7, s * 0.06), 0, 2 * math.pi)
                cr.fill()

    # -- the grove, where the fort stands when it is down ------------------

    def _pine(self, cr, x, base, h, sway):
        """A conifer: trunk and three tiers, its tip swaying by sway. Green
        the year round; in winter, snow lies along each tier."""
        w = h * 0.5
        snow = self.look["winter"]
        cr.set_source_rgb(*TRUNK_RGB)
        cr.rectangle(x - w * 0.07, base - h * 0.2, w * 0.14, h * 0.2)
        cr.fill()
        for i, (lo, hi, frac) in enumerate(((0.12, 0.62, 1.0),
                                            (0.38, 0.84, 0.78),
                                            (0.60, 1.0, 0.55))):
            dx = sway * (hi - 0.1)
            left = (x - w / 2 * frac + sway * lo, base - h * lo)
            right = (x + w / 2 * frac + sway * lo, base - h * lo)
            tip = (x + dx, base - h * hi)
            cr.move_to(*left)
            cr.line_to(*tip)
            cr.line_to(*right)
            cr.close_path()
            cr.set_source_rgb(*(PINE_RGB if i % 2 == 0 else PINE_HI_RGB))
            cr.fill()
            if snow > 0.01:
                # A cap over the tip and a sag of snow along the boughs.
                k = 0.42
                cr.move_to(tip[0] + (left[0] - tip[0]) * k,
                           tip[1] + (left[1] - tip[1]) * k)
                cr.line_to(*tip)
                cr.line_to(tip[0] + (right[0] - tip[0]) * k,
                           tip[1] + (right[1] - tip[1]) * k)
                cr.curve_to(tip[0], tip[1] + (left[1] - tip[1]) * 0.25,
                            tip[0], tip[1] + (left[1] - tip[1]) * 0.55,
                            tip[0] + (left[0] - tip[0]) * k,
                            tip[1] + (left[1] - tip[1]) * k)
                cr.close_path()
                cr.set_source_rgba(*SNOW_RGB, 0.95 * snow)
                cr.fill()

    def _round_tree(self, cr, x, base, h, sway, i=0):
        """A broadleaf: trunk and a canopy of three overlapping puffs, in
        the season's colours: blossom in spring, red, orange or yellow (by
        i) in autumn, and bare branches under snow in winter."""
        look = self.look
        bare = look["winter"]
        r = h * 0.26
        cr.set_source_rgb(*TRUNK_RGB)
        cr.rectangle(x - h * 0.04, base - h * 0.45, h * 0.08, h * 0.45)
        cr.fill()
        cy = base - h + r
        if bare > 0.01:
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_source_rgba(*TRUNK_RGB, bare)
            for dx, dy, wd in ((-0.75, 0.0, 0.05), (0.7, -0.15, 0.05),
                               (0.05, -0.85, 0.04), (-0.3, -0.55, 0.03),
                               (0.35, 0.35, 0.03)):
                cr.set_line_width(max(0.8, h * wd))
                cr.move_to(x, base - h * 0.4)
                cr.curve_to(x, cy + r * 0.6, x + dx * r * 0.4, cy + dy * r,
                            x + dx * r + sway, cy + dy * r)
                cr.stroke()
        hue = i % 3
        canopy = 1 - bare
        if canopy > 0.01:
            for dx, dy, rr, rgb in (
                    (-0.55, 0.35, 0.85, look["leaf"][hue]),
                    (0.55, 0.35, 0.85, look["leaf"][hue]),
                    (0.0, 0.0, 1.0, look["leaf_hi"][hue])):
                cr.set_source_rgba(*rgb, canopy)
                cr.arc(x + dx * r + sway, cy + dy * r, r * rr, 0,
                       2 * math.pi)
                cr.fill()
        if look["spring"] > 0.01:
            cr.set_source_rgba(*BLOSSOM_RGB, look["spring"])
            for k in range(6):
                bx = ((0.3 + (k + i) * 0.7548777) % 1.0 - 0.5) * 2.2 * r
                by = ((0.6 + (k + i) * 0.5698403) % 1.0 - 0.6) * 1.4 * r
                cr.arc(x + bx + sway, cy + by, max(0.7, r * 0.11), 0,
                       2 * math.pi)
                cr.fill()
        if bare > 0.01:
            cr.set_source_rgba(*SNOW_RGB, 0.9 * bare)
            for dx, dy in ((-0.75, 0.0), (0.7, -0.15), (0.05, -0.85)):
                cr.save()
                cr.translate(x + dx * r + sway, cy + dy * r - r * 0.05)
                cr.scale(r * 0.28, r * 0.09)
                cr.arc(0, 0, 1, 0, 2 * math.pi)
                cr.restore()
                cr.fill()

    def _bush(self, cr, x, base, s):
        look = self.look
        for dx, dy, rr, rgb in ((-0.5, 0.0, 0.55, look["leaf"][0]),
                                (0.5, 0.0, 0.55, look["leaf"][2]),
                                (0.0, -0.3, 0.65, look["leaf_hi"][1])):
            cr.set_source_rgb(*rgb)
            cr.arc(x + dx * s, base - s * 0.45 + dy * s, s * rr,
                   0, 2 * math.pi)
            cr.fill()
        if look["winter"] > 0.01:
            cr.set_source_rgba(*SNOW_RGB, 0.95 * look["winter"])
            cr.arc(x, base - s * 0.75, s * 0.62, math.pi * 1.05,
                   math.pi * 1.95)
            cr.close_path()
            cr.fill()

    @staticmethod
    def _beaver(cr, x, y, s, facing, thrash=0.0, swim=False, dive=0.0,
                stick=False):
        """A beaver about s long, nose toward facing, belly at y. Swimming,
        y is the waterline and only his head and back show; dive runs 0..1
        as he tips nose-down, tail flung up, and sinks. thrash rocks him,
        in radians. stick puts one crosswise in his teeth."""
        if s < 2:
            return
        cr.save()
        cr.translate(x, y)
        cr.scale(facing, 1)
        if swim:
            cr.save()
            cr.rectangle(-s * 2, -s * 2, s * 4, s * 2 + s * 0.04)
            cr.clip()
            cr.translate(0, s * 0.6 * dive)
        tip = min(1.0, dive * 4)
        cr.rotate(thrash + 0.7 * tip)
        if not swim or dive > 0:
            # The flat, scaly paddle of a tail.
            cr.save()
            cr.translate(-s * 0.42, -s * 0.12)
            cr.rotate(-1.4 * tip)
            cr.translate(-s * 0.2, 0)
            cr.scale(s * 0.24, s * 0.08)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgb(*BEAVER_DARK_RGB)
            cr.fill()
        cr.save()
        cr.translate(0, -s * 0.2)
        cr.scale(s * 0.38, s * 0.21)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.set_source_rgb(*BEAVER_RGB)
        cr.fill()
        cr.arc(s * 0.36, -s * 0.28, s * 0.15, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(*BEAVER_DARK_RGB)
        cr.arc(s * 0.29, -s * 0.42, s * 0.05, 0, 2 * math.pi)
        cr.fill()
        cr.arc(s * 0.5, -s * 0.29, s * 0.045, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(0.02, 0.02, 0.02)
        cr.arc(s * 0.41, -s * 0.33, max(0.4, s * 0.025), 0, 2 * math.pi)
        cr.fill()
        if stick:
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_source_rgb(*TRUNK_RGB)
            cr.set_line_width(max(0.8, s * 0.07))
            cr.move_to(s * 0.15, -s * 0.12)
            cr.line_to(s * 0.85, -s * 0.3)
            cr.stroke()
            cr.set_source_rgb(*LEAF_RGB)
            cr.arc(s * 0.85, -s * 0.33, max(0.6, s * 0.06), 0, 2 * math.pi)
            cr.fill()
        if not swim:
            cr.set_source_rgb(*BEAVER_DARK_RGB)
            for fx in (-0.2, 0.18):
                cr.save()
                cr.translate(s * fx, -s * 0.01)
                cr.scale(s * 0.08, s * 0.035)
                cr.arc(0, 0, 1, 0, 2 * math.pi)
                cr.restore()
                cr.fill()
        if swim:
            cr.restore()
        cr.restore()

    def _draw_grove(self, cr, x, y, w, h, t):
        """Trees and bushes where the stockade stands while it is up: the
        same ground, but nothing on it is held for anyone."""
        edge = t * 0.3
        X, Y, W, H = x - edge, y - edge, w + 2 * edge, h + 2 * edge

        self._rounded(cr, X, Y, W, H, edge)
        grad = cairo.LinearGradient(0, Y, 0, Y + H)
        grad.add_color_stop_rgba(0.0, *MEADOW_RGB, 0.55)
        grad.add_color_stop_rgba(1.0, *MEADOW_RGB, 0.30)
        cr.set_source(grad)
        cr.fill()

        # A row of trees along the back, taller ones at the corners where
        # the towers stand. Sizes vary but stay the same from frame to frame.
        n = max(4, round(W / (t * 0.5)))
        for i in range(n + 1):
            tx = X + W * i / n
            corner = i in (0, n)
            th = t * (1.45 if corner else 0.95 + 0.4 * ((i * 0.618) % 1.0))
            sway = math.sin(self.phase * 0.9 + i * 1.3) * t * 0.03
            if corner or i % 3 != 1:
                self._pine(cr, tx, y + edge * 0.2, th, sway)
            else:
                self._round_tree(cr, tx, y + edge * 0.2, th * 0.9, sway,
                                 i)

        # Bushes down the sides and along the front, with a gap for a path.
        s = t * 0.16
        rows = max(1, round(h / (s * 2.2)))
        for j in range(rows):
            by = y + h * (j + 0.8) / rows
            self._bush(cr, X + edge * 0.5, by, s)
            self._bush(cr, X + W - edge * 0.5, by, s)
        path = min(t * 0.9, w * 0.35)
        cr.set_source_rgba(*PATH_RGB, 0.6)
        cr.rectangle(X + W / 2 - path / 2, y + h, path, Y + H - (y + h))
        cr.fill()
        k = max(2, round((W - path) / 2 / (s * 2.1)))
        for side in (-1, 1):
            for j in range(k):
                bx = X + W / 2 + side * (path / 2 + s + j * (W - path) / 2 / k)
                self._bush(cr, bx, Y + H, s)

    # -- the wilds around the grove, while the fort is down ---------------

    def _lay_wilds(self, key, width, height, t, die, grove):
        """Lay out the woods and the trappers' ground once per size: on each
        flank of the grove the world's tree slots, its cabin plots (cabin,
        fire, cache and woodpile) on the near bank, its trap sites along
        both banks, and stepping stones across. A flank too small for any
        of it simply goes without, though its world goes on."""
        gx0, gy0, gx1, gy1 = grove
        # Narrow flanks get smaller figures rather than none at all.
        room = min(gx0, width - gx1) - 0.1 * t
        s = min(t * 0.58, max(t * 0.3, room / 2.4))
        mud = self.river["half"] * 0.35 + 2
        floor = height * 0.94

        def bank(x0, x1, side):
            ys = [self._river_y(x) + side * self._river_half_max(x)
                  for x in (x0 + (x1 - x0) * k / 16 for k in range(17))]
            return max(ys) + mud if side > 0 else min(ys) - mud

        flanks, pastures = [], []
        world = self.world
        for f in (0, 1):
            fl = {"near": None, "far": None, "ford": None, "sites": [],
                  "plots": [], "edge": None, "den": None}
            flanks.append(fl)
            x0, x1 = (0.0, gx0 - 0.1 * t) if f == 0 \
                else (gx1 + 0.1 * t, float(width))
            if x1 - x0 < 2 * s:
                continue
            top = bank(x0, x1, 1)
            if floor - top >= 1.5 * s:
                fl["near"] = (x0, top, x1, floor)
            if die is not None:
                cx0, cx1 = (x0, min(x1, die[0] - 0.1 * t)) if f == 0 \
                    else (max(x0, die[2] + 0.1 * t), x1)
                y0 = height * 0.03 + s
                bottom = bank(cx0, cx1, -1)
                if cx1 - cx0 >= 2 * s and bottom - y0 >= 0.2 * s:
                    fl["far"] = (cx0, y0, cx1, bottom)
            if fl["near"] is None:
                continue
            xf = width * (0.11 if f == 0 else 0.89)
            if fl["far"] and x0 + 0.4 * s <= xf <= x1 - 0.4 * s:
                ry, rh = self._river_y(xf), self._river_half_max(xf)
                fl["ford"] = ((xf, ry - rh - mud), (xf, ry + rh + mud))
            nx0, ny0, nx1, ny1 = fl["near"]
            H = ny1 - ny0
            fl["edge"] = (nx0 + 0.15 * s if f == 0 else nx1 - 0.15 * s,
                          ny0 + 0.45 * H)
            if H >= 3.2 * s:
                pastures.append((nx0 + 0.3 * s, ny0 + H * 0.84,
                                 nx1 - 0.3 * s, ny1 - 0.4 * s))
            # A trap site at each of the world's spots on this flank; one
            # across the river with no ford to reach it is set on this
            # bank instead.
            for k, (side, u) in enumerate(world.SITE_SPOTS):
                if side < 0 and fl["ford"] is None:
                    side = 1
                rx0, _, rx1, _ = fl["near"] if side > 0 else fl["far"]
                x = rx0 + 0.4 * s + (rx1 - rx0 - 0.8 * s) * u
                if fl["ford"] and abs(x - xf) < 0.9 * s:
                    x = xf + (0.9 * s if u >= 0.5 else -0.9 * s)
                    x = min(rx1 - 0.4 * s, max(rx0 + 0.4 * s, x))
                face = 1 if u < 0.5 else -1
                y = self._river_y(x) + side * (self._river_half_max(x)
                                               + mud * 0.6)
                stand = x - face * 0.42 * s
                if not rx0 + 0.2 * s <= stand <= rx1 - 0.2 * s:
                    face = -face
                    stand = x - face * 0.42 * s
                fl["sites"].append({"x": x, "y": y, "bank": side,
                                    "face": face,
                                    "stand": (stand, y + side * 0.12 * s)})
            # Each cabin plot, staggered so the nearer cabin does not
            # stand in front of the other.
            for k, u in enumerate(world.PLOT_U):
                cx = nx0 + 0.5 * s + (nx1 - nx0 - 1.0 * s) * u
                cy = ny0 + H * (0.55 if k == 0 else 0.72)
                cy = min(cy, ny1 - 0.2 * s)
                side = 1 if cx < (nx0 + nx1) / 2 else -1

                def inside(dx, dy):
                    return (min(nx1 - 0.35 * s,
                                max(nx0 + 0.35 * s, cx + dx * s)),
                            cy + dy * s)

                fl["plots"].append({
                    "cabin": (cx, cy), "door": inside(0.1, 0.12),
                    "wall": inside(-side * 0.5, 0.08),
                    "fire": inside(side * 0.6, 0.45),
                    "cache": inside(-side * 0.5, 0.42),
                    "pile": inside(side * 0.78, 0.03),
                    "hide": inside(-side * 1.0, 0.12), "side": side})
            # The den in the woods behind, out toward the flank's edge.
            fl["den"] = (nx0 + 0.8 * s if f == 0 else nx1 - 0.8 * s,
                         ny0 + 0.3 * H)
        if floor - gy1 >= 1.2 * s:
            pastures.append((gx0 + 0.3 * s, gy1 + 0.6 * s, gx1 - 0.3 * s,
                             floor - 0.1 * s))

        # Points the woods must leave in plain view: (x, feet, half width,
        # height) of whatever stands there.
        keep = []
        for fl in flanks:
            for st in fl["sites"]:
                keep += [(st["stand"][0], st["stand"][1], 0.5 * s, s),
                         (st["x"], st["y"], 0.7 * s, 0.8 * s)]
            for pl in fl["plots"]:
                keep += [(pl["cabin"][0], pl["cabin"][1], 0.75 * s,
                          1.3 * s),
                         (pl["fire"][0], pl["fire"][1], 0.4 * s, s),
                         (pl["cache"][0], pl["cache"][1], 0.5 * s, s),
                         (pl["hide"][0], pl["hide"][1], 0.4 * s, s)]
            if fl["den"]:
                keep.append((fl["den"][0], fl["den"][1], 0.8 * s, 0.6 * s))
            if fl["ford"]:
                (xf, ya), (_, yb) = fl["ford"]
                keep += [(xf, ya + (yb - ya) * k / 4, 0.6 * s, s)
                         for k in range(5)]
        for x0, y0, x1, y1 in pastures:
            keep.append(((x0 + x1) / 2, y1, (x1 - x0) / 2 + 0.6 * s,
                         y1 - y0 + 0.9 * s))

        overlaps = self._overlaps
        grove_tall = (gx0 - 0.1 * t, gy0 - 1.5 * t, gx1 + 0.1 * t,
                      gy1 + 0.2 * t)
        chip = die and (die[0] - 0.15 * t, die[1] - 0.15 * t,
                        die[2] + 0.15 * t, die[3] + 0.15 * t)

        def clear(x, base, h, box):
            if overlaps(box, grove_tall) or (chip and overlaps(box, chip)):
                return False
            return not any(
                overlaps(box, (px - w, py - ht, px + w, py + 0.3 * s))
                or (base > py - 0.2 * s and abs(x - px) < w + 0.3 * h
                    and base - h < py)
                for px, py, w, ht in keep)

        # The world's tree slots, each at its (u, v) in its zone of its
        # flank; one that would hide something is drawn smaller, never
        # left out, so the woods in the picture are the world's woods.
        tree_at = {}
        for i, slot in enumerate(self.world.trees):
            fl = flanks[slot["f"]]
            rect = fl["near"] if slot["side"] > 0 else fl["far"]
            if rect is None:
                continue
            x0, y0, x1, y1 = rect
            if slot["side"] > 0:
                v0, v1 = (0.02, 0.12) if slot["zone"] == "bank" \
                    else (0.16, 0.44)
            else:
                v0, v1 = (0.82, 1.0) if slot["zone"] == "bank" \
                    else (0.0, 0.7)
            x = x0 + 0.25 * s + slot["u"] * max(0.0, x1 - x0 - 0.5 * s)
            base = y0 + (v0 + (v1 - v0) * slot["v"]) * (y1 - y0)
            h = t * ((0.42 + 0.25 * slot["size"]) if slot["zone"] == "bank"
                     else (0.55 + 0.4 * slot["size"]))
            if not clear(x, base, h, (x - 0.32 * h, base - h, x + 0.32 * h,
                                      base)):
                h *= 0.55
            tree_at[i] = (x, base, h, slot["kind"], i)
        trees = sorted(tree_at.values(), key=lambda tr: tr[1])

        self.wild = {"key": key, "s": s, "t": t, "mud": mud, "trees": trees,
                     "tree_at": tree_at, "flanks": flanks,
                     "pastures": pastures, "grove": grove}
        self.horses = []
        if not pastures:
            return
        # The roomiest pasture gets two of the three.
        order = sorted(range(len(pastures)), key=lambda k: pastures[k][0]
                       - pastures[k][2])
        for i in range(3):
            k = order[0] if i == 2 else order[i % len(order)]
            x0, y0, x1, y1 = pastures[k]
            n = 2 if k == order[0] else 1
            j = 1 if i == 2 else 0
            self.horses.append({
                "pasture": k, "coat": i, "x": x0 + (x1 - x0) * (j + 0.5) / n,
                "y": self.rng.uniform(y0, y1), "facing": 1 if i % 2 else -1,
                "graze": 1, "graze_k": 1.0, "dest": None,
                "next_at": self.phase + self.rng.uniform(1.0, 6.0)})

    PELT_BALE = 5       # pelts on the stack before he ties them in a bale
    BALE_MAX = 3

    def _spot(self, f, place, job):
        """Where on flank f's ground a trapper stands for job at place, or
        None if the picture has no room for it."""
        fl = self.wild["flanks"][f]
        if fl["near"] is None:
            return None
        kind = place[0]
        if kind == "plot":
            pl = fl["plots"][place[2]]
            key = {"build": "wall", "stash": "cache", "fire": "fire"}.get(
                job, "door")
            x, y = pl[key]
            if key == "fire":
                return x - pl["side"] * 0.35 * self.wild["s"], y
            if key == "cache":
                return x + pl["side"] * 0.5 * self.wild["s"], y + 0.05 \
                    * self.wild["s"]
            return x, y
        if kind == "site":
            st = fl["sites"][place[2]]
            if job in ("fish", "steal"):
                # A bear goes down into the shallows, not to his stand.
                return st["x"] + st["face"] * 0.2 * self.wild["s"], st["y"]
            return st["stand"]
        if kind == "den":
            return fl["den"]
        if kind == "tree":
            spot = self.wild["tree_at"].get(place[1])
            if spot is None:
                return None
            x, base, h = spot[:3]
            nx0, _, nx1, _ = fl["near"]
            side = 1 if x < (nx0 + nx1) / 2 else -1
            return x + side * (0.12 * h + 0.3 * self.wild["s"]), \
                base + 0.04 * self.wild["s"]
        if kind == "edge":
            return fl["edge"]
        return None

    def _route(self, f, a, b):
        """Waypoints from a to b that keep to dry land: along flank f, over
        the river only on its stones."""
        fl = self.wild["flanks"][f]

        def bank(x, y):
            return 1 if y > self._river_y(x) else -1

        def leg(p, q, side):
            # Above the near rect's top (below the far rect's bottom) the
            # bank curves; going straight down to it and along is dry.
            rect = fl["near"] if side > 0 else fl["far"]
            if rect is None:
                return [q]
            lim = rect[1] if side > 0 else rect[3]
            pts = []
            if (p[1] - lim) * side < 0:
                pts.append((p[0], lim))
            if (q[1] - lim) * side < 0:
                pts.append((q[0], lim))
            return pts + [q]

        side = bank(*a)
        if bank(*b) == side or fl["ford"] is None:
            return [a] + leg(a, b, side)
        mine, theirs = fl["ford"] if side < 0 else fl["ford"][::-1]
        return [a] + leg(a, mine, side) + leg(theirs, b, -side)

    def _trapper_xy(self, tr):
        """Where trapper tr is drawn now: (x, feet, facing, walking), or
        None if he is out of the picture."""
        f, t = tr["f"], self.world.time
        b = self._spot(f, tr["to"], tr["job"])
        if b is None:
            return None
        if t >= tr["t1"]:
            face = self.wild["flanks"][f]["sites"][tr["to"][2]]["face"] \
                if tr["to"][0] == "site" else 1
            if tr["to"][0] == "plot":
                pl = self.wild["flanks"][f]["plots"][tr["to"][2]]
                face = pl["side"] if tr["job"] == "fire" else -pl["side"]
            elif tr["to"][0] == "tree":
                face = 1 if self.wild["tree_at"][tr["to"][1]][0] > b[0] \
                    else -1
            return b[0], b[1], face, False
        a = self._spot(f, tr["at"], "rest")
        return self._walk_xy(f, b if a is None else a, b,
                             (t - tr["t0"]) / max(1e-9, tr["t1"] - tr["t0"]))

    def _walk_xy(self, f, a, b, frac):
        """(x, feet, facing, True) frac of the way along the dry route from
        a to b on flank f."""
        pts = self._route(f, a, b)
        lens = [math.hypot(q[0] - p[0], q[1] - p[1])
                for p, q in zip(pts, pts[1:])]
        total = sum(lens)
        go = min(1.0, max(0.0, frac)) * total
        for j, ln in enumerate(lens):
            p0, p1 = pts[j], pts[j + 1]
            if go <= ln or j == len(lens) - 1:
                k = go / ln if ln > 0 else 1.0
                face = 1 if p1[0] >= p0[0] else -1
                return (p0[0] + (p1[0] - p0[0]) * min(1.0, k),
                        p0[1] + (p1[1] - p0[1]) * min(1.0, k), face, True)
            go -= ln
        return b[0], b[1], 1, True

    BEAR_K = 1.05       # a bear against a man, in the picture

    def _bear_place(self, b):
        """Bear b's start and end on its flank's ground, and which side of
        the man's spot it stands at if it is at a man (else 0); None if
        the picture has no room for it."""
        f, job = b["f"], b["job"]
        end = self._spot(f, b["to"], job)
        if end is None:
            return None
        start = self._spot(f, b["at"], "rest") or end
        side = 0
        if job in ("stalk", "fight", "eat", "dead"):
            if abs(start[0] - end[0]) > 1:
                side = 1 if start[0] > end[0] else -1
            else:
                x0, _, x1, _ = self.wild["flanks"][f]["near"]
                side = 1 if end[0] < (x0 + x1) / 2 else -1
            end = (end[0] + side * 0.6 * self.wild["s"], end[1])
        return start, end, side

    def _bear_xy(self, b):
        """Where bear b is drawn now: (x, feet, facing, walking), or None
        if it is out of the picture or asleep in its den."""
        w = self.world
        place = self._bear_place(b)
        if place is None or b["job"] == "den" and w.time >= b["t1"]:
            return None
        start, end, side = place
        if w.time < b["t1"]:
            return self._walk_xy(b["f"], start, end, (w.time - b["t0"])
                                 / max(1e-9, b["t1"] - b["t0"]))
        if side:
            face = -side
        elif b["to"][0] == "site":
            face = self.wild["flanks"][b["f"]]["sites"][b["to"][2]]["face"]
        else:
            face = 1 if start[0] <= end[0] else -1
        return end[0], end[1], face, False

    HORSE_COATS = ((HORSE_RGB, HORSE_DARK_RGB),
                   (HORSE_GREY_RGB, HORSE_GREY_DARK_RGB),
                   (HORSE_CHESTNUT_RGB, HORSE_CHESTNUT_DARK_RGB))

    def _horse_s(self):
        return self.wild["s"] * 0.9

    def _advance_horses(self, dt):
        """Loose horses grazing: mostly head down, now and then looking
        up, and once in a while ambling a few steps across the pasture."""
        hs_s = self._horse_s()
        for hs in self.horses:
            x0, y0, x1, y1 = self.wild["pastures"][hs["pasture"]]
            if hs["dest"] is not None:
                tx, ty = hs["dest"]
                dx, dy = tx - hs["x"], ty - hs["y"]
                dist = math.hypot(dx, dy)
                step = self.wild["t"] * 0.25 * dt
                if abs(dx) > 0.5:
                    hs["facing"] = 1 if dx > 0 else -1
                if dist <= step:
                    hs["x"], hs["y"], hs["dest"] = tx, ty, None
                else:
                    hs["x"] += dx / dist * step
                    hs["y"] += dy / dist * step
            elif self.phase >= hs["next_at"]:
                roll = self.rng.random()
                if roll < 0.6:
                    hs["graze"] = 1 - hs["graze"]
                elif roll < 0.85:
                    lo, hi = x0 + 0.6 * hs_s, max(x0 + 0.6 * hs_s,
                                                  x1 - 0.6 * hs_s)
                    dest = (min(hi, max(lo, hs["x"] + self.rng.uniform(
                                -2, 2) * hs_s)),
                            min(y1, max(y0, hs["y"] + self.rng.uniform(
                                -0.5, 0.5) * hs_s)))
                    # Not into another horse, standing or on its way.
                    if not any(abs(dest[0] - ox) < 1.3 * hs_s
                               and abs(dest[1] - oy) < 0.6 * hs_s
                               for o in self.horses if o is not hs
                               for ox, oy in (o["dest"] or (o["x"], o["y"]),
                                              (o["x"], o["y"]))):
                        hs["dest"] = dest
                hs["next_at"] = self.phase + (
                    self.rng.uniform(6.0, 12.0) if hs["graze"]
                    else self.rng.uniform(2.5, 5.0))
            want = 0.0 if hs["dest"] is not None else hs["graze"]
            hs["graze_k"] += (want - hs["graze_k"]) * min(1.0, 3.0 * dt)

    def _draw_horse(self, cr, hs):
        i = hs["coat"]
        # Head down, it nibbles: small dips as it crops the grass.
        nibble = 0.06 * max(0.0, math.sin(self.phase * 2.6 + i * 2)) ** 2
        self._cavalry(cr, hs["x"], hs["y"], self._horse_s(), hs["facing"],
                      self.phase * 5 + i, 0.0, rider=False,
                      coat=self.HORSE_COATS[i],
                      graze=hs["graze_k"] * (1 - nibble),
                      swish=math.sin(self.phase * 1.7 + i * 2) ** 3,
                      walk=hs["dest"] is not None)

    @staticmethod
    def _overlaps(a, b):
        return a[0] < b[2] and b[0] < a[2] and a[1] < b[3] and b[1] < a[3]

    def _scatter_trees(self, width, height, t, mud, kinds, clear):
        """Trees spread evenly (an R2 sequence) over the picture, each
        (x, base, h, kind, i), nearest last: on dry land, not crowding
        one another, and wherever clear(x, base, h, box) allows."""
        trees = []
        cap = int(min(90, width * height / (t * t * 0.8)))
        for i in range(cap * 10):
            if len(trees) >= cap:
                break
            x = (0.31 + i * 0.7548777) % 1.0 * width
            base = (0.17 + i * 0.5698403) % 1.0 * height
            kind = kinds[i % len(kinds)]
            h = t * (0.5 + 0.45 * ((i * 0.618) % 1.0))
            if kind in ("bush", "stump"):
                h *= 0.45 if kind == "bush" else 0.3
            box = (x - 0.32 * h, base - h, x + 0.32 * h, base)
            if base > height * 0.94 or base < 0.5 * h:
                continue
            far = self._river_y(x) - self._river_half_max(x) - mud
            near = self._river_y(x) + self._river_half_max(x) + mud
            if not (base <= far or base >= near + 0.35 * h):
                continue
            if not clear(x, base, h, box):
                continue
            if any(math.hypot(x - o[0], base - o[1]) < 0.3 * (h + o[2])
                   for o in trees):
                continue
            trees.append((x, base, h, kind, i))
        trees.sort(key=lambda tr: tr[1])
        return trees

    def _wild_items(self):
        """Everything in the idle picture's woods and pastures, as (feet,
        layer, draw, arg), to be drawn nearest last."""
        world = self.world
        items = [(tree[1], 0, self._draw_slot, tree)
                 for tree in self.wild["trees"]]
        for b in world.beavers:
            pose = self._beaver_pose(b)
            if pose[0] == "bank":
                items.append((pose[2], 1, self._draw_bank_beaver,
                              (b,) + pose))
        for f, fl in enumerate(self.wild["flanks"]):
            for k, st in enumerate(fl["sites"]):
                items.append((st["y"], 1, self._draw_site, (f, k, st)))
            for k, pl in enumerate(fl["plots"]):
                plot = world.plots[f][k]
                owner = next((tr for tr in world.trappers
                              if tr["id"] == plot["owner"]), None)
                items.append((pl["cabin"][1], 1, self._draw_cabin,
                              (pl, plot, owner)))
                if owner is not None:
                    items.append((pl["cache"][1], 1, self._draw_cache,
                                  (pl, owner)))
                    items.append((pl["pile"][1], 1, self._draw_woodpile,
                                  (pl, owner)))
                    if owner["job"] == "fire" and \
                            owner["to"] == ["plot", f, k] and \
                            world.time >= owner["t1"]:
                        items.append((pl["fire"][1], 1, self._draw_fire,
                                      (pl, owner)))
                    if owner["hide"] is not None and 0 <= world.time \
                            - owner["hide"] < world.HIDE_S:
                        items.append((pl["hide"][1], 1, self._draw_hide,
                                      (pl, owner)))
            if fl["den"] and any(b["f"] == f and b["job"] != "dead"
                                 for b in world.predators):
                items.append((fl["den"][1], 1, self._draw_den, (f, fl)))
        for g in world.graves:
            f = g["place"][1] if g["place"][0] in ("plot", "site", "edge") \
                else world.trees[g["place"][1]]["f"] \
                if g["place"][0] == "tree" else None
            spot = f is not None and self._spot(f, g["place"], "rest")
            if spot:
                items.append((spot[1], 1, self._draw_grave, (spot, g)))
        for tr in world.trappers:
            at = self._trapper_xy(tr)
            if at is not None and not (tr["job"] == "shelter"
                                       and world.time >= tr["t1"]):
                items.append((at[1], 2, self._draw_trapper, (tr, at)))
        for b in world.predators:
            at = self._bear_xy(b)
            if at is not None:
                items.append((at[1], 1 if b["job"] == "dead" else 2,
                              self._draw_bear, (b, at)))
        items += [(hs["y"], 2, self._draw_horse, hs) for hs in self.horses]
        return items

    def _draw_wilds(self, cr):
        """The woods, the beavers ashore, the trappers and the horses,
        nearest last."""
        items = self._wild_items()
        items.sort(key=lambda it: it[:2])
        for _, _, draw, arg in items:
            draw(cr, arg)

    def _draw_slot(self, cr, tree):
        """One of the world's trees as it stands now: grown, a stump with
        the beavers' sticks piled by it, or a sapling coming up."""
        x, base, h, kind, i = tree
        state = self.world.tree_state(i)
        if state == "tree":
            self._draw_tree(cr, tree)
            return
        slot = self.world.trees[i]
        if state == "sapling":
            g = 0.25 + 0.75 * self.world.growth(i)
            self._sapling(cr, x, base, h * g, kind == "pine")
        elif slot["by"] == "beaver":
            self._gnawed(cr, x, base, h * 0.22)
        else:
            self._stump(cr, x, base, h * 0.22)
        if state == "stump":
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_source_rgb(*TRUNK_RGB)
            cr.set_line_width(max(0.8, h * 0.03))
            for j in range(slot["pile"]):
                sx = x + h * (0.12 + 0.07 * (j % 2))
                sy = base - h * 0.025 * j
                cr.move_to(sx - h * 0.1, sy)
                cr.line_to(sx + h * 0.12, sy - h * 0.02)
                cr.stroke()

    def _draw_bank_beaver(self, cr, args):
        """A beaver ashore at its tree: gnawing it, eating its bark, or
        picking up a stick."""
        b, _, x, feet, facing, _ = args
        s = self.wild["s"] * 0.55
        busy = b["job"] in ("cut", "feed") and self.world.time >= b["t1"]
        thrash = math.sin(self.phase * 9 + b["id"]) * 0.08 if busy else 0.0
        self._beaver(cr, x, feet, s, facing, thrash=thrash,
                     stick=b["stick"])
        if busy and b["job"] == "cut":
            # Chips flying from the cut.
            for k in range(3):
                u = (self.phase * 1.8 + k / 3) % 1.0
                cr.set_source_rgba(*WOOD_HI_RGB, 1 - u)
                cr.arc(x + facing * s * (0.6 + 0.5 * u),
                       feet - s * (0.4 + 0.5 * u - 0.6 * u * u),
                       max(0.6, s * 0.04), 0, 2 * math.pi)
                cr.fill()

    @staticmethod
    def _gnawed(cr, x, base, h):
        """What a beaver leaves of a tree: a stump gnawed to a point."""
        w = h * 0.7
        cr.set_source_rgb(*TRUNK_RGB)
        cr.move_to(x - w * 0.5, base)
        cr.line_to(x - w * 0.42, base - h * 0.55)
        cr.line_to(x, base - h)
        cr.line_to(x + w * 0.42, base - h * 0.55)
        cr.line_to(x + w * 0.5, base)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*WOOD_HI_RGB)
        cr.move_to(x - w * 0.36, base - h * 0.55)
        cr.line_to(x, base - h)
        cr.line_to(x + w * 0.36, base - h * 0.55)
        cr.line_to(x, base - h * 0.7)
        cr.close_path()
        cr.fill()

    def _sapling(self, cr, x, base, h, pine):
        """A young tree coming up where one was felled."""
        if pine:
            self._pine(cr, x, base, h, 0.0)
            return
        cr.set_source_rgb(*TRUNK_RGB)
        cr.set_line_width(max(0.8, h * 0.05))
        cr.move_to(x, base)
        cr.line_to(x, base - h * 0.7)
        cr.stroke()
        look = self.look
        bare = look["winter"]
        if bare < 0.99:
            cr.set_source_rgba(*look["leaf_hi"][0], 1 - bare)
            for dx, dy in ((-0.15, -0.65), (0.15, -0.75), (0.0, -0.9)):
                cr.arc(x + dx * h, base + dy * h, h * 0.15, 0, 2 * math.pi)
                cr.fill()

    def _draw_trapper(self, cr, args):
        """A trapper at whatever he is about: walking with his rifle on his
        shoulder (a beaver on his back, or a log, if he carries one),
        kneeling at a trap, his cache, his wall or his fire, swinging an
        axe at a tree, or standing at ease looking about him."""
        tr, (x, feet, facing, walking) = args
        t, job = self.world.time, tr["job"]
        kneel = axe = aim = knife = 0.0
        shot = -1.0
        fight = tr["fight"]
        b = fight and next((b for b in self.world.predators
                            if b["id"] == fight["bear"]), None)
        place = b and self._bear_place(b)
        if place and not walking:
            # Facing the bear: the rifle up as it comes, one shot, then
            # the knife; helpers stand in beside him, away from it.
            side, s = place[2] or facing, self.wild["s"]
            facing = side
            target = b["fight"] and b["fight"]["target"]
            men = sorted((o for o in self.world.trappers if o["fight"]
                          and o["fight"]["bear"] == b["id"]
                          and t >= o["t1"]),
                         key=lambda o: o["id"] != target)
            k = men.index(tr) if tr in men else 0
            x -= side * 0.32 * s * k
            feet += 0.08 * s * k
            if fight["shot"] is not None:
                shot = t - fight["shot"]
            if b["job"] == "stalk" and fight["saw"] is not None:
                aim = self._ramp(t - fight["saw"], 0.0, self.world.REACT_S)
            elif 0 <= shot < 0.8:
                aim = 1.0
            elif b["job"] == "fight":
                knife = 0.15 + 0.85 * max(0.0, math.sin(
                    self.phase * 6.0 + tr["id"]))
        elif not walking:
            into, left = t - tr["t1"], tr["t2"] - t
            if job in ("set", "check", "collect", "stash", "fire", "build"):
                kneel = self._ramp(into, 0.0, 0.6) \
                    * (1 - self._ramp(-left, -0.6, 0.0))
            elif job == "chop":
                axe = 0.05 + 0.95 * (0.5 + 0.5 * math.sin(
                    self.phase * 4.2 + tr["id"]))
            elif job == "rest" and int(into / 2.5) % 2:
                facing = -facing  # looks about him
        step = math.sin(self.phase * 7.0 + tr["id"]) * 0.38 \
            if walking else 0.0
        self._mountain_man(cr, x, feet, self.wild["s"], facing,
                           step=step, shouldered=walking and job != "build",
                           kneel=kneel, axe=axe, aim=aim, elev=-0.06,
                           shot=shot if shot < 3.0 else -1.0, knife=knife,
                           beaver=walking and job == "stash"
                           and tr["carry"] == "beaver",
                           log=walking and job == "build")

    def _draw_bear(self, cr, args):
        """A bear at whatever it is about: ambling, charging or fleeing,
        fishing in the shallows, nosing at a trap, a cache or its kill,
        rearing to sniff the air, or up on its hind legs fighting, its
        blows drawing blood; slain, it lies where it fell a while."""
        b, (x, feet, facing, walking) = args
        world, s = self.world, self.wild["s"] * self.BEAR_K
        t, job = world.time, b["job"]
        if job == "dead":
            age = 1 - (b["t2"] - t) / world.CARCASS_S
            fade = 1 - max(0.0, age - 0.6) / 0.4
            cr.set_source_rgba(*BLOOD_RGB, 0.7 * fade)
            cr.save()
            cr.translate(x, feet)
            cr.scale(0.55 * s * min(1.0, 0.4 + age * 3), 0.12 * s)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()
            cr.push_group()
            self._bear(cr, x, feet, s, facing, fall=1.0)
            cr.pop_group_to_source()
            cr.paint_with_alpha(fade)
            return
        step = stand = charge = head = swipe = 0.0
        fish = False
        if walking:
            fast = job in ("stalk", "flee")
            step = math.sin(self.phase * (11.0 if fast else 6.0) + b["id"])
            charge = 1.0 if fast else 0.0
        elif job == "fight":
            stand = 1.0
            e = t - (b["fight"]["next"] - world.EXCHANGE_S)
            swipe = math.sin(min(1.0, max(0.0, e / 0.6)) * math.pi)
        elif job == "fish":
            head = 0.7 + 0.3 * math.sin(self.phase * 1.1 + b["id"])
            swipe = max(0.0, math.sin(self.phase * 1.3 + b["id"])) ** 8
            fish = b["t2"] - t < 8.0
            e = (self.phase + b["id"]) % 2.4
            self._splash(cr, x + facing * 0.35 * s, feet, s * 0.4, e)
        elif job in ("steal", "raid", "eat"):
            head = 0.85 + 0.15 * math.sin(self.phase * 4.0 + b["id"])
        elif job in ("hunt", "stalk"):
            head = 0.35
        elif job == "wander":
            u = (self.phase / 9.0 + b["id"] * 0.37) % 1.0
            stand = math.sin(u / 0.3 * math.pi) if u < 0.3 else 0.0
        self._bear(cr, x, feet, s, facing, step=step, stand=stand,
                   charge=charge, head=head, swipe=swipe, fish=fish)
        blow = b["blow"]
        if blow is not None and 0 <= t - blow["t"] < 0.7:
            if blow["on"] == "bear":
                self._spray(cr, x + facing * 0.3 * s,
                            feet - (0.4 + 0.45 * stand) * s, s * 0.9,
                            -facing, t - blow["t"], blow["t"] % 1.0)
            else:
                self._spray(cr, x + facing * 0.6 * s, feet - 0.6 * s,
                            s * 0.9, facing, t - blow["t"], blow["t"] % 1.0)

    def _draw_den(self, cr, args):
        """A bear's den, and while one sleeps in it, its breath."""
        f, fl = args
        world = self.world
        asleep = any(b["f"] == f and b["job"] == "den"
                     and world.time >= b["t1"] for b in world.predators)
        x, base = fl["den"]
        self._den(cr, x, base, self.wild["s"], self.look["winter"],
                  self.phase if asleep else -1.0, 1 if f == 0 else -1)

    def _draw_hide(self, cr, args):
        pl, owner = args
        x, y = pl["hide"]
        self._hide(cr, x, y, self.wild["s"] * 0.9)

    @staticmethod
    def _bear(cr, x, feet, s, facing, step=0.0, stand=0.0, charge=0.0,
              head=0.0, swipe=0.0, fall=0.0, fish=False):
        """A grizzly about s at the hump, nose toward facing, feet at feet.

        Drawn in a 100-unit model. step swings its legs, -1..1; charge
        (0..1) lowers and stretches it into a run; stand (0..1) rears it
        up on its hind legs, forepaws out; head (0..1) lowers its head to
        the water or the ground; swipe (0..1) raises the near forepaw to
        strike; fish puts one in its jaws. fall above 0 lays it on its
        side, dead."""
        if s < 2:
            return
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)

        def blob(cx, cy, rx, ry, rgb, rot=0.0):
            cr.save()
            cr.translate(cx, cy)
            cr.rotate(rot)
            cr.scale(rx, ry)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgb(*rgb)
            cr.fill()

        def limb(a, b, w, rgb, claws=True):
            cr.set_source_rgb(*rgb)
            cr.set_line_width(w)
            cr.move_to(*a)
            cr.line_to(*b)
            cr.stroke()
            blob(b[0] + 2, b[1] - 1, w * 0.6, w * 0.35, rgb)
            if claws:
                cr.set_source_rgb(*CLAW_RGB)
                cr.set_line_width(1.4)
                for k in (-1, 0, 1):
                    cr.move_to(b[0] + w * 0.5, b[1] + k * 2.2 - 1)
                    cr.line_to(b[0] + w * 0.5 + 4, b[1] + k * 2.6)
                cr.stroke()

        if fall > 0:
            # On its side, legs out stiff toward the viewer's left.
            cr.set_source_rgba(0, 0, 0, 0.25)
            cr.save()
            cr.scale(58, 7)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()
            blob(-2, -20, 50, 19, BEAR_RGB)
            blob(-6, -12, 40, 8, BEAR_DARK_RGB)
            for lx in (-34, -20, 18, 32):
                limb((lx, -8), (lx + 12, 3), 10, BEAR_DARK_RGB)
            blob(52, -14, 14, 11, BEAR_RGB, 0.3)
            blob(64, -9, 9, 6, BEAR_MUZZLE_RGB, 0.3)
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(1.5)
            cr.move_to(52, -20)
            cr.line_to(57, -18)
            cr.stroke()
            cr.restore()
            return

        cr.set_source_rgba(0, 0, 0, 0.25)
        cr.save()
        cr.scale(52 - 18 * stand, 6)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        reach = 10 + 10 * charge
        hip = (-24 + 8 * stand, -40 + 6 * charge)
        # The hind legs, crouched under it when it rears.
        for k, rgb in ((1, BEAR_DARK_RGB), (-1, BEAR_RGB)):
            sw = k * step * reach - 8 * charge * k
            knee = (hip[0] + 4 + sw * 0.4 - 6 * stand, -20)
            foot = (hip[0] + 2 + sw - 4 * stand + 4 * k * stand, -2)
            cr.set_source_rgb(*rgb)
            cr.set_line_width(15)
            cr.move_to(*hip)
            cr.line_to(*knee)
            cr.line_to(*foot)
            cr.stroke()
            blob(foot[0] + 3, foot[1], 9, 3.5, rgb)
        blob(hip[0] - 6, hip[1] - 2, 22, 21, BEAR_RGB)
        # The rest of it pivots up about the hips as it rears.
        cr.save()
        cr.translate(*hip)
        cr.rotate(-1.2 * stand)
        lift = 38 - 6 * charge
        drop = 0 if stand else 6 * charge
        fore = [((44, -2 + drop), (44 + step * reach + 12 * charge,
                                   lift)),
                ((40, 0 + drop), (40 - step * reach + 6 * charge, lift))]
        a, b = fore[0]
        limb(a, b, 13, BEAR_DARK_RGB)
        blob(26, -4 + drop, 42 + 4 * charge, 21 - 3 * charge, BEAR_RGB)
        blob(38, -16 + drop, 18, 15, BEAR_RGB)
        cr.set_source_rgba(*BEAR_HI_RGB, 0.6)
        cr.set_line_width(4)
        cr.arc(36, -12 + drop, 17, math.pi * 1.1, math.pi * 1.7)
        cr.stroke()
        # The head, held level as it rears, lowered to the ground or the
        # water when it feeds.
        cr.save()
        cr.translate(62 - 4 * head, -10 + drop + 24 * head)
        cr.rotate(1.0 * stand + 0.9 * head - 0.15 * charge)
        blob(0, 0, 14, 12, BEAR_RGB)
        blob(-5, -11, 4.5, 4.5, BEAR_DARK_RGB)
        blob(4, -12, 4.5, 4.5, BEAR_RGB)
        blob(13, 4, 10, 6.5, BEAR_MUZZLE_RGB)
        blob(22, 3, 3.2, 3, SEAM_RGB)
        blob(5, -3, 1.7, 1.7, (0.02, 0.02, 0.02))
        if stand > 0.5 or charge > 0.5:
            cr.set_source_rgb(*DEN_MOUTH_RGB)
            cr.move_to(10, 8)
            cr.line_to(22, 7)
            cr.line_to(14, 13)
            cr.close_path()
            cr.fill()
        if fish:
            blob(14, 9, 11, 3.5, FISH_RGB, 0.5)
            cr.set_source_rgb(*FISH_RGB)
            cr.move_to(21, 14)
            cr.line_to(27, 12)
            cr.line_to(25, 19)
            cr.close_path()
            cr.fill()
        cr.restore()
        # The near forepaw, swung up to strike.
        a, b = fore[1]
        ang = -1.9 * swipe
        b = (a[0] + (b[0] - a[0]) * math.cos(ang) - (b[1] - a[1])
             * math.sin(ang),
             a[1] + (b[0] - a[0]) * math.sin(ang) + (b[1] - a[1])
             * math.cos(ang))
        limb(a, b, 14, BEAR_RGB)
        cr.restore()
        cr.restore()

    @staticmethod
    def _den(cr, x, base, s, snow, breath=-1.0, facing=1):
        """A den dug under a bank: an earth mound with a dark mouth toward
        facing and stones about it; snow (0..1) lies on it, and breath is
        the phase of a sleeper's breath at the mouth, negative for none."""
        cr.save()
        cr.translate(x, base)
        cr.scale(facing, 1)
        cr.set_source_rgba(0, 0, 0, 0.25)
        cr.save()
        cr.scale(0.85 * s, 0.12 * s)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        cr.set_source_rgb(*DEN_RGB)
        cr.move_to(-0.8 * s, 0)
        cr.curve_to(-0.6 * s, -0.5 * s, 0.4 * s, -0.62 * s, 0.8 * s, 0)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*DEN_MOUTH_RGB)
        cr.move_to(0.05 * s, 0)
        cr.curve_to(0.08 * s, -0.36 * s, 0.5 * s, -0.36 * s, 0.52 * s, 0)
        cr.close_path()
        cr.fill()
        for k, (sx, sy, r) in enumerate(((-0.55, -0.06, 0.1),
                                         (-0.2, -0.36, 0.08),
                                         (0.6, -0.05, 0.09))):
            cr.set_source_rgb(*(STONE_RGB if k % 2 else STONE_DARK_RGB))
            cr.arc(sx * s, sy * s, r * s, 0, 2 * math.pi)
            cr.fill()
        cr.set_source_rgb(*TRUNK_RGB)
        cr.set_line_width(max(0.8, s * 0.03))
        cr.move_to(0.0, -0.3 * s)
        cr.curve_to(0.15 * s, -0.4 * s, 0.25 * s, -0.36 * s, 0.32 * s,
                    -0.3 * s)
        cr.stroke()
        if snow > 0:
            cr.set_source_rgba(*SNOW_RGB, min(1.0, snow * 1.5))
            cr.move_to(-0.72 * s, -0.1 * s)
            cr.curve_to(-0.55 * s, -0.5 * s, 0.35 * s, -0.6 * s,
                        0.72 * s, -0.08 * s)
            cr.curve_to(0.4 * s, -(0.5 - 0.12 * snow) * s,
                        -0.4 * s, -(0.45 - 0.14 * snow) * s, -0.72 * s,
                        -0.1 * s)
            cr.fill()
        if breath >= 0:
            for j in range(2):
                u = (breath * 0.3 + j * 0.5) % 1.0
                cr.set_source_rgba(*SMOKE_RGB, 0.45 * (1 - u))
                cr.arc((0.3 + 0.15 * u) * s, -(0.25 + 0.35 * u) * s,
                       (0.05 + 0.08 * u) * s, 0, 2 * math.pi)
                cr.fill()
        cr.restore()

    @staticmethod
    def _hide(cr, x, y, s):
        """A bear's hide laced to a willow frame to dry, leaning on its
        poles, about s tall."""
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgba(0, 0, 0, 0.25)
        cr.save()
        cr.translate(x, y)
        cr.scale(0.4 * s, 0.08 * s)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        top, bot = y - 1.0 * s, y - 0.12 * s
        cr.set_source_rgb(*RIFLE_WOOD_RGB)
        cr.set_line_width(max(1.0, s * 0.04))
        for dx in (-0.32, 0.32):
            cr.move_to(x + dx * s, y)
            cr.line_to(x + dx * 0.85 * s, top - 0.06 * s)
        cr.move_to(x - 0.36 * s, top + 0.02 * s)
        cr.line_to(x + 0.36 * s, top + 0.02 * s)
        cr.move_to(x - 0.34 * s, bot)
        cr.line_to(x + 0.34 * s, bot)
        cr.stroke()
        cy, h = (top + bot) / 2, bot - top
        cr.set_source_rgb(*BEAR_HIDE_RGB)
        for dx, dy in ((-1, -1), (1, -1), (-1, 1), (1, 1)):
            cr.save()
            cr.translate(x + dx * 0.19 * s, cy + dy * 0.3 * h)
            cr.rotate(dx * dy * 0.6)
            cr.scale(0.1 * s, 0.06 * s)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()
        cr.save()
        cr.translate(x, cy)
        cr.scale(0.17 * s, 0.4 * h)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        cr.arc(x, top + 0.1 * h, 0.08 * s, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(*BEAR_DARK_RGB)
        cr.set_line_width(max(0.6, s * 0.015))
        cr.move_to(x, cy - 0.3 * h)
        cr.line_to(x, cy + 0.3 * h)
        cr.stroke()
        cr.set_source_rgb(*CORD_RGB)
        for dx, dy in ((-0.3, -0.42), (0.3, -0.42), (-0.3, 0.42),
                       (0.3, 0.42), (-0.32, 0.0), (0.32, 0.0)):
            cr.move_to(x + dx * s, cy + dy * h)
            cr.line_to(x + dx * 0.6 * s, cy + dy * 0.75 * h)
        cr.stroke()

    def _draw_site(self, cr, args):
        """A trap at the water's edge: its stake in the bank, the chain
        running into the water and a float stick marking the jaws; once it
        has caught, the beaver thrashing on it."""
        f, k, st = args
        world = self.world
        site = world.sites[f][k]
        state = site["state"]
        here = ["site", f, k]
        working = next((tr for tr in world.trappers + world.predators
                        if tr["to"] == here and world.time >= tr["t1"]
                        and tr["job"] in ("set", "collect", "steal")),
                       None)
        u = 1.0
        if state == "empty":
            if working is None or working["job"] != "set":
                return
            u = min(1.0, (world.time - working["t1"])
                    / max(1e-9, working["t2"] - working["t1"]))
        s = self.wild["s"]
        x, side = st["x"], st["bank"]
        edge = self._river_edge(x, side)
        rh = self._river_half(x)
        if state == "caught":
            busy = working is not None
            fight = 0.0 if busy else math.sin(self.phase * 12 + x) * 0.35
            bx = x + st["face"] * 0.25 * s
            by = edge - side * rh * 0.25 + (0.12 * s if side > 0 else 0)
            if not busy:
                e = (self.phase + x * 0.1) % 0.8
                self._splash(cr, bx, by - 0.05 * s, s * 0.45, e * 1.6 / 0.8)
            self._beaver(cr, bx, by, s * 0.6, -st["face"], thrash=fight)
        stake = (x, edge + side * self.wild["mud"] * 0.5)
        jaws = (x + st["face"] * 0.28 * s, edge - side * rh * 0.3)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgb(*RIFLE_WOOD_RGB)
        cr.set_line_width(max(1.0, s * 0.06))
        # While he sets it, the stake goes in a blow at a time, and the
        # jaws go out on their chain once it holds.
        cr.move_to(*stake)
        cr.line_to(stake[0] - st["face"] * 0.08 * s,
                   stake[1] - 0.32 * s * (1.6 - 0.6 * math.floor(u * 4) / 4))
        cr.stroke()
        if u < 0.6:
            return
        cr.set_source_rgb(*IRON_RGB)
        for j in range(1, 5):
            v = j / 5
            sag = math.sin(v * math.pi) * 0.04 * s
            cr.arc(stake[0] + (jaws[0] - stake[0]) * v,
                   stake[1] + (jaws[1] - stake[1]) * v + sag,
                   max(0.5, s * 0.025), 0, 2 * math.pi)
            cr.fill()
        if state != "caught":
            bob = math.sin(self.phase * 2.3 + x) * 0.02 * s
            fx, fy = jaws[0], jaws[1] - 0.06 * s + bob
            cr.set_source_rgb(*TRUNK_RGB)
            cr.set_line_width(max(1.0, s * 0.045))
            cr.move_to(fx - 0.12 * s, fy + 0.02 * s)
            cr.line_to(fx + 0.12 * s, fy - 0.03 * s)
            cr.stroke()
            cr.set_source_rgba(*WATER_HI_RGB, 0.5)
            cr.set_line_width(0.8)
            cr.save()
            cr.translate(fx, fy + 0.02 * s)
            cr.scale(1.0, 0.3)
            cr.arc(0, 0, 0.2 * s, 0, 2 * math.pi)
            cr.restore()
            cr.stroke()

    def _draw_cabin(self, cr, args):
        """A cabin as far as it is built, smoke from its chimney while its
        owner sits by the hearth inside."""
        pl, plot, owner = args
        world = self.world
        inside = owner is not None and owner["job"] == "shelter" \
            and world.time >= owner["t1"]
        x, base = pl["cabin"]
        self._cabin(cr, x, base, self.wild["s"], plot["logs"],
                    world.CABIN_LOGS, self.phase if inside else -1.0,
                    self.look["winter"])

    def _draw_cache(self, cr, args):
        pl, owner = args
        x, y = pl["cache"]
        pelts = owner["pelts"]
        bales = min(self.BALE_MAX, pelts // self.PELT_BALE)
        loose = pelts - bales * self.PELT_BALE
        self._cache(cr, x, y, self.wild["s"] * 0.8,
                    min(loose, self.PELT_BALE * 2), bales)

    def _draw_woodpile(self, cr, args):
        """His logs in hand, stacked by the cabin."""
        pl, owner = args
        n = min(owner["logs"], 10)
        if n <= 0:
            return
        x, y = pl["pile"]
        s = self.wild["s"]
        r = s * 0.07
        k = 0
        row = 0
        while k < n:
            across = max(1, 4 - row)
            for j in range(across):
                if k >= n:
                    break
                cx = x + (j - (across - 1) / 2) * r * 2.1
                cy = y - r - row * r * 1.8
                cr.set_source_rgb(*WOOD_RGB)
                cr.arc(cx, cy, r, 0, 2 * math.pi)
                cr.fill()
                cr.set_source_rgb(*WOOD_HI_RGB)
                cr.arc(cx, cy, r * 0.55, 0, 2 * math.pi)
                cr.fill()
                k += 1
            row += 1

    def _draw_fire(self, cr, args):
        pl, owner = args
        x, y = pl["fire"]
        t = self.world.time
        e = (t - owner["t1"]) / max(1e-9, owner["t2"] - owner["t1"])
        self._campfire(cr, x, y, self.wild["s"], self.phase,
                       cooking=e < 0.8, lit=min(1.0, e * 6, (1 - e) * 4))

    def _draw_grave(self, cr, args):
        (x, y), g = args
        age = (self.world.time - g["t"]) / self.world.GRAVE_S
        self._grave(cr, x, y, self.wild["s"], age)

    @staticmethod
    def _cabin(cr, x, base, s, logs, total, smoke, snow):
        """A log cabin about 1.1s wide, raised a log at a time: courses of
        wall to total - 2, then the roof, then the stone chimney. smoke is
        the phase to draw chimney smoke at, or negative for none; snow
        (0..1) lies on the roof."""
        if logs <= 0:
            # The plot pegged out, waiting.
            cr.set_source_rgba(*PATH_RGB, 0.6)
            cr.save()
            cr.translate(x, base)
            cr.scale(0.6 * s, 0.12 * s)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()
            return
        walls = total - 2
        w, wall_h = 1.1 * s, 0.5 * s
        lh = wall_h / walls
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgba(0, 0, 0, 0.25)
        cr.save()
        cr.translate(x, base)
        cr.scale(0.62 * s, 0.1 * s)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        courses = min(logs, walls)
        for j in range(courses):
            y = base - (j + 1) * lh
            CpuView._rounded(cr, x - w / 2 - lh * 0.3, y, w + lh * 0.6, lh,
                             lh / 2)
            cr.set_source_rgb(*(WOOD_RGB if j % 2 else WOOD_HI_RGB))
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(0.6, lh * 0.12))
            cr.stroke()
        if courses >= 3:
            # The door, and a window once the walls are up.
            cr.set_source_rgb(*SEAM_RGB)
            dh = min(courses, 5) * lh
            cr.rectangle(x - w * 0.08, base - dh, w * 0.2, dh)
            cr.fill()
        if courses >= walls:
            lit = smoke >= 0
            cr.set_source_rgb(*(WINDOW_RGB if lit else SEAM_RGB))
            cr.rectangle(x + w * 0.22, base - wall_h * 0.72, w * 0.16,
                         wall_h * 0.28)
            cr.fill()
        top = base - courses * lh
        if logs >= total - 1:
            cr.move_to(x - w / 2 - s * 0.12, top)
            cr.line_to(x, top - s * 0.42)
            cr.line_to(x + w / 2 + s * 0.12, top)
            cr.close_path()
            cr.set_source_rgb(*ROOF_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(0.6, s * 0.02))
            cr.stroke()
            if snow > 0.01:
                cr.move_to(x - w / 2 - s * 0.12, top)
                cr.line_to(x, top - s * 0.42)
                cr.line_to(x + w / 2 + s * 0.12, top)
                cr.line_to(x + w / 2 + s * 0.02, top - s * 0.05)
                cr.line_to(x, top - s * 0.34)
                cr.line_to(x - w / 2 - s * 0.02, top - s * 0.05)
                cr.close_path()
                cr.set_source_rgba(*SNOW_RGB, 0.95 * snow)
                cr.fill()
        if logs >= total:
            cx, cw = x + w * 0.3, s * 0.13
            for j in range(4):
                cr.set_source_rgb(*(STONE_RGB if j % 2 else STONE_DARK_RGB))
                cr.rectangle(cx - cw / 2, top - s * 0.12 * (j + 2),
                             cw, s * 0.12)
                cr.fill()
            if smoke >= 0:
                cy = top - s * 0.5
                for j in range(4):
                    u = (smoke * 0.35 + j / 4) % 1.0
                    cr.set_source_rgba(*SMOKE_RGB, 0.55 * (1 - u))
                    cr.arc(cx + math.sin(u * 3 + j) * s * 0.08 + u * s * 0.2,
                           cy - u * s * 0.9, s * (0.06 + 0.12 * u), 0,
                           2 * math.pi)
                    cr.fill()

    @staticmethod
    def _campfire(cr, x, y, s, phase, cooking=True, lit=1.0):
        """A ring of stones, crossed sticks and flickering flames, with a
        haunch roasting on a spit over it when cooking; lit (0..1) is how
        well it is burning."""
        r = s * 0.22
        CpuView._glow(cr, x, y - r * 0.4, s * 0.9 * lit, FLASH_RGB,
                      0.35 * lit)
        for j in range(7):
            a = j / 7 * 2 * math.pi
            cr.set_source_rgb(*(STONE_RGB if j % 2 else STONE_DARK_RGB))
            cr.arc(x + math.cos(a) * r, y + math.sin(a) * r * 0.35,
                   r * 0.22, 0, 2 * math.pi)
            cr.fill()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgb(*TRUNK_RGB)
        cr.set_line_width(max(1.0, s * 0.05))
        for d in (-1, 1):
            cr.move_to(x - d * r * 0.7, y + r * 0.1)
            cr.line_to(x + d * r * 0.7, y - r * 0.25)
            cr.stroke()
        if lit > 0.02:
            for j in range(3):
                flick = 0.75 + 0.25 * math.sin(phase * 11 + j * 2.1)
                fh = s * 0.32 * lit * flick * (1 - 0.25 * abs(j - 1))
                fx = x + (j - 1) * r * 0.35
                cr.move_to(fx - r * 0.3, y - r * 0.1)
                cr.curve_to(fx - r * 0.3, y - fh * 0.5, fx, y - fh * 0.7,
                            fx + math.sin(phase * 7 + j) * r * 0.15,
                            y - fh)
                cr.curve_to(fx, y - fh * 0.6, fx + r * 0.3, y - fh * 0.4,
                            fx + r * 0.3, y - r * 0.1)
                cr.close_path()
                cr.set_source_rgba(*(FLASH_RGB if j == 1 else FORT_RGB),
                                   0.9)
                cr.fill()
        if cooking:
            # Forked sticks either side and the spit across.
            sy = y - s * 0.42
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.set_line_width(max(0.8, s * 0.03))
            for d in (-1, 1):
                cr.move_to(x + d * r * 1.3, y + r * 0.1)
                cr.line_to(x + d * r * 1.3, sy)
                cr.line_to(x + d * r * 1.45, sy - s * 0.06)
                cr.move_to(x + d * r * 1.3, sy)
                cr.line_to(x + d * r * 1.15, sy - s * 0.06)
            cr.move_to(x - r * 1.6, sy)
            cr.line_to(x + r * 1.6, sy)
            cr.stroke()
            cr.save()
            cr.translate(x, sy + s * 0.02)
            cr.rotate(phase * 1.5)
            cr.scale(s * 0.13, s * 0.08)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgb(*PELT_DARK_RGB)
            cr.fill()

    @staticmethod
    def _grave(cr, x, base, s, age):
        """A mound and a wooden cross where a trapper fell; age runs 0..1
        over the years it takes to lean, grey and fade away."""
        if age >= 1:
            return
        fade = 1 - age * age
        cr.set_source_rgba(*MUD_RGB, 0.8 * fade)
        cr.save()
        cr.translate(x, base)
        cr.scale(0.4 * s, 0.1 * s)
        cr.arc(0, 0, 1, math.pi, 2 * math.pi)
        cr.restore()
        cr.fill()
        cr.save()
        cr.translate(x, base - 0.05 * s)
        cr.rotate(0.35 * age)
        grey = (WOOD_RGB[0] + (STONE_RGB[0] - WOOD_RGB[0]) * age,
                WOOD_RGB[1] + (STONE_RGB[1] - WOOD_RGB[1]) * age,
                WOOD_RGB[2] + (STONE_RGB[2] - WOOD_RGB[2]) * age)
        cr.set_source_rgba(*grey, fade)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(max(1.0, s * 0.07))
        cr.move_to(0, 0)
        cr.line_to(0, -0.55 * s)
        cr.move_to(-0.17 * s, -0.4 * s)
        cr.line_to(0.17 * s, -0.4 * s)
        cr.stroke()
        cr.restore()

    @staticmethod
    def _cache(cr, x, y, s, pelts, bales):
        """A trapper's cache: a willow hoop with a pelt stretched to dry,
        a stack of loose pelts, and bales of them tied up beside it."""
        cr.set_source_rgba(0, 0, 0, 0.25)
        cr.save()
        cr.translate(x - 0.25 * s, y)
        cr.scale(0.9 * s, 0.14 * s)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        # The drying hoop leans on its stake behind the stack.
        hx, hy, r = x + 0.1 * s, y - 0.42 * s, 0.26 * s
        cr.set_source_rgb(*RIFLE_WOOD_RGB)
        cr.set_line_width(max(1.0, s * 0.04))
        cr.move_to(hx + 0.1 * s, y)
        cr.line_to(hx + 0.05 * s, hy - r * 1.1)
        cr.stroke()
        cr.set_source_rgb(*PELT_RGB)
        cr.arc(hx, hy, r * 0.85, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(*TRUNK_RGB)
        cr.arc(hx, hy, r, 0, 2 * math.pi)
        cr.stroke()
        cr.set_source_rgb(*PELT_DARK_RGB)
        cr.set_line_width(max(0.6, s * 0.015))
        for a in range(8):
            ang = a * math.pi / 4
            cr.move_to(hx + math.cos(ang) * r * 0.85,
                       hy + math.sin(ang) * r * 0.85)
            cr.line_to(hx + math.cos(ang) * r, hy + math.sin(ang) * r)
        cr.stroke()
        ph = 0.11 * s
        for k in range(pelts):
            off = (0.05 if k % 2 else -0.05) * s
            CpuView._rounded(cr, x - 0.3 * s + off, y - ph * (k + 1),
                             0.6 * s, ph, ph * 0.5)
            cr.set_source_rgb(*(PELT_RGB if k % 2 else BEAVER_RGB))
            cr.fill_preserve()
            cr.set_source_rgb(*PELT_DARK_RGB)
            cr.set_line_width(max(0.5, s * 0.02))
            cr.stroke()
        bw, bh = 0.5 * s, 0.34 * s
        spots = ((-0.95, 0), (-0.5, 0), (-0.72, 1))
        for k in range(bales):
            dx, row = spots[k]
            bx, by = x + dx * s - bw / 2, y - bh * (row + 1) + row * 0.04 * s
            CpuView._rounded(cr, bx, by, bw, bh, bh * 0.25)
            cr.set_source_rgb(*PELT_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*PELT_DARK_RGB)
            cr.set_line_width(max(0.5, s * 0.02))
            cr.stroke()
            cr.set_source_rgb(*CORD_RGB)
            cr.set_line_width(max(0.8, s * 0.035))
            for u in (0.3, 0.7):
                cr.move_to(bx + bw * u, by)
                cr.line_to(bx + bw * u, by + bh)
            cr.stroke()

    def _draw_tree(self, cr, tree):
        x, base, h, kind, i = tree
        sway = math.sin(self.phase * 0.9 + i * 1.3) * h * 0.03
        if kind == "pine":
            self._pine(cr, x, base, h, sway)
        elif kind == "round":
            self._round_tree(cr, x, base, h, sway, i)
        elif kind == "stump":
            self._stump(cr, x, base, h)
        else:
            self._bush(cr, x, base, h * 0.5)

    def _draw_wild_fords(self, cr):
        for f, fl in enumerate(self.wild["flanks"]):
            if fl["ford"]:
                self._draw_ford(cr, fl["ford"][0][0], self.wild["t"] * 0.22,
                                f)

    # -- the siege's landscape --------------------------------------------

    def _lay_scenery(self, key, width, height, t, die, fort_box):
        """Woods, stumps and boulders over the siege's open ground, once
        per size: kept off the trails (and anyone on them), the barracks,
        the chip, the fort and its sentries, and out of the river."""
        mud = self.river["half"] * 0.35 + 2
        overlaps = self._overlaps
        grow = [(fort_box, 0.2 * t), (die, 0.15 * t)] + [
            (box, 0.3 * t) for box in self.barracks_box]
        avoid = [(b[0] - m, b[1] - m, b[2] + m, b[3] + m)
                 for b, m in grow if b is not None]
        avoid += [(r["x"] - r["w"] * 0.7, r["base"] - r["h"] - 0.4 * t,
                   r["x"] + r["w"] * 0.7, r["base"] + 0.1 * t)
                  for r in self.rocks if r]
        avoid += [(r["x"] - r["w"] * 0.9, r["base"] - r["h"] - 0.5 * t,
                   r["x"] + r["w"] * 0.9, r["base"] + 0.2 * t)
                  for side in self.hrocks for r in side]
        path = []
        for pts in self.trails:
            for k in range(49):
                p = k / 48
                x, y = self._bezier(pts, p)
                size = self.redcoat_s * self._depth_scale(p)
                path.append((x, y, size))

        def clear(x, base, h, box):
            if any(overlaps(box, a) for a in avoid):
                return False
            # Neither hiding a man on the trail nor standing in his way.
            return not any(
                abs(x - px) < 0.32 * h + size * 0.75
                and base - h - size * 0.3 < py < base + size * 0.5
                for px, py, size in path)

        trees = self._scatter_trees(
            width, height, t, mud,
            ("pine", "round", "stump", "pine", "bush", "round"), clear)
        rocks = []
        for i in range(60):
            if len(rocks) >= 5:
                break
            x = (0.62 + i * 0.7548777) % 1.0 * width
            base = (0.41 + i * 0.5698403) % 1.0 * height * 0.94
            w = t * (0.25 + 0.15 * ((i * 0.618) % 1.0))
            box = (x - w * 0.6, base - w * 0.6, x + w * 0.6, base + 2)
            far = self._river_y(x) - self._river_half_max(x) - mud
            near = self._river_y(x) + self._river_half_max(x) + mud
            if (far < base < near + w * 0.6) or not clear(
                    x, base, w * 0.6, box) or any(
                    overlaps(box, (tx - 0.32 * h, tb - h, tx + 0.32 * h,
                                   tb + 0.1 * h))
                    for tx, tb, h, _, _ in trees):
                continue
            rocks.append((x, base, w, i))
        self.scenery = {"key": key, "trees": trees, "rocks": rocks}

    @staticmethod
    def _stump(cr, x, base, h):
        """A stump left where a log was cut for the stockade."""
        w = h * 0.55
        cr.set_source_rgb(*TRUNK_RGB)
        cr.move_to(x - w * 0.6, base)
        cr.line_to(x - w * 0.42, base - h * 0.7)
        cr.line_to(x + w * 0.42, base - h * 0.8)
        cr.line_to(x + w * 0.6, base)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*WOOD_HI_RGB)
        cr.save()
        cr.translate(x, base - h * 0.75)
        cr.rotate(-0.12)
        cr.scale(w * 0.42, h * 0.14)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()

    def _draw_scenery(self, cr):
        items = [(tree[1], self._draw_tree, tree)
                 for tree in self.scenery["trees"]]
        items += [(rock[1], self._draw_boulder, rock)
                  for rock in self.scenery["rocks"]]
        items.sort(key=lambda it: it[0])
        for _, draw, arg in items:
            draw(cr, arg)

    def _draw_boulder(self, cr, rock):
        x, base, w, i = rock
        self._rock(cr, x, base, w, w * 0.6, i)

    # -- the picture ------------------------------------------------------

    def _draw(self, _area, cr, width, height):
        self.fort_box = None
        if not self.cores:
            return
        self.look = self._season_look()
        fort = [c for c in self.cores
                if any(cpu in self.reserved for cpu in c["cpus"])]
        rest = [c for c in self.cores if c not in fort]
        gap = max(10.0, width * 0.025)
        label_h = max(16.0, height * 0.05)
        cols_f = max(1, min(self.COLS, len(fort)))
        rows_f = math.ceil(len(fort) / cols_f) if fort else 1
        cols_o = max(1, len(rest))

        # Every size is a multiple of a tile width, plus fixed gaps. Top to
        # bottom: the rest of the chip in one row of tiles t_o wide, 0.2t of
        # open ground, towers and sentries taking 1.6t above the fort's
        # wall, and the wall 0.3t a side. The fort's tiles t are sized on
        # their own, so a long row of the rest does not shrink the fort.
        # The outer fifth of the width each side is left to the trails.
        inner = width * 0.62
        t_o_max = (inner - (cols_o + 1.6) * gap) / cols_o if rest else 0.0
        die_h = 1.05 * t_o_max + label_h + 2.6 * gap if rest else 0.0
        a = 1.6 + 0.6 + 1.05 * rows_f + (0.2 if rest else 0)
        b = rows_f * label_h + (rows_f - 1) * gap + die_h + gap
        t = max(20.0, min((inner - (cols_f + 1) * gap) / (cols_f + 1.4),
                          (height - b) / a))
        t_o = max(12.0, min(t, t_o_max))
        die_h = 1.05 * t_o + label_h + 2.6 * gap if rest else 0.0
        tile_h = t * 1.05
        spare = max(0.0, height - (a * t + b - (
            1.05 * (t_o_max - t_o) if rest else 0)))
        # Most of any height to spare goes to open ground between the chip
        # and the fort, which lengthens the redcoats' march.
        ground = spare * 0.6 if rest else 0.0
        y = (spare - ground) / 2 + gap / 2

        fw = cols_f * t + (cols_f - 1) * gap
        ow = cols_o * t_o + (cols_o - 1) * gap
        # The yard is as wide as the land outside it, so the fort reads as
        # a fort and the wall has room for a man to walk.
        yw = max(fw, ow if rest else fw)
        fh = rows_f * (tile_h + label_h) + (rows_f - 1) * gap
        yx = (width - yw) / 2
        ox = (width - ow) / 2
        oy = y + 1.3 * gap
        fy = y + die_h + (0.2 * t + ground if rest else 0) + 1.6 * t + 0.3 * t

        # The river runs through the open ground between the chip, pins and
        # all, and the tops of the towers.
        self._draw_land(cr, width, height)
        chip_foot = oy + t_o * 1.05 + label_h + gap * 1.25 if rest else 0.0
        self._lay_river(width, chip_foot, fy - 0.9 * t, t)
        self._draw_river(cr)
        self._draw_works(cr)
        key = (width, height, len(fort), len(rest))
        pad = gap * 0.8
        die = (ox - pad, oy - pad * 1.55, ox + ow + pad,
               oy + t_o * 1.05 + label_h + pad * 1.55) if rest else None
        if not self.on:
            if self.wild is None or self.wild["key"] != key:
                grove = (yx - 0.3 * t, fy - 0.3 * t, yx + yw + 0.3 * t,
                         fy + fh + 0.3 * t + t * 0.1)
                self._lay_wilds(key, width, height, t, die, grove)
            self._draw_wild_fords(cr)

        self.trails = None
        self.fords = [None, None]
        self.barracks_box = [None, None]
        if self.on:
            # Each trail runs from a barracks in a top corner, clear of the
            # chip, down to the foot of the fort's side wall.
            self.redcoat_s = t * 0.9
            near = (yx - 0.3 * t - 0.32 * t, fy + fh + 0.3 * t)
            far = (width * 0.1, self.redcoat_s * 0.8 + 4)
            bend = min(ox - 0.8 * gap - 0.2 * t, width * 0.19)
            pts = (far, (bend, far[1] + (near[1] - far[1]) * 0.35),
                   (width * 0.04, far[1] + (near[1] - far[1]) * 0.7), near)
            self.trails = [pts, tuple((width - px, py) for px, py in pts)]
            self._draw_trails(cr)
            self._find_fords()
            self._lay_rocks()
            wall = 0.3 * t
            self.fort_geo = {"X": yx - wall, "Y": fy - wall, "W": yw + 2 * wall,
                             "H": fh + 2 * wall, "wall": wall, "t": t,
                             "floor": fy - wall - 0.5 * t}
            self._lay_hiding_rocks(key, width, height, t, die)
            self._draw_boats(cr)
            self._draw_fords(cr)
            for i in (0, 1):
                self._draw_barracks(cr, i)
            if self.scenery is None or self.scenery["key"] != key:
                # The fort's box as _draw_fort will make it.
                wall = 0.3 * t
                fort_box = (yx - wall * 1.84, fy - wall - 1.6 * t,
                            yx + yw + wall * 1.84, fy + fh + wall)
                self._lay_scenery(key, width, height, t, die, fort_box)
            self._draw_scenery(cr)
            self._draw_redcoats(cr)

        if rest:
            self._draw_die(cr, ox, oy, ow, t_o * 1.05 + label_h, gap)
            self._tiles(cr, rest, ox, oy, cols_o, t_o, t_o * 1.05, label_h,
                        gap, False)

        if self.on:
            towers, floor, walk, walk_y = self._draw_fort(cr, yx, fy, yw, fh,
                                                          t)
        else:
            self._draw_grove(cr, yx, fy, yw, fh, t)
        # Orange only while the fort holds them; down, they are like any other.
        self._tiles(cr, fort, yx + (yw - fw) / 2, fy, cols_f, t, tile_h,
                    label_h, gap, self.on)

        # Last, so a pacing sentry passes in front of the tower roofs.
        if self.on:
            self._draw_ladder(cr)
            self._draw_sentries(cr, towers, floor, walk, walk_y, t)
        else:
            self._draw_wilds(cr)
        self._draw_weather(cr, width, height, t)
        if not self.on and height >= 260 and width >= 420:
            self._draw_almanac(cr, height)

    def _almanac_text(self):
        """The season and year, the valley's tallies (beavers, trappers,
        pelts held, bears), and the season's fights in words, or ""."""
        w = self.world
        title = f"{w.SEASONS[w.season()].capitalize()}, year {w.year()}"
        tally = w.tally["bears"]
        lost = w.tally["deaths"].get("bear", 0)
        words = []
        for n, one, many in ((tally["fights"], "fight", "fights"),
                             (tally["slain"], "bear slain", "bears slain"),
                             (lost, "man lost", "men lost")):
            if n and (words or one == "fight"):
                words.append(f"{n} {one if n == 1 else many}")
        return title, (len(w.beavers), len(w.trappers),
                       sum(tr["pelts"] for tr in w.trappers),
                       w.stats()["bears"]), ", ".join(words)

    def _draw_almanac(self, cr, height):
        """A small caption in the bottom-left corner, below the pastures
        where the land fades out: the season, and a beaver, a cap, a pelt
        and a bear's head, each with its count; then the season's fights,
        if it has had any."""
        title, tallies, fights = self._almanac_text()
        size = max(9.0, min(13.0, height * 0.022))
        x, y = size * 0.8, height - size * 0.7
        x += self._text(cr, x, y, title, size, 0.7, align="left")
        x += size * 0.9
        icon = size * 0.8
        for k, n in enumerate(tallies):
            cy = y - size * 0.35
            if k == 3:
                cx = x + icon * 0.5
                for ex in (-0.32, 0.32):
                    cr.set_source_rgb(*BEAR_DARK_RGB)
                    cr.arc(cx + ex * icon, cy - icon * 0.28, icon * 0.16,
                           0, 2 * math.pi)
                    cr.fill()
                cr.set_source_rgb(*BEAR_RGB)
                cr.arc(cx, cy, icon * 0.4, 0, 2 * math.pi)
                cr.fill()
                cr.set_source_rgb(*BEAR_MUZZLE_RGB)
                cr.arc(cx, cy + icon * 0.12, icon * 0.17, 0, 2 * math.pi)
                cr.fill()
            elif k == 0:
                self._beaver(cr, x + icon * 0.5, y, icon * 1.3, 1)
            elif k == 1:
                cr.set_source_rgb(*FUR_RGB)
                cr.arc(x + icon * 0.5, cy + icon * 0.15, icon * 0.45,
                       math.pi, 2 * math.pi)
                cr.fill()
                cr.set_source_rgb(*STRIPE_RGB)
                cr.set_line_width(max(1.0, icon * 0.18))
                cr.move_to(x + icon * 0.1, cy + icon * 0.1)
                cr.line_to(x - icon * 0.1, cy + icon * 0.55)
                cr.stroke()
            else:
                self._rounded(cr, x, cy - icon * 0.3, icon, icon * 0.6,
                              icon * 0.2)
                cr.set_source_rgb(*PELT_RGB)
                cr.fill()
            x += icon * 1.3
            x += self._text(cr, x, y, str(n), size, 0.7, align="left")
            x += size * 0.8
        if fights:
            self._text(cr, x, y, fights, size, 0.7, align="left")

    def _draw_weather(self, cr, width, height, t):
        """Leaves drifting down in autumn, snow falling in winter, each
        flake or leaf on its own slow loop down the picture."""
        look = self.look
        area = width * height
        leaves = int(min(36, area / 9000) * look["autumn"])
        flakes = int(min(140, area / 2500) * look["winter"])
        tt = self.phase
        for i in range(leaves):
            fall = (0.13 + i * 0.5698403 + tt * (0.03 + 0.02 * (i % 3)))
            y = fall % 1.0 * (height + 20) - 10
            x = ((0.41 + i * 0.7548777) % 1.0 * width
                 + math.sin(tt * 1.3 + i) * t * 0.25) % width
            cr.save()
            cr.translate(x, y)
            cr.rotate(math.sin(tt * 2.1 + i * 1.7) * 1.2)
            cr.scale(max(1.5, t * 0.05), max(0.8, t * 0.025))
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgba(*AUTUMN_LEAF_HI_RGBS[i % 3],
                               0.9 * min(1.0, look["autumn"] * 2))
            cr.fill()
        cr.set_source_rgba(*SNOW_RGB, 0.85 * min(1.0, look["winter"] * 2))
        for i in range(flakes):
            fall = (0.29 + i * 0.5698403 + tt * (0.04 + 0.015 * (i % 4)))
            y = fall % 1.0 * (height + 10) - 5
            x = ((0.17 + i * 0.7548777) % 1.0 * width
                 + math.sin(tt * 0.8 + i * 2.3) * t * 0.15) % width
            cr.arc(x, y, max(0.8, t * (0.012 + 0.008 * (i % 3))), 0,
                   2 * math.pi)
            cr.fill()

    def _tiles(self, cr, cores, x0, y0, cols, t, tile_h, label_h, gap, mine):
        for i, core in enumerate(cores):
            col, row = i % cols, i // cols
            x = x0 + col * (t + gap)
            y = y0 + row * (tile_h + label_h + gap)
            self._draw_tile(cr, x, y, t, tile_h, core, mine)
            label = " · ".join(str(c) for c in core["cpus"])
            self._text(cr, x + t / 2, y + tile_h + label_h * 0.78,
                       label, max(9.0, label_h * 0.6),
                       0.85 if mine else 0.45, bold=mine)

    def _draw_die(self, cr, x, y, w, h, gap):
        """The package outline with pins, so the tiles read as one chip."""
        pad = gap * 0.8
        X, Y, W, H = x - pad, y - pad, w + 2 * pad, h + 2 * pad
        cr.set_line_width(2.0)
        cr.set_source_rgba(*DIM_RGB, 0.18)
        pin = pad * 0.55
        step = max(14.0, W / 24)
        px = X + step / 2
        while px < X + W:
            cr.move_to(px, Y)
            cr.line_to(px, Y - pin)
            cr.move_to(px, Y + H)
            cr.line_to(px, Y + H + pin)
            px += step
        cr.stroke()
        self._rounded(cr, X, Y, W, H, pad)
        grad = cairo.LinearGradient(X, Y, X + W, Y + H)
        grad.add_color_stop_rgba(0.0, 0.16, 0.17, 0.32, 0.92)
        grad.add_color_stop_rgba(1.0, 0.07, 0.09, 0.20, 0.92)
        cr.set_source(grad)
        cr.fill_preserve()
        cr.set_source_rgba(*DIM_RGB, 0.25)
        cr.set_line_width(1.4)
        cr.stroke()

    def _draw_tile(self, cr, x, y, w, h, core, mine):
        pulse = 0.5 + 0.5 * math.sin(self.phase * 2.2)
        live = mine and self.on
        rgb = FORT_RGB if mine else REST_RGB
        r = w * 0.16

        if live:
            self._glow(cr, x + w / 2, y + h / 2, w * (0.95 + 0.12 * pulse),
                       FORT_RGB, 0.30 + 0.12 * pulse)

        self._rounded(cr, x, y, w, h, r)
        cr.set_source_rgba(0.05, 0.06, 0.14, 0.92)
        cr.fill()

        # One bar per thread, filled from the bottom by its live load.
        cpus = core["cpus"]
        inner = w * 0.14
        bar_top = y + inner
        bar_h = y + h - inner - bar_top
        bar_gap = w * 0.08
        bar_w = (w - 2 * inner - bar_gap * (len(cpus) - 1)) / len(cpus)
        for j, cpu in enumerate(cpus):
            bx = x + inner + j * (bar_w + bar_gap)
            self._rounded(cr, bx, bar_top, bar_w, bar_h, bar_w * 0.25)
            cr.set_source_rgba(1, 1, 1, 0.06)
            cr.fill()
            load = self.shown.get(cpu, 0.0)
            fill = bar_h * load
            if fill < 1.0:
                continue
            self._rounded(cr, bx, bar_top + bar_h - fill, bar_w, fill,
                          min(bar_w * 0.25, fill / 2))
            grad = cairo.LinearGradient(0, bar_top + bar_h, 0, bar_top)
            if mine:
                grad.add_color_stop_rgba(0.0, *FORT_RGB, 0.95)
                grad.add_color_stop_rgba(1.0, *FORT_HOT_RGB, 0.95)
            else:
                grad.add_color_stop_rgba(0.0, *REST_RGB, 0.85)
                grad.add_color_stop_rgba(1.0, 0.55, 0.45, 1.0, 0.85)
            cr.set_source(grad)
            cr.fill()

        if live:
            self._sparks(cr, x, bar_top, w, bar_h, core["core"])

        # The frame. Its dash pattern, not its colour, is what says "fort".
        self._rounded(cr, x, y, w, h, r)
        if mine:
            cr.set_line_width(2.4 if live else 1.6)
            cr.set_dash([7.0, 5.0], -self.phase * 18.0 if live else 0.0)
            cr.set_source_rgba(*rgb, 0.95 if live else 0.55)
        else:
            cr.set_line_width(1.2)
            cr.set_dash([])
            cr.set_source_rgba(*DIM_RGB, 0.22)
        cr.stroke()
        cr.set_dash([])

    def _sparks(self, cr, x, top, w, h, seed):
        """Campfire embers rising through the reserved tile."""
        for k in range(4):
            t = (self.phase * 0.55 + k / 4 + seed * 0.37) % 1.0
            sx = x + w * (0.25 + 0.5 * ((k * 0.618 + seed * 0.29) % 1.0))
            sx += math.sin(t * 6.0 + k) * w * 0.04
            sy = top + h * (1.0 - t)
            edge = math.sin(t * math.pi)
            self._glow(cr, sx, sy, w * 0.07, FORT_HOT_RGB, 0.6 * edge)
            cr.set_source_rgba(1, 0.95, 0.85, 0.9 * edge)
            cr.arc(sx, sy, max(1.2, w * 0.012), 0, 2 * math.pi)
            cr.fill()


