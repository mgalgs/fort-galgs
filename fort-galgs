    assert gone[0] == gone[1] == 0 and gone[3] > 0 and gone[4] >= gone[3], gone
    for strength in (1.0, 0.8, 0.5, 0.2, 0.0):
        view.siege.wall = [strength, 1.0 - strength]
        view._draw(view, cr, 1024, 680)
    view.siege.wall = [1.0, 1.0]

    # THE CALM: with nothing in sight for QUIET_S, the two sentries come
    # down off their towers and sit round the pot with the walker, and
    # eat; it is the only time a sentry leaves his post. They are all
    # three there at once.
    siege = _calm_siege(3)
    siege.drill_start = [None, None]
    for m in siege.men:
        m["hunger"] = 0.6
    siege.run(Siege.QUIET_S - 1)
    assert all(m["mode"] != "pot" for m in siege.men), "not yet calm"
    assert _until(siege, lambda: all(siege.at_pot(i) for i in range(3)), 25)
    assert siege.tally["pot_together"] == 1
    xs = [siege.men[i]["x"] for i in range(3)]
