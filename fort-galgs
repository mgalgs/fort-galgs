    RAID_FAR = 0.8          # ...only with the owner at least this far off
    MEAT_GAIN = 0.06        # a meal
    LEAVE_E = 0.15          # energy below which, with nothing near, it goes
    WANDER_PULL = 0.02
    CHARGE_S = 5.0          # seconds to charge a unit of distance
    MAN_GAIN = 0.7          # a man, to a starving bear; less to a fed one
    EFFORT_S = 60.0         # the struggle it reckons a man will cost
    NEAR_D = 0.35           # men this close to a man are his company...
    COMPANY_K = 2.5         # ...each multiplying its dread by this more
    RISK_K = 1.5            # its dread of a man, at no hunger
    NOTICE_K = 0.22         # a man's chance a tick to see a bear coming,
    NOTICE_S = 10.0         # ...times exp(-seconds until it reaches him/this)
    VIGILANCE = (0.5, 0.6)  # his watch with nothing in him, and at work
    REACT_S = 1.5           # from seeing it to the rifle at his shoulder
    AIM_S = 5.0             # ...and from there to a fully aimed shot
    HIT_P = (0.3, 0.6)      # a shot's chance to hit unaimed, and full aim's
    SHOT_DMG = 0.55         # of a bear's health, fully aimed; 0.6 unaimed
    HELP_AIM = 0.4          # a helper's aim, arriving at a run
    HEAR_D = 1.2            # a shot carries this far; a struggle a third
    RUN_K = 0.6             # running, as a share of WALK_S
    EXCHANGE_S = 2.0        # between blows in the close fight
    CLAW_P, CLAW_DMG = 0.4, 0.2
    KNIFE_P, KNIFE_DMG = 0.5, 0.2
    FLEE_AT = 0.35          # health below which a bear breaks off...
    FLEE_HUNGER = 0.6       # ...lowered by this times its hunger
    EAT_S = 120.0
    CARCASS_S = 120.0
    BEAR_HEAL_K = 1 / 3000  # health won back a second with energy > 0.5
    HIDE_PELTS = 4
    BEAR_MEAT = 12
    HIDE_S = SEASON_S       # the hide hangs at his cabin this long
    ALERT_S = SEASON_S / 2  # a killing keeps his flank watchful this long
    ALERT_VIG = 1.6

    def __init__(self, seed=1):
        self.seed = seed
        self.rng = random.Random(seed)
        self.time = 0.0
        self.next_tick = self.TICK_S
        self.season_n = 0
        self.half_n = 0
        self.next_id = 1
        self.trees = self._slots()
        self.colonies = [{"dam": 0, "lodge": 0} for _ in (0, 1)]
        self.beavers = []
        for f in (0, 1):
            for _ in range(3):
                self._beaver(f, 0.7)
        self.empty_since = None
        self.sites = [[{"by": None, "state": "empty", "since": 0.0}
                       for _ in self.SITE_SPOTS] for _ in (0, 1)]
        self.plots = [[{"owner": None, "logs": 0} for _ in self.PLOT_U]
                      for _ in (0, 1)]
        self.trappers = []
        self.graves = []
        self.predators = []
        self.tally = self._fresh_tally()
        for f in (0, 1):
            self._trapper(f, 0, ["plot", f, 0])

    @classmethod
    def _slots(cls):
        """The fixed tree slots, the same in every world: each at (u, v)
        within its zone, u along the flank from its outer edge."""
        trees, j = [], 0
        for f in (0, 1):
            for zone, side, n in cls.SLOTS:
                for _ in range(n):
                    j += 1
                    u = (0.31 + j * 0.7548777) % 1.0
                    trees.append({
                        "f": f, "zone": zone, "side": side,
                        "u": u if f == 0 else 1 - u,
                        "v": (0.17 + j * 0.5698403) % 1.0,
                        "kind": "round" if zone == "bank" or j % 5 in (1, 3)
                        else "pine",
                        "size": (j * 0.618034) % 1.0,
                        "felled": None, "by": None, "pile": 0})
        return trees

    @staticmethod
    def _fresh_tally():
        return {"trapped": 0, "starved": 0, "kits": [0, 0], "deaths": {},
                "arrivals": 0, "pelts": 0, "rails": {"beavers": 0,
                                                     "trappers": 0},
                "bears": {"came": 0, "left": 0, "starved": 0, "slain": 0,
                          "fights": 0, "mauled": 0, "eaten": 0,
                          "robbed": 0},
                "events": []}

    def _trapper(self, f, k, at):
        tr = {"id": self.next_id, "f": f, "plot": k, "health": 1.0,
              "fed": 1.0, "pelts": 0, "meat": 0, "logs": 0, "job": "rest",
              "at": list(at), "to": ["plot", f, k], "t0": self.time,
              "t1": self.time, "t2": self.time, "site": None,
              "tree": None, "carry": None, "fuel": False, "hearth": 0.0,
              "effort": {},
              "effort_prev": {}, "winter": None, "fight": None,
              "alert": None, "hide": None}
        self.next_id += 1
        self.plots[f][k]["owner"] = tr["id"]
        self.trappers.append(tr)
        tr["t1"] = self.time + self.WALK_S * self.distance(at, tr["to"])
        tr["t2"] = tr["t1"] + 2.0
        return tr

    def _bear(self, f, at):
        b = {"id": self.next_id, "f": f, "energy": 0.6, "health": 1.0,
             "job": "wander", "at": list(at), "to": list(at),
             "t0": self.time, "t1": self.time, "t2": self.time,
             "target": None, "fight": None, "blow": None}
        self.next_id += 1
        self.predators.append(b)
        return b

    def _beaver(self, f, cond):
        b = {"id": self.next_id, "f": f, "cond": cond, "job": "lodge",
             "at": ["lodge", f], "to": ["lodge", f], "t0": self.time,
             "t1": self.time, "t2": self.time, "stick": False,
             "tree": None}
        self.next_id += 1
        self.beavers.append(b)
        return b

    # -- the clock --

    def season(self, t=None):
        """0 spring, 1 summer, 2 autumn, 3 winter."""
        return int((self.time if t is None else t) // self.SEASON_S) % 4

    def year(self):
        return int(self.time // self.YEAR_S) + 1

    def season_t(self):
        """How far into this season, 0..1."""
        return self.time % self.SEASON_S / self.SEASON_S

    def season_weights(self, t=None):
        """How much each season shows, summing to 1: one alone for most of
        a season, easing into the next over its last BLEND_S."""
        t = self.time if t is None else t
        s = self.season(t)
        u = min(1.0, max(0.0, (t % self.SEASON_S - self.SEASON_S
                               + self.BLEND_S) / self.BLEND_S))
        k = u * u * (3 - 2 * u)
        w = [0.0] * 4
        w[s] += 1 - k
        w[(s + 1) % 4] += k
        return w

    def cold(self):
        return self.season_weights()[3]

    def urgency(self):
        """How pressing shelter is, 0 in spring to 1 by winter."""
        s = self.season()
        return (0.0, self.URGENCY[0],
                self.URGENCY[1] + (1 - self.URGENCY[1]) * self.season_t(),
                1.0)[s]

    # -- places --

    def tree_state(self, i, t=None):
        """"tree", "stump" or "sapling"."""
        felled = self.trees[i]["felled"]
        if felled is None:
            return "tree"
        age = (self.time if t is None else t) - felled
        if age >= self.REGROW_S:
            return "tree"
        return "stump" if age < self.REGROW_S * self.STUMP_K else "sapling"

    def growth(self, i):
        """How grown a sapling is, 0..1."""
        felled = self.trees[i]["felled"]
        if felled is None:
            return 1.0
        k = self.STUMP_K
        return min(1.0, max(0.0, ((self.time - felled) / self.REGROW_S - k)
                            / (1 - k)))

    def _standing(self, i):
        tr = self.trees[i]
        if tr["felled"] is not None and \
                self.time - tr["felled"] >= self.REGROW_S:
            tr["felled"], tr["by"], tr["pile"] = None, None, 0
        return tr["felled"] is None

    def place_u(self, place):
        """Where a place lies across the picture, 0..1, and which side of
        the river (1 near, -1 far, 0 in it)."""
        kind = place[0]
        if kind == "tree":
            tr = self.trees[place[1]]
            return self._flank_u(tr["f"], tr["u"]), tr["side"]
        if kind == "dam":
            return self.DAM_U[place[1]], 0
        if kind == "lodge":
            return self.DAM_U[place[1]] - self.POND_LEN * 0.45, 0
        if kind == "swim":
            return place[2], 0
        if kind == "plot":
            return self._flank_u(place[1], self.PLOT_U[place[2]]), 1
        if kind == "site":
            side, u = self.SITE_SPOTS[place[2]]
            return self._flank_u(place[1], u), side
        if kind == "edge":
            return (0.0 if place[1] == 0 else 1.0), 1
        if kind == "den":
            u = self.DEN_U
            return self._flank_u(place[1], u if place[1] == 0 else 1 - u), 1
        return 0.5, 0

    @staticmethod
    def _flank_u(f, u):
        return 0.03 + 0.27 * u if f == 0 else 0.70 + 0.27 * u

    def distance(self, a, b):
        (ua, sa), (ub, sb) = self.place_u(a), self.place_u(b)
        return 3 * abs(ua - ub) + 0.3 * abs(sa - sb)

    def _send(self, a, to, job, work, speed):
        """Set actor a off to place to, to spend work seconds there at job
        once it arrives, speed seconds to the unit of distance."""
        a["at"] = a["to"]
        a["to"] = list(to)
        a["job"] = job
        a["t0"] = self.time
        a["t1"] = self.time + max(1.0, speed * self.distance(a["at"], to))
        a["t2"] = a["t1"] + work

    # -- the river's works --

    def dam_k(self, f):
        return min(1.0, self.colonies[f]["dam"] / self.DAM_STICKS)

    def lodge_k(self, f):
        return min(1.0, self.colonies[f]["lodge"] / self.LODGE_STICKS)

    def _sticks_wanted(self, f):
        c = self.colonies[f]
        want = self.DAM_STICKS - c["dam"]
        if c["dam"] >= self.DAM_STICKS / 2:
            want += self.LODGE_STICKS - c["lodge"]
        return want

    # -- stepping --

    def advance(self, dt):
        """Move the clock on dt seconds, deciding at every tick crossed."""
        end = self.time + max(0.0, dt)
        while self.next_tick <= end:
            self.time = self.next_tick
            self.next_tick += self.TICK_S
            self._tick()
        self.time = end

    run = advance

    def _tick(self):
        n = int(self.time // self.SEASON_S)
        if n != self.season_n:
            self.season_n = n
            self._season_turn()
        half = int(self.time // (self.SEASON_S / 2))
        if half != self.half_n:
            self.half_n = half
            if half % 8 == 1:
                self._births()
        self._advance_predators()
        self._advance_beavers()
        self._catches()
        self._advance_trappers()
        self._drifters()
        self._rails()
        if self.graves and self.time - self.graves[0]["t"] >= self.GRAVE_S:
            self.graves.pop(0)

    # -- bears --

    def _advance_predators(self):
        cold = self.cold()
        self._bear_arrivals(cold)
        tally = self.tally["bears"]
        for b in list(self.predators):
            job, arrived = b["job"], self.time >= b["t1"]
            if job == "dead":
                if self.time >= b["t2"]:
                    self.predators.remove(b)
                continue
            asleep = job == "den" and arrived
            b["energy"] -= (self.DEN_DRAIN if asleep else self.BEAR_DRAIN) \
                * self.TICK_S
            if b["energy"] <= 0:
                self._unhook(b)
                self.predators.remove(b)
                tally["starved"] += 1
                continue
            if b["energy"] > 0.5 and job != "fight":
                b["health"] = min(1.0, b["health"]
                                  + self.BEAR_HEAL_K * self.TICK_S)
            if job == "leave" and arrived:
                self.predators.remove(b)
                tally["left"] += 1
                continue
            if job == "stalk":
                self._stalk_tick(b, cold)
                continue
            if job == "fight":
                self._fight_tick(b, cold)
                continue
            if job == "eat" and arrived:
                tr = next((tr for tr in self.trappers if tr["to"] == b["to"]
                           and tr["fight"] is None
                           and self.time >= tr["t1"]), None)
                if tr is not None:
                    # He walks up on it over its kill: he sees it, and
                    # it does not let him go.
                    self._stalk(b, tr)
                    self._fight_start(b, tr, self.HELP_AIM)
                    continue
            if job == "hunt" and arrived and self.time < b["t2"]:
                self._bear_hunt(b)
            if cold >= 0.5 and job != "den" or asleep and cold < 0.5 \
                    or self.time >= b["t2"]:
                self._bear_done(b)
                self._bear_next(b, cold)

    def _offer(self, f):
        """What flank f holds for a bear, beyond the fish."""
        caught = sum(st["state"] == "caught" for st in self.sites[f])
        men = [tr for tr in self.trappers if tr["f"] == f]
        meat = sum(tr["meat"] for tr in men)
        return (sum(b["f"] == f for b in self.beavers) / self.BEAVER_REF
                + caught / 2 + meat / (4 * self.MEAT_PER_BEAVER)
                + 0.3 * len(men)) * (1 + self.FISH_K[self.season()])

    def _bear_arrivals(self, cold):
        if len(self.predators) >= self.BEARS_MAX or cold >= 0.5:
            return
        held = {b["f"] for b in self.predators}
        free = [f for f in (0, 1) if f not in held]
        if not free:
            return
        f = max(free, key=self._offer)
        p = self.BEAR_ARRIVE_K * self._offer(f) * self.TICK_S / self.SEASON_S
        if self.rng.random() < p:
            self._bear(f, ["edge", f])
            self.tally["bears"]["came"] += 1

    def _bear_hunt(self, b):
        """Waiting at the bank: a beaver may come within reach."""
        out = self._flank_beavers(b["f"])
        p = self.BEAR_CATCH_K * self.TICK_S * len(out) / self.BEAVER_REF
        if out and self.rng.random() < p:
            self.beavers.remove(min(out, key=lambda x: x["cond"]))
            self.tally["bears"]["eaten"] += 1
            self._feed(b, self.BEAVER_GAIN)
            b["t2"] = self.time

    def _feed(self, b, gain):
        b["energy"] = min(1.0, b["energy"] + gain)

    def _bear_done(self, b):
        job, to = b["job"], b["to"]
        if self.time < b["t2"]:
            return  # called away before it finished
        if job == "fish":
            self._feed(b, self.FISH_GAIN * self.FISH_K[self.season()])
        elif job == "steal":
            site = self.sites[to[1]][to[2]]
            if site["state"] == "caught":
                site.update(state="empty", by=None, since=self.time)
                self.tally["bears"]["eaten"] += 1
                self._feed(b, self.BEAVER_GAIN)
        elif job == "eat":
            self._feed(b, self.MAN_GAIN)
        elif job == "raid":
            owner = self._owner(to)
            if owner is not None and owner["meat"] > 0 \
                    and self._far(owner, to):
                take = min(owner["meat"], self.RAID_MEAT)
                owner["meat"] -= take
                self.tally["bears"]["robbed"] += 1
                self._feed(b, take * self.MEAT_GAIN)

    def _owner(self, plot):
        oid = self.plots[plot[1]][plot[2]]["owner"]
        return next((tr for tr in self.trappers if tr["id"] == oid), None)

    def _where(self, a):
        """The place an actor is at, or last left."""
        return a["to"] if self.time >= a["t1"] else a["at"]

    def _far(self, tr, place):
        return self.distance(self._where(tr), place) >= self.RAID_FAR

    def _man(self, mid):
        return next((tr for tr in self.trappers if tr["id"] == mid), None)

    def _company(self, f, place, but):
        """The other men of flank f about place."""
        return sum(tr["f"] == f and tr is not but
                   and self.distance(tr["to"], place) <= self.NEAR_D
                   for tr in self.trappers)

    def _vigilance(self, tr):
        """How watchful he is, 1 fed and idle."""
        none, busy = self.VIGILANCE
        v = none + (1 - none) * tr["fed"]
        if self.time >= tr["t1"] and tr["job"] not in ("rest", "fight"):
            v *= busy
        if self._alert(tr):
            v *= self.ALERT_VIG
        return v

    def _alert(self, tr):
        return tr["alert"] is not None and \
            self.time - tr["alert"] < self.ALERT_S

    def _sheltered(self, tr):
        plot = self.plots[tr["f"]][tr["plot"]]
        return tr["job"] == "shelter" and self.time >= tr["t1"] \
            and plot["logs"] >= self.CABIN_LOGS / 2

    def _stalk(self, b, tr):
        b["target"] = tr["id"]
        b["fight"] = {"target": tr["id"], "t0": self.time,
                      "company": self._company(b["f"], tr["to"], tr),
                      "wary": self._alert(tr),
                      "saw": None, "contact": None, "shot": None,
                      "hit": False, "help": 0, "next": None, "dmg": {},
                      "dead": []}
        self._send(b, tr["to"], "stalk", 0.0, self.CHARGE_S)

    def _stalk_tick(self, b, cold):
        """Closing on its man: he may see it coming."""
        tr = self._man(b["target"])
        if tr is None or cold >= 0.5 or tr["fight"] is None \
                and tr["to"] != b["to"]:
            self._call_off(b, cold)
            return
        contact = max(b["t1"], tr["t1"])
        if self.time >= contact:
            self._fight_start(b, tr)
            return
        if tr["fight"] is None:
            p = self.NOTICE_K * self._vigilance(tr) * math.exp(
                -(contact - self.time) / self.NOTICE_S)
            if self.rng.random() < p:
                b["fight"]["saw"] = self.time
                tr["fight"] = {"bear": b["id"], "saw": self.time,
                               "shot": None, "help": False}

    def _fighters(self, b):
        return [tr for tr in self.trappers if tr["fight"] is not None
                and tr["fight"]["bear"] == b["id"]]

    def _unhook(self, b):
        """Its men go back to what they were about, or, if they were
        fighting it, home."""
        for tr in self._fighters(b):
            tr["fight"] = None
            if tr["job"] == "fight":
                self._go(tr, ["plot", tr["f"], tr["plot"]], "rest",
                         self.rng.uniform(3.0, 8.0))
        b["target"], b["fight"] = None, None

    def _drop_errand(self, tr):
        """He leaves what he was about; a trap he meant to set is free."""
        if tr["job"] == "set" and tr["site"] is not None:
            st = self.sites[tr["f"]][tr["site"]]
            if st["by"] == tr["id"] and st["state"] == "empty":
                st["by"] = None
        tr["site"], tr["tree"], tr["fuel"] = None, None, False

    def _fight_start(self, b, tr, aim=None):
        """It reaches its man: his shot, if he has one, then the close
        fight."""
        fight = b["fight"]
        fight["contact"] = self.time
        fight["next"] = self.time + self.EXCHANGE_S
        b["job"] = "fight"
        if tr["fight"] is None:
            tr["fight"] = {"bear": b["id"], "saw": None, "shot": None,
                           "help": False}
        self._drop_errand(tr)
        tr["job"] = "fight"
        saw = tr["fight"]["saw"]
        if aim is None and saw is not None:
            aim = min(1.0, max(0.0, (self.time - saw - self.REACT_S)
                               / self.AIM_S))
        if aim is not None:
            fight["shot"] = self.time
            fight["hit"] = self._shoot(tr, b, aim)
        self._call_help(b)
        self._fight_over(b)

    def _shoot(self, tr, b, aim):
        tr["fight"]["shot"] = self.time
        if self.rng.random() >= self.HIT_P[0] + self.HIT_P[1] * aim:
            return False
        self._hurt_bear(b, tr, self.SHOT_DMG * (0.6 + 0.4 * aim)
                        * self.rng.uniform(0.7, 1.3))
        return True

    def _hurt_bear(self, b, tr, dmg):
        b["health"] -= dmg
        hurt = b["fight"]["dmg"]
        hurt[str(tr["id"])] = hurt.get(str(tr["id"]), 0.0) + dmg
        b["blow"] = {"t": self.time, "on": "bear", "id": b["id"]}

    def _call_help(self, b):
        """The men of its flank in earshot come running."""
        fight = b["fight"]
        hear = self.HEAR_D if fight["shot"] is not None else self.HEAR_D / 3
        for tr in self.trappers:
            if tr["f"] != b["f"] or tr["fight"] is not None or \
                    self.distance(self._where(tr), b["to"]) > hear:
                continue
            self._drop_errand(tr)
            tr["to"] = self._where(tr)
            tr["fight"] = {"bear": b["id"], "saw": None, "shot": None,
                           "help": True}
            self._send(tr, b["to"], "fight", 0.0, self.WALK_S * self.RUN_K)
            fight["help"] += 1

    def _fight_tick(self, b, cold):
        """An exchange of blows every EXCHANGE_S, helpers firing as they
        come up."""
        fight = b["fight"]
        if cold >= 0.5:
            self._fight_end(b, "fled")
            return
        men = self._fighters(b)
        here = [tr for tr in men if self.time >= tr["t1"]]
        for tr in here:
            if tr["fight"]["shot"] is None and tr["fight"]["help"]:
                self._shoot(tr, b, self.HELP_AIM)
                if self._fight_over(b):
                    return
        if self._fight_over(b):
            return
        self._call_help(b)
        if not here or self.time < fight["next"]:
            return
        fight["next"] = self.time + self.EXCHANGE_S
        tid = fight["target"]
        man = min(here, key=lambda tr: tr["id"] != tid)
        if self.rng.random() < self.CLAW_P * b["health"] * (
                0.6 + 0.4 * b["energy"]):
            man["health"] -= self.CLAW_DMG * self.rng.uniform(0.7, 1.3)
            b["blow"] = {"t": self.time, "on": "man", "id": man["id"]}
            if man["health"] <= 0:
                fight["dead"].append(man["id"])
                self.tally["bears"]["mauled"] += 1
                here.remove(man)
                self.die(man, "bear")
        for tr in here:
            if self.rng.random() < self.KNIFE_P * tr["health"] * (
                    0.5 + 0.5 * tr["fed"]):
                self._hurt_bear(b, tr, self.KNIFE_DMG
                                * self.rng.uniform(0.7, 1.3))
        self._fight_over(b)

    def _beaten(self, b):
        """Too hurt to fight on; the hungrier, the more it takes."""
        hunger = 1 - b["energy"]
        return b["health"] < self.FLEE_AT * (1 - self.FLEE_HUNGER * hunger)

    def _fight_over(self, b):
        """Ends the fight if the bear is dead or has had enough, or no
        man is left at it or coming."""
        if b["health"] <= 0:
            self._fight_end(b, "slain")
            return True
        if not self._fighters(b):
            self._fight_end(b, "over")
            return True
        if self._beaten(b):
            self._fight_end(b, "fled")
            return True
        return False

    def _fight_end(self, b, how):
        fight = b["fight"]
        if how == "slain":
            self._spoils(b)
        self.tally["events"].append({
            "kind": "fight", "bear": b["id"], "f": b["f"],
            "target": fight["target"], "company": fight["company"],
            "wary": fight["wary"],
            "saw": fight["saw"] is not None,
            "shot": fight["shot"] is not None, "hit": fight["hit"],
            "help": fight["help"], "won": not fight["dead"],
            "slain": how == "slain", "fled": how == "fled",
            "dead": len(fight["dead"]), "t0": fight["t0"], "t": self.time})
        tally = self.tally["bears"]
        tally["fights"] += 1
        tally["slain"] += how == "slain"
        self._unhook(b)
        if how == "slain":
            b.update(job="dead", t1=self.time, t2=self.time + self.CARCASS_S)
        elif how == "fled":
            self._send(b, ["den", b["f"]], "flee", 60.0, self.CHARGE_S)
        elif fight["dead"]:
            self._send(b, b["to"], "eat", self.EAT_S, self.BEAR_WALK_S)
        else:
            b["t2"] = self.time
            self._bear_next(b, self.cold())

    def _spoils(self, b):
        """The hide to whoever hurt it most, the meat shared out."""
        here = [tr for tr in self._fighters(b) if self.time >= tr["t1"]]
        if not here:
            return
        hurt = b["fight"]["dmg"]
        ids = list(hurt)
        victor = max(here, key=lambda tr: (
            hurt.get(str(tr["id"]), 0.0),
            -ids.index(str(tr["id"])) if str(tr["id"]) in ids else -99))
        victor["pelts"] += self.HIDE_PELTS
        victor["hide"] = self.time
        share = self.BEAR_MEAT // len(here)
        for tr in here:
            tr["meat"] += share
        victor["meat"] += self.BEAR_MEAT - share * len(here)

    def _call_off(self, b, cold):
        """It gives up on its man; he goes back to what he was about."""
        self._unhook(b)
        b["t2"] = self.time
        self._bear_next(b, cold)

    def _bear_next(self, b, cold):
        """It weighs what each errand would gain it a minute, and goes."""
        f = b["f"]
        jit = self.rng.uniform
        walk = self.BEAR_WALK_S
        if cold >= 0.5:
            self._send(b, ["den", f], "den", self.SEASON_S, walk)
            return
        if b["energy"] < self.LEAVE_E and self._offer(f) < self.WANDER_PULL:
            self._send(b, ["edge", f], "leave", 0.0, walk)
            return
        hunger = 1 - b["energy"]
        here = b["to"]

        def rate(gain, place, work, speed=walk):
            # A full belly is the cap: what it cannot eat is worth nothing.
            mins = (speed * self.distance(here, place) + work) / 60
            return min(gain, hunger) / max(mins, 1 / 60)

        options = []
        fish = self.FISH_GAIN * self.FISH_K[self.season()]
        for k, st in enumerate(self.sites[f]):
            place = ["site", f, k]
            if fish > 0:
                options.append((rate(fish, place, self.FISH_S), place,
                                "fish", self.FISH_S))
            if st["state"] == "caught":
                options.append((rate(self.BEAVER_GAIN, place, self.STEAL_S),
                                place, "steal", self.STEAL_S))
        out = len(self._flank_beavers(f))
        bank = next((i for i in self._bank_trees(f, b)
                     if self._standing(i)), None)
        if out and bank is not None:
            p = 1 - math.exp(-self.BEAR_CATCH_K * out / self.BEAVER_REF
                             * self.HUNT_S)
            place = ["tree", bank]
            options.append((rate(self.BEAVER_GAIN * p, place, self.HUNT_S),
                            place, "hunt", self.HUNT_S))
        for k, plot in enumerate(self.plots[f]):
            place = ["plot", f, k]
            owner = self._owner(place)
            if owner is not None and owner["meat"] > 0 \
                    and self._far(owner, place):
                take = min(owner["meat"], self.RAID_MEAT)
                options.append((rate(take * self.MEAT_GAIN, place,
                                     self.RAID_S),
                                place, "raid", self.RAID_S))
        for tr in [] if self._beaten(b) else self.trappers:
            if tr["f"] != f or tr["fight"] is not None \
                    or self._sheltered(tr):
                continue
            mins = (self.CHARGE_S * self.distance(here, tr["to"])
                    + self.EFFORT_S) / 60
            dread = self.RISK_K * (1 - hunger) ** 2 * (
                1 + self.COMPANY_K * self._company(f, tr["to"], tr))
            options.append((self.MAN_GAIN * (0.2 + hunger) / mins - dread,
                            tr, "stalk", 0.0))
        woods = [i for i, slot in enumerate(self.trees)
                 if slot["f"] == f and slot["zone"] == "woods"]
        options.append((self.WANDER_PULL, ["tree", self.rng.choice(woods)],
                        "wander", jit(20.0, 60.0)))
        _, place, job, work = max(options,
                                  key=lambda o: o[0] * jit(0.85, 1.15))
        if job == "stalk":
            self._stalk(b, place)
        else:
            self._send(b, place, job, work, walk)

    def _season_turn(self):
        self.tally = self._fresh_tally()
        season = self.season()
        if season == 0:
            for c in self.colonies:
                c["dam"] = max(0, c["dam"] - self.FLOOD_STICKS[0])
                c["lodge"] = max(0, c["lodge"] - self.FLOOD_STICKS[1])
        for row in self.plots:
            for plot in row:
                rot = (plot["owner"] is None) + (self.THAW_LOGS
                                                 if season == 0 else 0)
                plot["logs"] = max(0, plot["logs"] - rot)
        for tr in self.trappers:
            tr["effort_prev"], tr["effort"] = tr["effort"], {}
            win = tr["winter"]
            if season == 3:
                prev = tr["effort_prev"]
                busy = sum(prev.values())
                tr["winter"] = {
                    "start": tr["health"], "low": tr["health"],
                    "share": prev.get("trap", 0.0) / busy if busy else 0.0,
                    "ready": self.plots[tr["f"]][tr["plot"]]["logs"]
                    >= self.CABIN_LOGS}
            elif season == 0 and win is not None:
                self._winter_over(tr, win["start"] - win["low"])
                tr["winter"] = None
        if season == 0:
            self._arrivals()

    def _winter_over(self, tr, loss):
        win = tr["winter"]
        self.tally["events"].append(
            {"kind": "winter", "id": tr["id"], "share": win["share"],
             "ready": win["ready"], "loss": loss})

    # -- beavers --

    def _advance_beavers(self):
        cold = self.cold()
        dead = []
        for b in self.beavers:
            drain = self.COND_DRAIN * self.TICK_S
            if cold > 0:
                drain *= 1 + cold * (self.WINTER_DRAIN
                                     * (1.5 - self.dam_k(b["f"])) - 1)
            b["cond"] -= drain
            if b["cond"] <= 0:
                dead.append(b)
                continue
            if self.time >= b["t2"]:
                self._beaver_done(b)
                self._beaver_next(b, cold)
        for b in dead:
            self.beavers.remove(b)
            self.tally["starved"] += 1

    def _beaver_done(self, b):
        job, c = b["job"], self.colonies[b["f"]]
        tree = b["to"][1] if b["to"][0] == "tree" else None
        tr = self.trees[tree] if tree is not None else None
        if job == "cut" and self._standing(tree):
            tr.update(felled=self.time, by="beaver",
                      pile=self.STICKS_PER_TREE)
        elif job == "fetch" and tr["pile"] > 0:
            tr["pile"] -= 1
            b["stick"] = True
        elif job == "haul" and b["stick"]:
            b["stick"] = False
            if c["dam"] < self.DAM_STICKS:
                c["dam"] += 1
            elif c["lodge"] < self.LODGE_STICKS:
                c["lodge"] += 1
        elif job == "feed":
            if tr is None:
                gain = self.WEED_GAIN
            elif self._standing(tree):
                gain = self.FEED_GAIN
            else:
                gain = self.FEED_GAIN * 0.5 * self.growth(tree)
            b["cond"] = min(1.0, b["cond"] + gain)
        b["tree"] = None

    def _bank_trees(self, f, b):
        """Flank f's bank slots, nearest b's lodge first."""
        home = ["lodge", f]
        return sorted((i for i, tr in enumerate(self.trees)
                       if tr["f"] == f and tr["zone"] == "bank"),
                      key=lambda i: self.distance(home, ["tree", i]))

    def _beaver_next(self, b, cold):
        f = b["f"]
        jit = self.rng.uniform
        if b["stick"]:
            dest = "dam" if self.colonies[f]["dam"] < self.DAM_STICKS \
                else "lodge"
            self._send(b, [dest, f], "haul", self.HAUL_S, self.SWIM_S)
            return
        if cold > 0.5:
            self._send(b, ["lodge", f], "lodge", 30.0, self.SWIM_S)
            return
        taken = {o["tree"] for o in self.beavers if o is not b}
        trees = [i for i in self._bank_trees(f, b) if i not in taken]
        hunger = 1 - b["cond"]
        food = next((i for i in trees if self.tree_state(i) == "tree"),
                    None)
        if food is None:
            food = next((i for i in trees
                         if self.tree_state(i) == "sapling"), None)
        # Spring is for fattening up: the kits come from what is spare.
        fatten = self.SPRING_APPETITE * self.season_weights()[0] * hunger
        scores = {"feed": (2.0 * hunger * hunger + 0.05 + fatten)
                  * jit(0.85, 1.15),
                  "lodge": self.LODGE_REST * jit(0.85, 1.15),
                  "swim": 0.25 * jit(0.85, 1.15)}
        want = self._sticks_wanted(f)
        pile = next((i for i in self._bank_trees(f, b)
                     if self.trees[i]["pile"] > 0), None)
        fell = next((i for i in trees if self._standing(i)), None)
        if want > 0 and (pile is not None or fell is not None):
            scores["work"] = 0.9 * min(1.0, 0.4 + want / 4) * b["cond"] \
                * jit(0.85, 1.15)
        pick = max(scores, key=scores.get)
        if pick == "feed":
            if food is None:
                self._send(b, ["lodge", f], "feed", self.FEED_S,
                           self.SWIM_S)
            else:
                b["tree"] = food
                self._send(b, ["tree", food], "feed", self.FEED_S,
                           self.SWIM_S)
        elif pick == "work" and pile is not None:
            b["tree"] = pile
            self._send(b, ["tree", pile], "fetch", self.FETCH_S,
                       self.SWIM_S)
        elif pick == "work":
            b["tree"] = fell
            self._send(b, ["tree", fell], "cut", self.CUT_S, self.SWIM_S)
        elif pick == "swim":
            lo, hi = (0.04, 0.42) if f == 0 else (0.58, 0.96)
            self._send(b, ["swim", f, round(jit(lo, hi), 3)], "swim",
                       jit(4.0, 10.0), self.SWIM_S)
        else:
            self._send(b, ["lodge", f], "lodge", jit(15.0, 40.0),
                       self.SWIM_S)

    def _births(self):
        """Mid-spring: kits from each colony's surplus, as far as its
        lodge has room."""
        for f in (0, 1):
            mine = [b for b in self.beavers if b["f"] == f]
            room = int(self.LODGE_CAP * self.lodge_k(f)) - len(mine)
            surplus = sum(max(0.0, b["cond"] - 0.5) for b in mine)
            kits = max(0, min(room, int(surplus / self.KIT_COST + 1e-9),
                              self.BEAVER_MAX - len(self.beavers)))
            for _ in range(kits):
                mother = max(mine, key=lambda b: b["cond"])
                mother["cond"] -= self.KIT_COST
                self._beaver(f, self.KIT_COND)
            self.tally["kits"][f] += kits
            self.tally["events"].append(
                {"kind": "kits", "f": f, "n": kits,
                 "lodge": self.lodge_k(f)})
        for f in (0, 1):
            here = [b for b in self.beavers if b["f"] == f]
            there = [b for b in self.beavers if b["f"] != f]
            if not here and len(there) >= 4:
                # The young of a crowded colony strike out downriver.
                for b in sorted(there, key=lambda b: b["cond"])[:2]:
                    b["f"] = f
                    b["stick"], b["tree"] = False, None
                    self._send(b, ["lodge", f], "lodge", 10.0, self.SWIM_S)

    def _rails(self):
        if self.beavers:
            self.empty_since = None
            return
        if self.empty_since is None:
            self.empty_since = self.time
        elif self.time - self.empty_since >= self.RESTOCK_S:
            c = self.colonies
            f = 1 if c[1]["dam"] > c[0]["dam"] else 0
            for _ in range(2):
                self._beaver(f, 0.7)
            self.empty_since = None
            self.tally["rails"]["beavers"] += 1

    # -- trappers --

    def _flank_beavers(self, f):
        """f's beavers out of the lodge, where a trap can take them."""
        return [b for b in self.beavers if b["f"] == f
                and not (b["job"] == "lodge" and self.time >= b["t1"])]

    def _catches(self):
        ice = self.cold()
        if ice >= 1:
            return
        for f in (0, 1):
            for site in self.sites[f]:
                if site["state"] != "set" or \
                        self.time - site["since"] >= self.BAIT_S:
                    continue
                out = self._flank_beavers(f)
                p = self.CATCH_K * self.TICK_S * len(out) / self.BEAVER_REF
                if out and self.rng.random() < p * (1 - ice):
                    victim = min(out, key=lambda b: b["cond"])
                    self.beavers.remove(victim)
                    site["state"], site["since"] = "caught", self.time
                    self.tally["trapped"] += 1

    def _advance_trappers(self):
        cold = self.cold()
        dt = self.TICK_S
        dead = []
        for tr in self.trappers:
            tr["fed"] = max(0.0, tr["fed"] - self.FED_DRAIN * dt)
            arrived = self.time >= tr["t1"]
            shelter = 0.0
            if arrived and tr["job"] == "shelter":
                plot = self.plots[tr["f"]][tr["plot"]]
                shelter = min(1.0, plot["logs"] / self.CABIN_LOGS)
                if cold > 0 and tr["logs"] > 0:
                    tr["hearth"] += dt
                    if tr["hearth"] >= self.HEARTH_S:
                        tr["hearth"] -= self.HEARTH_S
                        tr["logs"] -= 1
                else:
                    shelter *= 1 - self.COLD_HEARTH
            elif arrived and tr["job"] == "fire":
                shelter = self.FIRE_WARMTH
            chill = self.COLD_K * cold * (1 - shelter) * dt
            starve = self.HUNGER_K * dt if tr["fed"] <= 0 else 0.0
            tr["health"] -= chill + starve
            if chill + starve == 0 and tr["fed"] > 0.3:
                tr["health"] = min(1.0, tr["health"] + self.HEAL_K * dt)
            if tr["winter"] is not None:
                tr["winter"]["low"] = min(tr["winter"]["low"],
                                          tr["health"])
            if tr["health"] <= 0:
                dead.append((tr, "hunger" if starve > chill else "cold"))
                continue
            if tr["fight"] is not None:
                continue  # the bear's turn decides what he does
            if self.time >= tr["t2"]:
                self._trapper_done(tr)
                self._trapper_next(tr, cold)
        for tr, cause in dead:
            self.die(tr, cause)

    def _trapper_done(self, tr):
        job = tr["job"]
        f = tr["f"]
        plot = self.plots[f][tr["plot"]]
        site = self.sites[f][tr["site"]] if tr["site"] is not None \
            else None
        if job == "set" and site is not None \
                and site["state"] != "caught":
            site["state"], site["since"] = "set", self.time
        elif job == "check" and site is not None \
                and site["state"] != "caught":
            # A stale trap is lifted, not rebaited: else whoever set the
            # sites first would hold them forever and the rest starve.
            site.update(state="empty", by=None, since=self.time)
        elif job == "collect" and site is not None:
            if site["state"] == "caught":
                tr["carry"] = "beaver"
            site.update(state="empty", by=None, since=self.time)
        elif job == "stash" and tr["carry"] == "beaver":
            tr["pelts"] += 1
            tr["meat"] += self.MEAT_PER_BEAVER
            self.tally["pelts"] += 1
        elif job == "chop" and self._standing(tr["tree"]):
            self.trees[tr["tree"]].update(felled=self.time, by="trapper",
                                          pile=0)
            tr["logs"] += self.LOGS_PER_TREE
        elif job == "build" and tr["logs"] > 0 \
                and plot["logs"] < self.CABIN_LOGS:
            tr["logs"] -= 1
            plot["logs"] += 1
        elif job == "fire" and tr["meat"] > 0:
            tr["meat"] -= 1
            tr["fed"] = 1.0
            if tr["fuel"]:
                tr["logs"] = max(0, tr["logs"] - 1)
        if job == "stash":
            tr["carry"] = None
        if job != "set":
            tr["site"] = None
        tr["tree"], tr["fuel"] = None, False

    def _chop_tree(self, tr):
        """The nearest standing tree on his flank nobody is bound for,
        woods before banks."""
        home = ["plot", tr["f"], tr["plot"]]
        taken = {o["tree"] for o in self.trappers + self.beavers
                 if o is not tr}
        best = None
        for i, slot in enumerate(self.trees):
            if slot["f"] != tr["f"] or i in taken or slot["felled"] \
                    is not None and not self._standing(i):
                continue
            key = (slot["zone"] != "woods",
                   self.distance(home, ["tree", i]))
            if best is None or key < best[0]:
                best = (key, i)
        return None if best is None else best[1]

    def _trapper_next(self, tr, cold):
        """He weighs his needs and does the most pressing thing."""
        f, k = tr["f"], tr["plot"]
        home = ["plot", f, k]
        plot = self.plots[f][k]
        jit = self.rng.uniform
        if tr["carry"] == "beaver":
            self._go(tr, home, "stash", self.STASH_S)
            return
        hunger = 1 - tr["fed"]
        ice = cold
        urgency = self.urgency()
        sites = self.sites[f]
        caught = [j for j, st in enumerate(sites)
                  if st["by"] == tr["id"] and st["state"] == "caught"]
        free = [j for j, st in enumerate(sites) if st["by"] is None]
        stale = [j for j, st in enumerate(sites) if st["by"] == tr["id"]
                 and st["state"] == "set"
                 and self.time - st["since"] >= self.BAIT_S]
        beavers = sum(b["f"] == f for b in self.beavers)
        trap = (self.TRAP_BASE + beavers / self.BEAVER_REF) * (1 - ice) \
            * (1 + 2 * hunger)
        scores = {"rest": self.REST_PULL}
        if caught:
            scores["collect"] = 1 + trap
        if free and ice < 0.9:
            scores["set"] = trap
        if stale and ice < 0.9:
            scores["check"] = trap * 1.1
        if tr["meat"] >= 1:
            scores["fire"] = 3 * hunger * hunger
        unbuilt = self.CABIN_LOGS - plot["logs"]
        need = unbuilt + self.WINTER_LOGS - tr["logs"]
        tree = None
        if need > 0:
            tree = self._chop_tree(tr)
            if tree is not None:
                scores["chop"] = min(1.0, need / 8) * (0.15 + urgency)
                if tr["meat"] >= 1 and tr["logs"] == 0:
                    scores["chop"] += 2 * hunger
        if tr["logs"] >= 1 and unbuilt > 0:
            scores["build"] = (0.15 + urgency) * 1.2
        if plot["logs"] >= self.CABIN_LOGS / 2:
            scores["shelter"] = 2 * cold * plot["logs"] / self.CABIN_LOGS
        for key in scores:
            scores[key] *= jit(0.85, 1.15)
        pick = max(scores, key=scores.get)
        if pick == "collect":
            tr["site"] = caught[0]
            self._go(tr, ["site", f, caught[0]], "collect", self.COLLECT_S)
        elif pick == "check":
            tr["site"] = stale[0]
            self._go(tr, ["site", f, stale[0]], "check", self.SET_S)
        elif pick == "set":
            j = self.rng.choice(free)
            sites[j]["by"] = tr["id"]
            tr["site"] = j
            self._go(tr, ["site", f, j], "set", self.SET_S)
        elif pick == "fire":
            tr["fuel"] = tr["logs"] > 0
            self._go(tr, home, "fire",
                     self.FIRE_S * (1 if tr["fuel"] else 2))
        elif pick == "chop":
            tr["tree"] = tree
            self._go(tr, ["tree", tree], "chop",
                     self.CHOP_S * self.LOGS_PER_TREE)
        elif pick == "build":
            self._go(tr, home, "build", self.BUILD_S)
        elif pick == "shelter":
            self._go(tr, home, "shelter", self.SHELTER_S)
        else:
            self._go(tr, self._idle_spot(tr), "rest", jit(3.0, 8.0))

    def _idle_spot(self, tr):
        """Home; or, watchful after a killing, the nearest neighbour's."""
        home = ["plot", tr["f"], tr["plot"]]
        if not self._alert(tr):
            return home
        near = [["plot", o["f"], o["plot"]] for o in self.trappers
                if o["f"] == tr["f"] and o is not tr]
        return min(near, key=lambda p: self.distance(home, p),
                   default=home)

    EFFORT = {"set": "trap", "check": "trap", "collect": "trap",
              "stash": "trap"}

    def _go(self, tr, to, job, work):
        self._send(tr, to, job, work, self.WALK_S)
        key = self.EFFORT.get(job, job)
        tr["effort"][key] = tr["effort"].get(key, 0.0) + tr["t2"] - \
            self.time

    def die(self, tr, cause):
        """He falls where he is; the nearest survivor takes his goods."""
        self.trappers.remove(tr)
        here = tr["to"] if self.time >= tr["t1"] else tr["at"]
        self.graves.append({"place": list(here), "t": self.time,
                            "id": tr["id"]})
        for st in self.sites[tr["f"]]:
            if st["by"] == tr["id"]:
                st.update(by=None, state="empty", since=self.time)
        self.plots[tr["f"]][tr["plot"]]["owner"] = None
        deaths = self.tally["deaths"]
        deaths[cause] = deaths.get(cause, 0) + 1
        if cause == "bear":
            for o in self.trappers:
                if o["f"] == tr["f"]:
                    o["alert"] = self.time
        if tr["winter"] is not None:
            self._winter_over(tr, 1.0)
        event = {"kind": "death", "id": tr["id"], "cause": cause,
                 "claimant": None, "moved": 0, "before": 0, "after": 0}
        self.tally["events"].append(event)
        heir = self._inherit(tr)
        if heir is not None:
            event.update(claimant=heir[0], moved=heir[1], before=heir[2],
                         after=heir[3])

    @staticmethod
    def stores(tr):
        return tr["pelts"] + tr["meat"] + tr["logs"]

    def _inherit(self, dead):
        if not self.trappers:
            return None
        heir = min(self.trappers, key=lambda o: (
            o["f"] != dead["f"], abs(self.PLOT_U[o["plot"]]
                                     - self.PLOT_U[dead["plot"]])
            if o["f"] == dead["f"] else 0, o["logs"] + o["meat"]))
        before = self.stores(heir)
        for key in ("pelts", "meat", "logs"):
            heir[key] += dead[key]
        theirs = self.plots[dead["f"]][dead["plot"]]
        mine = self.plots[heir["f"]][heir["plot"]]
        # One in a fight takes the goods but cannot stop to move house.
        if theirs["logs"] > mine["logs"] and heir["fight"] is None:
            mine["owner"] = None
            theirs["owner"] = heir["id"]
            moved = heir["f"] != dead["f"]
            heir["f"], heir["plot"] = dead["f"], dead["plot"]
            heir["site"] = None
            if moved:
                # No dry route crosses the grove: he drops his errand
                # and comes in from his new flank's edge, as newcomers do.
                heir["tree"], heir["fuel"] = None, False
                heir["to"] = ["edge", dead["f"]]
                self._go(heir, ["plot", dead["f"], dead["plot"]], "rest",
                         1.0)
            for row in self.sites:
                for st in row:
                    if st["by"] == heir["id"]:
                        st.update(by=None, state="empty", since=self.time)
        return heir["id"], self.stores(dead), before, self.stores(heir)

    def _free_plots(self):
        return [(f, k) for f in (0, 1) for k in range(len(self.PLOT_U))
                if self.plots[f][k]["owner"] is None]

    def _drifters(self):
        """Summer and autumn: now and then a lone newcomer, likelier the
        more plots stand free (as its square), the more beavers there
        are and the further winter is off."""
        if self.season() not in (1, 2) or self.cold() >= 0.5:
            return
        short = min(len(self._free_plots()),
                    self.TRAPPERS_MAX - len(self.trappers))
        if short <= 0:
            return
        p = self.DRIFT_K * short ** 2 * len(self.beavers) \
            / self.BEAVER_REF * (1 - self.urgency()) \
            * self.TICK_S / self.SEASON_S
        if p > 0 and self.rng.random() < p:
            self._arrivals(1)

    def _arrivals(self, n=None):
        """Newcomers into free plots: n of them, or in spring as many as
        the beavers draw."""
        free = self._free_plots()
        if n is None:
            x = self.ARRIVE_K * len(self.beavers) / self.BEAVER_REF
            n = int(x) + (self.rng.random() < x % 1)
            if not self.trappers and n == 0:
                n = 1
                self.tally["rails"]["trappers"] += 1
        n = min(n, len(free), self.TRAPPERS_MAX - len(self.trappers))
        for _ in range(n):
            per = [sum(tr["f"] == f for tr in self.trappers) for f in (0, 1)]
            f, k = max(free, key=lambda p: (self.plots[p[0]][p[1]]["logs"],
                                            -per[p[0]], -p[0]))
            free.remove((f, k))
            self._trapper(f, k, ["edge", f])
            self.tally["arrivals"] += 1

    # -- reading it --

    def stats(self):
        c = self.colonies
        return {
            "season": self.season(), "year": self.year(),
            "beavers": len(self.beavers),
            "dams": sum(x["dam"] >= self.DAM_STICKS for x in c),
            "dam_sticks": [x["dam"] for x in c],
            "lodges": sum(x["lodge"] >= self.LODGE_STICKS for x in c),
            "trees": sum(self.tree_state(i) == "tree"
                         for i in range(len(self.trees))),
            "trappers": len(self.trappers),
            "bears": sum(b["job"] != "dead" for b in self.predators),
            "cabins": sum(p["logs"] >= self.CABIN_LOGS
                          for row in self.plots for p in row),
            "pelts": sum(tr["pelts"] for tr in self.trappers),
            "effort": {tr["id"]: dict(tr["effort"])
                       for tr in self.trappers},
            "tally": json.loads(json.dumps(self.tally)),
        }

    # -- saving --

    STATE = ("seed", "time", "next_tick", "season_n", "half_n", "next_id",
             "trees", "colonies", "beavers", "empty_since", "sites",
             "plots", "trappers", "graves", "predators", "tally")

    def to_dict(self):
        d = {k: copy.deepcopy(getattr(self, k)) for k in self.STATE}
        v, state, gauss = self.rng.getstate()
        d.update(version=self.VERSION, rng=[v, list(state), gauss])
        return d

    @classmethod
    def from_dict(cls, d):
        """The world d describes; raises on anything not of this schema."""
        if not isinstance(d, dict) or d.get("version") != cls.VERSION:
            raise ValueError("not this world's schema")
        w = cls(d["seed"])
        for k in cls.STATE:
            setattr(w, k, copy.deepcopy(d[k]))
        if len(w.trees) != len(cls._slots()) or len(w.colonies) != 2:
            raise ValueError("not this valley")
        v, state, gauss = d["rng"]
        w.rng.setstate((v, tuple(state), gauss))
        w._check()
        return w

    GROWS = ("beavers", "trappers", "graves", "predators", "events")

    def _check(self):
        """Raise ValueError unless every field a fresh world has is here,
        of the same kind, and every place and index is one this valley
        has: the right version alone does not make a file sound."""
        fresh = World(0)
        grave = {"place": ["plot", 0, 0], "t": 0.0, "id": 0}
        protos = {"beavers": fresh.beavers[0], "trappers": fresh.trappers[0],
                  "graves": grave, "predators": fresh._bear(0, ["edge", 0])}

        def bad(why):
            raise ValueError("not this world's state: " + why)

        def num(v, lo=-math.inf, hi=math.inf):
            return isinstance(v, (int, float)) and not isinstance(v, bool) \
                and math.isfinite(v) and lo <= v <= hi

        def idx(v, n, none=True):
            return v is None and none or isinstance(v, int) and \
                not isinstance(v, bool) and 0 <= v < n

        def place(p):
            n = {"tree": (2, len(self.trees)), "dam": (2, 2),
                 "lodge": (2, 2), "swim": (3, 2), "plot": (3, 2),
                 "site": (3, 2), "edge": (2, 2), "den": (2, 2)}
            if not isinstance(p, list) or not p or p[0] not in n \
                    or len(p) != n[p[0]][0] or not idx(p[1], n[p[0]][1],
                                                       False):
                return False
            if p[0] == "swim":
                return num(p[2], 0, 1)
            if p[0] in ("plot", "site"):
                k = len(self.PLOT_U if p[0] == "plot" else self.SITE_SPOTS)
                return idx(p[2], k, False)
            return True

        def like(v, t, key=""):
            if key in ("at", "to", "place"):
                return place(v)
            if t is None or key in ("owner", "by", "felled", "site",
                                     "tree", "carry", "winter", "target",
                                     "fight", "blow", "alert", "hide"):
                # Each of these may be empty; the ones it matters for are
                # checked on their own below.
                return v is None or isinstance(v, (str, dict)) or num(v)
            if isinstance(t, bool):
                return isinstance(v, bool)
            if isinstance(t, (int, float)):
                return num(v)
            if isinstance(t, str):
                return isinstance(v, str)
            if isinstance(t, dict):
                return isinstance(v, dict) and all(
                    k in v and like(v[k], t[k], k) for k in t)
            if not isinstance(v, list):
                return False
            if key in self.GROWS:
                proto = protos.get(key)
                return proto is None or all(like(x, proto) for x in v)
            return len(v) == len(t) and all(
                like(x, y, key) for x, y in zip(v, t))

        for k in self.STATE:
            if not like(getattr(self, k), getattr(fresh, k), k):
                bad(k)
        if not (num(self.time, 0) and num(self.next_tick)
                and self.time < self.next_tick <= self.time + self.TICK_S):
            bad("clock")
        trees = len(self.trees)
        for a in self.beavers + self.trappers:
            if not (idx(a["f"], 2, False) and idx(a["tree"], trees)):
                bad("an actor's whereabouts")
        if any(b["job"] not in ("lodge", "feed", "cut", "haul", "fetch",
                                "swim") for b in self.beavers):
            bad("a beaver's job")
        fight = {"target": 0, "t0": 0.0, "company": 0, "wary": False,
                 "saw": None, "contact": None, "shot": None, "hit": False,
                 "help": 0, "next": None, "dmg": {}, "dead": []}
        for b in self.predators:
            f = b["fight"]
            if f is not None and not (
                    like(f, fight) and all(num(f[k]) for k in (
                        "saw", "contact", "shot", "next") if f[k] is not None)
                    and all(num(x) for x in f["dmg"].values())
                    and all(num(x) for x in f["dead"])):
                bad("a bear's fight")
            if not (idx(b["f"], 2, False) and num(b["energy"])
                    and num(b["health"])
                    and b["job"] in ("wander", "fish", "hunt", "steal",
                                     "raid", "stalk", "fight", "eat", "flee",
                                     "den", "leave", "dead")):
                bad("a bear")
        if any(st["state"] not in ("empty", "set", "caught")
               for row in self.sites for st in row):
            bad("a trap")
        for tr in self.trappers:
            win = tr["winter"]
            if not (tr["job"] in ("rest", "set", "check", "collect", "stash",
                                  "chop", "build", "fire", "shelter",
                                  "fight")
                    and all(num(x) for x in list(tr["effort"].values())
                            + list(tr["effort_prev"].values()))
                    and idx(tr["plot"], len(self.PLOT_U), False)
                    and idx(tr["site"], len(self.SITE_SPOTS))
                    and tr["carry"] in (None, "beaver", "log")
                    and all(tr[k] is None or num(tr[k])
                            for k in ("alert", "hide"))
                    and (tr["fight"] is None or like(tr["fight"], {
                        "bear": 0, "saw": None, "shot": None,
                        "help": False}))
                    and (win is None or like(win, {
                        "start": 0.0, "low": 0.0, "share": 0.0,
                        "ready": False}))):
                bad("a trapper")
        for slot in self.trees:
            if not (slot["felled"] is None or num(slot["felled"])):
                bad("a tree")


def world_path():
    """Where the valley is kept between runs."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "fort-galgs", "world.json")


def load_world(path):
    """The world saved at path, or a fresh one if there is none to be had:
    missing, unreadable, not JSON, of another schema, or one that will not
    run a season on. Never raises."""
    try:
        with open(path) as fh:
            d = json.load(fh)
        trial = World.from_dict(d)
        trial.run(World.SEASON_S)
        json.dumps(trial.stats())
        json.dumps(trial.to_dict())
        return World.from_dict(d)
    except Exception:  # anything wrong with the file means a fresh valley
        return World(random.randrange(2 ** 31))


def save_world(world, path):
    """Write the world to path whole or not at all."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(world.to_dict(), fh, separators=(",", ":"))
    os.replace(tmp, path)


# --------------------------------------------------------------------------
# The picture: the chip, with the fort's cores fenced off
# --------------------------------------------------------------------------

class Siege:
    """The redcoats' siege of the fort, apart from any picture of it.

    Redcoats set out from the barracks in the far corners and march down
    their trails, take cover behind a boulder when fired on, queue at the
    wall and beat on it; the two tower sentries pick whom to shoot, the
    walker's bugle calls one to fire, and a sentry with men at the foot of
    his wall calls for the fort's gun, whose ball takes them all. Nothing
    here draws, and nothing is in pixels: a redcoat's place on his trail is
    his distance d, or the screen fraction p that goes with it. Like World,
    it runs headless; CpuView advances it each frame and draws from it.

    The picture tells it a few facts that only its geometry can know:
    boulders[side] (a boulder stands beside that trail), has_walker (room
    on the wall for him to walk), and, as arguments, whether he is busy
    shooting at a boat. In return it takes men stepping ashore from a boat
    (land) and lets the view run the boats in the middle of a frame (the
    afloat hook of advance). Randomness is the seeded rng: a man's stride,
    the blast of the gun, a bear's blow, a bayonet's wound.

    A siege can go on past the wall. A redcoat who gets up on the wall walk
    (by the ladder, or through a breach) stands against the fort's gun; if
    he gets to it with the gun not ready, he takes it, and hacks at a tower
    roof, and through it drops into the yard to batter the cores, which is
    a picture and no more. It is the bears that stop him: see rouse_bears.
    In the calm the men sit round the stew pot; in desperate straits they
    pour it over the wall: see Siege.CALL_EVERY_S and DESP_AT.
    """

    MARCH_FAR = 6.0     # a new redcoat is this many times farther than...
    MARCH_NEAR = 1.0    # ...one at the near end of the trail
    MARCH_S = 26.0      # seconds to walk the whole trail
    ENGAGE_P = 0.5      # how far down the trail a sentry opens fire
    FALL_S = 1.6        # a shot redcoat topples and fades over this long
    FLEE_S = 3.5        # a riderless horse is off the picture within this
    DOOR_GAP = 0.3      # how far one must march before the next comes out
    DOOR_OPEN_S = 1.2   # the barracks door stands open this long for each
    CALLED_MAX = 16     # most a barracks will hold on call
    FILE = ("foot",) * 3
    WAVE = ("horse", "horse", "horse", "cannon")
    PACE = {"foot": 1.0, "horse": 2.6, "cannon": 0.45}
    HP = {"foot": 1, "horse": 1, "cannon": 5}
    WAVE_EVERY = (75.0, 105.0, 90.0)
    FLOOD_EVERY = 20.0  # an eager user's double click, every so often
    COVER_P = 0.64      # where on the trail a boulder offers cover
    HIDE_S = 9.5        # how long a man crouches behind it, at least...
    LULL_S = 5.0        # ...and until he has not been shot at for this long
    BREACH_WAIT_S = 4.0     # how long one waits at a gap before he tires
    AT_WALL = 2         # how many beat on the wall at once
    QUEUE_P = 0.08      # trail between each in the queue behind them

    # The call for relief, in seconds from the tower sentry's first note:
    # the walker hears it, runs to the gun, cranks it up and fires, then
    # runs back while the ball flies.
    HEARD_AT = 0.6
    RUN_S = 1.0
    WHEEL_AT = HEARD_AT + RUN_S
    WHEEL_S = 1.2
    CRANK_AT = WHEEL_AT + WHEEL_S
    FIRE_AT = CRANK_AT + 1.2
    FLIGHT_S = 1.4
    RELIEF_LEN = FIRE_AT + FLIGHT_S + 1.0
    GUN_POST = (0.2, 0.8)   # where on the wall walk he wheels it, per side
    BLAST_P = 0.85      # the blast takes queued redcoats this near the wall

    # What the redcoats at the foot of a side wall do to it, as a fraction
    # of its whole strength: a man on foot or a horseman per second as he
    # pounds, a cannon per ball (it fires every BOOM_EVERY seconds).
    HURT_PER_S = {"foot": 0.0015, "horse": 0.0025}
    HURT_PER_BALL = 0.013
    BOOM_EVERY = 4.0

    # Lulls, hunger and meals. A lull is QUIET_S seconds with no redcoat
    # beyond CLOSE_P of the trail, on either side. Hunger runs 0..1 for
    # each of the three men (the two tower sentries, 0 and 1, and the
    # walker, 2); it slows his drill and his work by up to HUNGER_SLOW.
    CLOSE_P = 0.5
    QUIET_S = 3.0
    MEAL_AFTER_S = 5.0  # the quiet must have held this long for a meal
    HUNGER_SLOW = 0.5
    HUNGER_S = 2400.0   # seconds on the wall to go from fed to starving...
    HEAVY_S = 220.0     # ...and doing heavy work
    MEAL_S = 80.0       # seconds to eat his fill from starving
    EAT_AT = 0.2        # hungry enough to sit down to a meal at this
    FED = 0.03          # and he gets up again of his own accord at this
    STARVING = 0.8      # too faint to go down and mend
    SIT_S = 0.9         # sitting down
    RISE_S = 1.1        # and getting up again, which is not instant
    PATROL_LEG_S = 9.0  # the walker takes this long from one tower to the next

    # Mending. Only the walker goes down, in a lull, for a wall weaker
    # than MEND_BELOW (the weakest first) and only while he is not
    # starving; with no walker, the sentry on that side does. A ladder
    # goes over the outside of the wall: lowered, climbed, used, climbed
    # again and hauled up, each of which takes real time at fed pace.
    MEND_BELOW = 0.96
    MEND_PER_S = 0.014  # of a wall's whole strength
    LOWER_S = 1.8
    HAUL_S = 1.8
    CLIMB_S = 2.2
    WALK_S = 5.0        # the walker takes this long to cross the wall walk
    LADDER_X = (0.03, 0.97)  # along the wall walk, the ladder at each wall
    WATCH_P = 0.3       # how far up the trail he can see redcoats come
    SAFE_S = 1.0        # he goes up when he has no more than this to spare
    START_S = 12.0      # he goes down only with this long before a redcoat
    CATCH_MARGIN = 0.5  # spare seconds he wants over the nearest redcoat
    MEND_FED = 0.3      # at his meal, with a wall to mend, he gets up at this
    HEAVY = ("lower", "descend", "mend", "ascend", "haul", "run", "hide",
             "home", "raise", "gun", "driven", "retake", "roof", "brawl",
             "carry")

    # Caught outside. Three hiding rocks stand in the woods outside each
    # side wall, 1 to 3 each farther from the fort, at ground distance g
    # from the foot of the wall (0). Redcoats on their trail are as far
    # from the foot as G_SPAN times the trail still ahead of them.
    G_SPAN = 3.0
    RUN_S = 1.2         # seconds to run one rock's distance, fed
    HOME_S = 1.4        # and to walk it
    RAISE_ALONE_S = 10.0
    HIDE_MIN_S = 6.0    # he stays behind a rock at least this long
    POT_EVERY = (None, 6.0, 20.0, None)  # seconds between his shots, by rock
    POT_HIT = (None, 0.5, 0.3, None)
    POT_RANGE = 1.25    # from his rock, in g, his rifle reaches
    DRIVE_RANGE = 1.0   # and a musket
    DRIVE_CHANCE = 0.25 # per second, that a redcoat in range goes after him
    DRIVERS_MAX = 2
    CLOSE_G = 0.25      # a redcoat this near his rock drives him back
    RUSH_P = 0.8        # per second, a redcoat close on his rock drives him off
    PIN_SHOTS = 4       # as do this many shots on his rock...
    PIN_WINDOW = 15.0   # ...in this many seconds
    VOLLEY_RATE = 1.5   # a redcoat's drill is this much quicker than a sentry's

    # The redcoats' use of the ladder, and the men's pushing it off. A
    # man at the foot of a wall with a ladder standing against it climbs
    # it, one at a time, slowly; a sentry on that side, or the walker if he
    # is on the wall walk, can put his rifle butt to its top and shove it
    # away, which takes longer than a shot. The ladder falls outward; whoever
    # is on it falls with it and dies. Two redcoats at the foot of a fallen
    # ladder raise it again, in RAISE_BY_S, if neither is shot.
    NOTICE_S = 1.5      # a man at the foot sees the ladder, and starts up
    CLIMB_UP_S = 7.0    # a redcoat's climb, from the ground to the top
    TOP_HOLD_S = 1.2    # at the top he is stopped this long, then shoved off
    SHOVE_AT = 2.6      # the shove lands this far into it...
    SHOVE_LEN = 3.6     # ...and he is done this far in
    LADDER_FALL_S = 1.2
    RAISE_BY_S = 6.0
    RUN_X_S = 4.0       # the walker runs the whole wall walk in this long

    # The wall top. A redcoat who gets up onto the wall walk, by the ladder
    # or through a gap, is a stormer, and keeps a place along the walk, x,
    # from 0 at the west tower to 1 at the east. Men on the walk turn the
    # fort's gun on him: the walker runs to it, wheels it to face them,
    # takes aim and fires along the walk, then reloads; whoever stands in
    # front of it within FIRE_RANGE may be taken. The stormers meanwhile
    # advance on the gun, and a man who reaches it, with the gun not ready
    # to fire, takes it.
    TOP_MAX = 3         # most stormers on one side's wall walk at once
    THROUGH_S = 2.0     # a redcoat at a gap goes through after this long...
    GAP_S = 4.0         # ...and no sooner than this after the last man did
    STORM_S = 20.0      # a stormer crosses the whole wall walk in this
    FIRE_RANGE = 0.3    # along the walk, how far in front of it the gun reaches
    AIM_S = 0.8         # from the walker sighting along the walk to the shot
    RELOAD_S = 12.0     # and he cannot fire again for this long: swab,
                        # powder, ball, ram; after a relief shot as well
    TURN_S = 1.0        # turning the gun round to the other way takes this
    BLAST_KILL = 0.9    # a man in the blast is taken with this chance
    STATION_DX = 0.035  # he stands this far behind the gun
    STAND_S = 2.0       # he keeps to his gun this long with nobody left
    TAKE_X = 0.04       # a stormer this near the gun lays hands on it
    SEIZE_S = 4.5       # a man at the gun takes this long to wrest it away
    RETAKE_S = 3.0      # to take back a gun, once the walk is his again

    # The tower roof. With the gun taken, the stormers go to the blockhouse
    # on their side and hack at its roof, its strength 1 down to 0, where
    # it is holed; its sentry gives way to the far tower while they do.
    # The walker mends a roof as he mends a wall, in a lull, walls first.
    ROOF_HACK_PER_S = 0.012     # of its strength, a man's axe and bayonet
    ROOF_MEND_PER_S = 0.014

    # The yard. Through a holed roof the stormers drop in, DROP_S apiece
    # to fall, and make for the core tiles nearest them, positions (u, v)
    # across and down the yard, 0..1, and batter them. That is a picture
    # and nothing more: a tile's dent runs 0 whole to 1 smashed, and
    # touches nothing real. Dents fade when the yard is clear in a lull.
    DROP_S = 1.2
    YARD_S = 14.0       # a stormer crosses the width of the yard in this
    BATTER_PER_S = 0.04
    DENT_FADE_PER_S = 0.02

    # The bears. They come at a run out of the woods, ground distance g
    # (BEAR_FAR_G, in rock distances) from the foot of a side wall, scale
    # its outside, and maul the redcoats on the wall walk, on the tower
    # roofs and in the yard, one at a time; the redcoats' bayonets wound
    # them, and a bear with WOUNDS of them withdraws. A bear is on one of
    # four layers: the ground, the wall's face, the walk, the yard; and
    # means to attack, to withdraw wounded, or to go home when nothing is
    # left to hunt. With the top clear they climb down, and on the ground
    # (in the woods' lane or the trail's, 0..1) hunt every redcoat about
    # the fort but those on the far half of a trail.
    BEAR_FAR_G = (3.2, 5.0)
    BEAR_RUN_G_S = 2.8  # rock distances a second, flat out
    BEAR_CLIMB_S = 1.2
    BEAR_WALK_S = 4.0   # to cross the whole wall walk
    BEAR_YARD_S = 5.0   # and the width of the yard
    BEAR_REACH = 0.06   # along the walk; in the yard, in u, twice this
    MAUL_S = 1.3        # one blow, from the rear to the recovery...
    MAUL_AT = 0.6       # ...landing this far in
    BEAR_KILL = 0.75    # that it takes the man it is at
    BAYONET_RATE = 0.25 # a redcoat in reach wounds a bear this often a second
    WOUNDS = (3, 5)     # a follower withdraws with this many, the mother
    WALKER_KILL = 0.2   # per second a man of the fort at a stormer in reach
    BEAR_REST_S = 0.5   # before the woods will send them again
    BEAR_REACH_G = 0.4  # on the ground, how near a man a bear must be to maul
    BEAR_LANE_S = 0.8   # to cross from the woods' lane to the trail's
    BEAR_WAIT_G = 1.5   # where they wait at the woods' edge, from the wall
    BEAR_WAIT_DG = 0.5  # and the room each leaves the next
    BEAR_CROSS_G = 5.0  # what a run round through the woods is worth
    DRIVER_BONUS_G = 1.5    # a man driving the walker is that much nearer
    MUSKET_RATE = 0.03  # per second, a musket on a charging bear hits
    MUSKET_G = 1.6      # from this far off
    BY_WALKER_G = 0.35  # she stands this far out from the walker in the woods
    GROUND_SEEN_S = 6.0 # redcoats about this long make a rousing a ground one
    BY_WALKER_S = 3.0   # the mother stops by the walker this long...
    BY_WALKER_DX = 0.2  # ...this far along the walk from him
    DRILL_LEN = 4.6     # from kneeling to the last of the smoke
    SHOT_AT = 2.0       # he fires this far into it

    BUGLE_LEN = 2.0     # from raising the bugle to lowering it
    BUGLE_HEARD = 1.2   # the tower sentry starts his drill this far in

    # The stew pot, hung over a small fire on the wall walk at POT_X along
    # it (the gun stands at 0.5, and is wheeled to 0.2 or 0.8). It holds
    # stew from 0 to 1 and is hot from 0 (cold) to 1 (at the boil). In THE
    # CALM, and only then, it fills over REFILL_S and comes to the boil over
    # BOIL_S; a man at it eats faster than from his pack, and draws it down
    # slowly; and the sentries come down off their towers, DOWN_S, to sit
    # round it with the walker, and go back, UP_S, when a redcoat is in sight.
    POT_X = 0.66
    POT_SEAT = (-0.095, 0.095, 0.0)     # the two sentries and the walker
    POT_MEAL_S = 30.0   # seconds to eat his fill from starving, at the pot
    POT_DRAW_S = 240.0  # seconds of one man eating that empty a full pot
    POT_MIN = 0.02      # least stew he will sit down to
    REFILL_S = 60.0
    BOIL_S = 40.0
    DOWN_S = 1.4
    UP_S = 1.4

    # Poured over the redcoats by a desperate sentry: a tower sentry whose
    # calls for the gun go unanswered DESP_AT times is desperate; he leaves
    # his tower and carries it from its fire to the wall top at CARRY_S for
    # the whole walk, tips it over, and the stew scalds whoever is on that
    # side's ladder or at the wall's foot. The pot then lies empty and
    # cold at the wall top until a lull, when it is carried back.
    CALL_EVERY_S = 4.0  # a sentry calls again this long after an unanswered one
    DESP_AT = 3.0       # unanswered calls it takes to make him resort to it
    DESP_MAX = 6.0      # and no more than this is stored up
    DESP_DRAIN_S = 6.0  # in a lull he loses one call's worth in this long
    DESP_RELIEVED = 0.5     # a relief shot on his side leaves this fraction
    GONE_S = 3.0        # nobody below this long, and a pour is called off
    HOLD_S = 30.0       # or, once he has the pot up, this long: he waits
    POT_REST_S = 20.0   # after a pour called off, not sent for again so soon
    POUR_MIN = 0.3      # the pot must hold at least this much to be poured
    CARRY_S = 5.0
    LIFT_S = 0.7
    SET_S = 0.7
    TIP_S = 2.2
    TIP_AT = 1.0

    def __init__(self, seed=1, steady=False):
        self.rng = random.Random(seed)    # its small chances; see vary()
        self.steady = steady              # no variation in the march
        self.phase = 0.0                  # its own clock, moved by tick()
        self.boulders = [True, True]      # one beside each trail, if laid
        self.has_walker = True            # room on the wall for him to walk
        self.drill_start = [None, None]   # phase each tower sentry knelt
        self.drill_target = [None, None]  # the redcoat he is aiming at
        self.drill_fired = [False, False]
        self.redcoats = []
        self.spawned = 0
        self.spawn_in = 1.0
        self.called = [[], []]            # kinds waiting at each barracks
        self.pending_call = None          # (side, phase, wait) of a lone click
        self.wave_in = 45.0 * self.vary(0.3)
        self.waves = 0
        self.flood = False                # an eager user at the barracks
        self.flood_in = 20.0
        self.floods = 0
        self.relief = None                # a tower's call for the gun
        self.gun_at = 0.5                 # along the wall walk, 0..1
        self.bugle_at = None              # phase the walker last sounded
        self.chipped = [None, None]       # phase a shot last struck each rock
        self.wall = [1.0, 1.0]            # each side wall's strength, 0..1
        self.roof = [1.0, 1.0]            # each tower roof's, likewise
        self.quiet_since = None           # phase the last redcoat left range
        self.trail_quiet_since = None     # the same, of those on the trails
        self.side_quiet_since = [None, None]  # and of each side alone
        self.calm_since = None            # phase nothing was in sight
        self.boats_in_sight = False       # the view's: redcoats afloat
        self.pot = {"x": self.POT_X, "stew": 1.0, "heat": 1.0,
                    "at": "fire", "task": None, "side": 0}
        self.desp = [0.0, 0.0]            # each sentry's desperation
        self.call_at = [-1e9, -1e9]       # phase each may call again
        self.horn_at = [-1e9, -1e9]       # phase each last blew, unanswered
        self.below_at = [-1e9, -1e9]      # phase someone was last below each
        self.pot_rest = -1e9              # phase it may be sent for again
        self.pot_all = False              # all three at it together
        self.men = [self._new_man("post"), self._new_man("post"),
                    self._new_man("patrol")]
        self.patrol_u = 0.0               # the walker's patrol, 0..2
        # The fort's one ladder: stowed on the wall walk ("up"), or leaning
        # on the outside of a wall ("standing", ext of its length hung
        # down, 0..1), or ("falling", "fallen") on the grass.
        self.ladder = {"side": 0, "state": "up", "ext": 0.0, "t0": 0.0,
                       "raised": 0.0}
        self.rock_chip = [[None] * 4 for _ in (0, 1)]  # phase each was hit
        self.stormers = []                # redcoats on the wall walk, or past
        self.gap_at = [-1e9, -1e9]        # phase a man last went through each gap
        self.tiles = [(u, v) for v in (0.3, 0.75) for u in (0.2, 0.5, 0.8)]
        self.dents = {}                   # tile -> how battered, 0..1
        self.valley_bears = 2             # as many as the view's world holds
        self.bears = []                   # bears on the field, mother first
        self.bear_rest = 0.0              # phase the woods may send them again
        self.bear_trigger = None          # phase this coming was roused
        self.bear_firsts = True           # a bear has reached the wall's top
        self.rousing = None               # the book of this coming
        # The fort's gun, for the fight on the wall walk: which way it
        # points (+1 east), from when it may fire, when the walker began to
        # sight along the walk, when it last fired, and whether it is taken.
        self.gun = {"facing": 1, "ready": 0.0, "aim": None, "fired": None,
                    "turned": None, "taken": False}
        self.tally = {"sent": {"foot": 0, "horse": 0, "cannon": 0},
                      "shot": 0, "reached": 0, "blasted": 0, "calls": 0,
                      "hurt": [0.0, 0.0], "mended": [0.0, 0.0],
                      "breaches": 0, "meals": 0, "eating_s": 0.0,
                      "repairs": 0, "repairs_done": 0, "caught": 0, "repairs_out": 0,
                      "out_s": 0.0, "retreats": 0, "driven": 0, "rc_shots": 0,
                      "climbs": 0, "pushes": 0, "raises": 0, "fell": 0,
                      "top": 0, "gun_kills": 0, "guns": 0,
                      "roof_hurt": [0.0, 0.0], "roof_mended": [0.0, 0.0],
                      "roof_holes": 0, "yard": 0, "batter_s": 0.0,
                      "bear_trips": 0, "bear_out": 0, "bear_wall": 0,
                      "bear_lag_s": 0.0, "bear_kills": 0,
                      "bear_withdrawn": 0, "walker_kills": 0,
                      "bear_inflight": 0, "bear_downs": 0, "bear_home": 0,
                      "bear_ground_kills": 0, "bear_musket": 0,
                      "bear_top_idle_max": 0.0, "rousings_over": 0,
                      "rousings_down": 0, "rousings_ground": 0,
                      "rousings_ground_killed": 0, "pot_meals": 0,
                      "pot_eating_s": 0.0, "pot_together": 0,
                      "pot_together_s": 0.0, "off_s": 0.0, "off_caught": 0,
                      "pour_trips": 0, "pours": 0, "scalded": 0,
                      "unanswered": 0, "reloads": 0, "desp_pours": 0}

    def vary(self, spread):
        """A factor near 1, up to spread either side of it: the siege's
        small chances, from its seeded random."""
        if self.steady:
            return 1.0
        return 1.0 + spread * (2.0 * self.rng.random() - 1.0)

    def _new_man(self, mode):
        """One of the fort's three men: his hunger, what he is at (mode),
        since when, and, at a meal, when he began to get up."""
        return {"hunger": 0.0, "mode": mode, "t0": self.phase, "up": None}

    @staticmethod
    def ramp(tau, a, b):
        u = min(1.0, max(0.0, (tau - a) / (b - a)))
        return u * u * (3 - 2 * u)

    @classmethod
    def trail_p(cls, d):
        """Screen position along the trail, 0 far to 1 near, for a redcoat
        at distance d. Size goes as 1/d, and so does the trail on screen,
        so a steady march seems to speed up as he comes closer."""
        far = 1 / cls.MARCH_FAR
        return (1 / d - far) / (1 / cls.MARCH_NEAR - far)

    @classmethod
    def trail_d(cls, p):
        """The distance at which a redcoat stands at screen position p."""
        far = 1 / cls.MARCH_FAR
        return 1 / (far + p * (1 / cls.MARCH_NEAR - far))

    # -- the clock and the calls ------------------------------------------

    def tick(self, dt):
        """Move the clock on dt seconds; advance() then runs the rules."""
        self.phase += dt

    def run(self, seconds, step=1 / 30):
        """Run the siege on this long, a frame at a time, with no picture."""
        for _ in range(int(seconds / step + 1e-9)):
            self.tick(step)
            self.advance(step)

    def call(self, side, kinds):
        q = self.called[side]
        q.extend(kinds[:max(0, self.CALLED_MAX - len(q))])

    def click_barracks(self, side, n, wait):
        """A click on a barracks: a double click calls a wave, a single one
        a file of foot, held until wait seconds have passed with no second
        click, so a double click does not also send the file."""
        if n >= 2:
            self.pending_call = None
            self.call(side, self.WAVE)
        else:
            self.pending_call = (side, self.phase, wait)

    def sound_bugle(self, side, walker_busy=False):
        """The walker sounds his bugle, and the tower sentry on side kneels
        and fires, at a redcoat if one is in sight. Not while he is
        sounding it, working the gun or (walker_busy) shooting at a boat."""
        if self.bugling() or self.relief is not None or walker_busy \
                or self.men[2]["mode"] != "patrol":
            return False
        self.bugle_at = self.phase
        if not self.busy(side) and self.men[side]["mode"] in ("post", "eat"):
            self.drill_start[side] = self.phase + self.BUGLE_HEARD
            self.drill_target[side] = None
            self.drill_fired[side] = False
        return True

    # -- the tower sentries -----------------------------------------------

    def drill_t(self, i):
        """Seconds into tower sentry i's drill; negative while he waits on
        the bugle, DRILL_LEN or more once he is done."""
        start = self.drill_start[i]
        return self.DRILL_LEN if start is None else self.phase - start

    def busy(self, i):
        return self.drill_t(i) < self.DRILL_LEN

    def drilling(self, i):
        return 0 <= self.drill_t(i) < self.DRILL_LEN

    def drill(self, i):
        """Tower sentry i kneels, takes aim and fires. Returns (kneel, aim,
        seconds since the shot or -1)."""
        return self.drill_pose(self.drill_t(i))

    @classmethod
    def drill_pose(cls, tau):
        """The same, tau seconds into a drill."""
        kneel = cls.ramp(tau, 0.0, 0.6) - cls.ramp(tau, 3.2, 3.8)
        aim = cls.ramp(tau, 0.4, 1.1) - cls.ramp(tau, 2.8, 3.4)
        shot = tau - cls.SHOT_AT if cls.SHOT_AT <= tau < cls.DRILL_LEN \
            else -1.0
        return kneel, aim, shot

    def bugle_t(self):
        if self.bugle_at is None:
            return self.BUGLE_LEN
        return self.phase - self.bugle_at

    def bugling(self):
        return self.bugle_t() < self.BUGLE_LEN

    # -- the ladder ---------------------------------------------------------

    def fort_at_ladder(self):
        """One of the fort's men is working the ladder, or is on it."""
        return any(m["mode"] in ("lower", "descend", "mend", "ascend",
                                 "haul", "raise") for m in self.men)

    def usable(self):
        """The ladder stands fully down against its wall with no one of
        the fort's at it: the redcoats' to climb, the sentries' to push."""
        lad = self.ladder
        return lad["state"] == "standing" and lad["ext"] >= 1.0 \
            and not self.fort_at_ladder()

    def climbers(self):
        """Redcoats alive on the ladder."""
        return [rc for rc in self.redcoats if rc["hit"] is None
                and rc.get("climb") is not None]

    def climb_u(self, rc):
        """How far up the ladder a redcoat is, 0..1."""
        end = self.phase if rc["hit"] is None else rc["hit"]
        return min(1.0, max(0.0, (end - rc["climb"]) / self.CLIMB_UP_S))

    def fall_u(self):
        """How far the ladder has fallen outward, 0..1."""
        lad = self.ladder
        if lad["state"] == "fallen":
            return 1.0 - self.ramp(lad["raised"], 0.0, 1.0)
        if lad["state"] == "falling":
            return min(1.0, (self.phase - lad["t0"]) / self.LADDER_FALL_S)
        return 0.0

    def top_of_ladder(self, rc):
        """THE TOP OF THE LADDER: a redcoat who has climbed all the way
        steps off it onto the wall walk, if there is room for him there,
        and is a stormer from then on. A sentry may still shove the ladder
        off under the men who come after him; one already on top stays."""
        if self._room_on_top(rc["side"]):
            self._step_onto(rc)

    def _room_on_top(self, side):
        """There is room for one more to step up onto side's wall walk: not
        crowded, and no bear on the wall for him to meet there."""
        return sum(1 for st in self.stormers if st["side"] == side
                   and st["hit"] is None) < self.TOP_MAX \
            and not self.bears_on("walk", "yard")

    def _step_onto(self, rc):
        """A redcoat steps up onto the wall walk at his side's end of it:
        out of the trail's men and into the stormers."""
        self.redcoats.remove(rc)
        for k in ("climb", "drive", "hid", "rock"):
            rc.pop(k, None)
        rc.update(kind="foot", mode="walk", at_wall=None, since=self.phase,
                  x=self.LADDER_X[rc["side"]],
                  stride=1.0 + 0.2 * (self.vary(1.0) - 1.0))
        self.stormers.append(rc)
        self.tally["top"] += 1

    def stormers_on(self, side=None, mode=None):
        """The stormers alive, on one side and in one place if asked."""
        return [st for st in self.stormers if st["hit"] is None
                and (side is None or st["side"] == side)
                and (mode is None or st["mode"] == mode)]

    def _advance_stormers(self, dt):
        """Redcoats on the wall walk advance on the fort's gun."""
        gx = self.gun_at
        gone = self.gun_gone()
        for st in self.stormers_on(mode="walk"):
            end = float(st["side"] == 1)
            stop = end if gone else gx + (-1 if st["side"] == 0 else 1) \
                * self.STATION_DX * 0.7
            step = dt * st["stride"] / self.STORM_S
            if any(abs(b["x"] - st["x"]) <= self.BEAR_REACH * 1.5
                   for b in self.bears_on("walk")):
                step = 0.0      # they have a bear to deal with
            st["x"] += max(-step, min(step, stop - st["x"]))
            if gone and abs(stop - st["x"]) < 1e-9:
                st.update(mode="hack", since=self.phase)
            elif not gone and abs(gx - st["x"]) <= self.TAKE_X:
                self._reach_gun(st)
        for side in (0, 1):
            hackers = self.stormers_on(side, "hack")
            for st in hackers:
                self.hurt_roof(side, self.ROOF_HACK_PER_S * dt)
            if self.holed(side):
                for k, st in enumerate(hackers):
                    if st.get("drop_at") is None:
                        st["drop_at"] = self.phase + 0.5 + k
                    if self.phase >= st["drop_at"]:
                        st.update(mode="drop", since=self.phase)
        self._advance_yard(dt)
        self.stormers = [st for st in self.stormers
                         if st["hit"] is None
                         or self.phase - st["hit"] < self.FALL_S]

    def _foot_men(self, side):
        return [rc for rc in self.redcoats if rc["side"] == side
                and rc["hit"] is None and rc["kind"] in ("foot", "horse")
                and self.at_wall(rc)]

    def _advance_ladder(self, dt):
        """Redcoats climb a standing ladder or raise a fallen one; a
        falling one lands."""
        lad = self.ladder
        side = lad["side"]
        if lad["state"] == "falling":
            if self.phase - lad["t0"] >= self.LADDER_FALL_S:
                lad.update(state="fallen", raised=0.0)
        elif lad["state"] == "fallen":
            alone = self.men[2]["mode"] == "raise" \
                or any(m["mode"] == "raise" for m in self.men)
            if not alone:
                if len(self._foot_men(side)) >= 2:
                    lad["raised"] = min(1.0, lad["raised"]
                                        + dt / self.RAISE_BY_S)
                else:
                    lad["raised"] = max(0.0, lad["raised"]
                                        - 2.0 * dt / self.RAISE_BY_S)
                if lad["raised"] >= 1.0:
                    lad.update(state="standing", ext=1.0, raised=0.0)
                    self.tally["raises"] += 1
        elif self.usable():
            on = self.climbers()
            if not on:
                for rc in self._foot_men(side):
                    if rc.get("climb") is None and not rc.get("drive") \
                            and self.phase - rc["at_wall"] >= self.NOTICE_S:
                        rc["climb"] = self.phase
                        self.tally["climbs"] += 1
                        break
        for rc in list(self.redcoats):
            if rc["hit"] is None and rc.get("climb") is not None \
                    and self.climb_u(rc) >= 1.0:
                self.top_of_ladder(rc)

    def _push_off(self):
        """The ladder goes over backward, outward into the grass, and
        takes whoever is on it."""
        lad = self.ladder
        lad.update(state="falling", t0=self.phase, raised=0.0)
        self.tally["pushes"] += 1
        for rc in self.climbers():
            rc.update(hit=self.phase, hp=0, fell=True)
            self.tally["fell"] += 1

    def shove_t(self, i):
        """Seconds into man i's shove at the ladder, or -1."""
        m = self.men[i]
        return (self.phase - m["t0"]) * self.pace(i) \
            if m["mode"] == "shove" else -1.0

    def _wants_shove(self, i):
        """Whether tower sentry i, with nothing at his rifle, would rather
        put his rifle butt to the ladder than shoot: a man climbing, or
        two at its foot, which is an assault; one alone he shoots."""
        lad = self.ladder
        if lad["side"] != i or not self.usable():
            return False
        return bool(self.climbers()) or len(self._foot_men(i)) >= 2

    def _advance_shoves(self, dt, walker_busy):
        """Men at the ladder's top with their rifle butts."""
        for i in (0, 1, 2):
            m = self.men[i]
            if m["mode"] == "shove":
                t = self.shove_t(i)
                if not m.get("done") and t >= self.SHOVE_AT:
                    m["done"] = True
                    if self.ladder["state"] == "standing":
                        self._push_off()
                if t >= self.SHOVE_LEN:
                    m.pop("done", None)
                    self._home_post(i)
            elif m["mode"] == "shove_run":
                goal = self.LADDER_X[m["side"]]
                step = dt * self.pace(2) / self.RUN_X_S
                m["x"] += max(-step, min(step, goal - m["x"]))
                if not self._wants_shove(m["side"]) or not self.usable():
                    self._home_post(2)
                elif abs(goal - m["x"]) < 1e-9:
                    m.update(mode="shove", t0=self.phase)

    # -- lulls, hunger and meals --------------------------------------------

    def trail_in_range(self):
        """Some redcoat on a trail is close to a wall."""
        return any(rc["hit"] is None and self.trail_p(rc["d"]) >= self.CLOSE_P
                   for rc in self.redcoats)

    def in_range(self):
        """Some redcoat is close to a wall: within the sentries' range, or
        up on it."""
        return self.trail_in_range() or bool(self.stormers_on())

    def trail_quiet(self):
        """No redcoat has been close to a wall for QUIET_S seconds, as far
        as the trails go; the bears watch for this before they go."""
        return self.trail_quiet_since is not None and self.phase \
            - self.trail_quiet_since >= self.QUIET_S

    def lull(self, seconds=None):
        """THE LULL: no redcoat close to either wall for QUIET_S seconds.
        Whatever a man does only in the quiet asks this; a meal asks that
        the quiet should have lasted a little longer."""
        return self.quiet_since is not None and self.phase \
            - self.quiet_since >= (self.QUIET_S if seconds is None
                                   else seconds)

    def _side_busy(self, side, p=None):
        """Something is up on one side alone: a redcoat close to its wall
        or on its trail within range (p, CLOSE_P unless asked, farther for
        the calm), on its ladder or up on its walk, or out of the trail to
        drive the man in the woods back."""
        p = self.CLOSE_P if p is None else p
        return any(rc["side"] == side and rc["hit"] is None and (
            self.trail_p(rc["d"]) >= p or rc["at_wall"] is not None
            or rc.get("drive") or rc.get("climb") is not None)
            for rc in self.redcoats) or bool(self.stormers_on(side))

    def side_lull(self, side):
        """THE LULL ON ONE SIDE: none of that side's business has been
        about for QUIET_S seconds. The man in the woods judges by this, not
        by the far side."""
        since = self.side_quiet_since[side]
        return since is not None and self.phase - since >= self.QUIET_S

    def pace(self, i):
        """How fast man i works, 1 fed and HUNGER_SLOW less starving."""
        return 1.0 - self.HUNGER_SLOW * self.men[i]["hunger"]

    def sit(self, i):
        """How far man i has sat down to eat, 0..1; he is not eating until
        it is 1, and is on his feet again when it is 0."""
        m = self.men[i]
        if m["mode"] != "eat":
            return 0.0
        if m["up"] is None:
            return self.ramp(self.phase - m["t0"], 0.0, self.SIT_S)
        return 1.0 - self.ramp(self.phase - m["up"], 0.0, self.RISE_S)

    def eating(self, i):
        return self.men[i]["mode"] == "eat" and self.men[i]["up"] is None \
            and self.phase - self.men[i]["t0"] >= self.SIT_S

    def _sit_down(self, i):
        m = self.men[i]
        m.update(mode="eat", t0=self.phase, up=None)
        self.tally["meals"] += 1

    def _meal(self, i, dt, stay):
        """Man i at his meal: eating while stay, getting up when not;
        True once he is on his feet again, and free to go back to work."""
        m = self.men[i]
        if m["up"] is None:
            if self.eating(i):
                m["hunger"] = max(0.0, m["hunger"] - dt / self.MEAL_S)
                self.tally["eating_s"] += dt
            if not stay or m["hunger"] <= self.FED:
                m["up"] = self.phase
        elif self.phase - m["up"] >= self.RISE_S:
            m["up"] = None
            return True
        return False

    def out(self, i):
        """Man i is off the walls, and not walking, shooting or ringing
        them: on the ground outside, or on the ladder."""
        return self.men[i]["mode"] in ("descend", "mend", "ascend", "run",
                                       "hide", "home", "raise")

    def _wall_to_mend(self):
        """The most damaged side wall, if it is damaged enough to go down
        for; else None."""
        side = 0 if self.wall[0] <= self.wall[1] else 1
        return side if self.wall[side] < self.MEND_BELOW else None

    def _time_to_foot(self, side):
        """Seconds until the nearest redcoat on side is at the foot of
        its wall, by the pace he is marching now; 0 if one is there."""
        speed = (self.MARCH_FAR - self.MARCH_NEAR) / self.MARCH_S
        best = math.inf
        if self.stormers_on(side):
            return 0.0
        for rc in self.redcoats:
            if rc["side"] != side or rc["hit"] is not None:
                continue
            if rc["at_wall"] is not None:
                return 0.0
            if rc.get("hid") is None and self.trail_p(rc["d"]) >= self.WATCH_P:
                best = min(best, (rc["d"] - self.MARCH_NEAR)
                           / (speed * self.PACE[rc["kind"]]
                              * rc.get("stride", 1.0)))
        return best

    def _start_mending(self, i, side):
        """Man i, in a lull, sets out to mend the wall on side."""
        m = self.men[i]
        m.update(side=side, t0=self.phase, h=1.0, g=0.0)
        self.ladder.update(side=side)
        if i != 2:
            self.ladder.update(state="standing", ext=0.0)
        m["x"] = self.walker_x()[0] if i == 2 else None
        m["mode"] = "to_wall" if i == 2 else "lower"
        self.tally["repairs"] += 1

    def _home_post(self, i):
        """Man i is back at his place: the patrol, or his tower."""
        m = self.men[i]
        if i == 2:
            x = m["x"] if m.get("x") is not None else self.walker_x()[0]
            pos = math.acos(1.0 - 2.0 * min(1.0, max(0.0, x))) / math.pi
            self.patrol_u = pos if x < 0.5 else 2.0 - pos
            m["mode"] = "patrol"
        else:
            m["mode"] = "post"
        m["x"], m["up"] = None, None

    def _ladder_work(self, i, dt):
        """Man i mending: from the wall walk down the ladder, at the
        wall's foot, and back up with the ladder after him."""
        m = self.men[i]
        side, lad, pace = m["side"], self.ladder, self.pace(i)
        mode = m["mode"]
        wary = self._time_to_foot(side) < self.START_S / 2
        if mode == "to_wall":
            goal = self.LADDER_X[side]
            step = dt * pace / self.WALK_S
            m["x"] += max(-step, min(step, goal - m["x"]))
            if wary:
                self._home_post(i)
            elif abs(goal - m["x"]) < 1e-9:
                m["mode"] = "lower"
                lad.update(state="standing", ext=0.0)
        elif mode == "lower":
            lad["ext"] = min(1.0, lad["ext"] + dt * pace / self.LOWER_S)
            if wary:
                m["mode"] = "haul"
            elif lad["ext"] >= 1.0:
                m["mode"] = "descend"
        elif mode == "descend":
            m["h"] = max(0.0, m["h"] - dt * pace / self.CLIMB_S)
            self._ladder_alarm(i)
            if m["mode"] == "descend" and m["h"] <= 0.0:
                m["mode"] = "mend"
        elif mode == "mend":
            if self.wall[side] >= 1.0:
                self.tally["repairs_done"] += 1
                if m["g"] > 0.0:
                    self.tally["repairs_out"] += 1
                    m["mode"] = "home"  # from out in the grass, on foot
                else:
                    m["mode"] = "ascend"
            else:
                self._ladder_alarm(i)
                if m["mode"] == "mend":
                    self.mend(side, dt * pace * self.MEND_PER_S)
        elif mode == "ascend":
            m["h"] = min(1.0, m["h"] + dt * pace / self.CLIMB_S)
            if m["h"] >= 1.0:
                m["mode"] = "haul"
        elif mode == "haul":
            lad["ext"] = max(0.0, lad["ext"] - dt * pace / self.HAUL_S)
            if lad["ext"] <= 0.0:
                lad["state"] = "up"
                self._home_post(i)

    def ground_g(self, rc):
        """How far from the foot of its wall, in rock distances, a redcoat
        is on his trail."""
        return (1.0 - self.trail_p(rc["d"])) * self.G_SPAN

    def _time_needed(self, i):
        """Seconds man i needs to be up on the wall again with the ladder
        under him, from where he is, at his pace."""
        m, lad = self.men[i], self.ladder
        t = 0.0
        if m["mode"] in ("home", "run", "hide", "mend"):
            t += m["g"] * self.HOME_S
        if lad["state"] in ("fallen", "falling") and m["mode"] != "ascend":
            t += self.RAISE_ALONE_S * (1.0 - lad["raised"])
        h = m["h"] if m["mode"] in ("descend", "ascend", "mend") else 0.0
        return (t + (1.0 - h) * self.CLIMB_S) / self.pace(i)

    def _slack(self, i):
        """Seconds to spare: how long before the nearest redcoat he can
        see is at the foot of the wall, less what it would take man i to
        be up on the wall again."""
        return self._time_to_foot(self.men[i]["side"]) - self._time_needed(i)

    def _ladder_alarm(self, i):
        """Man i, on the ladder or below it, watches the trail. While he
        has time to spare he goes on; when he has only just enough he
        goes back up; and when he has not enough, he breaks for the woods,
        leaving the ladder where it stands."""
        m = self.men[i]
        slack = self._slack(i)
        if slack > self.SAFE_S:
            return
        if slack >= 0:
            if m["mode"] in ("descend", "mend"):
                m["mode"] = "home" if m["g"] > 0.0 else "ascend"
            return
        self._break_for_woods(i)

    def _break_for_woods(self, i):
        m = self.men[i]
        self.tally["caught"] += 1
        m["driven"] = False
        self.ladder["raised"] = 0.0
        m.update(mode="run", rock=min(3, max(1, math.ceil(m["g"] - 1e-9))),
                 t0=self.phase, h=0.0, up=None, pinned=[], shot_t=None)

    def _advance_ground(self, i, dt):
        """Man i out in the grass: running for the woods, behind a rock
        taking pot shots, walking home, or raising the ladder alone."""
        m, lad, pace = self.men[i], self.ladder, self.pace(i)
        side, mode = m["side"], m["mode"]
        if mode == "run":
            goal = float(m["rock"])
            m["g"] = min(goal, m["g"] + dt * pace / self.RUN_S)
            if m["g"] >= goal:
                m.update(mode="hide", t0=self.phase, shot_t=None,
                         pinned=[], next_shot=self.phase + self._pot_wait(m))
        elif mode == "hide":
            self._hide(i, dt)
        elif mode == "home":
            if m["g"] > 0.0:
                self._ladder_alarm(i)
            if m["mode"] != "home":
                return
            m["g"] = max(0.0, m["g"] - dt * pace / self.HOME_S)
            if m["g"] <= 0.0:
                m["mode"] = "raise" if lad["state"] in ("fallen", "falling") \
                    else "ascend"
                m["h"] = 0.0
        elif mode == "raise":
            self._ladder_alarm(i)
            if m["mode"] != "raise":
                return
            if lad["state"] == "falling":
                return
            lad["raised"] = min(1.0, lad["raised"]
                                + dt * pace / self.RAISE_ALONE_S)
            if lad["raised"] >= 1.0:
                lad.update(state="standing", ext=1.0, raised=0.0)
                m.update(mode="ascend", h=0.0)

    def _pot_wait(self, m):
        every = self.POT_EVERY[m["rock"]]
        return math.inf if every is None else every * (
            0.6 + 0.8 * self.rng.random())

    def _hide(self, i, dt):
        """Behind a rock: crouched, rising now and then to take a pot shot
        at a redcoat on his side, and driven back by fire or by a redcoat
        close on him. Home in a lull."""
        m = self.men[i]
        side, k, pace = m["side"], m["rock"], self.pace(i)
        m["pinned"] = [t for t in m["pinned"]
                       if self.phase - t < self.PIN_WINDOW]
        foes = [rc for rc in self.redcoats if rc["side"] == side
                and rc["hit"] is None]
        # A man on foot close on his rock is a threat that stays; a
        # horseman, going by, half of one.
        crowd = sum(1.0 if rc["kind"] == "foot" else 0.5 for rc in foes
                    if rc["kind"] != "cannon" and rc.get("hid") is None
                    and abs(self.ground_g(rc) - k) <= self.CLOSE_G)
        if k < 3 and (len(m["pinned"]) >= self.PIN_SHOTS or (
                crowd and self.rng.random() < self.RUSH_P * crowd * dt)):
            self.tally["retreats"] += 1
            if not m.get("driven"):
                m["driven"] = True    # once for each time he is caught
                self.tally["driven"] += 1
            m.update(mode="run", rock=k + 1, t0=self.phase, pinned=[],
                     shot_t=None)
            self._call_off(side)
            return
        if m["shot_t"] is not None:
            m["shot_t"] += dt * pace
            if m["shot_t"] >= self.SHOT_AT and not m.get("fired"):
                m["fired"] = True
                self._pot_shot(i)
            if m["shot_t"] >= self.DRILL_LEN:
                m["shot_t"] = None
                m["next_shot"] = self.phase + self._pot_wait(m)
            return
        if self.phase >= m["next_shot"] and self.POT_EVERY[k] is not None \
                and self._pot_target(i) is not None:
            m.update(shot_t=0.0, fired=False)
            return
        if self.side_lull(side) and self.phase - m["t0"] >= self.HIDE_MIN_S \
                and not m["pinned"] \
                and self._slack(i) > self.SAFE_S + self.CATCH_MARGIN:
            self._call_off(side)
            if self.wall[side] < self.MEND_BELOW:
                # He is already outside: the cheapest moment to mend it.
                m.update(mode="mend", t0=self.phase, h=0.0, up=None)
                self.tally["repairs"] += 1
            else:
                m["mode"] = "home"

    def _call_off(self, side):
        """The redcoats who left the trail to drive him off go back to it."""
        for rc in self.redcoats:
            if rc["side"] == side:
                rc.pop("drive", None)

    def _pot_target(self, i):
        m = self.men[i]
        best, at = None, math.inf
        for rc in self.redcoats:
            if rc["side"] != m["side"] or rc["hit"] is not None \
                    or rc.get("hid") is not None:
                continue
            gap = abs(self.ground_g(rc) - m["rock"])
            if gap <= self.POT_RANGE and gap < at:
                best, at = rc, gap
        return best

    def _pot_shot(self, i):
        m = self.men[i]
        rc = self._pot_target(i)
        if rc is None or self.rng.random() >= self.POT_HIT[m["rock"]]:
            return
        rc["hp"] -= 1
        rc["struck"] = self.phase
        if rc["hp"] <= 0:
            rc["hit"] = self.phase
            self.tally["shot"] += 1

    def _advance_drivers(self, dt):
        """A redcoat near his rock may leave the trail to drive him off:
        he kneels and fires at the rock, and keeps on while the man is
        there, until he has fallen back or the redcoat is shot."""
        for i in (0, 1, 2):
            m = self.men[i]
            if m["mode"] != "hide" or m["rock"] >= 3:
                continue
            side, k = m["side"], m["rock"]
            drivers = [rc for rc in self.redcoats if rc["side"] == side
                       and rc["hit"] is None and rc.get("drive")]
            for rc in self.redcoats:
                if len(drivers) >= self.DRIVERS_MAX:
                    break
                if rc["side"] == side and rc["hit"] is None \
                        and rc["kind"] == "foot" and rc["at_wall"] is None \
                        and rc.get("hid") is None and not rc.get("drive") \
                        and abs(self.ground_g(rc) - k) <= self.DRIVE_RANGE \
                        and self.rng.random() < self.DRIVE_CHANCE * dt:
                    rc["drive"] = {"t0": self.phase + self.rng.random(),
                                   "born": self.phase, "rock": k,
                                   "fired": False}
                    drivers.append(rc)
            for rc in drivers:
                d = rc["drive"]
                tau = (self.phase - d["t0"]) * self.VOLLEY_RATE
                if tau >= self.DRILL_LEN:
                    d.update(t0=self.phase + 0.3 + self.rng.random() * 0.6,
                             fired=False)
                elif tau >= self.SHOT_AT and not d["fired"]:
                    d["fired"] = True
                    self.tally["rc_shots"] += 1
                    self.rock_chip[side][k] = self.phase
                    m["pinned"].append(self.phase)

    def hide_pose(self, i):
        """Man i behind his rock: (how far ducked down behind it, kneel,
        aim, seconds since his shot or -1)."""
        t = self.men[i].get("shot_t")
        if t is None:
            return 1.0, 1.0, 0.0, -1.0
        _, aim, shot = self.drill_pose(t)
        duck = 1.0 - self.ramp(t, 0.0, 0.7) \
            + self.ramp(t, self.DRILL_LEN - 1.0, self.DRILL_LEN - 0.3)
        return min(1.0, max(0.0, duck)), 1.0, aim, shot

    def volley(self, rc):
        """A redcoat who has left the trail for his man's rock: (kneel,
        aim, seconds since his shot or -1)."""
        d = rc.get("drive")
        if not d:
            return 0.0, 0.0, -1.0
        tau = (self.phase - d["t0"]) * self.VOLLEY_RATE
        kneel, aim, shot = self.drill_pose(max(0.0, tau))
        return kneel, aim, shot / self.VOLLEY_RATE if shot >= 0 else -1.0

    def _advance_men(self, dt, walker_busy):
        """Hunger, the walker's patrol, and what each man does in a lull."""
        if self.in_range():
            self.quiet_since = None
        elif self.quiet_since is None:
            self.quiet_since = self.phase
        if self.trail_in_range():
            self.trail_quiet_since = None
        elif self.trail_quiet_since is None:
            self.trail_quiet_since = self.phase
        if self.boats_in_sight or any(self._side_busy(side, self.WATCH_P)
                                      for side in (0, 1)):
            self.calm_since = None
        elif self.calm_since is None:
            self.calm_since = self.phase
        for side in (0, 1):
            if self._side_busy(side):
                self.side_quiet_since[side] = None
            elif self.side_quiet_since[side] is None:
                self.side_quiet_since[side] = self.phase
        for m in self.men:
            if m["mode"] != "eat" and not (m["mode"] == "pot"
                                           and m["leg"] == "sit"):
                m["hunger"] = min(1.0, m["hunger"] + dt / (
                    self.HEAVY_S if m["mode"] in self.HEAVY
                    else self.HUNGER_S))
        for i, m in enumerate(self.men):
            if m["mode"] in ("to_wall", "lower", "descend", "mend",
                             "ascend", "haul"):
                self._ladder_work(i, dt)
            elif m["mode"] in ("run", "hide", "home", "raise"):
                self._advance_ground(i, dt)
            if self.out(i):
                self.tally["out_s"] += dt
        self._advance_drivers(dt)
        self._advance_shoves(dt, walker_busy)
        self._advance_gunnery(dt)
        self._advance_stormers(dt)
        self._advance_driven(dt)
        self._advance_roofing(dt)
        self._advance_pot(dt)
        self._advance_bears(dt)
        if not self.has_walker:
            # No room on the wall for him: the sentry on a damaged side
            # goes down instead, if he has nothing at his rifle.
            side = self._wall_to_mend()
            if side is not None and self.lull() \
                    and self._time_to_foot(side) > self.START_S \
                    and self.men[side]["mode"] == "post" \
                    and not self.busy(side) \
                    and self.men[side]["hunger"] < self.STARVING \
                    and self.ladder["state"] == "up" \
                    and self.relief is None:
                self._start_mending(side, side)
            return
        # The walker's patrol goes on while he is on the wall and not at
        # his bugle, the gun or a shot at a boat.
        walker = self.men[2]
        free = not (self.bugling() or self.relief is not None or walker_busy
                    or self.greeting())
        if walker["mode"] == "patrol" and free:
            self.patrol_u = (self.patrol_u + dt / self.PATROL_LEG_S) % 2.0
            side = self._wall_to_mend()
            sh = self.ladder["side"]
            if self.stormers_on(mode="walk") and not self.gun["taken"]:
                x, face = self.walker_x()
                walker.update(mode="gun", x=x, face=face, t0=self.phase,
                              station=None, clear=None)
            elif self.gun["taken"] and self.walk_clear():
                x, face = self.walker_x()
                walker.update(mode="retake", x=x, face=face, got=None)
            elif self._wants_shove(sh) and self.climbers() \
                    and (self.busy(sh) or self.men[sh]["mode"] != "post"):
                # The sentry there has his hands full; he goes himself.
                walker.update(mode="shove_run", side=sh,
                              x=self.walker_x()[0], t0=self.phase)
            elif self.lull() and side is not None \
                    and walker["hunger"] < self.STARVING \
                    and self.ladder["state"] == "up" \
                    and self._time_to_foot(side) > self.START_S:
                self._start_mending(2, side)
            elif self.lull() and side is None \
                    and self._roof_to_mend() is not None \
                    and walker["hunger"] < self.STARVING \
                    and self.ladder["state"] == "up" \
                    and self._time_to_foot(self._roof_to_mend()) \
                    > self.START_S:
                x, face = self.walker_x()
                walker.update(mode="to_roof", x=x, face=face, t0=self.phase,
                              side=self._roof_to_mend())
            elif self.lull(self.MEAL_AFTER_S) \
                    and walker["hunger"] >= self.EAT_AT:
                if self.pot_ready():
                    self._to_pot(2, "meal")     # from the pot, not his pack
                else:
                    self._sit_down(2)
            elif self.calm():
                self._to_pot(2, "rest")
        elif walker["mode"] == "eat":
            if self._meal(2, dt, not self.in_range() and not (
                    self._wall_to_mend() is not None
                    and walker["hunger"] <= self.MEND_FED)):
                walker["mode"] = "patrol"

    def walker_x(self):
        """Where the walker stands on the wall walk, 0 at the west tower
        to 1 at the east, and the way he faces (the way he is walking,
        or outward when he is at a wall's ladder)."""
        m = self.men[2]
        if m["mode"] in ("gun", "driven", "retake", "to_roof", "roof",
                         "brawl", "pot", "carry"):
            return m["x"], m["face"]
        if m["mode"] in ("to_wall", "shove_run", "shove", "lower", "haul",
                         "descend", "ascend", "mend"):
            x = m["x"] if m["mode"] in ("to_wall", "shove_run") \
                else self.LADDER_X[m["side"]]
            goal = self.LADDER_X[m["side"]]
            return x, (1 if goal > x else -1) \
                if m["mode"] in ("to_wall", "shove_run") \
                else (-1 if m["side"] == 0 else 1)
        u = self.patrol_u
        pos = u if u < 1.0 else 2.0 - u
        return 0.5 - 0.5 * math.cos(pos * math.pi), 1 if u < 1.0 else -1

    # -- the stew pot -----------------------------------------------------

    def calm(self):
        """THE CALM, deeper than a lull: no redcoat in sight on either
        trail, nor at a wall, nor up on it, for QUIET_S seconds."""
        return self.calm_since is not None and self.phase \
            - self.calm_since >= self.QUIET_S

    def pot_ready(self):
        """The pot hangs over its fire at the boil, with stew in it."""
        p = self.pot
        return p["at"] == "fire" and p["heat"] >= 1.0 \
            and p["stew"] >= self.POT_MIN

    def seat_x(self, i):
        """Where man i sits by the pot, along the wall walk."""
        return min(1.0, max(0.0, self.POT_X + self.POT_SEAT[i]))

    def pot_sit(self, i):
        """How far man i has sat down by the pot, 0..1."""
        m = self.men[i]
        if m["mode"] != "pot":
            return 0.0
        if m["leg"] == "sit":
            return self.ramp(self.phase - m["t0"], 0.0, self.SIT_S)
        if m["leg"] == "rise":
            return 1.0 - self.ramp(self.phase - m["up"], 0.0, self.RISE_S)
        return 0.0

    def pot_eating(self, i):
        """Man i is at his stew, or the jerky he has with him, by the pot."""
        m = self.men[i]
        return m["mode"] == "pot" and m["leg"] == "sit" \
            and m["feed"] is not None \
            and self.phase - m["t0"] >= self.SIT_S

    def at_pot(self, i):
        m = self.men[i]
        return m["mode"] == "pot" and m["leg"] == "sit"

    def _to_pot(self, i, why):
        """Man i sets out for the pot: the walker along the walk; a
        sentry down from his tower first. Only in a lull or the calm."""
        m = self.men[i]
        if i == 2:
            x, face = self.walker_x()
            m.update(mode="pot", leg="to", x=x, face=face, why=why,
                     t0=self.phase, up=None, feed=None)
        else:
            m.update(mode="pot", leg="down", x=self._end_x(i), h=0.0,
                     why=why, t0=self.phase, up=None, feed=None,
                     caught=False, face=1 if i == 0 else -1)
            self.drill_start[i] = None

    def _pot_leave(self, i):
        """Man i gets up from the pot, or turns back from it."""
        m = self.men[i]
        leg = m["leg"]
        if leg in ("down", "to") and i != 2:
            m["leg"] = "up" if leg == "down" else "back"
        elif leg == "to":
            self._home_post(2)
        elif leg == "sit":
            m.update(leg="rise", up=self.phase)

    def _sentry_may_rest(self, i):
        """A tower sentry with nothing at his rifle goes down to the pot,
        in the calm and only then."""
        man = self.men[i]
        return self.has_walker and man["mode"] == "post" and self.calm() \
            and not self.busy(i) and not self.calling(i) \
            and self.relief is None and not self.ousted(i)

    def _advance_pot(self, dt):
        """The pot and the men round it. In the calm it fills and comes to
        the boil; a man at it eats from it, and the sentries come down and
        sit with the walker; when a redcoat comes in sight they get up and
        go back."""
        if not self.has_walker:
            for i, m in enumerate(self.men):
                if m["mode"] in ("pot", "carry"):
                    self._home_post(i)
            if self.pot["at"] == "carried":
                self.pot.update(at="fire", x=self.POT_X, task=None)
            self.pot["task"] = None
            return
        p = self.pot
        sight = self.calm_since is None
        if p["at"] == "fire" and self.lull() \
                and not any(m["mode"] == "pot" and m["feed"] == "stew"
                            for m in self.men):
            p["stew"] = min(1.0, p["stew"] + dt / self.REFILL_S)
            p["heat"] = min(1.0, p["heat"] + dt / self.BOIL_S)
        self._pot_dispatch()
        for i, m in enumerate(self.men):
            if m["mode"] == "carry":
                self._pot_carry(i, m, dt)
            elif m["mode"] == "pot":
                if i != 2:
                    self.tally["off_s"] += dt
                self._pot_man(i, m, dt, sight)
        together = all(self.at_pot(i) for i in (0, 1, 2))
        if together:
            self.tally["pot_together_s"] += dt
            if not self.pot_all:
                self.tally["pot_together"] += 1
        self.pot_all = together

    def _pot_man(self, i, m, dt, sight):
        p, pace, leg = self.pot, self.pace(i), m["leg"]
        if i != 2 and not m["caught"] and leg != "sit" and any(
                rc["side"] == i and rc["hit"] is None and (
                    self.trail_p(rc["d"]) >= self.ENGAGE_P
                    or rc["at_wall"] is not None)
                for rc in self.redcoats):
            m["caught"] = True      # a redcoat at his range and he not back
            self.tally["off_caught"] += 1
        if leg == "down":
            if sight:
                m["leg"] = "up"
                return
            m["h"] = min(1.0, m["h"] + dt * pace / self.DOWN_S)
            if m["h"] >= 1.0:
                m["leg"] = "to"
        elif leg == "to":
            if (self.in_range() if i == 2 and m["why"] == "meal" else sight):
                self._pot_leave(i)
                return
            goal = self.seat_x(i)
            step = dt * pace / self.WALK_S
            left = goal - m["x"]
            m["x"] += max(-step, min(step, left))
            m["face"] = 1 if left > 0 else -1 if left < 0 else m["face"]
            if abs(goal - m["x"]) < 1e-9:
                m.update(leg="sit", t0=self.phase, feed=None)
                m["face"] = -1 if i == 1 else 1   # to the fire
                if i == 2:
                    m["face"] = 1 if m["x"] <= self.POT_X else -1
        elif leg == "sit":
            fed = False
            if self.pot_sit(i) >= 1.0 and m["hunger"] > self.FED:
                if self.pot_ready():
                    m["feed"] = "stew"
                    m["hunger"] = max(0.0, m["hunger"] - dt / self.POT_MEAL_S)
                    p["stew"] = max(0.0, p["stew"] - dt / self.POT_DRAW_S)
                    self.tally["pot_eating_s"] += dt
                    fed = True
                elif m["hunger"] >= self.EAT_AT:
                    m["feed"] = "pack"
                    m["hunger"] = max(0.0, m["hunger"] - dt / self.MEAL_S)
                    self.tally["eating_s"] += dt
                    fed = True
            if not fed:
                m["feed"] = None
            if fed and not m.get("sat_fed"):
                m["sat_fed"] = True
                self.tally["pot_meals"] += 1
            if i == 2:
                work = self._wall_to_mend() is not None \
                    and m["hunger"] <= self.MEND_FED
                stay = not self.in_range() if m["why"] == "meal" \
                    else not sight
                done = m["why"] == "meal" and m["hunger"] <= self.FED
                if not stay or done or work:
                    m.update(leg="rise", up=self.phase, sat_fed=False)
            elif sight:
                m.update(leg="rise", up=self.phase, sat_fed=False)
        elif leg == "rise":
            if self.phase - m["up"] >= self.RISE_S:
                if i == 2:
                    self._home_post(2)
                else:
                    m["leg"] = "back"
        elif leg == "back":
            goal = self._end_x(i)
            step = dt * pace / self.WALK_S
            left = goal - m["x"]
            m["x"] += max(-step, min(step, left))
            m["face"] = 1 if left > 0 else -1 if left < 0 else m["face"]
            if abs(left) < 1e-9:
                m["leg"] = "up"
        elif leg == "up":
            m["h"] = max(0.0, m["h"] - dt * pace / self.UP_S)
            if m["h"] <= 0.0:
                self._home_post(i)

    # -- the pot, poured -----------------------------------------------------

    def below(self, side):
        """Anyone on that side's ladder or at that wall's foot: those the
        stew would scald."""
        return any(rc["side"] == side and rc["hit"] is None
                   and (rc.get("climb") is not None
                        or rc["at_wall"] is not None)
                   for rc in self.redcoats)

    def _pot_carrier(self, x):
        """The man nearest x along the wall walk who can leave what he is
        doing to carry the pot: the walker, or a tower sentry."""
        best, far = None, math.inf
        walker = self.men[2]
        if walker["mode"] in ("patrol", "eat", "pot", "gun", "to_wall",
                              "shove_run", "to_roof", "roof") \
                and not self.out(2):
            best, far = 2, abs(self.walker_x()[0] - x)
        for i in (0, 1):
            m = self.men[i]
            if m["mode"] in ("post", "eat", "pot") and not self.ousted(i):
                at = m["x"] if m["mode"] == "pot" else self._end_x(i)
                if abs(at - x) < far:
                    best, far = i, abs(at - x)
        return best

    def _pot_dispatch(self):
        """Who is to carry the pot, and where: to a side in desperate
        straits, if it is hot and holds stew; back to its fire, in the
        calm, once it has been emptied."""
        p = self.pot
        for s in (0, 1):
            if self.below(s):
                self.below_at[s] = self.phase
        if p["task"] is not None:
            return
        if p["at"] == "fire":
            # a desperate sentry takes it himself, if it is hot and full
            if p["heat"] < 1.0 or p["stew"] < self.POUR_MIN \
                    or self.phase < self.pot_rest:
                return
            ready = [s for s in (0, 1) if self.desp[s] >= self.DESP_AT
                     and self.below(s) and self.men[s]["mode"] == "post"
                     and not self.busy(s) and not self.calling(s)
                     and not self.ousted(s)]
            if not ready:
                return
            side = max(ready, key=lambda s: self.desp[s])
            self.tally["desp_pours"] += 1
            self._start_carry(side, "pour", side)
            return
        if p["at"] == "spent" and self.lull():
            side, kind = p["side"], "fetch"
        else:
            return
        i = self._pot_carrier(p["x"])
        if i is not None:
            self._start_carry(i, kind, side)

    def _start_carry(self, i, kind, side):
        m, p = self.men[i], self.pot
        p["task"] = {"kind": kind, "i": i, "side": side}
        if kind == "pour":
            self.tally["pour_trips"] += 1
        if i == 2:
            x, face = self.walker_x()
            m.update(mode="carry", leg="to", x=x, face=face, t0=self.phase,
                     up=None, kind=kind, side=side)
        else:
            on = m["mode"] == "pot"
            m.update(mode="carry", leg="to" if on else "down",
                     x=m["x"] if on else self._end_x(i),
                     h=m["h"] if on else 0.0, t0=self.phase, up=None,
                     kind=kind, side=side, caught=m.get("caught", False),
                     face=m.get("face", 1 if i == 0 else -1))
            self.drill_start[i] = None

    def _finish_carry(self, i):
        """He has put the pot down, or turned from it: back to the pot's
        seat if it is calm, to his round or his tower if not."""
        m, p = self.men[i], self.pot
        p["task"] = None
        if i == 2:
            if self.calm():
                self._to_pot(2, "rest")
            else:
                self._home_post(2)
        else:
            m.update(mode="pot", leg="to" if self.calm() else "back",
                     why="rest", feed=None, t0=self.phase)

    def _gone(self, side, wait):
        """Nobody has been below that side for wait seconds: men going
        through the gap, or the next coming up the trail, leave it empty
        for a moment, which is not gone."""
        return self.phase - self.below_at[side] >= wait

    def _pour_off(self, m):
        """He carries the pot home rather than pour it on nobody, and it
        is not sent for again until it has rested."""
        m["kind"] = self.pot["task"]["kind"] = "fetch"
        self.pot_rest = self.phase + self.POT_REST_S

    def _scald(self, side):
        """The stew goes down the outside of the wall: everyone on that
        side's ladder and at the wall's foot is scalded dead. A redcoat
        already on the walk is not caught by it."""
        for rc in self.redcoats:
            if rc["side"] == side and rc["hit"] is None and (
                    rc.get("climb") is not None
                    or rc["at_wall"] is not None):
                rc.update(hit=self.phase, hp=0, scalded=True)
                self.tally["scalded"] += 1

    def _pot_carry(self, i, m, dt):
        """Man i with the pot: to it, up with it, along the walk, and
        either tipping it over the wall or setting it back on its fire."""
        p, pace, leg = self.pot, self.pace(i), m["leg"]
        side, kind = m["side"], m["kind"]
        if i != 2:
            self.tally["off_s"] += dt
        if leg == "down":
            m["h"] = min(1.0, m["h"] + dt * pace / self.DOWN_S)
            if m["h"] >= 1.0:
                m["leg"] = "to"
        elif leg == "to":
            if kind == "pour" and self._gone(side, self.GONE_S):
                self.pot_rest = self.phase + self.POT_REST_S
                self._finish_carry(i)       # it is over
                return
            if kind == "fetch" and self.quiet_since is None:
                self._finish_carry(i)       # the lull is over
                return
            step = dt * pace / self.RUN_X_S
            left = p["x"] - m["x"]
            m["x"] += max(-step, min(step, left))
            m["face"] = 1 if left > 0 else -1 if left < 0 else m["face"]
            if abs(p["x"] - m["x"]) < 1e-9:
                m.update(leg="lift", t0=self.phase)
        elif leg == "lift":
            if self.phase - m["t0"] >= self.LIFT_S / pace:
                p["at"] = "carried"
                m["leg"] = "bear"
        elif leg == "bear":
            if kind == "pour" and self._gone(side, self.HOLD_S):
                # nobody left below: carry it back rather than waste it
                self._pour_off(m)
                kind = "fetch"
            goal = self.LADDER_X[side] if kind == "pour" else self.POT_X
            step = dt * pace / self.CARRY_S
            left = goal - m["x"]
            m["x"] += max(-step, min(step, left))
            m["face"] = 1 if left > 0 else -1 if left < 0 else m["face"]
            p["x"] = m["x"]
            if abs(goal - m["x"]) < 1e-9 \
                    and (kind != "pour" or self.below(side)):
                # at the wall with nobody below yet, he holds it there
                m.update(leg="tip" if kind == "pour" else "set",
                         t0=self.phase, tipped=False)
                if kind == "pour":
                    m["face"] = -1 if side == 0 else 1
        elif leg == "tip":
            t = (self.phase - m["t0"]) * pace
            if t >= self.TIP_AT and not m["tipped"] and not self.below(side):
                # nobody below: hold it, and carry it home if they are gone
                if self._gone(side, self.HOLD_S):
                    self._pour_off(m)
                m["leg"] = "bear"
                return
            if t >= self.TIP_AT and not m["tipped"]:
                m["tipped"] = True
                self.tally["pours"] += 1
                p.update(stew=0.0, heat=0.0)
                self._scald(side)
                self.desp[side] = 0.0
            if t >= self.TIP_S:
                p.update(at="spent", side=side, x=m["x"])
                self._finish_carry(i)
        elif leg == "set":
            if self.phase - m["t0"] >= self.SET_S / pace:
                p.update(at="fire", x=self.POT_X)
                self._finish_carry(i)

    def pour_t(self):
        """Seconds into the tip of the pot, or -1; and the side it is over."""
        for m in self.men:
            if m["mode"] == "carry" and m["leg"] == "tip":
                return (self.phase - m["t0"]) * self.pace(
                    self.men.index(m)), m["side"]
        return -1.0, None

    # -- the gun ----------------------------------------------------------

    def relief_t(self):
        r = self.relief
        return None if r is None else self.phase - r["t0"]

    def calling(self, i):
        """Tower sentry i is blowing his horn for the gun."""
        t = self.relief_t()
        return t is not None and self.relief["side"] == i \
            and t < self.BUGLE_LEN

    def horning(self, i):
        """Tower sentry i is blowing his horn for a gun that is not
        coming: a note only, he does not take his hands off his rifle."""
        return self.phase - self.horn_at[i] < self.BUGLE_LEN

    def call_t(self, i):
        """Seconds into sentry i's call, whether the gun answers or not."""
        t = self.relief_t()
        if t is not None and self.relief["side"] == i and t < self.BUGLE_LEN:
            return t
        return self.phase - self.horn_at[i]

    def gun_frac(self):
        """Where the fort's gun stands, as a fraction of the wall walk."""
        r = self.relief
        if r is None:
            return self.gun_at
        k = self.ramp(self.phase - r["t0"], self.WHEEL_AT,
                      self.WHEEL_AT + self.WHEEL_S)
        return r["from"] + (self.GUN_POST[r["side"]] - r["from"]) * k

    def _advance_relief(self, dt, walker_busy):
        """A tower sentry with redcoats at the foot of his wall or on his
        ladder calls for the gun; when the ball lands, it takes those at
        the foot. A call nobody answers (the walker busy or away, the gun
        taken or still being loaded) is made again, and each raises his
        desperation; see _pot_dispatch."""
        r = self.relief
        free = self.has_walker and not self.bugling() and not walker_busy \
            and self.men[2]["mode"] == "patrol" and not self.gun["taken"] \
            and self.phase >= self.gun["ready"] \
            and self.gun.get("load_left") is None
        if r is None:
            for i in (0, 1):
                if not self.below(i):
                    self.call_at[i] = -1e9
                    if self.lull():
                        self.desp[i] = max(
                            0.0, self.desp[i] - dt / self.DESP_DRAIN_S)
                    continue
                if self.busy(i) or self.men[i]["mode"] not in (
                        "post", "eat") or self.ousted(i):
                    continue
                if free and any(rc["side"] == i and rc["hit"] is None
                                and self.at_wall(rc)
                                for rc in self.redcoats):
                    self.relief = {"side": i, "t0": self.phase,
                                   "landed": False, "fired": False,
                                   "from": self.gun_at}
                    self.gun["facing"] = -1 if i == 0 else 1
                    self.tally["calls"] += 1
                    self.call_at[i] = self.phase + self.CALL_EVERY_S
                    return
                if self.phase >= self.call_at[i] and not self.calling(i):
                    self.horn_at[i] = self.phase
                    self.call_at[i] = self.phase + self.CALL_EVERY_S
                    self.desp[i] = min(self.DESP_MAX, self.desp[i] + 1.0)
                    self.tally["unanswered"] += 1
            return
        # The other side's sentry, with the walker at this side's call,
        # goes unanswered and calls again.
        i = 1 - r["side"]
        if not self.below(i):
            self.call_at[i] = -1e9
            if self.lull():
                self.desp[i] = max(0.0, self.desp[i] - dt / self.DESP_DRAIN_S)
        elif not (self.busy(i) or self.men[i]["mode"] not in ("post", "eat")
                  or self.ousted(i)) \
                and self.phase >= self.call_at[i] and not self.calling(i):
            self.horn_at[i] = self.phase
            self.call_at[i] = self.phase + self.CALL_EVERY_S
            self.desp[i] = min(self.DESP_MAX, self.desp[i] + 1.0)
            self.tally["unanswered"] += 1
        t = self.phase - r["t0"]
        if not r["fired"] and t >= self.FIRE_AT:
            r["fired"] = True
            pace = self.pace(2)
            self.gun.update(fired=self.phase, aim=None,
                            ready=self.phase + self.RELOAD_S / pace)
            self.tally["reloads"] += 1
        if not r["landed"] and t >= self.FIRE_AT + self.FLIGHT_S:
            r["landed"] = True
            self.desp[r["side"]] *= self.DESP_RELIEVED
            for rc in self.redcoats:
                if rc["side"] == r["side"] and rc["hit"] is None and (
                        self.at_wall(rc)
                        or self.trail_p(rc["d"]) >= self.BLAST_P):
                    rc["hp"] = 0
                    rc["hit"] = self.phase
                    self.tally["blasted"] += 1
        if t >= self.RELIEF_LEN:
            self.gun_at = self.GUN_POST[r["side"]]
            self.relief = None
            m = self.men[2]
            if m["mode"] == "patrol" and not self.gun["taken"]:
                # He stays at it, loading, and the stormers' rules for a
                # walker at the gun are his: see _advance_gunnery.
                face = self.gun["facing"]
                st = min(1.0, max(0.0, self.gun_at - face * self.STATION_DX))
                m.update(mode="gun", x=st, face=face, t0=self.phase,
                         station=st, clear=None)

    def _advance_gunnery(self, dt):
        """The walker at the gun against the stormers on the wall walk: he
        runs to his station behind it, turns it on the nearest of them,
        sights along the walk and fires, and reloads; when none are left
        he stays at it a moment and goes back to his round."""
        m, g = self.men[2], self.gun
        if m["mode"] != "gun":
            return
        if g["taken"]:
            return
        if g.get("load_left") is not None:
            # back at a load he was driven from: he takes it up again
            g.update(ready=self.phase + g["load_left"], load_left=None)
        pace, gx = self.pace(2), self.gun_at
        threats = self.stormers_on(mode="walk")
        if threats:
            m["clear"] = None
            near = min(threats, key=lambda st: abs(st["x"] - gx))
            face = 1 if near["x"] >= gx else -1
        else:
            g["aim"] = None
            if m["clear"] is None:
                m["clear"] = self.phase
            elif self.phase - m["clear"] >= self.STAND_S \
                    and self.phase >= g["ready"]:
                self._home_post(2)
                return
            face = g["facing"]
        # His place is behind the gun as it is to point: when it is to turn
        # to the other side he runs round behind it, and when a tower's call
        # for it turned it without him he does not stand before its muzzle.
        m["station"] = min(1.0, max(0.0, gx - face * self.STATION_DX))
        step = dt * pace / self.RUN_X_S
        left = m["station"] - m["x"]
        m["x"] += max(-step, min(step, left))
        if abs(m["station"] - m["x"]) > 1e-9:
            m["face"] = 1 if left > 0 else -1
            return
        m["face"] = face
        if not threats:
            return
        if face != g["facing"]:
            g.update(facing=face, turned=self.phase, aim=None)
            g["ready"] = max(g["ready"], self.phase + self.TURN_S / pace)
        ahead = [st for st in threats
                 if 0 < (st["x"] - gx) * g["facing"] <= self.FIRE_RANGE]
        if ahead and self.phase >= g["ready"] \
                and not self._bear_in_blast(g["facing"]):
            if g["aim"] is None:
                g["aim"] = self.phase
            elif self.phase - g["aim"] >= self.AIM_S / pace:
                self._fire_gun(ahead, pace)
        else:
            g["aim"] = None

    def gun_gone(self):
        """The gun is the stormers', or there is no wall walk for one."""
        return self.gun["taken"] or not self.has_walker

    def _crewed(self, face):
        """The walker is at the gun, loaded and turned to face, with
        nothing left to do but fire."""
        m, g = self.men[2], self.gun
        return m["mode"] == "gun" and m["station"] is not None \
            and abs(m["station"] - m["x"]) < 1e-9 \
            and g["facing"] == face and self.phase >= g["ready"]

    def _reach_gun(self, st):
        """A stormer has his hands on the gun. If the crew can fire, it
        goes off at point blank; if it is reloading, or being turned, or
        there is no crew, he takes it, and the walker is driven back
        along the walk to the far tower."""
        face = 1 if st["x"] >= self.gun_at else -1
        if self._crewed(face):
            if self._bear_in_blast(face):
                return              # never fire on a bear
            self._fire_gun([o for o in self.stormers_on(mode="walk")
                            if abs(o["x"] - self.gun_at) <= self.FIRE_RANGE
                            and (o["x"] - self.gun_at) * face >= 0],
                           self.pace(2))
            return
        if st.get("at_gun") is None:
            st["at_gun"] = self.phase
        if self.phase - st["at_gun"] < self.SEIZE_S:
            return
        self.gun.update(taken=True, aim=None)
        if self.gun["ready"] > self.phase:
            self.gun["load_left"] = self.gun["ready"] - self.phase
        self.tally["guns"] += 1
        m = self.men[2]
        if m["mode"] in ("gun", "patrol", "eat", "shove_run", "to_wall",
                         "shove", "to_roof", "roof", "retake", "pot"):
            x, face = self.walker_x()
            m.update(mode="driven", x=x, face=face, up=None,
                     goal=float(st["side"] == 0), t0=self.phase)

    def hurt_roof(self, side, amount):
        before = self.roof[side]
        self.roof[side] = max(0.0, before - amount)
        self.tally["roof_hurt"][side] += before - self.roof[side]
        if before > 0.0 and self.roof[side] <= 0.0:
            self.tally["roof_holes"] += 1

    def mend_roof(self, side, amount):
        before = self.roof[side]
        self.roof[side] = min(1.0, before + amount)
        self.tally["roof_mended"][side] += self.roof[side] - before

    def holed(self, side):
        return self.roof[side] <= 0.0

    def ousted(self, i):
        """Tower sentry i has been driven off his roof by men hacking it,
        or by those who have gone down through it."""
        return any(st["side"] == i and st["mode"] != "walk"
                   for st in self.stormers_on())

    def dent(self, k):
        """How battered core tile k is, 0 whole to 1 smashed."""
        return self.dents.get(k, 0.0)

    def _advance_yard(self, dt):
        """Stormers dropped through a roof, in the yard: each makes for
        the nearest tile not yet smashed and batters it, and when the yard
        is clear in a lull the dents mend over time."""
        for st in self.stormers_on(mode="drop"):
            if self.phase - st["since"] >= self.DROP_S:
                st.update(mode="yard", u=0.02 if st["side"] == 0 else 0.98,
                          v=0.0, tile=None, since=self.phase)
                self.tally["yard"] += 1
        yard = self.stormers_on(mode="yard")
        for st in yard:
            if st["tile"] is None or self.dent(st["tile"]) >= 1.0:
                live = [k for k in range(len(self.tiles))
                        if self.dent(k) < 1.0]
                st["tile"] = min(live, key=lambda k: math.hypot(
                    self.tiles[k][0] - st["u"], self.tiles[k][1] - st["v"]),
                    default=None)
            if st["tile"] is None:
                continue
            tu, tv = self.tiles[st["tile"]]
            gu, gv = tu - st["u"], tv - st["v"]
            dist = math.hypot(gu, gv)
            step = dt * st["stride"] / self.YARD_S
            if dist > 0.05:
                st["u"] += gu / dist * min(step, dist)
                st["v"] += gv / dist * min(step, dist)
                st["batter"] = False
            else:
                st["batter"] = True
                k = st["tile"]
                self.dents[k] = min(1.0, self.dent(k)
                                    + self.BATTER_PER_S * dt)
                self.tally["batter_s"] += dt
        if not yard and self.lull():
            for k in list(self.dents):
                self.dents[k] = max(0.0, self.dents[k]
                                    - self.DENT_FADE_PER_S * dt)
                if self.dents[k] <= 0.0:
                    del self.dents[k]

    def _advance_driven(self, dt):
        """The walker with the gun taken: back along the walk to the far
        tower, where he waits; and, once the walk is clear again, back to
        the gun to take it back."""
        m = self.men[2]
        pace = self.pace(2)
        if m["mode"] == "driven":
            step = dt * pace / self.RUN_X_S
            left = m["goal"] - m["x"]
            m["x"] += max(-step, min(step, left))
            m["face"] = (1 if left > 0 else -1) if abs(left) > 1e-9 \
                else (1 if m["goal"] < 0.5 else -1)
            if abs(left) < 1e-9 and self.walk_clear():
                m.update(mode="retake", t0=self.phase, got=None)
            elif abs(left) < 1e-9 and self.bears_on("walk") \
                    and self.stormers_on(mode="walk"):
                m["mode"] = "brawl"
        elif m["mode"] == "brawl":
            foes = self.stormers_on(mode="walk")
            if not foes or not self.bears_on("walk"):
                m["mode"] = "driven"
                return
            st = min(foes, key=lambda o: abs(o["x"] - m["x"]))
            left = st["x"] - m["x"]
            m["face"] = 1 if left > 0 else -1
            if abs(left) > self.BEAR_REACH * 0.8:
                step = dt * pace / self.RUN_X_S
                m["x"] += max(-step, min(step, left))
            elif self.rng.random() < self.WALKER_KILL * dt * pace:
                st.update(hit=self.phase, hp=0, mauled=True)
                self.tally["walker_kills"] += 1
        elif m["mode"] == "retake":
            if not self.walk_clear():
                m.update(mode="driven", goal=float(self.gun_at < 0.5),
                         x=m["x"])
                return
            gx = self.gun_at
            left = gx - m["x"] + (0.05 if m["x"] > gx else -0.05)
            step = dt * pace / self.RUN_X_S
            if m["got"] is None:
                m["x"] += max(-step, min(step, left))
                m["face"] = 1 if left > 0 else -1
                if abs(left) < 1e-9:
                    m["got"] = self.phase
            elif self.phase - m["got"] >= self.RETAKE_S / pace:
                left = self.gun.get("load_left") or 0.0
                self.gun.update(taken=False, ready=self.phase + left,
                                load_left=None, aim=None)
                self._home_post(2)

    def _roof_to_mend(self):
        """The most damaged tower roof, if damaged enough to go up for."""
        side = 0 if self.roof[0] <= self.roof[1] else 1
        return side if self.roof[side] < self.MEND_BELOW else None

    def _advance_roofing(self, dt):
        """The walker going along the walk to a tower to mend its roof, and
        mending it; he goes back to his round if redcoats come."""
        m = self.men[2]
        if m["mode"] not in ("to_roof", "roof"):
            return
        side, pace = m["side"], self.pace(2)
        if self._time_to_foot(side) < self.START_S / 2 \
                or self.stormers_on():
            self._home_post(2)
        elif m["mode"] == "to_roof":
            goal = float(side == 1)
            step = dt * pace / self.WALK_S
            left = goal - m["x"]
            m["x"] += max(-step, min(step, left))
            m["face"] = 1 if left > 0 else -1
            if abs(goal - m["x"]) < 1e-9:
                m["mode"] = "roof"
        else:
            self.mend_roof(side, dt * pace * self.ROOF_MEND_PER_S)
            if self.roof[side] >= 1.0:
                self._home_post(2)

    def walk_clear(self):
        """No stormer is alive on the walk or its roofs, nor in the yard.
        Bears keeping watch do not count: the walker takes the gun back
        with them beside him."""
        return not self.stormers_on()

    def _bear_in_blast(self, face):
        """A bear on the walk is in front of the gun, within its reach."""
        gx = self.gun_at
        return any(0 <= (b["x"] - gx) * face <= self.FIRE_RANGE
                   for b in self.bears_on("walk"))

    def _fire_gun(self, ahead, pace):
        """The gun goes off along the wall walk: whoever is in front of it
        may be taken, and it must be reloaded."""
        g = self.gun
        g.update(fired=self.phase, aim=None,
                 ready=self.phase + self.RELOAD_S / pace)
        for st in ahead:
            if self.rng.random() < self.BLAST_KILL:
                st["hit"] = self.phase
                st["hp"] = 0
                self.tally["gun_kills"] += 1

    # -- the bears --------------------------------------------------------

    def rouse_bears(self, side):
        """THE BEARS COME. The first redcoat to set foot on the top of the
        wall rouses them, and it is the spot, not the man, that does it:
        last spring a mother bear with a wounded foreleg was taken in
        under the care of a mountain man of this fort, and she gave birth
        on that very place on the wall's top. She has a pale scar across
        that foreleg and a hate for anyone who touches it, and she comes
        at a run out of the woods, larger than the rest, and always. The
        woods come with her: one more bear for each the valley holds, up
        to three, all of them claws first up the stockade. Roused, they
        hunt redcoats wherever they are about the fort (see _bear_foes),
        the top first, and go home when none is left."""
        self.tally["bear_trips"] += 1
        self.bear_trigger = self.phase
        self.bear_firsts = False
        self.rousing = {"ground_s": 0.0, "ground_kills": 0, "down": False,
                        "idle_s": 0.0}
        n = 1 + min(3, max(0, self.valley_bears))
        for k in range(n):
            self.bears.append({
                "n": k, "mother": k == 0, "side": side, "layer": "ground",
                "intent": "attack", "g": self.rng.uniform(*self.BEAR_FAR_G),
                "u": 0.0, "x": 0.0, "wounds": 0, "maul": None,
                "stopped": None, "by": None, "t0": self.phase,
                "far": 0.0, "lane": 0.0, "dir": 1, "aim": None,
                "exit": None, "face": 1 if side == 0 else -1})
            self.bears[-1]["far"] = self.bears[-1]["g"]
            self.tally["bear_out"] += 1

    def bears_on(self, *layers):
        return [b for b in self.bears if b["layer"] in layers]

    def bear_on_walk(self):
        return bool(self.bears_on("walk", "yard"))

    def greeting(self):
        """The mother bear is at the walker, or on her way to him."""
        return any(b["intent"] == "greet" and b["layer"] == "walk"
                   for b in self.bears)

    def _end_x(self, side):
        return float(side == 1)

    def _wounded_enough(self, b):
        if b["intent"] != "attack":
            return False
        if b["mother"] and self.stormers_on(mode="yard"):
            return False    # she never leaves while a redcoat is in the yard
        return b["wounds"] >= self.WOUNDS[b["mother"]]

    def _bear_foes(self):
        """The redcoats a roused bear hunts below the top: those on a
        ladder, at the foot of either wall, on the near half of either
        trail, and any who left the trail to drive the walker from his
        rock. Not the far half of a trail: they do not go up to the
        barracks."""
        return [rc for rc in self.redcoats if rc["hit"] is None and (
            rc.get("climb") is not None or rc["at_wall"] is not None
            or rc.get("drive") or self.trail_p(rc["d"]) >= self.CLOSE_P)]

    def _foe_g(self, rc):
        """Where on the ground, from the foot of his wall, a redcoat is."""
        if rc.get("climb") is not None or rc["at_wall"] is not None:
            return 0.0
        return self.ground_g(rc)

    @staticmethod
    def _top_foe(rc):
        """Whether rc is a stormer (up on the top) rather than a redcoat
        on the ground."""
        return rc.get("mode") is not None

    def _top_x(self, st):
        """Where along the wall walk a redcoat up there is, for a bear
        going to him: those on a roof or in the yard are at their tower."""
        return st["x"] if st["mode"] == "walk" else self._end_x(st["side"])

    def _bear_is_up(self, b):
        return b["layer"] in ("walk", "yard") \
            or (b["layer"] == "wall" and b["dir"] > 0)

    def _bear_plan(self, dt):
        """What each bear means to do, from what it sees. They go home
        when no redcoat is left to hunt and the trails have been quiet;
        until then, the top comes first: every bear not already at a man
        goes up while any redcoat is on it (and the first time they are
        roused, to the top they were called for, whoever is left there);
        otherwise each goes to the nearest redcoat on the ground, the men
        driving the walker weighed ahead of the others, and a bear with
        nothing to fight waits at the woods' edge."""
        foes = self._bear_foes()
        tops = self.stormers_on()
        home = not foes and not tops and self.trail_quiet()
        sent = False
        for b in self.bears:
            if b["maul"] is not None:
                continue
            if b["intent"] == "attack" and home:
                b.update(intent="greet" if b["mother"] else "leave",
                         by=None, aim=None)
                sent = True
            elif b["intent"] in ("greet", "leave") and not home:
                b.update(intent="attack", by=None)      # more of them
        if sent:
            self.tally["bear_home"] += 1
        live = [b for b in self.bears if b["intent"] == "attack"]
        claims = {}
        free = []
        for b in live:
            if self._bear_is_up(b):
                b["aim"] = "top" if tops or not self.bear_firsts else None
            elif b["maul"] is not None:
                b["aim"] = b["maul"]["target"]
                claims[id(b["aim"])] = claims.get(id(b["aim"]), 0) + 1
            else:
                free.append(b)
        for b in free:
            if tops or not self.bear_firsts:
                b["aim"] = "top"
                continue
            here = b["g"] if b["layer"] == "ground" else 0.0
            best, score = None, math.inf
            for rc in foes:
                c = abs(self._foe_g(rc) - here) \
                    + (self.BEAR_CROSS_G if rc["side"] != b["side"] else 0.0) \
                    - (self.DRIVER_BONUS_G if rc.get("drive") else 0.0) \
                    + 0.8 * claims.get(id(rc), 0) \
                    - (0.3 if b["aim"] is rc else 0.0)
                if c < score:
                    best, score = rc, c
            b["aim"] = best
            if best is not None:
                claims[id(best)] = claims.get(id(best), 0) + 1
        if self.rousing is not None and any(
                b["aim"] not in (None, "top") for b in live):
            self.rousing["ground_s"] += dt      # redcoats near, and a bear
                                                # free to go for them

    def _advance_bears(self, dt):
        """The woods and the fort's whole surround: bears rouse, run in,
        climb, maul, climb down when the top is clear, hunt the redcoats on
        the ground, and go home when there are none, the mother last,
        stopping by the walker on her way."""
        stormers = self.stormers_on()
        if not self.bears and stormers and self.phase >= self.bear_rest:
            self.rouse_bears(min(stormers, key=lambda st: st["since"])["side"])
        if self.bears:
            self._bear_plan(dt)
            r = self.rousing
            if self.bears_on("walk", "yard") and not stormers:
                r["idle_s"] += dt
                self.tally["bear_top_idle_max"] = max(
                    self.tally["bear_top_idle_max"], r["idle_s"])
            else:
                r["idle_s"] = 0.0
        for b in self.bears:
            self._bear_step(b, dt)
        left = [b for b in self.bears if not b.get("gone")]
        if self.bears and not left:
            self.bear_rest = self.phase + self.BEAR_REST_S
            r, t = self.rousing, self.tally
            t["rousings_over"] += 1
            t["rousings_down"] += r["down"]
            if r["ground_s"] >= self.GROUND_SEEN_S:
                t["rousings_ground"] += 1
                t["rousings_ground_killed"] += r["ground_kills"] > 0
            self.rousing = None
        self.bears = left

    def _bear_step(self, b, dt):
        layer = b["layer"]
        if self._wounded_enough(b):
            b["intent"] = "withdraw"
            b["maul"] = None
            self.tally["bear_withdrawn"] += 1
        speed = 0.6 if b["intent"] == "withdraw" else 1.0
        if layer == "ground":
            self._bear_on_ground(b, dt, speed)
        elif layer == "wall":
            self._bear_on_wall(b, dt, speed)
        elif layer == "walk":
            self._bear_on_walk(b, dt, speed)
        else:
            self._bear_in_yard(b, dt, speed)

    def _bear_wounds(self, b, dt, here):
        """The redcoats in reach, with their bayonets, wound the bear."""
        n = sum(1 for st in here)
        if n and self.rng.random() < self.BAYONET_RATE * n * dt:
            b["wounds"] += 1

    def _bear_blow(self, b, target, dt):
        """The bear is at a man: it rears, strikes, and recovers, and the
        man may fall."""
        m = b["maul"]
        if m is None:
            b["maul"] = {"t0": self.phase, "target": target, "struck": False}
            return
        t = self.phase - m["t0"]
        if not m["struck"] and t >= self.MAUL_AT:
            m["struck"] = True
            tg = m["target"]
            if tg["hit"] is None and self.rng.random() < self.BEAR_KILL:
                tg.update(hit=self.phase, hp=0, mauled=True)
                self.tally["bear_kills"] += 1
                if not self._top_foe(tg):
                    self.tally["bear_ground_kills"] += 1
                    if self.rousing is not None:
                        self.rousing["ground_kills"] += 1
        if t >= self.MAUL_S:
            b["maul"] = None

    # On the ground: where it goes, the lane it is in (0 the woods' own,
    # 1 the trail's, where the redcoats march), and how it is hurt.

    def _bear_ground_move(self, b, goal, dt, speed=1.0, lane=0.0):
        """Run along the ground toward goal, in the given lane."""
        run = self.BEAR_RUN_G_S * dt * speed
        d = goal - b["g"]
        b["g"] += max(-run, min(run, d))
        k = dt / self.BEAR_LANE_S
        b["lane"] += max(-k, min(k, lane - b["lane"]))
        if abs(d) > 1e-9:
            inward = 1 if b["side"] == 0 else -1
            b["face"] = inward if d < 0 else -inward

    def _bear_cross(self, b, dt):
        """Out through the woods and round to the other side's wall."""
        self._bear_ground_move(b, b["far"], dt)
        if b["g"] >= b["far"] - 1e-9:
            b["side"] = 1 - b["side"]

    def _bear_ground_wounds(self, b, dt, charging):
        """Redcoats on the ground fight back: bayonets on a bear at their
        elbow, and a musket shot at one charging in."""
        near, shooters = 0, 0
        for rc in self.redcoats:
            if rc["side"] != b["side"] or rc["hit"] is not None \
                    or rc.get("climb") is not None:
                continue
            gap = abs(self._foe_g(rc) - b["g"])
            if gap <= self.BEAR_REACH_G * 1.5 and b["lane"] > 0.5:
                near += 1
            elif charging and rc["kind"] != "horse" \
                    and gap <= self.MUSKET_G:
                shooters += 1
        near, shooters = min(near, 2), min(shooters, 3)    # elbow room
        if near and self.rng.random() < self.BAYONET_RATE * near * dt:
            b["wounds"] += 1
        if shooters and self.rng.random() < self.MUSKET_RATE * shooters * dt:
            b["wounds"] += 1
            self.tally["bear_musket"] += 1

    def _greet_plan(self):
        """Where the mother is to stop by the walker: ("ground", side, g)
        if he is out in the woods, ("walk", side, x) if he is on the wall,
        or None if there is no walker."""
        if not self.has_walker:
            return None
        m = self.men[2]
        if self.out(2):
            return "ground", m["side"], m.get("g", 0.0) + self.BY_WALKER_G
        wx = self.walker_x()[0]
        return "walk", 0 if wx < 0.5 else 1, wx

    def _bear_top_side(self, b):
        """The wall a bear is to climb to get at the redcoats up there,
        by the time it takes: round through the woods, and along the
        walk."""
        tops = self.stormers_on()
        best, score = b["side"], math.inf
        if not tops:
            return best
        for side in (0, 1):
            sec = (0.0 if side == b["side"]
                   else 2.0 * b["far"] / self.BEAR_RUN_G_S)
            sec += min(abs(self._top_x(st) - self._end_x(side))
                       for st in tops) * self.BEAR_WALK_S
            if sec < score:
                best, score = side, sec
        return best

    def _bear_on_ground(self, b, dt, speed):
        intent = b["intent"]
        if intent in ("withdraw", "leave"):
            self._bear_ground_move(b, b["far"], dt, speed)
            if b["g"] >= b["far"] - 1e-9:
                b["gone"] = True
            return
        if intent == "greet":
            plan = self._greet_plan()
            if plan is None:
                b["intent"] = "leave"
                return
            kind, side, goal = plan
            if b["side"] != side:
                self._bear_cross(b, dt)
            elif kind == "ground":
                self._bear_ground_move(b, goal, dt)
                if abs(goal - b["g"]) < 0.05:
                    if b["by"] is None:
                        b["by"] = self.phase
                    elif self.phase - b["by"] >= self.BY_WALKER_S:
                        b["intent"] = "leave"
                else:
                    b["by"] = None
            else:
                self._to_the_wall(b, dt)
            return
        # Hunting.
        self._bear_ground_wounds(b, dt, b["maul"] is None
                                 and b["aim"] is not None)
        if b["maul"] is not None:
            tg = b["maul"]["target"]
            if tg["hit"] is not None \
                    and self.phase - b["maul"]["t0"] >= self.MAUL_AT:
                b["maul"] = None
            else:
                self._bear_blow(b, tg, dt)
            return
        aim = b["aim"]
        if aim == "top":
            if self._bear_top_side(b) != b["side"]:
                self._bear_cross(b, dt)
            else:
                self._to_the_wall(b, dt)
        elif aim is not None:
            if aim["side"] != b["side"]:
                self._bear_cross(b, dt)
                return
            goal = self._foe_g(aim)
            self._bear_ground_move(b, goal, dt, lane=1.0)
            if abs(goal - b["g"]) <= self.BEAR_REACH_G * 0.8 \
                    and b["lane"] >= 0.95:
                self._bear_blow(b, aim, dt)
        else:
            self._bear_ground_move(
                b, self.BEAR_WAIT_G + self.BEAR_WAIT_DG * b["n"], dt)

    def _to_the_wall(self, b, dt):
        """To the foot of the wall by the woods' lane, and up it."""
        self._bear_ground_move(b, 0.0, dt)
        if b["g"] <= 1e-9 and b["lane"] <= 1e-9:
            b.update(layer="wall", u=0.0, dir=1)

    def _bear_on_wall(self, b, dt, speed):
        """On the outside of the wall, climbing or coming down it, claws
        to the logs either way."""
        intent = b["intent"]
        up = (intent == "attack" and b["aim"] == "top") \
            or (intent == "greet" and self._greet_plan() is not None
                and self._greet_plan()[0] == "walk")
        b["dir"] = 1 if up else -1
        b["u"] += b["dir"] * dt * speed / self.BEAR_CLIMB_S
        if b["u"] >= 1.0:
            b.update(layer="walk", u=1.0, x=self._end_x(b["side"]))
            if not self.bear_firsts:
                self.bear_firsts = True
                self.tally["bear_wall"] += 1
                self.tally["bear_lag_s"] += self.phase - self.bear_trigger
        elif b["u"] <= 0.0:
            b.update(layer="ground", u=0.0, g=0.0, lane=0.0)

    def _bear_descend(self, b, step):
        """Nothing left up here: along the walk to the wall's end and down
        the outside, to the side with the redcoats to be fought if any."""
        x = b["x"]
        if b["exit"] is None:
            side = 0 if x < 0.5 else 1
            if b["intent"] == "attack":
                foes = self._bear_foes()
                if foes:
                    near = min(foes, key=lambda rc: self._foe_g(rc)
                               + (0.0 if rc["side"] == side else 1.0))
                    side = near["side"]
            b["exit"] = side
        end = self._end_x(b["exit"])
        if abs(end - x) > 1e-9:
            b["x"] += max(-step, min(step, end - x))
            b["face"] = 1 if end > x else -1
            return
        b.update(layer="wall", u=1.0, dir=-1, side=b["exit"], exit=None,
                 aim=None)
        self.tally["bear_downs"] += 1
        if self.rousing is not None:
            self.rousing["down"] = True

    def _bear_on_walk(self, b, dt, speed):
        side, x = b["side"], b["x"]
        step = dt * speed / self.BEAR_WALK_S
        reach = self.BEAR_REACH
        foes = self.stormers_on(mode="walk")
        hackers = self.stormers_on(mode="hack")
        # The redcoats near it wound it, whatever it means to do.
        near = [st for st in foes if abs(st["x"] - x) <= reach] \
            + [st for st in hackers
               if abs(self._end_x(st["side"]) - x) <= reach]
        self._bear_wounds(b, dt, near)
        if b["intent"] == "attack":
            goals = [(abs(st["x"] - x), st["x"], st) for st in foes] \
                + [(abs(self._end_x(st["side"]) - x),
                    self._end_x(st["side"]), st) for st in hackers]
            if b["maul"] is not None:
                if b["maul"]["target"]["hit"] is not None \
                        and self.phase - b["maul"]["t0"] >= self.MAUL_AT:
                    b["maul"] = None
                else:
                    self._bear_blow(b, b["maul"]["target"], dt)
                    return
            if goals:
                b["exit"] = None
                dist, gx, st = min(goals, key=lambda g: g[0])
                if dist <= reach * 0.8:
                    self._bear_blow(b, st, dt)
                else:
                    b["x"] += max(-step, min(step, gx - x))
                    b["face"] = 1 if gx > x else -1
                return
            if self.stormers_on(mode="yard") or self.stormers_on(
                    mode="drop"):
                end = self._end_x(side)
                if abs(end - x) > 1e-9:
                    b["x"] += max(-step, min(step, end - x))
                    b["face"] = 1 if end > x else -1
                else:
                    b.update(layer="yard", u=0.02 if side == 0 else 0.98,
                             v=0.0)
                return
            self._bear_descend(b, step)
            return
        if b["intent"] == "greet":
            plan = self._greet_plan()
            if plan is None:
                b["intent"] = "leave"
            elif plan[0] == "ground":
                self._bear_descend(b, step)     # he is out in the woods
                return
            else:
                wx = plan[2]
                stand = min(1.0, max(0.0, wx + (-1 if side == 0 else 1)
                                     * self.BY_WALKER_DX))
                if abs(stand - x) > 0.01:
                    b["x"] += max(-step, min(step, stand - x))
                    b["face"] = 1 if wx > x else -1
                else:
                    if b["by"] is None:
                        b["by"] = self.phase
                    b["face"] = 1 if wx > x else -1
                    others = [o for o in self.bears if not o["mother"]
                              and o["layer"] != "ground"]
                    if self.phase - b["by"] >= self.BY_WALKER_S \
                            and not others:
                        b["intent"] = "leave"
                return
        # Leaving, or withdrawn: back along the walk and down.
        self._bear_descend(b, step)

    def _bear_in_yard(self, b, dt, speed):
        step = dt * speed / self.BEAR_YARD_S
        reach = self.BEAR_REACH * 2
        foes = self.stormers_on(mode="yard")
        self._bear_wounds(b, dt, [st for st in foes
                                  if math.hypot(st["u"] - b["u"],
                                                st["v"] - b["v"]) <= reach])
        if b["intent"] == "attack":
            if b["maul"] is not None:
                tg = b["maul"]["target"]
                if tg["hit"] is not None \
                        and self.phase - b["maul"]["t0"] >= self.MAUL_AT:
                    b["maul"] = None
                else:
                    self._bear_blow(b, tg, dt)
                    return
            if foes:
                st = min(foes, key=lambda o: math.hypot(
                    o["u"] - b["u"], o["v"] - b["v"]))
                gu, gv = st["u"] - b["u"], st["v"] - b["v"]
                dist = math.hypot(gu, gv)
                if dist <= reach * 0.8:
                    self._bear_blow(b, st, dt)
                else:
                    b["u"] += gu / dist * min(step, dist)
                    b["v"] += gv / dist * min(step, dist)
                    b["face"] = 1 if gu > 0 else -1
                return
        # Back to the wall's end, and up to the walk.
        eu = 0.02 if b["side"] == 0 else 0.98
        gu, gv = eu - b["u"], 0.0 - b["v"]
        dist = math.hypot(gu, gv)
        if dist > 0.03:
            b["u"] += gu / dist * min(step, dist)
            b["v"] += gv / dist * min(step, dist)
            b["face"] = 1 if gu > 0 else -1
        else:
            b.update(layer="walk", x=self._end_x(b["side"]))

    # -- the walls --------------------------------------------------------

    def breached(self, side):
        """The wall on side has no strength left: there is a gap."""
        return self.wall[side] <= 0.0

    def hurt(self, side, amount):
        """The wall on side takes a blow."""
        before = self.wall[side]
        self.wall[side] = max(0.0, before - amount)
        self.tally["hurt"][side] += before - self.wall[side]
        if before > 0.0 and self.wall[side] <= 0.0:
            self.tally["breaches"] += 1

    def mend(self, side, amount):
        """The wall on side is made stronger."""
        before = self.wall[side]
        self.wall[side] = min(1.0, before + amount)
        self.tally["mended"][side] += self.wall[side] - before

    def wait_at_breach(self, rc):
        """THE BREACH: a redcoat at the foot of a wall with a gap in it.
        After THROUGH_S he goes through, and from inside the gap up onto
        the wall walk, if there is room for him there, and a man on foot or
        a horseman is a stormer from then on. One who cannot get anywhere,
        a gun's crew or a man with no room, does not wait for ever: he
        tires after BREACH_WAIT_S and goes back up the trail out of the
        picture, so a steady siege still has its lulls."""
        if rc["at_wall"] is None:
            return
        waited = self.phase - rc["at_wall"]
        side = rc["side"]
        if waited >= self.THROUGH_S and rc["kind"] != "cannon" \
                and self.phase - self.gap_at[side] >= self.GAP_S \
                and self._room_on_top(side):
            self.gap_at[side] = self.phase
            self._step_onto(rc)
        elif waited >= self.BREACH_WAIT_S:
            rc["gone"] = True

    def _pound(self, dt):
        """Redcoats at the wall's foot beat on it; a cannon fires into the
        logs. A breached wall takes nothing more."""
        for rc in list(self.redcoats):
            if rc["hit"] is not None or not self.at_wall(rc) \
                    or rc.get("climb") is not None:
                continue
            side = rc["side"]
            if self.breached(side):
                self.wait_at_breach(rc)
            elif rc["kind"] == "cannon":
                due = int((self.phase - rc["at_wall"]) / self.BOOM_EVERY) + 1
                while rc.get("booms", 0) < due:
                    rc["booms"] = rc.get("booms", 0) + 1
                    self.hurt(side, self.HURT_PER_BALL)
            else:
                self.hurt(side, self.HURT_PER_S[rc["kind"]] * dt)

    # -- the redcoats -----------------------------------------------------

    def at_wall(self, rc):
        """At the wall itself, rather than waiting in the queue behind."""
        return rc["at_wall"] is not None and rc["slot"] < self.AT_WALL

    def cover(self, rc):
        """How far a redcoat has stepped off the trail behind his boulder,
        0..1: he ducks in quickly and steps out again more slowly."""
        if "rock" not in rc or not self.boulders[rc["rock"]]:
            return 0.0
        if rc["hid"] is not None:
            return self.ramp(self.phase - rc["hid"], 0.0, 0.35)
        return 1.0 - self.ramp(self.phase - rc["rose"], 0.0, 0.6)

    def door_open(self, i):
        """Someone has just come out of barracks i (not off a boat)."""
        return any(rc["side"] == i and not rc.get("boat")
                   and self.phase - rc["born"] < self.DOOR_OPEN_S
                   for rc in self.redcoats)

    def send(self, side, kind, d=None, boat=None):
        """A redcoat sets out from the barracks on trail side, or, given d
        and a place to hop from, steps ashore from a boat there."""
        self.redcoats.append({"side": side, "d": d or self.MARCH_FAR,
                              "hit": None, "n": self.spawned,
                              "stride": self.vary(0.1),
                              "born": self.phase, "kind": kind,
                              "hp": self.HP[kind], "struck": None,
                              "at_wall": None, "slot": 0, "boat": boat})
        self.spawned += 1
        self.tally["sent"][kind] += 1

    def land(self, side, d, bow):
        """A man from a boat steps ashore on trail side at distance d, to
        hop from bow, wherever the view has it."""
        self.send(side, "foot", d, bow)

    def advance(self, dt, walker_busy=False, afloat=None):
        """Step the siege dt seconds: the gun, the redcoats' march, the
        barracks' calls and the sentries choosing whom to shoot. The
        clock is moved first, by tick(). walker_busy says he is shooting
        at a boat; afloat, if given, is called between the barracks' calls
        and the new arrivals, to run the boats and let men land from them."""
        self._advance_relief(dt, walker_busy)
        self._pound(dt)
        speed = (self.MARCH_FAR - self.MARCH_NEAR) / self.MARCH_S
        for side in (0, 1):
            # Two at a time beat on the wall; the rest wait in a queue back
            # up the trail, and all of it shuffles forward when a place at
            # the wall comes free.
            halted = [rc for rc in self.redcoats if rc["side"] == side
                      and rc["hit"] is None and rc["at_wall"] is not None]
            front = {rc["slot"] for rc in halted if rc["slot"] < self.AT_WALL}
            if len(front) < self.AT_WALL:
                for rc in halted:
                    if rc["slot"] >= self.AT_WALL:
                        rc["at_wall"] = None
                halted = [rc for rc in halted if rc["at_wall"] is not None]
            moving = sorted((rc for rc in self.redcoats
                             if rc["side"] == side and rc["hit"] is None
                             and rc["at_wall"] is None),
                            key=lambda rc: rc["d"])
            rock = self.boulders[side]
            nearest = min((rc for rc in self.redcoats if rc["side"] == side
                           and rc["hit"] is None), key=lambda rc: rc["d"],
                          default=None)
            for rc in moving:
                if rc.get("drive"):
                    continue    # he has left the trail for the woods
                if rc.get("hid") is not None:
                    # Not until the fire on him slackens: under steady fire
                    # he stays down until the third shot finds him.
                    if self.phase - rc["hid"] < self.HIDE_S or \
                            self.phase - rc["shot_at"] < self.LULL_S:
                        continue
                    rc["hid"], rc["rose"] = None, self.phase
                was = self.trail_p(rc["d"])
                rc["d"] = max(self.MARCH_NEAR,
                              rc["d"] - speed * self.PACE[rc["kind"]]
                              * rc.get("stride", 1.0) * dt)
                # A man on foot who reaches the boulder with a rifle on him
                # drops behind it, once.
                if rock and rc["kind"] == "foot" and "rock" not in rc \
                        and was < self.COVER_P <= self.trail_p(rc["d"]) \
                        and (self.drill_target[side] is rc
                             or rc is nearest) \
                        and not any(o.get("hid") is not None
                                    and o["side"] == side
                                    and o["hit"] is None
                                    for o in self.redcoats):
                    rc.update(d=self.trail_d(self.COVER_P), hid=self.phase,
                              rock=side, ducked=0, shot_at=self.phase)
                    continue
                k = len(halted)
                stop = 1.0 if k < self.AT_WALL \
                    else 1.0 - self.QUEUE_P * (k - self.AT_WALL + 1)
                if self.trail_p(rc["d"]) >= stop - 1e-9:
                    rc["at_wall"] = self.phase
                    taken = {o["slot"] for o in halted}
                    rc["slot"] = min(set(range(k + 1)) - taken) \
                        if k < self.AT_WALL else k
                    halted.append(rc)
                    if rc["slot"] < self.AT_WALL and not rc.get("reached"):
                        rc["reached"] = True
                        self.tally["reached"] += 1
        self.redcoats = [rc for rc in self.redcoats if not rc.get("gone")
                         and (rc["hit"] is None or self.phase - rc["hit"] < (
                             self.FLEE_S if rc["kind"] == "horse"
                             else self.FALL_S))]

        if self.pending_call is not None and \
                self.phase - self.pending_call[1] > self.pending_call[2]:
            self.call(self.pending_call[0], self.FILE)
            self.pending_call = None
        if self.flood:
            self.flood_in -= dt
            if self.flood_in <= 0:
                self.call(self.floods % 2, self.WAVE)
                self.flood_in = self.FLOOD_EVERY
                self.floods += 1
        self.wave_in -= dt
        if self.wave_in <= 0:
            self.call(self.waves % 2, self.WAVE)
            self.wave_in = self.WAVE_EVERY[self.waves % 3] * self.vary(0.3)
            self.waves += 1

        def door_clear(side):
            return all(rc["d"] < self.MARCH_FAR - self.DOOR_GAP
                       for rc in self.redcoats if rc["side"] == side)

        for side in (0, 1):
            if self.called[side] and door_clear(side):
                self.send(side, self.called[side].pop(0))

        if afloat is not None:
            afloat()
        self.spawn_in -= dt
        if self.spawn_in <= 0:
            n = self.spawned
            side = (0, 1, 1, 0, 1, 0, 0, 1)[n % 8]
            marching = sum(rc["side"] == side and rc["hit"] is None
                           for rc in self.redcoats)
            if marching < 2 and door_clear(side):
                self.send(side, "foot")
                self.spawn_in = (6.0, 4.5, 7.5, 5.0)[n % 4] * self.vary(0.25)
            else:
                self.spawn_in = 1.0

        self._advance_ladder(dt)
        self._advance_men(dt, walker_busy)
        for i in (0, 1):
            targets = [rc for rc in self.redcoats
                       if rc["side"] == i and rc["hit"] is None]
            nearest = min(targets, key=lambda rc: rc["d"], default=None)
            man = self.men[i]
            if self.ousted(i):
                self.drill_start[i] = None   # he has given way to the far tower
                continue
            if man["mode"] == "post" and not self.busy(i) \
                    and not self.calling(i) and self._wants_shove(i):
                man.update(mode="shove", t0=self.phase, side=i)
                continue
            if self._sentry_may_rest(i):
                self._to_pot(i, "rest")
                continue
            if man["mode"] not in ("post", "eat"):
                continue  # he is at the ladder, or below it, or shoving
            if man["mode"] == "eat":
                # He never leaves his post; he sits where he stands, and
                # stands up first if called to his rifle.
                if self._meal(i, dt, not self.in_range()
                              and not self.busy(i)):
                    man["mode"] = "post"
                elif self.busy(i):
                    self.drill_start[i] = max(
                        self.drill_start[i], (man["up"] or self.phase)
                        + self.RISE_S)
                continue
            if not self.busy(i) and self.lull(self.MEAL_AFTER_S) \
                    and man["hunger"] >= self.EAT_AT:
                self._sit_down(i)
                continue
            if not self.busy(i):
                self.drill_target[i] = None
                if self.calling(i):
                    continue  # his hands are on the horn
                # He fires on men in the open before one behind a rock.
                near = [rc for rc in targets
                        if self.trail_p(rc["d"]) >= self.ENGAGE_P]
                open_ = [rc for rc in near if rc.get("hid") is None]
                pick = min(open_ or near, key=lambda rc: rc["d"],
                           default=None)
                if pick:
                    self.drill_start[i] = self.phase
                    self.drill_target[i] = pick
                    self.drill_fired[i] = False
                continue
            tau = self.drill_t(i)
            target = self.drill_target[i]
            if target is None and 0 <= tau < self.SHOT_AT:
                # Called by the bugle: he takes whoever is closest.
                self.drill_target[i] = target = nearest
            if tau >= self.SHOT_AT and not self.drill_fired[i]:
                self.drill_fired[i] = True
                if target is not None and target["hit"] is None \
                        and target.get("hid") is not None:
                    # Behind the boulder, only every third shot finds him.
                    target["ducked"] += 1
                    target["shot_at"] = self.phase
                    if target["ducked"] % 3:
                        if self.boulders[target["rock"]]:
                            self.chipped[target["rock"]] = self.phase
                        continue
                if target is not None and target["hit"] is None:
                    target["hp"] -= 1
                    target["struck"] = self.phase
                    if target["hp"] <= 0:
                        target["hit"] = self.phase
                        self.tally["shot"] += 1
        # A hungry man's drill drags: each second of it is a little longer.
        for i in (0, 1):
            start = self.drill_start[i]
            if start is not None and self.phase - start < self.DRILL_LEN:
                self.drill_start[i] = start + dt * (1.0 - self.pace(i))


class CpuView(Gtk.DrawingArea):
    """Every physical core as a tile, each of its threads a live load bar.

    The chip sits in open country with a river running across it, in a
    valley that lives on its own (World): the seasons turn over the whole
    picture, beavers fell trees along the banks and build dams and
    lodges, and trappers trap them, chop and build cabins, cook at their
    fires and sit out the winter, or die of it; bears fish, den up and
    now and then fight a trapper, drawn shot, blood and all, in the idle
    picture only. The world runs on whether the fort is up or down; this
    view only draws it.

    While the fort is up, the reserved cores stand inside a log stockade,
    embers rising in their orange tiles; mountain men watch from its
    towers and walk its wall, redcoats march on it down trails from
    barracks in the far corners or come down the river in boats, take
    cover behind boulders, and the sentries and the fort's gun see them
    off. Boats row past the first ford to put their men ashore at the
    second, and the one walking the wall takes shots at them as they pass:
    every man he hits is one fewer marching on the wall. The
    river still shows the beavers' dams, ponds and lodges, and the beavers
    swimming. While it is down, a grove grows there instead and those
    cores look like every other; around it are the valley's woods, the
    trappers at their work, their cabins, caches and graves, loose horses
    grazing, and a small almanac of the season in the corner. Which state
    it is in never depends on telling orange from blue.
    """

    COLS = 5

    def __init__(self):
        super().__init__(content_height=400, hexpand=True, vexpand=True)
        self.cores = []
        self.reserved = set()
        self.on = False
        self.loads = {}       # cpu -> target load
        self.shown = {}       # cpu -> displayed load, eased toward target
        self.phase = 0.0                  # the scene's clock, in seconds
        self.last_draw = -1.0             # real seconds, as self.real
        self._t0 = None
        self.real = 0.0                   # real seconds since the first frame
        self.speed = 1                    # scene seconds per real second
        self._base = (0.0, 0.0)           # (real, phase) the speed last set
        self.siege = Siege(seed=7)        # the rules; this view draws them
        self.siege.boulders = [False, False]  # none laid until drawn
        self.siege.has_walker = False
        self.gun_facing = 1
        self.stains = []                  # (x, y, size, phase) of the fallen
        self.barracks_box = [None, None]  # (x0, y0, x1, y1) as last drawn
        self.trails = None                # each side's trail, as last drawn
        self.redcoat_s = 14.0             # a redcoat's size at the near end
        self.walker_at = None             # (x, feet) as last drawn
        self.sentries_at = None           # (towers, floor, size) as drawn
        self.yard_tiles = []              # (x, y, w, h) of each fort tile
        self.yard_geo = None              # (x, y, w, h) of the yard
        self.potshot = None               # his shot at a boat, if taking one
        self.potshot_after = 0.0          # siege time he may next shoot
        self.overboard = []               # men shot out of the boats
        self.fort_box = None              # (x0, y0, x1, y1) as last drawn
        self.fort_geo = None              # the stockade's measures, as drawn
        self.river = None                 # its course, as last laid out
        self.fords = [None, None]         # p where each trail crosses it
        self.rocks = [None, None]         # each trail's cover, as last laid
        self.hrocks = [[], []]            # each side's three hiding rocks
        self.hrocks_key = None
        self.scenery = None               # the siege's woods, per size
        self.boats = []                   # bateaux of redcoats on the river
        self.boat_in = 30.0
        self.boats_sent = 0
        self.rng = random.Random(7)       # the horses' only source of chance
        self.wild = None                  # the idle scene's layout, per size
        self.horses = []
        self.world = World(seed=7)
        self.time_scale = 1.0             # world seconds per real second
        self.current = 0.0                # how far the glints have drifted
        self.world_at = None              # monotonic s the world last ran
        self.look = self._season_look()   # the season's colours, per frame
        self.set_draw_func(self._draw)
        self.add_tick_callback(self._on_tick)
        click = Gtk.GestureClick()
        click.connect("pressed", self._on_click)
        self.add_controller(click)
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        self.add_controller(motion)

    def set_state(self, cores, reserved, on):
        self.cores = cores
        self.reserved = set(reserved)
        if not on:
            # Standing down sends everyone home; the next siege starts fresh.
            self.boats = []
            self.potshot = None
            self.overboard = []
            self.potshot_after = 0.0
            self.stains = []
            old, self.siege = self.siege, Siege(seed=7)
            self.siege.boulders = old.boulders
            self.siege.has_walker = old.has_walker
        self.on = on
        self.queue_draw()

    def set_world(self, world):
        self.world = world
        self.wild = None  # its places are laid out afresh
        self.look = self._season_look()

    CATCH_UP_MAX = 10.0  # most real seconds one catch-up makes good

    def catch_up(self, now):
        """Run the world on to real time now (monotonic seconds) if the
        picture has stopped ticking: hidden, minimised, or another page
        showing. A long gap, like a suspend, counts for only a little."""
        if self.world_at is not None and now - self.world_at > 1.0:
            gap = min(now - self.world_at, self.CATCH_UP_MAX)
            self.world.advance(gap * self.time_scale * self.speed)
        if self.world_at is None or now - self.world_at > 1.0:
            self.world_at = now

    def set_loads(self, loads):
        self.loads = loads

    def set_speed(self, speed):
        """Run the whole scene, siege, boats and valley alike, at speed
        times real time from here on, like fast-forwarding a film. The
        fort itself, its loads and the user's clicks stay on real time."""
        self._base = (self.real, self.phase)
        self.speed = speed

    def _on_tick(self, widget, clock):
        now = clock.get_frame_time()
        if self._t0 is None:
            self._t0 = now
        prev = self.real
        self.real = (now - self._t0) / 1_000_000.0
        real0, phase0 = self._base
        self.phase = phase0 + (self.real - real0) * self.speed
        dt = max(0.0, self.real - prev)
        # Faster is more frames' worth of the same steps, not longer steps.
        for _ in range(self.speed):
            self._advance(min(dt, 0.1), dt)
        self.world_at = GLib.get_monotonic_time() / 1_000_000.0
        # Frame-rate independent easing: the same glide at 30 Hz or 144 Hz.
        k = 1.0 - math.exp(-dt * 7.0)
        for cpu, target in self.loads.items():
            cur = self.shown.get(cpu, target)
            self.shown[cpu] = cur + (target - cur) * k

        root = widget.get_root()
        focused = root is not None and root.is_active()
        if focused or self.real - self.last_draw >= IDLE_REDRAW_S:
            self.last_draw = self.real
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    @staticmethod
    def _in_box(box, x, y):
        return box is not None and box[0] <= x <= box[2] \
            and box[1] <= y <= box[3]

    def _on_fort(self, x, y):
        return self._in_box(self.fort_box, x, y)

    def _barracks_at(self, x, y):
        for i, box in enumerate(self.barracks_box):
            if self._in_box(box, x, y):
                return i
        return None

    def _on_river(self, x, y):
        r = self.river
        return r is not None and abs(y - self._river_y(x)) <= \
            self._river_half(x) + r["half"] * 0.35 + 1

    def _on_motion(self, _ctl, x, y):
        hot = self._on_fort(x, y) or self._barracks_at(x, y) is not None \
            or (self.on and self._on_river(x, y))
        self.set_cursor_from_name("pointer" if hot else None)

    def _on_click(self, _gesture, n, x, y):
        """A click on a barracks sends out a file of redcoats, a double
        click a wave of cavalry and a cannon. One on the fort has the walker
        sound his bugle the way he faces, and the tower sentry on that side
        kneels and fires, at a redcoat if one is in sight. One on the river
        sends a boatload of redcoats down it."""
        i = self._barracks_at(x, y)
        if i is not None:
            # Its wait is on the siege's clock, the click's on real time.
            self.siege.click_barracks(i, n,
                                      self._double_click_s() * self.speed)
            return
        if not self._on_fort(x, y):
            if self.on and self._on_river(x, y):
                self._launch_boat()
            return
        self.siege.sound_bugle(1 if self.siege.walker_x()[1] > 0 else 0,
                               self.potshot is not None)

    def _double_click_s(self):
        settings = self.get_settings()
        ms = settings.props.gtk_double_click_time if settings else 400
        return ms / 1000.0

    def _advance(self, dt, elapsed=None):
        """Step the scene: the walker's halts, and the siege, which runs
        the redcoats, the sentries and the gun while the fort is up. The
        valley's clock runs on whether the fort is up or down. elapsed is
        how long the clock really moved, if a stalled frame is stepped by
        only dt."""
        self.world.advance(dt * self.time_scale)
        # The current slows under the winter ice.
        self.current += dt * 0.035 * (1 - 0.7 * self.look["winter"])
        siege = self.siege
        siege.valley_bears = sum(b["job"] != "dead"
                                 for b in self.world.predators)
        if self.on:
            siege.tick(dt if elapsed is None else elapsed)
        if not self.on:
            if self.wild is not None:
                self._advance_horses(dt)
            return
        # A boat of redcoats on the river is in sight, too.
        siege.boats_in_sight = any(b["men"] > 0 and b["landed"] is None
                                   for b in self.boats)
        siege.advance(dt, self.potshot is not None,
                      lambda: self._advance_afloat(dt))

    def _advance_afloat(self, dt):
        """Between the barracks' calls and the new arrivals: the walker's
        shots at the boats, and the boats themselves."""
        self._advance_potshot(dt)
        self._advance_boats(dt)

    # -- the boats --------------------------------------------------------

    BOAT_MEN = 4        # a steersman and three at the oars
    BOAT_EVERY = (110.0, 140.0)
    BOATS_MAX = 2       # most afloat at once
    LAND_GAP_S = 1.4    # between one man stepping ashore and the next
    ASHORE_S = 0.6      # a man takes this long to step from the bow
    BANK_WALK = 1.5     # then walks down the bank this many sizes a second
    CREW_X = (-64, 45, 8, -28)  # the steersman, then the oars, in the model

    def _launch_boat(self, side=1):
        """Put a boat in at the upstream edge, bound for side's ford, or
        the other if side's trail does not cross the river. Side 1's ford is
        the downstream one: a boat bound there rows past the first ford and
        the whole length of the fort's wall, under the walker's rifle."""
        if len(self.boats) >= self.BOATS_MAX:
            return False
        if self.fords[side] is None:
            side = 1 - side
            if self.fords[side] is None:
                return False
        self.boats.append({"side": side, "x": -self._boat_m(side) * 0.9,
                           "men": self.BOAT_MEN, "landed": None,
                           "next_at": 0.0, "left": None, "adrift": None,
                           "lands": True, "n": self.boats_sent})
        self.boats_sent += 1
        return True

    def _boat_m(self, side):
        """The size of a man in a boat bound for side's ford: as big as he
        will be stepping ashore there."""
        p = self.fords[side] if self.fords[side] is not None else 0.5
        return self.redcoat_s * self._depth_scale(p)

    def _boat_stop(self, b):
        """Where the boat's middle comes to rest, its bow just short of
        the ford's stones; None if it is not putting in at a ford. At the
        downstream ford it pulls in short of the tower instead, its whole
        length clear of the sentry there, so the walker's line of fire
        stays open while its men step out and walk down the bank."""
        p = self.fords[b["side"]]
        if p is None or self.trails is None or not b["lands"] \
                or b["men"] == 0:
            return None
        x = self._bezier(self.trails[b["side"]], p)[0]
        m = self._boat_m(b["side"])
        stones = self.redcoat_s * 0.5 * self._depth_scale(p) * 0.9
        stop = x - stones - m * 0.9
        if b["side"] == 1 and self.sentries_at is not None:
            towers, _, s = self.sentries_at
            stop = min(stop, towers[1] - s * 0.5 - m * 0.95)
        return stop

    def _landing_p(self, side):
        """Where on the trail a man from the boat steps ashore: the far
        bank, just up the trail from the ford's stones."""
        p = self.fords[side]
        if p is None:
            return 0.0
        mud = self.river["half"] * 0.35 + 1
        for k in range(60):
            q = max(0.0, p - k * 0.005)
            x, y = self._bezier(self.trails[side], q)
            if y <= self._river_edge(x, -1) - mud or q == 0.0:
                return q
        return q

    def _boat_at(self, b):
        """The boat's waterline (x, y) and how far it has pulled in toward
        the far bank, 0..1."""
        m = self._boat_m(b["side"])
        stop = self._boat_stop(b)
        if b["left"] is not None:
            pull = 1.0 - self._ramp(self.siege.phase - b["left"], 0.0, 2.5)
        elif b["adrift"] is not None:
            t, pull = b["adrift"]
            pull *= 1.0 - self._ramp(self.siege.phase - t, 0.0, 2.5)
        elif stop is None:
            pull = 0.0
        else:
            pull = 1.0 - min(1.0, max(0.0, (stop - b["x"]) / (2.5 * m)))
            pull = pull * pull * (3 - 2 * pull)
        x = b["x"]
        y = self._river_y(x) + self._river_half(x) * (0.1 - 0.55 * pull)
        return x, y, pull

    def _bow(self, b):
        x, y, _ = self._boat_at(b)
        return x + self._boat_m(b["side"]) * 0.75, y

    def _aboard(self, b, k):
        """Where the k-th of the boat's crew sits: (x, waterline)."""
        x, y, _ = self._boat_at(b)
        return x + self.CREW_X[k] * self._boat_m(b["side"]) / 100, y

    def _advance_boats(self, dt):
        """Boats come down the river now and then, row past the first ford
        and pull in at the second; whoever the walker has not shot by then
        steps ashore onto the trail, one by one, and the empty boat drifts
        on downstream. One whose crew is all shot drifts off too."""
        if self.trails is None or self.river is None:
            return
        self.boat_in -= dt
        if self.boat_in <= 0:
            if self._launch_boat():
                self.boat_in = self.BOAT_EVERY[self.boats_sent % 2]
            else:
                self.boat_in = 5.0
        for b in self.boats:
            m = self._boat_m(b["side"])
            v = self.redcoat_s * 0.45
            stop = self._boat_stop(b)
            if b["landed"] is None and stop is not None:
                # Easing in to the bank as it nears the ford.
                v *= max(0.2, min(1.0, (stop - b["x"]) / m))
                b["x"] = min(stop, b["x"] + v * dt)
                if b["x"] >= stop - 0.5:
                    b["landed"] = self.siege.phase
                    b["next_at"] = self.siege.phase + 0.5
            elif b["landed"] is not None and b["men"] > 0:
                if self.siege.phase >= b["next_at"]:
                    self.siege.land(b["side"], Siege.trail_d(
                        self._landing_p(b["side"])), self._bow(b))
                    b["men"] -= 1
                    b["next_at"] += self.LAND_GAP_S
                    if b["men"] == 0:
                        b["left"] = self.siege.phase
            else:
                if b["left"] is not None:
                    v *= 0.3 + 0.7 * self._ramp(self.siege.phase - b["left"],
                                                0.0, 3.0)
                elif b["adrift"] is not None:
                    v *= 0.6
                b["x"] += v * dt
        self.boats = [b for b in self.boats
                      if b["x"] < self.river["w"] + 2 * self._boat_m(
                          b["side"])]
        for f in self.overboard:
            if f["at"] is None and self.siege.phase - f["t0"] >= self.SLUMP_S:
                f["at"] = self._aboard(f["boat"], f["slot"])
        self.overboard = [f for f in self.overboard
                          if self.siege.phase - f["t0"] < self.STAIN_S]

    # -- the walker's shots at the boats ----------------------------------

    POTSHOT_REST = 6.0  # seconds he patrols, at least, between his shots
    SLUMP_S = 0.4       # a man shot in a boat slumps this long...
    OVER_S = 0.5        # ...then goes over the side and under

    def _advance_potshot(self, dt):
        """On patrol, the walker now and then halts to shoot at the nearest
        boat still carrying redcoats down the river; his every shot takes
        a man out of it."""
        ps = self.potshot
        if ps is None:
            if not self.siege.has_walker or self.walker_at is None \
                    or self.siege.men[2]["mode"] != "patrol" \
                    or self.siege.bugling() or self.siege.relief is not None \
                    or self.siege.phase < self.potshot_after:
                return
            wx, wy = self.walker_at
            # Only a boat whose man to be hit will still be in sight when
            # he fires and goes over: no boat rows faster than full speed.
            # One pulled in at the ford is fair game until its men are out.
            ahead = self.redcoat_s * 0.45 * (Siege.SHOT_AT + self.SLUMP_S)
            afloat = [b for b in self.boats if b["men"] > 0
                      and b["left"] is None and 0 <= b["x"]
                      and self._aboard(b, b["men"] - 1)[0] + ahead
                      <= self.river["w"]]
            afloat = [b for b in afloat if self._clear_shot(b)]
            b = min(afloat, key=lambda b: math.hypot(
                b["x"] - wx, self._boat_at(b)[1] - wy), default=None)
            if b is not None:
                self.potshot = {"t0": self.siege.phase, "boat": b,
                                "fired": False, "tau": 0.0}
            return
        # A hungry man's shot drags like his drill.
        ps["tau"] += dt * self.siege.pace(2)
        tau = ps["tau"]
        if tau >= Siege.SHOT_AT and not ps["fired"]:
            ps["fired"] = True
            self._shoot_aboard(ps["boat"])
        if tau >= Siege.DRILL_LEN:
            self.potshot = None
            self.potshot_after = self.siege.phase + self.POTSHOT_REST

    def _clear_shot(self, b):
        """Whether the walker's line of fire at b, as he draws it, passes
        over both tower sentries, their rifles and all, rather than
        through one of them."""
        if self.sentries_at is None:
            return True
        towers, floor, s = self.sentries_at
        wx, wy = self.walker_at
        mx, my = wx, wy - s * 0.92 * 0.52
        bx, by, _ = self._boat_at(b)
        by -= self._boat_m(b["side"]) * 0.3
        for tx in towers:
            for x in (tx - s * 0.5, tx + s * 0.5):
                if min(mx, bx) <= x <= max(mx, bx) and bx != mx:
                    y = my + (by - my) * (x - mx) / (bx - mx)
                    if y > floor - s * 1.4:
                        return False
        return True

    def _shoot_aboard(self, b):
        """One of the boat's crew is hit and goes over the side."""
        if b["men"] <= 0 or not any(o is b for o in self.boats):
            return
        pull = self._boat_at(b)[2]
        b["men"] -= 1
        self.overboard.append({"boat": b, "slot": b["men"], "s":
                               self._boat_m(b["side"]), "t0": self.siege.phase,
                               "at": None, "n": b["n"] * 4 + b["men"]})
        if b["men"] == 0:
            if b["landed"] is None:
                b["adrift"] = (self.siege.phase, pull)
            else:
                b["left"] = self.siege.phase

    @staticmethod
    def _bateau(cr, x, y, s, men, stroke, tilt, flag):
        """A flat-bottomed bateau, bow to the right, sitting on the water at
        (x, y), in the 100-unit model of the men aboard: a steersman at the
        stern and up to three at the oars, who face him as they row. stroke
        is the phase of their stroke; with nobody aboard the oars lie
        shipped and the bow rides a little high. flag is the phase of the
        ensign's flutter."""
        cr.save()
        cr.translate(x, y)
        cr.scale(s / 100.0, s / 100.0)
        cr.rotate(tilt - (0.04 if men == 0 else 0.0))
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        rowers = [(px, -1) for px in CpuView.CREW_X[1:]][:max(0, men - 1)]
        crew = ([(CpuView.CREW_X[0], 1)] if men > 0 else []) + rowers
        # The ensign at the stern.
        cr.set_source_rgb(*STEEL_RGB)
        cr.set_line_width(1.6)
        cr.move_to(-84, -20)
        cr.line_to(-88, -58)
        cr.stroke()
        wave = math.sin(flag) * 3
        cr.set_source_rgb(*COAT_RGB)
        cr.move_to(-88, -58)
        cr.curve_to(-96, -60 + wave, -104, -54 - wave, -110, -56 + wave)
        cr.line_to(-108, -44 + wave)
        cr.curve_to(-102, -42 - wave, -96, -48 + wave, -87, -46)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*KIT_RGB)
        cr.set_line_width(1.4)
        cr.move_to(-88, -52)
        cr.line_to(-109, -50 + wave)
        cr.stroke()
        # Men from the waist up, seated below the gunwale.
        for px, face in crew:
            cr.save()
            cr.translate(px, 32)
            cr.scale(face, 1)
            CpuView._rc_upper(cr)
            cr.restore()
        # The hull: raked bow and stern, a pale strake under the gunwale.
        cr.move_to(-92, -24)
        cr.curve_to(-80, -14, -60, -12, 0, -12)
        cr.curve_to(60, -12, 80, -14, 94, -26)
        cr.line_to(72, 5)
        cr.line_to(-70, 5)
        cr.close_path()
        cr.set_source_rgb(*HULL_RGB)
        cr.fill_preserve()
        cr.set_source_rgb(*SEAM_RGB)
        cr.set_line_width(1.5)
        cr.stroke()
        cr.set_source_rgb(*HULL_HI_RGB)
        cr.set_line_width(2.5)
        cr.move_to(-86, -18)
        cr.curve_to(-70, -9, -50, -8, 0, -8)
        cr.curve_to(50, -8, 72, -9, 88, -20)
        cr.stroke()
        cr.set_source_rgba(*WATER_HI_RGB, 0.6)
        cr.set_line_width(1.6)
        cr.move_to(-74, 4)
        cr.line_to(76, 4)
        cr.stroke()
        if men == 0:
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.set_line_width(3)
            for k in range(3):
                cr.move_to(-50 + k * 6, -15 - k * 2)
                cr.line_to(56 + k * 4, -15 - k * 2)
            cr.stroke()
        for k, (px, face) in enumerate(crew):
            if face > 0:
                # The steersman's long oar, trailing astern.
                cr.set_source_rgb(*RIFLE_WOOD_RGB)
                cr.set_line_width(3)
                cr.move_to(px + 8, -20)
                cr.line_to(-112, 6)
                cr.stroke()
                hand = (px + 8, -20)
            else:
                # Feathered back above the water, then pulled through it.
                ang = stroke + k * 0.15
                blade = (px + 34 + 22 * math.cos(ang),
                         4 if math.sin(ang) > 0 else -8)
                pivot = (px + 12, -13)
                hand = (pivot[0] - (blade[0] - pivot[0]) * 0.35,
                        pivot[1] - (blade[1] - pivot[1]) * 0.35 - 8)
                cr.set_source_rgb(*RIFLE_WOOD_RGB)
                cr.set_line_width(3)
                cr.move_to(*hand)
                cr.line_to(*blade)
                cr.stroke()
                cr.save()
                cr.translate(*blade)
                cr.rotate(math.atan2(blade[1] - hand[1], blade[0] - hand[0]))
                cr.scale(9, 3)
                cr.arc(0, 0, 1, 0, 2 * math.pi)
                cr.restore()
                cr.fill()
                if blade[1] > 0:
                    cr.set_source_rgba(1, 1, 1, 0.6)
                    cr.arc(blade[0] - 8, 1, 3, 0, 2 * math.pi)
                    cr.fill()
            cr.set_source_rgb(*COAT_RGB)
            cr.set_line_width(6)
            cr.move_to(px + face * 3, -2)
            cr.line_to(*hand)
            cr.stroke()
            cr.set_source_rgb(*SKIN_RGB)
            cr.arc(*hand, 3, 0, 2 * math.pi)
            cr.fill()
        cr.restore()

    def _draw_boats(self, cr):
        for f in self.overboard:
            self._draw_splash(cr, f)
        for b in self.boats:
            x, y, pull = self._boat_at(b)
            m = self._boat_m(b["side"])
            slope = self._river_y(x + 6) - self._river_y(x - 6)
            rowing = b["landed"] is None and pull < 0.9
            stroke = self.phase * 3.2 + b["n"] if rowing else 1.6
            if b["landed"] is None or b["men"] == 0:
                # A wake spreading behind.
                cr.set_source_rgba(*WATER_HI_RGB, 0.35)
                cr.set_line_width(1.2)
                for side in (-1, 1):
                    cr.move_to(x - m * 0.8, y + m * 0.02)
                    cr.line_to(x - m * 1.8, y + side * m * 0.12)
                cr.stroke()
            self._bateau(cr, x, y, m, b["men"], stroke,
                         math.atan2(slope, 12), self.phase * 4 + b["n"])
        for f in self.overboard:
            self._draw_overboard(cr, f)

    def _overboard_at(self, f):
        """Where the shot man sits, or sat: (x, waterline)."""
        return f["at"] or self._aboard(f["boat"], f["slot"])

    def _draw_overboard(self, cr, f):
        """The man slumps where he sat, then tips forward over the near
        gunwale, in front of the hull, and down into the water."""
        e = self.siege.phase - f["t0"]
        over = self._ramp(e, self.SLUMP_S, self.SLUMP_S + self.OVER_S)
        if over >= 1.0:
            return
        x, y = self._overboard_at(f)
        face = 1 if f["slot"] == 0 else -1
        cr.save()
        cr.translate(x, y)
        cr.scale(f["s"] / 100.0, f["s"] / 100.0)
        # Below the gunwale while he sits, below the water once over it.
        cr.rectangle(-300, -300, 600, 288 + 30 * over)
        cr.clip()
        cr.translate(face * 14 * over, 32 + 62 * over * over)
        cr.translate(0, -42)
        cr.rotate(face * (0.45 * self._ramp(e, 0.0, self.SLUMP_S)
                          + 1.1 * over))
        cr.translate(0, 42)
        cr.scale(face, 1)
        self._rc_upper(cr)
        cr.restore()

    def _draw_splash(self, cr, f):
        """Where he went in: a splash, rings and a little blood spreading
        on the water and drifting downstream."""
        if f["at"] is None:
            return
        e = self.siege.phase - f["t0"] - self.SLUMP_S - self.OVER_S * 0.6
        if e < 0:
            return
        x, y = f["at"]
        m = f["s"]
        face = 1 if f["slot"] == 0 else -1
        x += face * m * 0.14 + m * 0.12 * e
        y += m * 0.3
        fade = 1.0 - max(0.0, e - self.STAIN_S * 0.5) / (self.STAIN_S * 0.4)
        if fade > 0:
            cr.save()
            cr.translate(x, y)
            cr.scale(1.0, 0.3)
            cr.arc(0, 0, m * 0.3 * min(1.0, 0.3 + e * 0.6), 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgba(*BLOOD_RGB, 0.55 * fade)
            cr.fill()
        if e < 1.5:
            cr.set_source_rgba(*WATER_HI_RGB, 0.7 * (1 - e / 1.5))
            cr.set_line_width(max(0.6, m * 0.02))
            for k in range(2):
                r = m * (0.15 + 0.35 * e) * (1 - 0.35 * k)
                cr.save()
                cr.translate(x, y)
                cr.scale(1.0, 0.3)
                cr.arc(0, 0, r, 0, 2 * math.pi)
                cr.restore()
                cr.stroke()
        if e < 0.8:
            cr.set_source_rgba(*WATER_HI_RGB, 0.85 * (1 - e / 0.8))
            for k in range(7):
                a = -math.pi * (0.15 + 0.7 * k / 6)
                v = m * (0.5 + 0.2 * ((k + f["n"]) % 3))
                cr.arc(x + math.cos(a) * v * e,
                       y + math.sin(a) * v * e + m * 2.0 * e * e,
                       max(0.6, m * 0.035), 0, 2 * math.pi)
                cr.fill()

    # -- helpers ----------------------------------------------------------

    @staticmethod
    def _glow(cr, x, y, radius, rgb, alpha):
        if radius <= 0 or alpha <= 0:
            return
        grad = cairo.RadialGradient(x, y, 0, x, y, radius)
        grad.add_color_stop_rgba(0.0, *rgb, alpha)
        grad.add_color_stop_rgba(0.5, *rgb, alpha * 0.3)
        grad.add_color_stop_rgba(1.0, *rgb, 0.0)
        cr.set_source(grad)
        cr.arc(x, y, radius, 0, 2 * math.pi)
        cr.fill()

    @staticmethod
    def _rounded(cr, x, y, w, h, r):
        r = min(r, w / 2, h / 2)
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    @staticmethod
    def _text(cr, x, y, text, size, alpha, bold=False, align="center"):
        """Text with its baseline at y, centred on x or starting there;
        returns how far it runs."""
        cr.select_font_face("Cantarell", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold
                            else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        ext = cr.text_extents(text)
        left = x - ext.x_bearing if align == "left" \
            else x - ext.width / 2 - ext.x_bearing
        cr.move_to(left, y)
        cr.set_source_rgba(1, 1, 1, alpha)
        cr.show_text(text)
        return ext.x_advance

    # -- the fort ---------------------------------------------------------

    @staticmethod
    def _stake(cr, x, bottom, w, top, pointed):
        """One upright log, sharpened or flat, with a highlight and seam."""
        tip = w * 0.6 if pointed else 0.0
        cr.move_to(x, bottom)
        cr.line_to(x, top + tip)
        if pointed:
            cr.line_to(x + w / 2, top)
        cr.line_to(x + w, top + tip)
        cr.line_to(x + w, bottom)
        cr.close_path()
        cr.set_source_rgb(*WOOD_RGB)
        cr.fill_preserve()
        cr.set_source_rgb(*SEAM_RGB)
        cr.set_line_width(max(0.8, w * 0.08))
        cr.stroke()
        cr.set_source_rgba(*WOOD_HI_RGB, 0.8)
        cr.rectangle(x + w * 0.18, top + tip + w * 0.2, w * 0.16,
                     max(0.0, bottom - top - tip - w * 0.4))
        cr.fill()

    def _wall(self, cr, x0, x1, bottom, top, stake_w, pointed):
        n = max(1, round((x1 - x0) / stake_w))
        w = (x1 - x0) / n
        for i in range(n):
            # Every other stake a little taller, like hand-cut logs.
            lift = stake_w * 0.25 if (i % 2 and pointed) else 0.0
            self._stake(cr, x0 + i * w, bottom, w, top - lift, pointed)

    WALL_PIECES = 10    # logs stacked up each of a side wall's two columns
    GAP_PIECES = (1, 2, 3)  # low on the wall, a man's height: the gap

    @classmethod
    def _wall_piece_state(cls, strength, j, col):
        """How the log j up from the foot of a side wall's column col (0
        the outer one) stands at this strength: 0 whole, 1 splintered, 2
        splintered and askew, 3 fallen. The blows land low, where the gap
        opens, and the damage spreads out from there. Only the logs of the
        gap ever fall away entire, the outer column's first; the ones round
        it are knocked askew; the rest of the wall stands, splintered, so
        that a breached wall is a wall with one hole in it."""
        lo, hi = cls.GAP_PIECES[0], cls.GAP_PIECES[-1]
        away = max(lo - j, j - hi, 0)
        hit = ((j * 7 + col * 3 + 1) * 0.618034) % 1.0
        u = (1.0 - strength) * 1.2 - 0.18 * away - 0.25 * hit - 0.1 * col
        if away == 0:
            if strength <= 0.0 or (u > 0.75 and col == 0 and j == 2):
                return 3
            return 2 if u > 0.6 else 1 if u > 0.15 else 0
        if away == 1:
            return 2 if u > 0.75 else 1 if u > 0.2 else 0
        return 1 if u - 0.12 * away > 0.1 else 0

    @classmethod
    def _wall_piece_height(cls, state, j, col):
        """How tall of a log's full length is left of one in this state:
        a splintered one stands nearly whole, at its own ragged height."""
        if state == 0:
            return 1.0
        return 0.78 + 0.17 * (((j * 5 + col * 11 + 3) * 0.618034) % 1.0)

    def _side_wall(self, cr, side, x, wall, top, bottom):
        """A side wall, seen end-on as a column of two stacks of logs. As
        it is hurt, logs splinter, then are knocked askew, and at the last
        those low on the wall fall out of it, leaving one gap; it reads by
        shape, not by colour."""
        strength = self.siege.wall[side]
        n = self.WALL_PIECES
        w = wall / 2
        sh = (bottom - top) / n
        fallen = 0
        for col in (1, 0):
            cx = x + (col if side == 0 else 1 - col) * w
            for j in range(n):
                state = self._wall_piece_state(strength, j, col)
                y1 = bottom - j * sh
                if state == 3:
                    fallen += 1
                    continue
                cr.save()
                h = sh * self._wall_piece_height(state, j, col)
                if state == 2:
                    lean = (0.22 if (j + col) % 2 else -0.18)
                    cr.translate(cx + w / 2, y1)
                    cr.rotate(lean)
                    cr.translate(-(cx + w / 2), -y1)
                cr.move_to(cx, y1)
                if state == 0:
                    cr.line_to(cx, y1 - h)
                    if j == n - 1:
                        cr.line_to(cx + w / 2, y1 - h - w * 0.6)
                    cr.line_to(cx + w, y1 - h)
                else:
                    # A ragged break across the top.
                    cr.line_to(cx, y1 - h)
                    for k in range(1, 5):
                        cr.line_to(cx + w * k / 4, y1 - h
                                   - (w * 0.45 if k % 2 else 0.0)
                                   + (w * 0.15 if j % 2 else 0.0))
                cr.line_to(cx + w, y1)
                cr.close_path()
                cr.set_source_rgb(*WOOD_RGB)
                cr.fill_preserve()
                cr.set_source_rgb(*SEAM_RGB)
                cr.set_line_width(max(0.8, w * 0.08))
                cr.stroke()
                cr.set_source_rgba(*WOOD_HI_RGB, 0.8)
                cr.rectangle(cx + w * 0.18, y1 - h + w * 0.25, w * 0.16,
                             max(0.0, h - w * 0.5))
                cr.fill()
                cr.restore()
        # The fallen lie at the foot, outside, a log each, clear of the gap.
        out = -1 if side == 0 else 1
        for k in range(fallen):
            cr.save()
            cr.translate(x + wall / 2 + out * wall * (0.75 + 0.35 * (k % 3))
                         + out * wall * 0.15 * (k // 3),
                         bottom - (k // 3 + 0.5) * w * 0.5)
            cr.rotate(0.12 * ((k % 3) - 1))
            self._rounded(cr, -wall * 0.5, -w * 0.25, wall, w * 0.5,
                          w * 0.25)
            cr.set_source_rgb(*WOOD_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(0.8, w * 0.08))
            cr.stroke()
            cr.restore()

    ROOF_PLANKS = 8

    @classmethod
    def _roof_plank_state(cls, strength, k):
        """How plank k across a tower's roof stands at this strength: 0
        whole, 1 splintered and short, 2 broken out. The middle goes
        first, where the axes fall, and a hole opens there."""
        n = cls.ROOF_PLANKS
        mid = abs(k - (n - 1) / 2) / (n / 2)
        hit = ((k * 5 + 2) * 0.618034) % 1.0
        rank = 0.55 * mid + 0.45 * hit
        u = (1.0 - strength) * 1.15 - rank * 0.8
        return 0 if u <= 0 else 1 if u < 0.15 else 2

    def _roof(self, cr, x, y, w, lh, side):
        """A tower's roof, where its sentry stands, as planks, which break
        out as it is hacked at, to a hole you can see the dark through."""
        strength = self.siege.roof[side] if self.on else 1.0
        n = self.ROOF_PLANKS
        rx, ry, rw, rh = x - lh * 0.35, y - lh * 0.35, w + lh * 0.7, lh * 0.7
        pw = rw / n
        cr.set_source_rgb(0.03, 0.02, 0.02)
        cr.rectangle(rx, ry, rw, rh)
        cr.fill()
        for k in range(n):
            state = self._roof_plank_state(strength, k)
            if state == 2:
                continue
            h = rh * (0.35 if state == 1 else 1.0)
            cr.move_to(rx + k * pw, ry + rh)
            cr.line_to(rx + k * pw, ry + rh - h)
            if state == 1:
                cr.line_to(rx + (k + 0.3) * pw, ry + rh - h - rh * 0.2)
                cr.line_to(rx + (k + 0.6) * pw, ry + rh - h)
                cr.line_to(rx + (k + 0.8) * pw, ry + rh - h - rh * 0.12)
            cr.line_to(rx + (k + 1) * pw, ry + rh - h)
            cr.line_to(rx + (k + 1) * pw, ry + rh)
            cr.close_path()
            cr.set_source_rgb(*WOOD_HI_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(0.8, lh * 0.06))
            cr.stroke()

    def _blockhouse(self, cr, x, y, w, h, side=0):
        """A square log tower; y is its floor, where a sentry stands."""
        logs = 4
        lh = h / logs
        for i in range(logs):
            self._rounded(cr, x - lh * 0.15, y + i * lh, w + lh * 0.3, lh,
                          lh / 2)
            cr.set_source_rgb(*WOOD_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(0.8, lh * 0.1))
            cr.stroke()
        # A loophole for the long rifle.
        cr.set_source_rgb(*SEAM_RGB)
        cr.rectangle(x + w * 0.42, y + lh * 1.3, w * 0.16, lh * 0.5)
        cr.fill()
        self._roof(cr, x, y, w, lh, side)

    def _gate(self, cr, cx, bottom, top, w):
        """Shut while the fort is up; swung open while it is down."""
        cr.set_source_rgba(0.02, 0.02, 0.05, 0.9)
        cr.rectangle(cx - w / 2, top, w, bottom - top)
        cr.fill()
        half = w / 2
        if self.on:
            for side in (-1, 1):
                x = cx - half if side < 0 else cx
                self._stake(cr, x, bottom, half, top, False)
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(1.2, w * 0.06))
            cr.move_to(cx - half * 0.9, top + (bottom - top) * 0.2)
            cr.line_to(cx + half * 0.9, bottom - (bottom - top) * 0.15)
            cr.move_to(cx + half * 0.9, top + (bottom - top) * 0.2)
            cr.line_to(cx - half * 0.9, bottom - (bottom - top) * 0.15)
            cr.stroke()
        else:
            # Doors swung outward, seen edge-on: two slanted planks.
            for side in (-1, 1):
                hinge = cx + side * half
                cr.move_to(hinge, top)
                cr.line_to(hinge + side * half * 0.45, top + w * 0.15)
                cr.line_to(hinge + side * half * 0.45, bottom + w * 0.15)
                cr.line_to(hinge, bottom)
                cr.close_path()
                cr.set_source_rgb(*WOOD_RGB)
                cr.fill_preserve()
                cr.set_source_rgb(*SEAM_RGB)
                cr.set_line_width(1.0)
                cr.stroke()

    @staticmethod
    def _mountain_man(cr, x, feet, s, facing, step=0.0, shouldered=False,
                      glint=0.0, kneel=0.0, aim=0.0, shot=-1.0, bugle=0.0,
                      toot=-1.0, elev=0.04, beaver=False, axe=0.0,
                      log=False, knife=0.0, sit=0.0, eat=-1.0):
        """A buckskin-clad mountain man with a coonskin cap and a long rifle.

        Drawn in a 100-unit-tall model with the feet at 0; facing is +1 for
        right, -1 for left. The rifle stands taller than he does. kneel and
        aim run 0..1 from standing at ease; shot is the seconds since he
        fired, or negative if he has not. bugle runs 0..1 from his hip to
        his lips, and toot is the seconds since he began to blow it. elev is
        how far above level, in radians, he aims. beaver slings one over
        his shoulder, hanging down his back, and log carries one on it.
        axe above 0 puts an axe in his hands instead, raised behind him at
        1 and swung through at 0, with the rifle slung across his back.
        knife above 0 likewise slings the rifle and puts a knife in his
        near hand, thrust out at 1. sit runs 0..1 as he sits on the
        ground with his rifle stood beside him; eat, once he is sitting, is
        the seconds he has been at his jerky and steaming tin cup.
        """
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        drop = 20 * kneel + 30 * sit

        def lerp(a, b, u):
            return (a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u)

        def leg(swing, rgb, front):
            fx = math.sin(swing) * 40
            # Kneeling, the front knee juts forward and the back one rests
            # on the ground with the shin trailing behind.
            knee = lerp((fx / 2, -24), (20, -26) if front else (-4, -5),
                        kneel)
            foot = lerp((fx, -2), (21, -2) if front else (-26, -3), kneel)
            if sit > 0:
                knee = lerp(knee, (22, -22) if front else (14, -20), sit)
                foot = lerp(foot, (30, -2) if front else (22, -2), sit)
            cr.set_source_rgb(*rgb)
            cr.set_line_width(8)
            cr.move_to(0, -46 + drop)
            cr.line_to(*knee)
            cr.line_to(*foot)
            cr.stroke()
            cr.set_source_rgb(*SEAM_RGB)
            cr.save()
            cr.translate(foot[0] + 3, foot[1] + 0.5)
            cr.scale(6, 2.6)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()

        # The long rifle swings from butt-on-the-ground to butt-at-the-
        # shoulder, and kicks back a little when it fires.
        kick = max(0.0, 1.0 - shot / 0.25) if shot >= 0 else 0.0

        def rifle_pose(aim, drop, kick):
            butt = lerp((16, -1), (-2 - 4 * kick, -72 + drop), aim)
            return butt, aim * (math.pi / 2 - elev) - 0.08 * kick

        def along(pose, dist):
            (bx, by), ang = pose
            return bx + math.sin(ang) * dist, by - math.cos(ang) * dist

        pose = rifle_pose(aim, drop, kick)

        def rifle():
            (bx, by), ang = pose
            cr.save()
            cr.translate(bx, by)
            cr.rotate(ang)
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.move_to(-3, 0)
            cr.line_to(3, 0)
            cr.line_to(1.5, -31)
            cr.line_to(-1, -31)
            cr.close_path()
            cr.fill()
            cr.set_source_rgb(*STEEL_RGB)
            cr.set_line_width(2.2)
            cr.move_to(0.2, -31)
            cr.line_to(0.2, -127)
            cr.stroke()
            cr.restore()
            return along(pose, 127)

        def rifle_shouldered():
            # Stock in his hand at the hip, barrel over the shoulder.
            angle = 1.05
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.save()
            cr.translate(9, -56)
            cr.rotate(angle)
            cr.rectangle(-3, -3, 28, 6)
            cr.fill()
            cr.set_source_rgb(*STEEL_RGB)
            cr.set_line_width(2.2)
            cr.move_to(-2, 0)
            cr.line_to(-82, 0)
            cr.stroke()
            cr.restore()
            return 9 - 82 * math.cos(angle), -56 - 82 * math.sin(angle)

        leg(-step, BUCK_DARK_RGB, False)
        if axe > 0 or knife > 0:
            # The rifle slung across his back while his hands are busy.
            cr.set_source_rgb(*STEEL_RGB)
            cr.set_line_width(2.2)
            cr.move_to(-12, -40 + drop)
            cr.line_to(10, -118 + drop)
            cr.stroke()
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.set_line_width(5)
            cr.move_to(-14, -34 + drop)
            cr.line_to(-8, -56 + drop)
            cr.stroke()
            tip = (10, -118 + drop)
        elif shouldered:
            tip = rifle_shouldered()
        if beaver:
            cr.save()
            cr.translate(0, drop)
            cr.set_source_rgb(*BEAVER_DARK_RGB)
            cr.save()
            cr.translate(-19, -46)
            cr.rotate(0.25)
            cr.scale(4.5, 9)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()
            cr.set_source_rgb(*BEAVER_RGB)
            cr.save()
            cr.translate(-15, -64)
            cr.rotate(1.35)
            cr.scale(15, 8)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()
            cr.arc(-8, -79, 6, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(*BEAVER_DARK_RGB)
            cr.arc(-3.5, -82, 2, 0, 2 * math.pi)
            cr.fill()
            cr.restore()

        # Fringed buckskin shirt.
        cr.save()
        cr.translate(0, drop)
        cr.set_source_rgb(*BUCK_RGB)
        cr.move_to(-12, -44)
        cr.line_to(12, -44)
        cr.line_to(10, -78)
        cr.line_to(-10, -78)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*BUCK_DARK_RGB)
        cr.set_line_width(1.4)
        for fx in range(-11, 12, 3):
            cr.move_to(fx, -44)
            cr.line_to(fx + 0.5, -38.5)
        cr.stroke()
        cr.set_source_rgb(*SEAM_RGB)
        cr.rectangle(-11.5, -53, 23, 4)
        cr.fill()
        # Powder horn on its strap.
        cr.set_line_width(1.6)
        cr.move_to(-9, -76)
        cr.line_to(9, -52)
        cr.stroke()
        cr.set_source_rgb(0.93, 0.88, 0.74)
        cr.move_to(4, -55)
        cr.line_to(12, -51)
        cr.line_to(6, -50)
        cr.close_path()
        cr.fill()
        cr.restore()

        leg(step, BUCK_RGB, True)

        # Head, beard, and the coonskin cap with its ringed tail.
        cr.save()
        cr.translate(0, drop)
        cr.set_source_rgb(*SKIN_RGB)
        cr.arc(1, -86, 7.5, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(*BEARD_RGB)
        cr.move_to(-5, -86)
        cr.curve_to(-6, -76, 2, -71, 9, -76)
        cr.line_to(8.5, -84)
        cr.curve_to(5, -81, 0, -81, -5, -86)
        cr.fill()
        cr.set_source_rgb(*FUR_RGB)
        cr.arc(0.5, -88.5, 8.6, math.pi, 2 * math.pi)
        cr.fill()
        cr.rectangle(-8.6, -90, 18.2, 3.2)
        cr.fill()
        segs = 6
        for i in range(segs):
            u0, u1 = i / segs, (i + 1) / segs
            p0 = (-8 - 6 * u0 - 3 * math.sin(u0 * math.pi), -89 + 21 * u0)
            p1 = (-8 - 6 * u1 - 3 * math.sin(u1 * math.pi), -89 + 21 * u1)
            cr.set_source_rgb(*(STRIPE_RGB if i % 2 else FUR_RGB))
            cr.set_line_width(5.5 - 1.5 * u0)
            cr.move_to(*p0)
            cr.line_to(*p1)
            cr.stroke()
        cr.set_source_rgb(*SEAM_RGB)
        cr.arc(5.5, -88, 1.1, 0, 2 * math.pi)
        cr.fill()
        cr.restore()

        shoulder = (6, -75 + drop)
        if not shouldered and aim > 0:
            # The far hand comes up under the barrel to steady it.
            grip = lerp(shoulder, along(pose, 48), aim)
            cr.set_source_rgb(*BUCK_DARK_RGB)
            cr.set_line_width(6)
            cr.move_to(4, -73 + drop)
            cr.line_to(*grip)
            cr.stroke()
            cr.set_source_rgb(*SKIN_RGB)
            cr.arc(*grip, 3, 0, 2 * math.pi)
            cr.fill()
        if axe > 0:
            # Both hands on the haft, swung from over his shoulder down
            # into the trunk in front of him.
            ang = -0.5 + 2.4 * (1 - axe)
            dx, dy = math.sin(ang), -math.cos(ang)
            hand = (shoulder[0] + dx * 24, shoulder[1] + dy * 24)
            head = (hand[0] + dx * 30, hand[1] + dy * 30)
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.set_line_width(3.5)
            cr.move_to(hand[0] - dx * 6, hand[1] - dy * 6)
            cr.line_to(*head)
            cr.stroke()
            cr.save()
            cr.translate(*head)
            cr.rotate(ang)
            cr.set_source_rgb(*STEEL_RGB)
            cr.move_to(-2, 2)
            cr.line_to(12, -2)
            cr.line_to(12, 8)
            cr.line_to(-2, 5)
            cr.close_path()
            cr.fill()
            cr.restore()
            for start in ((4, -73 + drop), shoulder):
                cr.set_source_rgb(*BUCK_RGB)
                cr.set_line_width(6)
                cr.move_to(*start)
                cr.line_to(*hand)
                cr.stroke()
            cr.set_source_rgb(*SKIN_RGB)
            cr.arc(*hand, 3.5, 0, 2 * math.pi)
            cr.fill()
        elif knife > 0:
            # The far forearm up to ward off, the near hand driving the
            # blade in, low and forward.
            guard = (20, -86 + drop)
            hand = lerp((14, -58 + drop), (38, -70 + drop), knife)
            for start, end, rgb in (((4, -73 + drop), guard, BUCK_DARK_RGB),
                                    (shoulder, hand, BUCK_RGB)):
                cr.set_source_rgb(*rgb)
                cr.set_line_width(6)
                cr.move_to(*start)
                cr.line_to(*end)
                cr.stroke()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(3)
            cr.move_to(hand[0] - 3, hand[1] + 2)
            cr.line_to(hand[0] + 1, hand[1] - 1)
            cr.stroke()
            cr.set_source_rgb(*STEEL_RGB)
            cr.move_to(hand[0], hand[1] - 2.5)
            cr.line_to(hand[0] + 17, hand[1] - 6)
            cr.line_to(hand[0] + 2, hand[1] + 1.5)
            cr.close_path()
            cr.fill()
            cr.set_source_rgb(*SKIN_RGB)
            for p in (guard, hand):
                cr.arc(*p, 3, 0, 2 * math.pi)
                cr.fill()
        elif sit > 0.3:
            # The rifle stood beside him; jerky in the near hand, brought
            # up to his mouth now and then, and a tin cup in the far one,
            # steaming.
            tip = rifle()
            bite = max(0.0, math.sin(eat * 1.7)) ** 2 if eat >= 0 else 0.0
            cup = (25, -34 + drop)
            mouth = (9, -80 + drop)
            hand = lerp((22, -44 + drop), mouth, bite)
            cr.set_line_width(6)
            for start, end, rgb in (((4, -73 + drop), cup, BUCK_DARK_RGB),
                                    (shoulder, hand, BUCK_RGB)):
                cr.set_source_rgb(*rgb)
                cr.move_to(*start)
                cr.line_to(*end)
                cr.stroke()
            cr.set_source_rgb(*BEAVER_DARK_RGB)
            cr.set_line_width(3.2)
            cr.move_to(hand[0], hand[1])
            cr.line_to(hand[0] + 9, hand[1] - 3)
            cr.stroke()
            cr.set_source_rgb(*STEEL_RGB)
            cr.move_to(cup[0] - 5, cup[1] - 5)
            cr.line_to(cup[0] + 5, cup[1] - 5)
            cr.line_to(cup[0] + 4, cup[1] + 5)
            cr.line_to(cup[0] - 4, cup[1] + 5)
            cr.close_path()
            cr.fill()
            cr.set_source_rgb(*SKIN_RGB)
            for p in (cup, hand):
                cr.arc(*p, 3, 0, 2 * math.pi)
                cr.fill()
            if eat >= 0:
                cr.set_source_rgba(*SMOKE_RGB, 0.7)
                cr.set_line_width(1.8)
                for k in range(3):
                    u = (eat * 0.7 + k / 3) % 1.0
                    cr.new_sub_path()
                    cr.arc(cup[0] - 3 + 3 * k + 3 * math.sin(u * 7 + k),
                           cup[1] - 8 - 26 * u, 1.6 + 2 * u, 0, 2 * math.pi)
                    cr.set_source_rgba(*SMOKE_RGB, 0.7 * (1 - u))
                    cr.fill()
        else:
            if not shouldered:
                tip = rifle()
            # The arm that holds the rifle.
            cr.set_source_rgb(*BUCK_RGB)
            cr.set_line_width(6)
            cr.move_to(*shoulder)
            hand = along(pose, 61 - 47 * aim) if not shouldered \
                else (9, -56)
            cr.line_to(*hand)
            cr.stroke()
            cr.set_source_rgb(*SKIN_RGB)
            cr.arc(*hand, 3, 0, 2 * math.pi)
            cr.fill()
        if log:
            # A log across his shoulder, held there by the near hand.
            cr.save()
            cr.translate(2, -80 + drop)
            cr.rotate(-0.12)
            CpuView._rounded(cr, -30, -5, 60, 10, 5)
            cr.set_source_rgb(*WOOD_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(1.4)
            cr.stroke()
            cr.set_source_rgb(*WOOD_HI_RGB)
            cr.save()
            cr.translate(29, 0)
            cr.scale(2.5, 5)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()
            cr.restore()

        if bugle > 0:
            # The far hand brings the bugle up from his hip to his lips,
            # bell forward and a little up.
            mouth = lerp((12, -50), (8, -81), bugle)
            ang = math.pi / 2 + (-0.2 - math.pi / 2) * bugle
            grip = (mouth[0] + math.cos(ang) * 9, mouth[1] + math.sin(ang) * 9)
            cr.save()
            cr.translate(*mouth)
            cr.rotate(ang)
            cr.set_source_rgb(*BRASS_RGB)
            cr.set_line_width(2.6)
            cr.move_to(0, 0)
            cr.line_to(19, 0)
            cr.stroke()
            cr.save()
            cr.translate(10, 3.5)
            cr.scale(6, 3)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.set_line_width(1.8)
            cr.stroke()
            cr.move_to(18, -1.5)
            cr.line_to(28, -6.5)
            cr.line_to(28, 6.5)
            cr.line_to(18, 1.5)
            cr.close_path()
            cr.fill()
            if toot >= 0:
                # Sound rolling out of the bell, ring after ring.
                cr.set_line_width(2.0)
                for j in range(3):
                    p = (toot * 1.6 - j / 3) % 1.0
                    if toot * 1.6 < j / 3:
                        continue
                    cr.set_source_rgba(*BRASS_RGB, 0.9 * (1 - p))
                    cr.new_sub_path()
                    cr.arc(28, 0, 5 + 26 * p, -0.7, 0.7)
