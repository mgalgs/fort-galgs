def siege_report(minutes, seed=1, out=None, pressure="normal"):
    """Run a fresh siege headless for so many minutes and print one row a
    minute, then the total: the redcoats sent (foot/horse/cannon), those
    shot, those who reached the wall, those the gun's blast took, the
    calls for the gun, and the walls' story: damage dealt and mended per
    side (percent of a wall), breaches, repairs started and finished,
    times the walker was caught outside, seconds spent out, retreats from
    rock to rock, shots fired by redcoats, ladder climbs, push-offs and
    raises, men killed falling, and minutes eating. No boats: they row on
    the river as drawn, which a headless run has not got. pressure
    "flood" adds an eager user's wave from a barracks every twenty
    seconds."""
    out = out or sys.stdout
    siege = Siege(seed)
    siege.flood = pressure == "flood"
    print(f"siege, seed {seed}, {pressure}, no boats (they need the drawn "
          f"river)", file=out)
    print(f"{'minute':>6}" + "".join(f"{name:>{w}}"
                                     for name, w, _ in SIEGE_COLUMNS),
          file=out)

    def row(label, t):
        print(f"{label:>6}" + "".join(f"{str(get(t)):>{w}}"
                                      for _, w, get in SIEGE_COLUMNS),
              file=out)

    last = copy.deepcopy(siege.tally)
    for n in range(int(minutes)):
        siege.run(60.0)
        row(n + 1, _tally_minus(siege.tally, last))
        last = copy.deepcopy(siege.tally)
    row("total", siege.tally)


# What the owner wants of an hour of siege, as the share of runs in which
# each thing happens at least so often: (what, test on a run's tally).
SIEGE_CLAIMS = (
    ("a wall damaged, then mended, more than once",
     lambda t: t["repairs_done"] >= 2),
    ("a wall breached", lambda t: t["breaches"] >= 1),
    ("walker caught outside", lambda t: t["caught"] >= 1),
    ("... and driven back past the first rock",
     lambda t: t["caught"] >= 1 and t["retreats"] >= 1),
    ("redcoats climb the ladder", lambda t: t["climbs"] >= 1),
    ("a man eating", lambda t: t["eating_s"] > 0 or t["pot_eating_s"] > 0),
    ("redcoats onto the wall top", lambda t: t["top"] >= 1),
    ("every rousing brought a bear to the wall",
     lambda t: t["bear_wall"] >= t["bear_trips"] - t["bear_inflight"]),
    ("a gun overpowered", lambda t: t["guns"] >= 1),
    ("a tower roof holed", lambda t: t["roof_holes"] >= 1),
    ("redcoats battered a core", lambda t: t["batter_s"] > 0),
    ("the three men at the pot together in the calm",
     lambda t: t["pot_together"] >= 1),
    ("a sentry caught off his tower", lambda t: t["off_caught"] >= 1),
    ("a man mended from outside after hiding (of runs with a catch)",
     lambda t: t["repairs_out"] >= 1),
    ("bears climbed down once the top was clear, every rousing",
     lambda t: t["rousings_down"] == t["rousings_over"]),
    ("a bear stayed on top 60 s with nothing to fight",
     lambda t: t["bear_top_idle_max"] >= 60.0),
    ("roused bears killed redcoats on the ground, every rousing with "
     "redcoats near",
     lambda t: t["rousings_ground_killed"] == t["rousings_ground"]),
    ("bears went home", lambda t: t["bear_home"] >= 1),
    ("stew poured", lambda t: t["pours"] >= 1),
)

# Claims whose share is of the runs with something, not of all runs.
SIEGE_BASES = {
    "a man mended from outside after hiding (of runs with a catch)":
        lambda t: t["caught"] >= 1,
}


def siege_seeds(minutes, seeds, pressure="normal", out=None):
    """Run the siege headless over seeds 1..seeds for so many minutes
    each and print, for each of the owner's wishes in SIEGE_CLAIMS, in how
    many of those runs it came true. Returns the tallies."""
    out = out or sys.stdout
    tallies = []
    for seed in range(1, seeds + 1):
        siege = Siege(seed)
        siege.flood = pressure == "flood"
        siege.run(60.0 * minutes)
        siege.tally["bear_inflight"] = int(not siege.bear_firsts)
        tallies.append(siege.tally)
    print(f"{seeds} seeds x {minutes} minutes, {pressure}", file=out)
    for what, test in SIEGE_CLAIMS:
        base = SIEGE_BASES.get(what, lambda t: True)
        n = sum(1 for t in tallies if base(t) and test(t))
        print(f"  {n:>2}/{sum(1 for t in tallies if base(t))}  {what}",
              file=out)
    caught = sum(t["caught"] for t in tallies)
    driven = sum(t["driven"] for t in tallies)
    print(f"  caught {caught} times in all, and driven back past the first "
          f"rock in {driven} of them ({100 * driven // max(1, caught)}%)",
          file=out)
    for key in ("breaches", "caught", "driven", "climbs", "pushes",
                "raises", "fell", "top", "guns", "roof_holes", "yard",
                "bear_trips", "bear_kills", "bear_withdrawn", "bear_downs",
                "bear_home", "bear_ground_kills", "repairs_out",
                "pour_trips", "pours", "scalded", "pot_together", "off_caught",
                "unanswered", "reloads", "desp_pours"):
        print(f"  {key:>9}: " + " ".join(f"{t[key]:>3}" for t in tallies),
              file=out)
    return tallies


def parse_args(argv):
    """The command line as a dict; a usage error exits 2."""
    opts = {"self_test": False, "snapshot": None, "help": False,
            "time_scale": 1.0, "almanac": None, "siege": None,
            "seed": 1, "seeds": None, "pressure": "normal"}
    args = list(argv)

    def fail():
        print(USAGE, file=sys.stderr)
        raise SystemExit(2)

    while args:
        a = args.pop(0)
        if a == "--self-test":
            opts["self_test"] = True
        elif a in ("--help", "-h"):
            opts["help"] = True
        elif a == "--snapshot" and len(args) == 1:
            opts["snapshot"] = args.pop(0)
        elif a == "--time-scale" and args:
            try:
                x = float(args.pop(0))
            except ValueError:
                fail()
            if not 0 < x < float("inf"):
                fail()
            opts["time_scale"] = x
        elif a == "--time-scale":
            fail()
        elif a == "--pressure" and args \
                and args[0] in ("normal", "flood"):
            opts["pressure"] = args.pop(0)
        elif a == "--pressure":
            fail()
        elif a in ("--almanac", "--siege", "--seed", "--seeds"):
            try:
                n = int(args.pop(0))
            except (IndexError, ValueError):
                fail()
            if a in ("--almanac", "--siege", "--seeds") and n < 1:
                fail()
            opts[a[2:]] = n
    return opts


def main():
    opts = parse_args(sys.argv[1:])
    if opts["almanac"]:
        almanac(opts["almanac"], opts["seed"])
        return 0
    if opts["siege"] and opts["seeds"]:
        siege_seeds(opts["siege"], opts["seeds"], opts["pressure"])
        return 0
    if opts["siege"]:
        siege_report(opts["siege"], opts["seed"], pressure=opts["pressure"])
        return 0
    if opts["self_test"]:
        self_test()
        return 0
    if opts["snapshot"]:
        snapshot(opts["snapshot"])
        return 0
    if opts["help"]:
        print(__doc__)
        return 0
    return FortApp(opts["time_scale"]).run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
