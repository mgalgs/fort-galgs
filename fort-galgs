    @staticmethod
    def _pounding(cr, t, seed, y):
        """A musket swung butt-first at a wall in front of him, at height
        y; t is the seconds he has been at it."""
        thrust = max(0.0, math.sin(t * 5.5 + seed)) ** 3
        bx = 18 + 14 * thrust
        cr.set_source_rgb(*RIFLE_WOOD_RGB)
        cr.set_line_width(5)
        cr.move_to(bx, y)
        cr.line_to(bx - 26, y - 3)
        cr.stroke()
        cr.set_source_rgb(*STEEL_RGB)
        cr.set_line_width(2.2)
        cr.move_to(bx - 26, y - 3)
        cr.line_to(bx - 80, y - 9)
        cr.stroke()
        cr.set_source_rgb(*COAT_RGB)
        cr.set_line_width(6)
        for hx in (bx - 8, bx - 36):
            cr.move_to(3, y - 13)
            cr.line_to(hx, y - (1 if hx > bx - 20 else 5))
        cr.stroke()
        if thrust > 0.6:
            # Dust and splinters off the logs.
            a = (thrust - 0.6) / 0.4
            cr.set_source_rgba(*WOOD_HI_RGB, 0.8 * a)
            for k in range(3):
                ang = -0.9 + k * 0.9
                cr.arc(bx + 6 + math.cos(ang) * 8 * a,
                       y + math.sin(ang) * 8 * a, 2.2, 0, 2 * math.pi)
                cr.fill()

    @staticmethod
    def _redcoat(cr, x, feet, s, facing, step, fall, pound=-1.0, seed=0.0,
                 crouch=0.0, aim=0.0, shot=-1.0):
        """A redcoat on the march, musket at the shoulder, in the same
        100-unit model as the mountain man. fall runs 0..1 as he topples
        backward and fades once he is shot; pound is the seconds he has
        been beating on the fort's wall, or negative on the march. crouch
        runs 0..1 as he drops to one knee. aim runs 0..1 as he levels his
        musket in front of him; shot is the seconds since he fired it, or
        negative, a flash and smoke at its muzzle."""
        if s < 1.5:
            return
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        if fall > 0:
            cr.rotate(-1.45 * min(1.0, fall * 1.8))
            cr.push_group()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)

        drop = 26 * crouch

        def lerp(a, b):
            return (a[0] + (b[0] - a[0]) * crouch,
                    a[1] + (b[1] - a[1]) * crouch)

        def leg(swing, front):
            fx = math.sin(swing) * 36
            knee = lerp((fx / 2, -24), (18, -24) if front else (-4, -5))
            foot = lerp((fx, -2), (20, -2) if front else (-26, -3))
            cr.set_source_rgb(*KIT_RGB)
            cr.set_line_width(8)
            cr.move_to(0, -46 + drop)
            cr.line_to(*knee)
            cr.line_to(*foot)
            cr.stroke()
            cr.set_source_rgb(*HAT_RGB)
            cr.save()
            cr.translate(foot[0] + 3, foot[1] + 0.5)
            cr.scale(6, 2.6)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()

        leg(-step, False)
        # Coat tails behind, then the coat, its white cross-belts on top.
        cr.translate(0, drop)
        cr.set_source_rgb(*COAT_DARK_RGB)
        cr.move_to(-10, -52)
        cr.line_to(-17, -30)
        cr.line_to(-6, -36)
        cr.close_path()
        cr.fill()
        cr.translate(0, -drop)
        leg(step, True)
        cr.translate(0, drop)
        CpuView._rc_upper(cr)

        if pound >= 0:
            CpuView._pounding(cr, pound, seed, -62)
            if fall > 0:
                cr.pop_group_to_source()
                cr.paint_with_alpha(max(0.0, 1.0 - fall))
            cr.restore()
            return

        # Musket at the shoulder, bayonet fixed; swung up level, about the
        # shoulder, as he aims.
        if aim > 0:
            cr.save()
            cr.translate(4, -72)
            cr.rotate(aim * (math.pi / 2 + 0.13))
            cr.translate(-4, 72)
        cr.set_source_rgb(*RIFLE_WOOD_RGB)
        cr.set_line_width(5)
        cr.move_to(7, -46)
        cr.line_to(4, -72)
        cr.stroke()
        cr.set_source_rgb(*STEEL_RGB)
        cr.set_line_width(2.2)
        cr.move_to(4, -72)
        cr.line_to(-3, -124)
        cr.stroke()
        cr.set_line_width(1.2)
        cr.move_to(-2, -122)
        cr.line_to(-4, -138)
        cr.stroke()
        cr.set_source_rgb(*COAT_RGB)
        cr.set_line_width(6)
        cr.move_to(3, -75)
        cr.line_to(7, -50)
        cr.stroke()
        cr.set_source_rgb(*SKIN_RGB)
        cr.arc(7, -48, 3, 0, 2 * math.pi)
        cr.fill()
        if aim > 0:
            cr.restore()
        if 0 <= shot < 2.2:
            mx, my = 60.0, -72.0 + drop * 0
            for j in range(3):
                u = min(1.0, max(0.0, shot - 0.06 * j) / 2.2)
                cr.set_source_rgba(*SMOKE_RGB, 0.55 * (1 - u))
                cr.arc(mx + 6 + 22 * math.sqrt(u) + 7 * j,
                       my - 12 * u - 3 * j, 4 + 11 * math.sqrt(u) + 2 * j,
                       0, 2 * math.pi)
                cr.fill()
            if shot < 0.14:
                flare = 1.0 - shot / 0.14
                CpuView._glow(cr, mx + 6, my, 26 * flare + 6, FLASH_RGB,
                              flare)
                cr.set_source_rgba(1, 1, 0.9, flare)
                cr.move_to(mx, my - 4)
                cr.line_to(mx + 22 * flare + 6, my)
                cr.line_to(mx, my + 4)
                cr.close_path()
                cr.fill()

        if fall > 0:
            cr.pop_group_to_source()
            cr.paint_with_alpha(max(0.0, 1.0 - fall))
        cr.restore()

    @staticmethod
    def _cavalry(cr, x, feet, s, facing, gallop, fall, pound=-1.0,
                 seed=0.0, rider=True, coat=(HORSE_RGB, HORSE_DARK_RGB),
                 graze=0.0, swish=0.0, walk=True):
        """A redcoat on horseback, saber out, in the same 100-unit model;
        gallop is the phase of the stride, and pound as for a redcoat.
        Without a rider, coat is the horse's (colour, shade); graze runs
        0..1 as it puts its head down to the grass, swish flicks its tail,
        and walk False stands it still."""
        if s < 1.5:
            return
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        if fall > 0:
            cr.rotate(-1.2 * min(1.0, fall * 1.8))
            cr.push_group()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        moving = pound < 0 and fall <= 0 and walk
        bob = math.sin(gallop * 2) * 2.5 if moving else 0.0
        hide, shade = coat

        def legs(far):
            cr.set_source_rgb(*(shade if far else hide))
            cr.set_line_width(5)
            for hx in ((-24, 14) if far else (-18, 20)):
                ph = gallop + (0.0 if hx < 0 else 2.0) + (0.5 if far else 0)
                swing = math.sin(ph) * 0.6 if moving else 0.0
                lift = max(0.0, math.cos(ph)) * 6 if moving else 0.0
                cr.move_to(hx, -40 + bob)
                cr.line_to(hx + math.sin(swing) * 12, -20 - lift)
                cr.line_to(hx + math.sin(swing) * 20, -2 - lift)
            cr.stroke()

        # The horse is drawn in its own units, scaled up to stand as high
        # at the withers as a man's shoulder.
        cr.save()
        cr.scale(1.35, 1.35)
        legs(True)
        cr.set_source_rgb(*shade)
        cr.set_line_width(5)
        cr.move_to(-30, -52 + bob)
        cr.curve_to(-40, -50, -44 + swish * 5, -40, -42 - bob + swish * 10,
                    -28)
        cr.stroke()
        cr.set_source_rgb(*hide)
        cr.save()
        cr.translate(0, -48 + bob)
        cr.scale(30, 12)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()
        cr.fill()
        # Neck and head, from up and alert to down at the grass.
        up = ((18, -54), (30, -80), (48, -68), (45, -62), (34, -66),
              (30, -44), (19, -58), (29, -80))
        down = ((16, -56), (38, -36), (47, -12), (40, -8), (33, -24),
                (27, -42), (17, -58), (37, -38))
        pts = [(ux + (dx - ux) * graze, uy + (dy - uy) * graze + bob)
               for (ux, uy), (dx, dy) in zip(up, down)]
        cr.move_to(*pts[0])
        for pt in pts[1:6]:
            cr.line_to(*pt)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*shade)
        cr.set_line_width(3)
        cr.move_to(*pts[6])
        cr.line_to(*pts[7])
        cr.stroke()
        legs(False)
        cr.restore()

        # The rider, sitting the saddle.
        if rider:
            cr.save()
            cr.translate(-3, (-60 + bob) * 1.35 + 42)
            cr.set_source_rgb(*KIT_RGB)
            cr.set_line_width(7)
            cr.move_to(0, -44)
            cr.line_to(8, -30)
            cr.line_to(6, -18)
            cr.stroke()
            CpuView._rc_upper(cr)
            if pound >= 0:
                CpuView._pounding(cr, pound, seed, -62)
            else:
                cr.set_source_rgb(*COAT_RGB)
                cr.set_line_width(6)
                cr.move_to(3, -74)
                cr.line_to(16, -64)
                cr.stroke()
                cr.set_source_rgb(*STEEL_RGB)
                cr.set_line_width(1.8)
                cr.move_to(16, -64)
                cr.line_to(44, -84)
                cr.stroke()
                cr.set_source_rgb(*SKIN_RGB)
