    assert siege.tally["pot_together_s"] > 15 and siege.tally["off_s"] > 30
    assert all(m["hunger"] < 0.3 for m in siege.men), "fed on stew"
    assert siege.tally["pot_meals"] >= 3 and siege.tally["pot_eating_s"] > 20
    # Stew feeds better than the pack: the same man, the same time.
    fed = {}
    for how in ("stew", "pack"):
        siege = _quiet_siege()
        siege.drill_start = [None, None]
        m = siege.men[2]
        m["hunger"] = 0.9
        if how == "stew":
            siege._to_pot(2, "meal")
        else:
            siege.pot.update(heat=0.0, stew=0.0)
            siege._sit_down(2)
        siege.run(Siege.WALK_S + Siege.SIT_S + 10)
        fed[how] = 0.9 - m["hunger"]
    assert fed["stew"] > 1.5 * fed["pack"] > 0, fed
    # The pot holds so much and eating draws it down, slowly; it is not
    # eaten from again until it is refilled and at the boil, which takes
    # a calm.
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    siege.pot.update(stew=0.3)
    siege.REFILL_S = 1e9                # (not refilling, to see it drawn)
    for m in siege.men:
        m["hunger"] = 1.0
    siege.men[2].update(mode="patrol")
    siege._to_pot(2, "meal")
    siege.run(Siege.WALK_S + 5)
    assert 0.0 < siege.pot["stew"] < 0.3, "drawn down"
    assert _until(siege, lambda: siege.pot["stew"] <= 0.0
                  or siege.men[2]["mode"] != "pot", 120)
    siege.men[2]["hunger"] = 1.0
    del siege.REFILL_S
    siege.pot.update(stew=0.0, heat=0.0)
    near = _foe(siege, "foot", 0.6, 0)
    near["hp"] = 99
    near["d"] = Siege.trail_d(0.6)
    siege.gun["ready"] = 1e9            # (the gun cannot take him)
    siege.run(30)
    assert siege.pot["stew"] == 0.0 and siege.pot["heat"] == 0.0 \
        and not siege.pot_ready(), "no lull, no stew"
    siege.redcoats = []
    siege.boats_in_sight = False
    assert _until(siege, lambda: siege.pot["stew"] > 0.2, 30)
    assert not siege.pot_ready(), "full enough to eat from, not yet at the boil"
    assert _until(siege, lambda: siege.pot_ready(), 120)
    assert siege.pot["stew"] > 0.5
    # When a redcoat comes into sight on either trail, they get up: a
    # sentry takes a beat to rise, walk back and climb, and until he is
    # back he cannot shoot.
    siege = _calm_siege(4)
    siege.drill_start = [None, None]
    assert _until(siege, lambda: all(siege.at_pot(i) for i in range(3)), 25)
    foe = _foe(siege, "foot", 0.45, 1)
    foe["hp"] = 99
    foe["d"] = Siege.trail_d(0.45)
    siege.run(0.1)
    assert siege.men[1]["leg"] in ("rise", "sit"), siege.men[1]["leg"]
    siege.run(Siege.RISE_S + 0.1)
    assert siege.men[1]["mode"] == "pot" and siege.men[1]["leg"] == "back"
    siege.drill_start[1] = siege.phase - 1.0    # he is called to fire...
    assert siege.men[1]["mode"] == "pot", "...but is not at his rifle"
    shots = siege.tally["shot"]
    siege.run(2.0)
    assert foe["hit"] is None and siege.tally["shot"] == shots
    assert _until(siege, lambda: siege.men[1]["mode"] == "post", 12)
    assert siege.men[2]["mode"] in ("patrol", "gun", "eat"), siege.men[2]
    assert siege.tally["off_caught"] >= 1 or foe["hit"] is not None
    assert _until(siege, lambda: all(m["mode"] != "pot" for m in siege.men), 12)

    # A SENTRY'S DESPERATION. A tower sentry with redcoats below him
    # calls for the gun whether or not anyone can answer; each call that
    # goes unanswered, made again every CALL_EVERY_S while they are there,
    # raises his own desperation and no other's. With the pot cold he
    # cannot do anything about it, and it stays high.
    siege = _quiet_siege(2)
    siege.drill_start = [None, None]
    siege.pot.update(heat=0.0)          # nothing to pour yet
    siege.gun["ready"] = 1e9            # and the gun not loaded
    foe = _at_the_foot(siege, "foot", 0, 0)
    foe["hp"] = 99
    assert _until(siege, lambda: siege.tally["unanswered"] >= 1, 12)
    assert siege.horning(0) and not siege.calling(0) and siege.relief is None
    assert siege.desp[0] == 1.0 and siege.desp[1] == 0.0
    assert _until(siege, lambda: siege.desp[0] >= Siege.DESP_AT, 60)
    siege.run(40)
    assert siege.desp[0] >= Siege.DESP_AT and siege.desp[1] == 0.0
    assert siege.men[0]["mode"] in ("post", "eat") \
        and siege.tally["pour_trips"] == 0, "cold: he cannot, and waits"
    # Once it is hot and full he takes it himself: his tower stands
    # unmanned, the other sentry stays, and the stew falls on his side.
    siege.pot.update(heat=1.0, stew=1.0)
    assert _until(siege, lambda: siege.men[0]["mode"] == "carry", 15)
    assert siege.pot["task"]["i"] == 0 and siege.men[1]["mode"] == "post"
    assert siege.tally["desp_pours"] == 1
    assert _until(siege, lambda: siege.tally["pours"] == 1, 30)
    assert foe["hit"] is not None and foe.get("scalded")
    assert siege.desp[0] == 0.0, "a pour resets it"

    # A relief shot on his side eases it, and a lull drains it away.
    siege = _quiet_siege(2)
    siege.drill_start = [None, None]
    siege.pot.update(heat=0.0)
    siege.desp[0] = 2.0
    foe = _at_the_foot(siege, "foot", 0, 0)
    foe["hp"] = 99
    assert _until(siege, lambda: siege.relief is not None, 12)
    siege.run(Siege.FIRE_AT + Siege.FLIGHT_S + 0.1)
    assert siege.relief["landed"] and foe["hit"] is not None
    assert 0.0 < siege.desp[0] < 2.0, "eased, not forgotten"
    siege.desp[0] = 2.0
    siege.run(Siege.QUIET_S + 2 * Siege.DESP_DRAIN_S + 6)
    assert siege.lull() and siege.desp[0] == 0.0, siege.desp

    # The gun is loaded again after every shot, and the walker is tied
    # up at it: swab, powder, ball, ram. While he loads he answers
    # nothing; then it answers again, and he goes back to his round.
    siege = _quiet_siege(2)
    siege.drill_start = [None, None]
    siege.pot.update(heat=0.0)
    foe = _at_the_foot(siege, "foot", 0, 0)
    foe["hp"] = 99
    assert _until(siege, lambda: siege.relief is not None, 12)
    assert _until(siege, lambda: siege.relief is None, 10)
    walker = siege.men[2]
    assert walker["mode"] == "gun", "he stays at it, loading"
    assert siege.gun["ready"] - siege.gun["fired"] >= Siege.RELOAD_S
    assert siege.phase < siege.gun["ready"] and siege.tally["reloads"] == 1
    again = _at_the_foot(siege, "foot", 0, 1)
    again["hp"] = 99
    while siege.phase < siege.gun["ready"] - 0.3:
        siege.run(0.2)
        assert siege.relief is None, "no second shot while he loads"
        assert walker["mode"] == "gun"
    assert _until(siege, lambda: walker["mode"] == "patrol", 5)
    assert _until(siege, lambda: siege.relief is not None, 15), \
        "loaded, it answers again"
    # A stormer who reaches it while it is being loaded takes it, and the
    # load waits for the walker to get it back.
    siege = _quiet_siege(2)
    siege.drill_start = [None, None]
    walker = siege.men[2]
    gx = siege.gun_at
    walker.update(mode="gun", x=gx - Siege.STATION_DX, face=1, t0=siege.phase,
                  clear=None, station=gx - Siege.STATION_DX)
    siege.gun.update(facing=1, ready=siege.phase + 20.0)
    st = _on_the_walk(siege, 1, gx + Siege.TAKE_X / 2)
    assert _until(siege, lambda: siege.gun["taken"], 12)
    assert siege.gun["load_left"] > 5.0, "the load is waiting"

    # The pot is poured: the desperate sentry leaves his tower, takes it off
    # its fire, carries it to that wall top and tips it over. Everyone on
    # that side's ladder and at the wall's foot is scalded, with steam and
    # no blood; a redcoat already on the walk is not; the other side is
    # untouched. Then the pot lies empty, and cold.
    siege = _quiet_siege(2)
    siege.drill_start = [None, None]
    siege.gun["ready"] = 1e9
    siege.desp[0] = Siege.DESP_AT
    siege.ladder.update(side=0, state="standing", ext=1.0)
    foot = [_at_the_foot(siege, "foot", 0, k) for k in range(4)]
    elsewhere = _at_the_foot(siege, "foot", 1, 0)
    on_ladder = foot[0]
    on_ladder.update(climb=siege.phase - 0.15 * Siege.CLIMB_UP_S)
    walking = _on_the_walk(siege, 0, 0.3)
    for rc in foot + [elsewhere, walking]:
        rc["hp"] = 99
    siege.wall[0] = 1.0
    assert siege.pot_ready() and siege.pot["stew"] == 1.0
    assert _until(siege, lambda: siege.men[2]["mode"] == "carry"
                  or siege.pot["task"], 12)
    assert not siege.pot_ready() or siege.pot["task"], "off its fire"
    assert _until(siege, lambda: siege.tally["pours"] == 1, 30)
    scalded = [rc for rc in foot if rc.get("scalded")]
    assert any(rc.get("climb") is not None for rc in scalded) \
        and len(scalded) >= 2, "on the ladder and at the foot"
    assert on_ladder in siege.stormers, "the first was already up: not caught"
    assert elsewhere["hit"] is None and not walking.get("scalded")
    assert all(rc["hp"] == 0 for rc in scalded) \
        and siege.tally["scalded"] == len(scalded)
    assert siege.pot["stew"] == 0.0 and siege.pot["heat"] == 0.0
    assert _until(siege, lambda: siege.pot["at"] == "spent", 5)
    assert siege.pot["x"] == Siege.LADDER_X[0] and not siege.pot_ready()
    # The price is supper: nobody eats stew until, in a lull, the pot is
    # carried back, refilled and brought to the boil.
    siege.redcoats = []
    siege.stormers = []
    for m in siege.men:
        m["hunger"] = 0.8
    assert _until(siege, lambda: siege.pot["at"] == "fire", 60), siege.pot
    assert siege.pot["x"] == Siege.POT_X and siege.pot["task"] is None
    assert not siege.pot_ready() and siege.pot["stew"] < 0.5
    assert _until(siege, lambda: siege.pot_ready(), 120)

    # A cold or an empty pot is not poured; with no stew, nothing happens.
    for heat, stew in ((0.5, 1.0), (1.0, 0.1)):
        siege = _quiet_siege(2)
        siege.drill_start = [None, None]
        siege.gun["ready"] = 1e9
        siege.desp[0] = Siege.DESP_AT
        siege.pot.update(heat=heat, stew=stew)
        siege.ladder.update(side=0, state="standing", ext=1.0)
        siege.gun["taken"] = True
        top = _at_the_foot(siege, "foot", 0, 0)
        top.update(climb=siege.phase - 0.7 * Siege.CLIMB_UP_S, hp=99)
        siege.run(12)
        assert not siege.tally["pours"] and siege.pot["at"] == "fire"
    # With the walker out in the woods, a tower sentry brings it: down off
    # his tower first.
    siege = _quiet_siege(2)
    siege.drill_start = [None, None]
    siege.desp[1] = Siege.DESP_AT
    siege.ladder.update(side=1, state="standing", ext=1.0)
    walker = _walker_out(siege, "hide", 1)
    walker.update(g=2.0, rock=2, shot_t=None, pinned=[], next_shot=1e9,
                  t0=siege.phase + 99)
    siege.gun["taken"] = True
    top = _at_the_foot(siege, "foot", 1, 0)
    top.update(climb=siege.phase - 0.6 * Siege.CLIMB_UP_S, hp=99)
    foot_man = _at_the_foot(siege, "foot", 1, 1)
    foot_man["hp"] = 99
    assert _until(siege, lambda: siege.pot["task"], 12)
    assert siege.pot["task"] and siege.pot["task"]["i"] == 1
    carrier = siege.men[siege.pot["task"]["i"]]
    assert carrier["mode"] == "carry"
    assert _until(siege, lambda: siege.tally["pours"] == 1, 30)
    assert _until(siege, lambda: carrier["mode"] == "pot"
                  and carrier["leg"] in ("back", "up")
                  or carrier["mode"] == "post", 8)
    assert siege.tally["scalded"] >= 1 and foot_man.get("scalded")

    # A side that flickers in and out of desperate straits does not have
    # the pot sent for over and over: a moment with nobody below does not
    # call a pour off, and once one is called off the pot rests a while.
    siege = _quiet_siege(2)
    siege.drill_start = [None, None]
    siege.desp[1] = Siege.DESP_AT
    siege.ladder.update(side=1, state="standing", ext=1.0)
    siege.gun["taken"] = True
    walker = _walker_out(siege, "hide", 1)
    walker.update(g=2.0, rock=2, shot_t=None, pinned=[], next_shot=1e9,
                  t0=siege.phase + 99)

    def flare():
        top = _at_the_foot(siege, "foot", 1, 0)
        top.update(climb=siege.phase - 0.6 * Siege.CLIMB_UP_S, hp=99)
        _at_the_foot(siege, "foot", 1, 1)["hp"] = 99

    flare()
    assert _until(siege, lambda: siege.pot["task"], 12)
    assert siege.pot["task"]["kind"] == "pour" \
        and siege.tally["pour_trips"] == 1
    siege.redcoats = []
    siege.run(Siege.GONE_S * 0.5)
    flare()
    siege.run(0.5)
    assert siege.pot["task"]["kind"] == "pour", "a moment is not gone"
    siege.redcoats = []
    assert _until(siege, lambda: siege.pot["task"] is None
                  or siege.pot["task"]["kind"] == "fetch",
                  Siege.HOLD_S + 2), "they are gone: called off"
    assert not siege.tally["pours"]
    while siege.phase < siege.pot_rest - 1.0:
        flare()
        siege.run(2.0)
        siege.redcoats = []
        siege.run(0.5)
    assert siege.tally["pour_trips"] == 1, "rested, not sent for again"
    assert _until(siege, lambda: siege.pot["at"] == "fire"
                  and siege.pot["task"] is None, 20)
    siege.run(max(0.0, siege.pot_rest - siege.phase))
    flare()
    assert _until(siege, lambda: siege.tally["pour_trips"] == 2, 12), \
        "and sent for once it has rested"

    # A man at his meal, drawn: in the calm, all three round the pot, the
    # sentries on their way down off the towers and up again.
    view.siege.redcoats = []
    view.siege.spawn_in = view.siege.wave_in = view.boat_in = 1e9
    view.siege.drill_start = [None, None]
    for man in view.siege.men:
        man["hunger"] = 0.7
    view.siege.pot.update(heat=1.0, stew=1.0)
    legs = set()
    for n in range(int(40 * 30)):
        view.phase += 1 / 30
        view._advance(1 / 30)
        legs.update(m.get("leg") for m in view.siege.men)
        if n % 3 == 0:
            view._draw(view, cr, 1024, 680)
    assert all(view.siege.at_pot(i) for i in range(3)), view.siege.men
    assert view.siege.tally["pot_meals"] >= 3 and view.siege.tally["pot_together"]
    assert {"down", "to", "sit"} <= legs, legs

    # Every leg of the way to the pot and of the pot's carrying, drawn.
    for i in (0, 1, 2):
        for leg in ("down", "to", "sit", "rise", "back", "up"):
            view.siege.men[i].update(mode="pot", leg=leg, x=0.4, h=0.5,
                                     why="rest", t0=view.siege.phase - 2,
                                     up=view.siege.phase - 0.3, feed="stew",
                                     face=1)
            view._draw(view, cr, 1024, 680)
        for leg in ("down", "to", "lift", "bear", "tip", "set"):
            view.siege.pot.update(at="carried", x=0.3)
            view.siege.men[i].update(mode="carry", leg=leg, x=0.3, h=0.5,
                                     t0=view.siege.phase - 1.4, kind="pour",
                                     side=i % 2, face=-1)
            view._draw(view, cr, 1024, 680)
    view.siege.pot.update(at="spent", side=1, x=Siege.LADDER_X[1])
    view._draw(view, cr, 1024, 680)
    view.siege.pot.update(at="fire", x=Siege.POT_X, task=None)
    for i in (0, 1):
        view.siege._home_post(i)
    view.siege._home_post(2)

    # The ladder, and the men on it and below it, drawn.
    view.siege.wall = [0.4, 0.4]
    for man in view.siege.men:
        man["hunger"] = 0.0
        man["mode"] = "patrol" if man is view.siege.men[2] else "post"
        man["up"] = None
    seen = set()
    for _ in range(int(90 * 30)):
        view.phase += 1 / 30
        view._advance(1 / 30)
        seen.add(view.siege.men[2]["mode"])
        if _ % 5 == 0:
            view._draw(view, cr, 1024, 680)
    assert {"to_wall", "lower", "descend", "mend", "ascend", "haul"} <= seen
    view.siege.wall = [1.0, 1.0]

    # A breached wall is still a wall: one gap a man could get through,
    # the rest standing broken, so the outline of the fort stays closed.
    for col in (0, 1):
        states = [CpuView._wall_piece_state(0.0, j, col)
                  for j in range(CpuView.WALL_PIECES)]
        gone = [j for j, st in enumerate(states) if st == 3]
        assert gone == list(CpuView.GAP_PIECES), (col, states)
        assert any(st == 1 for st in states) and any(st == 2 for st in states)
        heights = {CpuView._wall_piece_height(st, j, col)
                   for j, st in enumerate(states) if st == 1}
        assert all(0.5 < h < 1.0 for h in heights)
    for strength in (1.0, 0.6, 0.25, 0.05, 0.0):
        fallen = sum(CpuView._wall_piece_state(strength, j, c) == 3
                     for j in range(CpuView.WALL_PIECES) for c in (0, 1))
        assert fallen <= 2 * len(CpuView.GAP_PIECES), (strength, fallen)
    view.siege.wall = [0.0, 0.0]
    view._draw(view, cr, 900, 560)
    view.siege.wall = [1.0, 1.0]

    # A breached wall in a flood, drawn as it runs: redcoats through the
    # gap and up on the walk, the gun, the bears coming and mauling.
    siege = view.siege
    siege.redcoats = []
    siege.wall = [0.0, 0.0]
    siege.flood = True
    siege.spawn_in = siege.wave_in = view.boat_in = 1e9
    siege.called = [["foot"] * 6, ["foot"] * 6]
    seen = set()
    for n in range(int(75 * 30)):
        view.phase += 1 / 30
        view._advance(1 / 30)
        seen.update(b["layer"] for b in siege.bears)
        if n % 5 == 0:
            view._draw(view, cr, 1024, 680)
    assert siege.tally["top"] and siege.tally["bear_trips"] \
        and {"ground", "wall", "walk"} <= seen, (siege.tally, seen)
    siege.flood = False
    siege.wall = [1.0, 1.0]
    siege.called = [[], []]


def self_test():
    """Build every page and draw every state against a real surface.

    Cairo draws that are wrong mostly paint nothing rather than raise, so
    this proves the code paths run, not that the picture looks right.
    """
    Adw.init()
    load_css()
    win = FortWindow(None)
    for name in ("loading", "home", "error"):
        win.stack.set_visible_child_name(name)
        assert win.stack.get_visible_child_name() == name, name

    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, 520, 260)
    cr = cairo.Context(surface)
    for mode in ("on", "off", "partial"):
        for delegated in (True, False):
            for apps in (SAMPLE_STATE["apps"], []):
                st = dict(SAMPLE_STATE, mode=mode, apps=apps,
                          cpuset_delegated=delegated)
                win.apply_state(st)
                win._update_rows()
                win.app_list.set_cpu({})
                assert win.hero.get_label()
                win.view.shown = {c: (c % 7) / 6 for c in range(20)}
                for win.view.phase in (0.0, 0.7, 3.3, 11.3, 13.05, 14.5):
                    win.view._draw(win.view, cr, 520, 260)
    win.view._draw(win.view, cr, 60, 40)  # drives every clamp

    view = win.view
    # The seasons turn every fifteen minutes, a year an hour, blending
    # into each other over the last minute, whether the fort is up or not.
    w = World(1)
    assert (w.season(), w.year()) == (0, 1)
    w.run(World.SEASON_S * 5)
    assert (w.season(), w.year()) == (1, 2), (w.season(), w.year())
    w = World(1)
    prev = None
    for k in range(int(2 * World.SEASON_S)):
        weights = w.season_weights(k * 0.5 + World.SEASON_S - 200)
        assert abs(sum(weights) - 1) < 1e-9, weights
        if prev:
            assert max(abs(a - b) for a, b in zip(weights, prev)) <= 0.05
        prev = weights
    assert w.season_weights(800.0) == [1.0, 0.0, 0.0, 0.0]
    weights = w.season_weights(World.SEASON_S - World.BLEND_S / 2)
    assert abs(weights[0] - 0.5) < 1e-9 and abs(weights[1] - 0.5) < 1e-9
    for on in (False, True):
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], on)
        before = view.world.time
        view._advance(0.1)
        assert view.world.time > before, "the clock runs up and down"
        for t in (0.0, 850.0, 900.0, 1800.0, 2700.0, 3550.0):
            view.world.time = t
            for size in ((60, 40), (300, 220), (560, 420), (1024, 680)):
                view._draw(view, cr, *size)
    view.time_scale = 50.0
    before = view.world.time
    view._advance(0.1)
    assert abs(view.world.time - before - 5.0) < 1e-6, view.world.time
    view.time_scale = 1.0
    # Hidden, the picture stops ticking, and the window's clock runs the
    # world on; a long gap counts for only a little.
    view.world_at = None
    view.catch_up(100.0)
    before = view.world.time
    view.catch_up(100.5)
    assert view.world.time == before, "not while it ticks"
    view.catch_up(104.0)
    assert abs(view.world.time - before - 4.0) < 1e-6, view.world.time
    view.catch_up(10_000.0)
    assert abs(view.world.time - before - 4.0 - view.CATCH_UP_MAX) < 1e-6
    assert parse_args(["--time-scale", "60"])["time_scale"] == 60.0
    for bad in (["--time-scale", "0"], ["--time-scale", "x"],
                ["--time-scale"]):
        err = sys.stderr
        sys.stderr = io.StringIO()
        try:
            parse_args(bad)
            assert False, bad
        except SystemExit as e:
            assert e.code == 2, bad
        finally:
            sys.stderr = err
    view.world = World(seed=7)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)

    # The valley is kept between runs, through JSON, and goes on exactly as
    # it would have; a missing or bad file starts a fresh one, quietly.
    w = World(3)
    w.run(2000)
    w2 = World.from_dict(json.loads(json.dumps(w.to_dict())))
    assert w2.to_dict() == w.to_dict()
    w.run(World.YEAR_S)
    w2.run(World.YEAR_S)
    assert w2.to_dict() == w.to_dict(), "a loaded world runs on the same"
    with tempfile.TemporaryDirectory() as tmp:
        bad = {"nope": "nope", "list": "[]", "other": '{"version": 999}'}
        # Of this schema but broken within: each would raise later, in
        # the frame clock or while the window is built.
        for name, spoil in (
                ("hungerless", lambda d: d["trappers"][0].pop("fed")),
                ("timeless", lambda d: d.update(time="x")),
                ("nowhere", lambda d: d["beavers"][0].update(
                    at=["plot", 0, 9])),
                ("denless", lambda d: d["predators"].append(
                    dict(World(0)._bear(0, ["edge", 0]), to=["den", 9]))),
                ("jobless", lambda d: d["predators"].append(
                    dict(World(0)._bear(0, ["edge", 0]), job="x"))),
                ("lost", lambda d: d["trappers"][0].update(
                    job="fight", to=["plot", 0, 9])),
                ("stalled", lambda d: d.update(next_tick=0.0))):
            d = w.to_dict()
            spoil(d)
            bad[name] = json.dumps(d)
        for name, text in bad.items():
            with open(os.path.join(tmp, name), "w") as fh:
                fh.write(text)
        err = sys.stderr
        for name in ["missing", "."] + list(bad):
            sys.stderr = io.StringIO()
            try:
                fresh = load_world(os.path.join(tmp, name))
                said = sys.stderr.getvalue()
            finally:
                sys.stderr = err
            assert fresh.time == 0 and not said, (name, said)
        path = os.path.join(tmp, "a", "b", "world.json")
        save_world(w, path)
        assert os.listdir(os.path.dirname(path)) == ["world.json"]
        assert load_world(path).time == w.time
        old = os.environ.get("XDG_STATE_HOME")
        os.environ["XDG_STATE_HOME"] = tmp
        try:
            assert world_path().startswith(tmp + os.sep), world_path()
        finally:
            if old is None:
                del os.environ["XDG_STATE_HOME"]
            else:
                os.environ["XDG_STATE_HOME"] = old
        kept = FortWindow(None, state_path=os.path.join(tmp, "w.json"))
        assert kept.save_id and kept.view.world.time == 0
        kept.view.world.run(42.0)
        kept._on_close(kept)
        assert load_world(os.path.join(tmp, "w.json")).time == 42.0
        assert kept.save_id == 0
        # Ctrl-C saves it too, and quits.
        kept.view.world.run(8.0)
        app, quits = FortApp(), []
        app.window, app.quit = kept, lambda: quits.append(1)
        assert app._on_sigint() == GLib.SOURCE_REMOVE and quits == [1]
        assert load_world(os.path.join(tmp, "w.json")).time == 50.0
    assert win.state_path is None and win.save_id == 0, "never the real one"
    view.set_world(w2)
    for size in ((300, 220), (1024, 680), (560, 420)):
        view._draw(view, cr, *size)
    # The valley over several seeds and years, which the tests below read.
    started = time.monotonic()
    rows = envelope((1, 2, 3, 4), 4)
    took = time.monotonic() - started
    assert took < 60, took
    beaver_tests(view, cr, rows)

    # The woods stand still from frame to frame, clear of the grove and
    # out of the water, and every size lays out, down to none at all.
    every = [cpu for core in SAMPLE_STATE["cores"] for cpu in core["cpus"]]
    for reserved, on in ((SAMPLE_STATE["reserved"], True), (every, True),
                         (SAMPLE_STATE["reserved"], False), (every, False)):
        view.set_state(SAMPLE_STATE["cores"], reserved, on)
        for size in ((60, 40), (300, 220), (1, 1)):
            view._draw(view, cr, *size)
            for _ in range(5 * 30):
                view.phase += 1 / 30
                view._advance(1 / 30)
            view._launch_boat(0)
            view._draw(view, cr, *size)
            assert (view.scenery if on else view.wild) is not None, size
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    view._draw(view, cr, 1024, 680)
    trees = list(view.wild["trees"])
    view.phase += 1.0
    view._draw(view, cr, 1024, 680)
    assert trees and view.wild["trees"] == trees, "the woods hold still"
    for x, base, h, kind, i in trees:
        assert not view._in_box(view.wild["grove"], x, base), (x, base)
        assert abs(base - view._river_y(x)) > view._river_half_max(x), \
            (x, base)

    more = envelope((5, 6, 7, 8), 4)
    trapper_tests(view, cr, rows, more)
    bear_tests(view, cr, rows, more)

    # The almanac prints a row a season, headless, touching no state file.
    with tempfile.TemporaryDirectory() as tmp:
        old = os.environ.get("XDG_STATE_HOME")
        os.environ["XDG_STATE_HOME"] = tmp
        try:
            buf = io.StringIO()
            almanac(1, seed=2, out=buf)
            assert parse_args(["--almanac", "3"])["almanac"] == 3
            assert parse_args(["--almanac", "3", "--seed", "5"])["seed"] == 5
        finally:
            if old is None:
                del os.environ["XDG_STATE_HOME"]
            else:
                os.environ["XDG_STATE_HOME"] = old
        assert not os.listdir(tmp), os.listdir(tmp)
    lines = buf.getvalue().splitlines()
    assert len(lines) == 5, lines
    for word in ("season", "beavers", "dams", "lodges", "trappers", "bears",
                 "cabins", "pelts", "trees", "deaths", "arrivals", "fights"):
        assert word in lines[0], word
    assert [ln.split()[0] for ln in lines[1:]] == list(World.SEASONS)

    # The siege report runs headless too: a row a minute and a total, in
    # which redcoats were sent and some were shot.
    buf = io.StringIO()
    siege_report(3, seed=2, out=buf)
    assert parse_args(["--siege", "3"])["siege"] == 3
    assert parse_args(["--siege", "3", "--seed", "5"])["seed"] == 5
    lines = buf.getvalue().splitlines()
    assert len(lines) == 2 + 3 + 1, lines
    assert "no boats" in lines[0]
    for word in ("minute", "sent", "shot", "wall", "blasted", "gun calls"):
        assert word in lines[1], word
    assert [ln.split()[0] for ln in lines[2:]] == ["1", "2", "3", "total"]
    sent, shot = lines[-1].split()[1:3]
    assert sum(map(int, sent.split("/"))) >= 5 and int(shot) >= 1, lines[-1]
    for word in ("hurt", "mended", "breaches", "repairs", "caught", "out s",
                 "retreats", "rc shots", "climbs", "pushes", "raises", "fell",
                 "eating"):
        assert word in lines[1], word
    assert parse_args(["--siege", "3", "--pressure", "flood"])["pressure"] \
        == "flood"
    assert parse_args(["--siege", "3", "--seeds", "4"])["seeds"] == 4
    # The flood adds an eager user's waves, and the summary says in how
    # many runs each of the owner's wishes came true.
    calm, flooded = io.StringIO(), io.StringIO()
    quiet = siege_seeds(5, 2, "normal", out=calm)
    wet = siege_seeds(5, 2, "flood", out=flooded)
    assert sum(sum(t["sent"].values()) for t in wet) \
        > sum(sum(t["sent"].values()) for t in quiet)
    assert "2 seeds x 5 minutes, flood" in flooded.getvalue()
    for what, _ in SIEGE_CLAIMS:
        assert what in calm.getvalue(), what

    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
    view.boats, view.potshot = [], None
    for facing, phase in ((1, 0.0), (-1, 10.0)):
        view.siege.bugle_at = None
