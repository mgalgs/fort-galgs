def siege_pictures(view, size=(900, 560), outdir=None):
    """Draw each state of SIEGE_PICTURES on a fresh siege, a few frames
    apiece so that anything animated moves, and write each as a PNG into
    outdir if one is given. Returns the names drawn."""
    w, h = size
    names = []
    for name, stage, *zoom in SIEGE_PICTURES:
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
        cr = cairo.Context(surface)
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
        siege = view.siege
        siege.wave_in = siege.spawn_in = view.boat_in = 1e9
        siege.drill_start = [siege.phase + 1e9, siege.phase + 1e9]
        view.phase = siege.phase
        view._draw(view, cr, w, h)
        stage(siege)
        for _ in range(4):
            view.phase += 0.1
            siege.tick(0.1)
            cr.save()
            if zoom:
                # A close-up: about (fx, fy) of the picture, k times as big.
                fx, fy, k = zoom[0]
                cr.translate(w / 2, h / 2)
                cr.scale(k, k)
                cr.translate(-fx * w, -fy * h)
            view._draw(view, cr, w, h)
            cr.restore()
        if outdir:
            surface.write_to_png(os.path.join(outdir, f"{name}.png"))
        names.append(name)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    return names


def siege_tests(view, cr):
    """The walls, the lulls, the walker's mending and the ladder: staged
    situations, run with Siege alone, and the drawings of each state."""
    # Pounding hurts the wall, a horseman a little more than a man, a
    # cannon most, one side only; a breached wall takes nothing more.
    for kind in ("foot", "horse", "cannon"):
        siege = _quiet_siege()
        _at_the_foot(siege, kind, side=1)
        siege.run(20)
        assert siege.wall[0] == 1.0 and siege.wall[1] < 1.0, (kind, siege.wall)
        siege.redcoats[0]["hp"] = 99
        if kind == "foot":
            foot = 1.0 - siege.wall[1]
        elif kind == "horse":
            assert 1.0 - siege.wall[1] > foot, "a horseman hits harder"
            horse = 1.0 - siege.wall[1]
        else:
            assert 1.0 - siege.wall[1] > horse, "a cannon hits hardest"
    siege = _quiet_siege()
    rc = _at_the_foot(siege, "cannon")
    rc["hp"] = 99
    siege.wall[0] = Siege.HURT_PER_BALL * 1.5
    siege.run(Siege.BOOM_EVERY + 1)
    assert siege.breached(0) and siege.tally["breaches"] == 1, siege.wall
    before = siege.tally["hurt"][0]
    siege.run(Siege.BREACH_WAIT_S - Siege.BOOM_EVERY - 2)
    assert siege.wall[0] == 0.0 and siege.tally["hurt"][0] == before
    assert siege.tally["breaches"] == 1, "a breach is counted once"
    assert siege.at_wall(rc), "he waits at the gap"
    siege.run(Siege.BREACH_WAIT_S)
    assert rc not in siege.redcoats, "and tires of waiting, and goes"
    assert not siege.in_range(), "so the quiet can come"

    # A lull, a few quiet seconds, lets a hungry man sit and eat: each of
    # the two sentries where he stands and the walker on the wall walk,
    # while a fed man goes on watching. Redcoats in range send him back to
    # work, but standing up takes a beat.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.boats_in_sight = True     # no calm: the pot is not for them
    siege.pot.update(heat=0.0, stew=0.0)
    siege.men[0]["hunger"], siege.men[2]["hunger"] = 0.6, 0.6
    siege.run(Siege.QUIET_S - 1)
    assert not siege.lull() and not siege.eating(0), "not yet a lull"
    siege.run(Siege.MEAL_AFTER_S - Siege.QUIET_S + 2.5)
    assert siege.lull() and siege.eating(0) and siege.eating(2)
    assert not siege.eating(1), "a fed man does not sit down"
    assert siege.sit(0) == 1.0 and siege.men[0]["mode"] == "eat"
    assert not siege.sound_bugle(0), "no bugle from a man at his meal"
    siege.run(20)
    assert siege.men[0]["hunger"] < 0.6 and siege.tally["meals"] >= 2
    assert siege.tally["eating_s"] > 30
    rc = _at_the_foot(siege)
    rc["d"] = Siege.trail_d(0.6)
    rc["at_wall"] = None
    siege.run(0.3)
    assert siege.men[0]["mode"] == "eat" and 0 < siege.sit(0) < 1, \
        "getting up is not instant"
    siege.run(Siege.RISE_S + 0.2)
    assert siege.men[0]["mode"] == "post" and siege.sit(0) == 0.0
    assert siege.men[2]["mode"] == "patrol"
    siege.run(0.5)
    assert not siege.lull(), "redcoats in range"
    # A hungry man's drill takes longer.
    siege = _quiet_siege()
    siege.drill_start = [siege.phase, siege.phase]
    siege.men[0]["hunger"] = 1.0
    siege.run(Siege.DRILL_LEN + 0.2)
    assert not siege.busy(1) and siege.busy(0), "starving, he is slower"
    assert abs(siege.pace(0) - (1 - Siege.HUNGER_SLOW)) < 1e-9
    siege.run(Siege.DRILL_LEN)
    assert not siege.busy(0)

    # In a lull the walker goes down to mend the most damaged wall: he
    # walks to its end, lowers the ladder over the outside, climbs down and
    # mends, the strength rising as he works. While he is down nobody
    # walks the wall: no bugle, no gun. He climbs back and hauls the
    # ladder up after him when redcoats come into range.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.wall = [1.0, 0.5]
    walker = siege.men[2]
    assert _until(siege, lambda: walker["mode"] == "to_wall", 10), walker
    assert siege.tally["repairs"] == 1 and siege.ladder["side"] == 1
    assert _until(siege, lambda: walker["mode"] == "lower", 20), walker
    assert siege.ladder["state"] == "standing"
    assert _until(siege, lambda: walker["mode"] == "mend", 20), walker
    assert siege.ladder["ext"] == 1.0 and walker["h"] == 0.0
    assert siege.out(2) and not siege.sound_bugle(1), "nobody walks the wall"
    before = siege.wall[1]
    siege.run(10)
    assert siege.wall[1] > before + 0.05 and siege.tally["mended"][1] > 0.05
    assert siege.wall[0] == 1.0
    siege.relief = None
    _at_the_foot(siege, "cannon", side=0)
    siege.redcoats[-1]["hp"] = 99
    siege.run(2)
    assert siege.relief is None, "the gun cannot be worked"
    siege.redcoats = []
    siege.wall[0] = 1.0
    rc = _at_the_foot(siege, "foot", side=1)
    rc["d"], rc["at_wall"] = Siege.trail_d(0.45), None
    assert _until(siege, lambda: walker["mode"] == "ascend", 3), \
        "he sees them come"
    assert _until(siege, lambda: walker["mode"] == "haul", 10)
    assert _until(siege, lambda: walker["mode"] == "patrol", 10)
    assert siege.ladder["state"] == "up" and not siege.out(2)
    assert siege.tally["repairs_done"] == 0, "not finished"
    # Left to it, he finishes the wall and goes back to his patrol.
    siege.redcoats = []
    assert _until(siege, lambda: walker["mode"] == "mend", 40)
    assert _until(siege, lambda: siege.wall[1] >= 1.0, 60)
    assert _until(siege, lambda: walker["mode"] == "haul", 10)
    assert _until(siege, lambda: siege.ladder["state"] == "up", 10)
    assert siege.tally["repairs_done"] == 1 and siege.tally["repairs"] == 2
    assert siege.ladder["state"] == "up" and siege.wall == [1.0, 1.0]
    # A starving man eats first; he does not go down faint.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.wall = [0.5, 1.0]
    siege.boats_in_sight = True
    siege.pot.update(heat=0.0, stew=0.0)
    walker = siege.men[2]
    walker["hunger"] = 0.9
    siege.run(Siege.MEAL_AFTER_S + 2)
    assert siege.eating(2) and siege.tally["repairs"] == 0
    # With no room on the wall for a walker, the sentry on that side mends.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.has_walker = False
    siege.wall = [1.0, 0.5]
    assert _until(siege, lambda: siege.men[1]["mode"] == "mend", 40)
    assert siege.out(1) and not siege.out(0) and siege.ladder["side"] == 1
    assert _until(siege, lambda: siege.wall[1] >= 1.0, 60)
    assert _until(siege, lambda: siege.men[1]["mode"] in ("post", "eat"), 20)
    assert siege.ladder["state"] == "up" and not siege.out(1)

    # Caught outside: a horseman in range will be at the foot of the wall
    # before he can climb, so he breaks for the woods; the ladder is left
    # standing. A man on foot far enough off, he climbs away from.
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    siege.wall = [0.5, 1.0]
    walker = _walker_out(siege)
    _foe(siege, "horse", 0.55)
    siege.run(0.2)
    assert walker["mode"] == "run" and siege.tally["caught"] == 1, walker
    assert siege.ladder["state"] == "standing" and siege.out(2)
    assert _until(siege, lambda: walker["mode"] == "hide", 10)
    assert walker["rock"] == 1 and walker["g"] == 1.0
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    walker = _walker_out(siege)
    siege.wall = [0.5, 1.0]
    _foe(siege, "foot", 0.52)
    siege.run(0.2)
    assert walker["mode"] == "ascend", "time enough to climb"
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    walker = _walker_out(siege)
    siege.wall = [0.5, 1.0]
    siege.men[2]["hunger"] = 1.0   # starving, slowly
    _foe(siege, "foot", 0.52)
    siege.run(0.2)
    assert walker["mode"] == "run", \
        "a hungry man is caught where a fed one is not"

    # Behind a rock he takes pot shots at redcoats on his side, often from
    # the first, seldom from the second and not at all from the third,
    # which is out of range.
    shots = []
    for k in (1, 2, 3):
        count = 0
        for seed in range(6):
            siege = _quiet_siege(seed)
            walker = _walker_out(siege)
            walker.update(mode="hide", g=float(k), rock=k, shot_t=None,
                          pinned=[], next_shot=siege.phase + 1)
            rc = _foe(siege, "foot", 1.0 - (k + 0.7) / Siege.G_SPAN)
            d, rc["hp"] = rc["d"], 99
            for _ in range(40 * 30):
                rc["d"] = d     # he stands his ground, for the count
                siege.run(1 / 30)
                walker.update(pinned=[], g=float(k), t0=siege.phase)
            count += rc["struck"] is not None
        shots.append(count)
    assert shots[0] > shots[1] > shots[2] == 0, shots

    # Redcoats answer: one leaves the trail and fires at the man's rock,
    # chipping it; enough fire, and he falls back to the next rock. The
    # man who went after him goes back to the trail.
    siege = _quiet_siege(3)
    siege.drill_start = [None, None]
    walker = _walker_out(siege)
    walker.update(mode="hide", g=1.0, rock=1, shot_t=None, pinned=[],
                  next_shot=1e9)
    siege.DRIVE_CHANCE = 600.0  # as good as certain, for the test
    rc = _foe(siege, "foot", 0.43)
    rc["hp"] = 99
    assert _until(siege, lambda: rc.get("drive"), 60), "he goes after him"
    assert _until(siege, lambda: siege.tally["rc_shots"] >= 1, 10)
    assert siege.rock_chip[0][1] is not None, "the rock is struck"
    assert _until(siege, lambda: walker["rock"] == 2, 40), walker
    assert siege.tally["retreats"] == 1 and not rc.get("drive")
    assert walker["mode"] in ("run", "hide") and siege.men[2]["hunger"] > 0

    # He comes home in a lull, climbs the ladder and hauls it up.
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    walker = _walker_out(siege)
    walker.update(mode="hide", g=2.0, rock=2, shot_t=None, pinned=[],
                  next_shot=1e9)
    assert _until(siege, lambda: walker["mode"] == "home", 30)
    assert _until(siege, lambda: walker["mode"] == "ascend", 20)
    assert walker["g"] == 0.0
    assert _until(siege, lambda: walker["mode"] == "patrol", 30)
    assert siege.ladder["state"] == "up" and not siege.out(2)
    assert siege.tally["out_s"] > 5

    # He judges by his own side: with a redcoat at the far wall, and his
    # own side clear, he comes out from behind his rock. If his wall is
    # damaged he mends it from out in the grass, and then goes home; if it
    # is whole he goes straight home. The far side stays busy throughout.
    for wall in (0.5, 1.0):
        siege = _quiet_siege()
        siege.drill_start = [None, None]
        siege.wall = [wall, 1.0]
        siege.pot.update(heat=0.0)      # no stew to scald him with
        walker = _walker_out(siege)
        walker.update(mode="hide", g=2.0, rock=2, shot_t=None, pinned=[],
                      next_shot=1e9)
        far = _at_the_foot(siege, "foot", 1)
        far["hp"] = 99
        modes = []
        for _ in range(120 * 30):
            siege.run(1 / 30)
            if far["at_wall"] is not None:
                far["d"] = Siege.MARCH_NEAR
            if not modes or modes[-1] != walker["mode"]:
                modes.append(walker["mode"])
            if walker["mode"] == "patrol":
                break
            assert not siege.lull(), "the far side is never quiet"
            if walker["mode"] == "mend":
                assert walker["g"] == 2.0, "he mends from where he is"
        if wall < 1.0:
            assert modes == ["hide", "mend", "home", "ascend", "haul", "patrol"], modes
            assert siege.wall[0] >= 1.0 and siege.tally["repairs_out"] == 1
        else:
            assert modes == ["hide", "home", "ascend", "haul", "patrol"], modes
            assert siege.tally["repairs_out"] == 0
    # With a redcoat on his own trail, close enough to matter, he stays.
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    siege.wall = [0.5, 1.0]
    walker = _walker_out(siege)
    walker.update(mode="hide", g=2.0, rock=2, shot_t=None, pinned=[],
                  next_shot=1e9)
    near = _foe(siege, "foot", 0.2)
    near["hp"] = 99
    for _ in range(30 * 20):
        siege.run(1 / 30)
        near["d"] = Siege.trail_d(0.52)
        assert walker["mode"] in ("hide", "run"), walker["mode"]
    # And mending outside, a horseman on his side catches him again.
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    siege.wall = [0.5, 1.0]
    walker = _walker_out(siege)
    walker.update(mode="mend", g=2.0, rock=2, h=0.0, shot_t=None, pinned=[])
    _foe(siege, "horse", 0.55)
    siege.run(0.2)
    assert walker["mode"] == "hide" and siege.tally["caught"] == 1, walker

    # A standing ladder is the redcoats' too: a man at its foot climbs it
    # instead of pounding, one at a time, slowly; at the top he steps onto
    # the wall walk. (Sentries and walker hold fire here.)
    siege = _quiet_siege()
    siege.has_walker = False
    siege.ladder.update(side=0, state="standing", ext=1.0)
    first = _at_the_foot(siege, "foot", 0, 0)
    second = _at_the_foot(siege, "foot", 0, 1)
    first["hp"] = second["hp"] = 99
    siege.run(Siege.NOTICE_S + 0.5)
    assert siege.tally["climbs"] == 1 and len(siege.climbers()) == 1
    mid = siege.climbers()[0]
    siege.run(Siege.CLIMB_UP_S / 2)
    assert 0.3 < siege.climb_u(mid) < 0.8, siege.climb_u(mid)
    assert siege.tally["climbs"] == 1, "one man on it at a time"
    assert _until(siege, lambda: mid in siege.stormers, 20), \
        "at the top he steps onto the wall walk"
    assert siege.tally["top"] == 1 and mid not in siege.redcoats \
        and mid["mode"] == "walk" and mid["side"] == 0
    assert not siege.climbers()
    assert siege.ladder["state"] == "standing", "still the redcoats' to use"
    assert _until(siege, lambda: siege.tally["climbs"] == 2, 10)
    # A shove kills the man on it: a sentry on that side puts his rifle
    # butt to the ladder's top, which takes him longer than a shot, and
    # the ladder falls outward.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.ladder.update(side=0, state="standing", ext=1.0)
    foot = _at_the_foot(siege, "foot", 0, 0)
    foot["hp"] = 99
    assert _until(siege, lambda: siege.climbers(), 10)
    assert _until(siege, lambda: siege.men[0]["mode"] == "shove", 5), \
        "a man climbing: he shoves"
    assert siege.men[1]["mode"] == "post"
    siege.run(Siege.SHOVE_AT - 0.5)
    assert siege.ladder["state"] == "standing" and foot["hit"] is None, \
        "slower than a shot"
    siege.run(1.0)
    assert siege.ladder["state"] == "falling" and foot["hit"] is not None
    assert foot["fell"] and siege.tally["fell"] == 1 \
        and siege.tally["pushes"] == 1
    siege.run(Siege.LADDER_FALL_S + 0.1)
    assert siege.ladder["state"] == "fallen"
    assert _until(siege, lambda: siege.men[0]["mode"] == "post", 5)
    # Two redcoats raise a fallen ladder, together, in some seconds; one
    # alone cannot, and a shot man stops them.
    siege = _quiet_siege()
    siege.has_walker = False
    siege.ladder.update(side=0, state="fallen", raised=0.0)
    a = _at_the_foot(siege, "foot", 0, 0)
    a["hp"] = 99
    siege.run(Siege.RAISE_BY_S + 1)
    assert siege.ladder["state"] == "fallen" and siege.ladder["raised"] == 0
    b = _at_the_foot(siege, "foot", 0, 1)
    b["hp"] = 99
    siege.run(Siege.RAISE_BY_S / 2)
    assert 0.3 < siege.ladder["raised"] < 0.7, siege.ladder
    b["hit"] = siege.phase
    siege.run(Siege.RAISE_BY_S)
    assert siege.ladder["state"] == "fallen" and siege.ladder["raised"] == 0
    c = _at_the_foot(siege, "foot", 0, 1)
    c["hp"] = 99
    assert _until(siege, lambda: siege.ladder["state"] == "standing",
                  Siege.RAISE_BY_S + 2)
    assert siege.tally["raises"] == 1
    assert _until(siege, lambda: siege.tally["climbs"] == 1, 5), \
        "a raised ladder is theirs to climb"
    # With a sentry's hands full the walker runs to the wall's end himself
    # and shoves it off.
    siege = _quiet_siege()
    siege.ladder.update(side=0, state="standing", ext=1.0)
    a = _at_the_foot(siege, "foot", 0, 0)
    a["hp"] = 99
    assert _until(siege, lambda: siege.men[2]["mode"] == "shove_run", 20)
    assert _until(siege, lambda: siege.men[2]["mode"] == "shove", 10)
    assert _until(siege, lambda: siege.men[2]["mode"] == "patrol", 10)
    assert siege.ladder["state"] in ("falling", "fallen") \
        and siege.tally["pushes"] == 1
    # He comes home to a fallen ladder, and raises it alone, which takes a
    # while, before he climbs.
    siege = _quiet_siege()
    siege.ladder.update(side=0, state="fallen", ext=1.0, raised=0.0)
    walker = _walker_out(siege, "home")
    siege.ladder["state"] = "fallen"
    walker["g"] = 1.0
    assert _until(siege, lambda: walker["mode"] == "raise", 10)
    start = siege.phase
    assert _until(siege, lambda: walker["mode"] == "ascend", 30)
    assert siege.phase - start > Siege.RAISE_ALONE_S * 0.9
    assert _until(siege, lambda: walker["mode"] == "patrol", 30)
    assert siege.ladder["state"] == "up"

    # Redcoats on the wall walk advance on the gun; the walker runs to it,
    # turns it on them and fires along the walk, which takes more than one
    # man at once, and he reloads before he can fire again.
    siege = _quiet_siege()
    siege.BLAST_KILL = 1.0
    a = _on_the_walk(siege, 0, 0.1)
    b = _on_the_walk(siege, 0, 0.13)
    assert siege.men[2]["mode"] == "patrol"
    siege.run(0.1)
    assert siege.men[2]["mode"] == "gun", "he goes to the gun"
    assert a["x"] > 0.1, "they advance on it"
    assert _until(siege, lambda: siege.gun["fired"] is not None, 30)
    assert a["hit"] is not None and b["hit"] is not None, "both taken"
    assert siege.tally["gun_kills"] == 2 and siege.gun["facing"] == -1
    assert siege.gun["turned"] is not None, "turned to face the west"
    assert siege.gun["ready"] - siege.gun["fired"] >= Siege.RELOAD_S
    c = _on_the_walk(siege, 0, 0.05)
    siege.run(Siege.RELOAD_S - 1.0)
    assert c["hit"] is None, "no second shot while he reloads"
    assert _until(siege, lambda: c["hit"] is not None, 20)
    assert _until(siege, lambda: siege.men[2]["mode"] == "patrol",
                  Siege.RELOAD_S + 10), \
        "and back to his round"
    assert not siege.stormers_on()
    # From the east it already faces them, and there is no turning.
    siege = _quiet_siege()
    d = _on_the_walk(siege, 1, 0.9)
    assert _until(siege, lambda: siege.gun["fired"] is not None, 40)
    assert siege.gun["facing"] == 1 and siege.gun["turned"] is None
    assert d["hit"] is not None, "taken from the east"
    # With stormers coming up on both sides, he goes round behind the gun
    # each time it turns: at his place, never before its muzzle.
    siege = _quiet_siege()
    _on_the_walk(siege, 0, 0.1)["hp"] = 99
    _on_the_walk(siege, 1, 0.95)["hp"] = 99
    m, gun, faced = siege.men[2], siege.gun, set()
    for _ in range(int(20 * 30)):
        siege.run(1 / 30)
        if m["mode"] == "gun" and m["station"] is not None \
                and abs(m["x"] - m["station"]) < 1e-9:
            faced.add(gun["facing"])
            assert (m["x"] - siege.gun_at) * gun["facing"] < 0, (m, gun)
            assert m["face"] == gun["facing"]
    assert faced == {-1, 1}, "turned to the one side and the other"
    # Turned without him, by a tower's call, he goes behind it again,
    # running, not in one jump.
    siege.stormers = []
    gun.update(taken=False, ready=siege.phase)  # (a long load lets them in)
    m.update(mode="gun", x=siege.gun_at - gun["facing"] * Siege.STATION_DX,
             station=None, clear=siege.phase, face=gun["facing"])
    gun["facing"] = -gun["facing"]
    was = m["x"]
    siege.run(1 / 30)
    assert 0 < abs(m["x"] - was) < Siege.STATION_DX
    assert _until(siege, lambda: abs(m["x"] - m["station"]) < 1e-9, 2)
    assert (m["x"] - siege.gun_at) * gun["facing"] < 0

    # Men who reach the gun while it cannot be fired take it, and the
    # walker is driven back along the walk to the far tower, never killed.
    siege = _quiet_siege()
    siege.gun["ready"] = siege.phase + 1e6      # reloading, for good
    a = _on_the_walk(siege, 0, 0.3)
    assert _until(siege, lambda: siege.gun["taken"], 40)
    assert siege.tally["guns"] == 1 and a["hit"] is None
    assert siege.men[2]["mode"] == "driven" and siege.men[2]["goal"] == 1.0
    assert _until(siege, lambda: siege.men[2]["x"] >= 1.0, 10)
    assert siege.men[2]["mode"] == "driven", "he waits at the far tower"
    assert siege.gun["fired"] is None and siege.relief is None
    _at_the_foot(siege, "foot", 1)
    siege.run(0.2)
    assert siege.relief is None, "a taken gun is silent"
    # But a crew that can fire in time keeps it.
    siege = _quiet_siege()
    siege.BLAST_KILL = 1.0
    a = _on_the_walk(siege, 0, 0.1)
    assert _until(siege, lambda: a["hit"] is not None, 40)
    assert not siege.gun["taken"] and siege.tally["guns"] == 0
    # With the gun taken they go along the walk to the tower on their side
    # and hack at its roof; the sentry there gives way to the far tower.
    siege = _quiet_siege()
    siege.gun["taken"] = True
    siege.men[2].update(mode="driven", x=1.0, face=-1, goal=1.0, up=None)
    a = _on_the_walk(siege, 0, 0.4)
    assert siege.roof == [1.0, 1.0] and not siege.ousted(0)
    assert _until(siege, lambda: a["mode"] == "hack", 30)
    assert a["x"] == 0.0 and siege.ousted(0) and not siege.ousted(1)
    siege.run(5)
    assert siege.roof[0] < 1.0 and siege.roof[1] == 1.0
    assert siege.tally["roof_hurt"][0] > 0.05
    assert not siege.holed(0) and siege.men[2]["mode"] == "driven"
    siege.roof[0] = 0.01
    siege.run(2)
    assert siege.holed(0) and siege.tally["roof_holes"] == 1
    # The walker, with the walk clear again, takes the gun back.
    a["hit"], a["hp"] = siege.phase, 0
    siege.run(Siege.FALL_S + 0.1)
    assert _until(siege, lambda: siege.men[2]["mode"] == "retake", 5)
    assert _until(siege, lambda: not siege.gun["taken"], 30)
    assert siege.men[2]["mode"] in ("patrol", "to_roof"), "back to work"
    # Through a holed roof they drop into the yard and batter the core
    # tile nearest them, a picture and nothing more; the dents fade once
    # the yard is clear and it is quiet.
    siege = _quiet_siege()
    siege.gun["taken"] = True
    siege.men[2].update(mode="driven", x=1.0, face=-1, goal=1.0, up=None)
    siege.roof[0] = 0.0
    a = _on_the_walk(siege, 0, 0.0)
    a.update(mode="hack")
    assert _until(siege, lambda: a["mode"] == "drop", 10), "down the hole"
    assert not siege.tally["yard"]
    assert _until(siege, lambda: a["mode"] == "yard", 5)
    assert siege.tally["yard"] == 1 and siege.ousted(0)
    assert _until(siege, lambda: siege.dent(0) > 0.1, 60)
    assert a["tile"] == 0 and siege.dent(1) == 0.0 and not siege.dent(5)
    assert siege.tally["batter_s"] > 1.0 and siege.wall == [1.0, 1.0]
    assert _until(siege, lambda: siege.dent(0) >= 1.0, 60), "smashed"
    assert _until(siege, lambda: a["tile"] == 1, 5), "and on to the next"
    assert siege.tally["roof_holes"] == 0 and siege.holed(0)
    before = dict(siege.dents)
    siege.run(12)
    assert siege.dent(1) > before.get(1, 0.0), "battered while in the yard"
    a["hit"], a["hp"] = siege.phase, 0
    siege.run(Siege.FALL_S + Siege.QUIET_S + 2)
    again = dict(siege.dents)
    siege.run(3)
    assert siege.dent(0) < again[0] and siege.dent(1) < again[1], \
        "the marks fade once the yard is clear"
    # The first redcoat on the wall top rouses the bears: the mother, who
    # is larger of heart as of body, and one more for each bear the valley
    # holds, up to three, out in the woods.
    for valley, want in ((0, 1), (2, 3), (9, 4)):
        siege = _quiet_siege()
        siege.bear_rest = 0.0
        siege.valley_bears = valley
        siege.gun["taken"] = True
        siege.run(1)
        assert not siege.bears and not siege.tally["bear_trips"]
        _on_the_walk(siege, 1, 0.9)
        siege.run(0.1)
        assert len(siege.bears) == want, (valley, len(siege.bears))
        assert siege.bears[0]["mother"] \
            and not any(b["mother"] for b in siege.bears[1:])
        assert siege.tally["bear_trips"] == 1 \
            and siege.tally["bear_out"] == want
        assert all(b["layer"] == "ground" and b["side"] == 1
                   for b in siege.bears), "from the woods, to his side"
        siege.run(0.1)
        assert len(siege.bears) == want, "once, not each frame"
    # They run in, climb the stockade and maul the redcoats on the walk,
    # while the men look on and the walker fights beside them; the walker
    # keeps back from the gun until they have cleared the walk. Then they
    # go back down and into the woods, the mother last, stopping by the
    # walker first.
    siege = _quiet_siege(4)
    siege.bear_rest = 0.0
    siege.valley_bears = 2
    siege.gun["taken"] = True
    siege.men[2].update(mode="driven", x=1.0, face=-1, goal=1.0, up=None)
    foes = [_on_the_walk(siege, 0, 0.1 + 0.05 * k) for k in range(3)]
    siege.run(0.1)
    mother, *others = siege.bears
    assert _until(siege, lambda: siege.bears_on("wall"), 15)
    assert not siege.bears_on("walk")
    assert _until(siege, lambda: siege.bears_on("walk"), 10)
    assert siege.tally["bear_wall"] == 1
    assert 2 < siege.tally["bear_lag_s"] < 12, siege.tally["bear_lag_s"]
    gone = []
    stopped = None
    for _ in range(180 * 30):
        siege.run(1 / 30)
        for b in siege.bears + [mother] + others:
            if b.get("gone") and b not in gone:
                gone.append(b)
        if mother["by"] is not None and stopped is None:
            stopped = siege.phase
            assert all(b.get("gone") or b["layer"] == "ground"
                       for b in others), "she stops once the others are down"
        if siege.stormers_on():
            assert siege.gun["taken"], "not retaken with redcoats up there"
        if not siege.bears:
            break
    assert not siege.bears and all(f["hit"] is not None for f in foes)
    assert siege.tally["bear_kills"] + siege.tally["walker_kills"] == 3
    assert siege.tally["bear_kills"] >= 1
    assert gone[-1] is mother and len(gone) == 3, "her last"
    assert stopped is not None and siege.phase - stopped >= Siege.BY_WALKER_S
    assert siege.tally["guns"] == 0, "no gun was lost to them"
    assert _until(siege, lambda: not siege.gun["taken"], 30), "and he retakes it"
    # Roused, they hunt redcoats wherever they are about the fort, the top
    # first. With the top cleared they climb down the outside of the wall,
    # and kill the men at its foot, the near half of either trail, and the
    # men driving the walker from his rock; they never go up to the
    # barracks; and they go home only when none is left to hunt and the
    # trails have been quiet.
    siege = _quiet_siege(5)
    siege.bear_rest = 0.0
    siege.has_walker = False
    siege.valley_bears = 2
    top = _on_the_walk(siege, 0, 0.5)
    top["hp"] = 99
    siege.run(0.1)
    assert len(siege.bears) == 3 and all(b["aim"] == "top"
                                         for b in siege.bears[:2])
    assert _until(siege, lambda: siege.bears_on("walk"), 12)
    held = []
    foot = _at_the_foot(siege, "foot", 0, 0)
    far_foot = _at_the_foot(siege, "cannon", 1, 0)
    near = _foe(siege, "foot", 0.7, 0)
    driver = _foe(siege, "foot", 0.35, 0)
    driver["drive"] = {"t0": siege.phase, "born": siege.phase, "rock": 1,
                       "fired": False}
    barracks = _foe(siege, "foot", 0.2, 0)
    for rc in (foot, far_foot, near, driver, barracks):
        rc["hp"] = 99
    mauled, hunted_g, climbed = [], 0.0, False
    for _ in range(150 * 30):
        near["d"] = Siege.trail_d(0.7)
        barracks["d"] = Siege.trail_d(0.2)
        siege.run(1 / 30)
        climbed |= any(b["layer"] == "wall" and b["dir"] < 0
                       for b in siege.bears)
        for b in siege.bears:
            assert b["aim"] is not barracks, "never the far half"
            if b["layer"] == "ground" and b["maul"] is not None:
                hunted_g = max(hunted_g, b["g"])
            if b["intent"] != "attack" and b["layer"] != "walk" \
                    and b["intent"] != "withdraw":
                assert not siege.stormers_on() and not [
                    rc for rc in (foot, far_foot, near, driver)
                    if rc["hit"] is None], "not while redcoats are about"
        if not siege.bears:
            break
    assert climbed and siege.tally["bear_downs"] >= 1, "down from the top"
    assert top["hit"] is not None
    assert all(rc["hit"] is not None and rc.get("mauled")
               for rc in (foot, far_foot, near, driver)), \
        "at the wall's foot, on either side, on the trail, driving"
    assert barracks["hit"] is None and hunted_g < 2.3, \
        "not up the trail to the barracks"
    assert siege.tally["bear_ground_kills"] >= 4
    assert not siege.bears and siege.tally["bear_home"] >= 1, \
        "home once none is left and it has been quiet"
    assert siege.tally["rousings_over"] == 1 and siege.tally["rousings_down"] == 1
    assert siege.tally["bear_top_idle_max"] < 12, siege.tally

    # While any redcoat is up on top, the bears there stay; the rest come
    # up to join them. The top cleared, they all come down; at the woods'
    # edge they wait out the quiet, and climb straight back up if a redcoat
    # steps onto the top again.
    siege = _quiet_siege(6)
    siege.has_walker = False
    siege.gun["taken"] = True
    far = _on_the_walk(siege, 0, 0.95)
    far.update(hp=99)
    siege.BEAR_KILL = 0.0   # he stays up there, to see what they do
    mother, b1, b2, b3 = _bears_up(siege, 0, 3)
    for b in (mother, b1):
        b.update(layer="walk", x=0.0)
    b2.update(layer="wall", u=0.5, dir=1)
    b3.update(g=2.6)
    siege.run(5)
    assert mother["layer"] != "ground" and b1["layer"] in ("walk", "yard")
    assert not siege.bears_on("ground") or b3["layer"] == "ground"
    assert all(b["layer"] != "ground" or b is b3 for b in siege.bears) \
        or siege.tally["bear_downs"] == 0, "none down while one is up there"
    far["hit"], far["hp"] = siege.phase, 0
    siege.trail_quiet_since = siege.phase + 6.0     # quiet only from then
    assert _until(siege, lambda: siege.tally["bear_downs"] >= 3, 15)
    assert _until(siege, lambda: all(b["layer"] == "ground"
                                     for b in siege.bears), 12), \
        [(b["layer"], b["intent"]) for b in siege.bears]
    assert not siege.bears_on("walk", "yard", "wall")
    siege.run(2.5)
    for b in siege.bears:
        assert b["intent"] == "attack" and b["aim"] is None \
            and b["g"] > Siege.BEAR_WAIT_G - 0.1, \
            "they wait at the woods' edge out the quiet"
    again = _on_the_walk(siege, 1, 0.9)
    again["hp"] = 99
    siege.run(0.1)
    assert sum(b["aim"] == "top" for b in siege.bears) >= 2
    assert _until(siege, lambda: siege.bears_on("wall", "walk"), 8), \
        "straight back up"
    assert siege.tally["rousings_over"] == 0

    # In the woods with the walker out, the mother goes home by way of him:
    # she stops by him there, then leaves; the others go straight home.
    siege = _quiet_siege(7)
    siege.wall = [0.5, 1.0]
    walker = _walker_out(siege)
    walker.update(mode="hide", g=2.0, rock=2, shot_t=None, pinned=[],
                  next_shot=1e9, t0=siege.phase + 30)
    mother, b1 = _bears_up(siege, 0, 1)
    mother.update(g=3.0, far=3.0)
    b1.update(g=2.7, far=4.0)
    siege.trail_quiet_since = siege.phase - Siege.QUIET_S - 1
    assert _until(siege, lambda: mother["intent"] == "greet", 2)
    assert _until(siege, lambda: b1.get("gone"), 10)
    assert _until(siege, lambda: mother["by"] is not None, 10)
    assert abs(mother["g"] - (walker["g"] + Siege.BY_WALKER_G)) < 0.06
    assert mother["layer"] == "ground" and mother["side"] == 0
    stopped = siege.phase
    assert _until(siege, lambda: mother["intent"] == "leave", 8)
    assert siege.phase - stopped >= Siege.BY_WALKER_S - 0.5
    assert _until(siege, lambda: mother.get("gone"), 10)

    # A redcoat on the ground fights back: bayonets at the bear's elbow,
    # and a musket at one charging in; enough wounds, and the bear goes.
    siege = _quiet_siege(8)
    siege.has_walker = False
    siege.gun["taken"] = True
    mother, b1, *_ = _bears_up(siege, 0, 1)
    top = _on_the_walk(siege, 0, 0.9)
    top["hp"] = 99
    b1.update(g=0.0, lane=1.0, wounds=0, aim=None)
    mother.update(g=3.5, far=3.5, wounds=0)
    foot = _at_the_foot(siege, "foot", 0, 0)
    foot["hp"] = 99
    siege.BEAR_KILL = 0.0       # a bear that cannot kill, to see the wounds
    siege.MUSKET_RATE = 0.0
    siege.run(40)
    assert b1["wounds"] >= 1 and foot["hit"] is None, "bayonets"
    siege = _quiet_siege(9)
    siege.has_walker = False
    siege.gun["taken"] = True
    mother, = _bears_up(siege, 0, 0)
    top = _on_the_walk(siege, 0, 0.1)
    top["hp"] = 99
    mother.update(g=3.0, far=3.0, aim="top")
    near = _foe(siege, "foot", 0.6, 0)
    near["hp"] = 99
    siege.MUSKET_RATE = 60.0
    siege.BAYONET_RATE = 0.0
    siege.run(2)
    assert siege.tally["bear_musket"] >= 1 and mother["wounds"] >= 1, \
        "a musket shot at a bear charging in"

    # A bear that takes enough bayonet wounds withdraws, wounded; the
    # mother does not leave with a redcoat in the yard.
    siege = _quiet_siege()
    siege.bear_rest = 0.0
    siege.gun["taken"] = True
    siege.men[2].update(mode="driven", x=1.0, face=-1, goal=1.0, up=None)
    a = _on_the_walk(siege, 0, 0.1)
    siege.run(0.1)
    mother, follower, _ = siege.bears
    mother.update(layer="walk", x=0.0, wounds=Siege.WOUNDS[1])
    follower.update(layer="walk", x=0.0, wounds=Siege.WOUNDS[0])
    yard = _on_the_walk(siege, 0, 0.0)
    yard.update(mode="yard", u=0.5, v=0.5, tile=None, batter=False)
    siege.run(0.2)
    assert follower["intent"] == "withdraw" \
        and siege.tally["bear_withdrawn"] == 1
    assert mother["intent"] == "attack", "never, with a redcoat in the yard"
    assert _until(siege, lambda: follower.get("gone"), 40), "to the woods"
    assert not mother.get("gone")
    yard["hit"] = siege.phase
    siege.run(0.2)
    assert mother["intent"] == "withdraw", "once the yard is clear"

    # In a lull he mends a roof, walls first.
