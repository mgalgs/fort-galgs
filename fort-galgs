class FortApp(Adw.Application):
    def __init__(self, time_scale=1.0):
        super().__init__(application_id=APP_ID)
        self.window = None
        self.time_scale = time_scale

    def do_startup(self):
        Adw.Application.do_startup(self)
        load_css()
        # Out of the fenced app.slice, or the animation stutters under
        # exactly the load the fort exists for. Failing only costs that.
        run_backend(["adopt", str(os.getpid())],
                    lambda ok, text: ok or print(text, file=sys.stderr))
        # Here, not on the window: the self-test builds windows with no
        # main loop running, and one would swallow a real Ctrl-C.
        signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self._on_sigint)

    def _on_sigint(self):
        """Ctrl-C keeps the valley, as closing the window does."""
        if self.window is not None:
            self.window._on_close(self.window)
        self.quit()
        return GLib.SOURCE_REMOVE

    def do_activate(self):
        if not self.window:
            self.window = FortWindow(self, state_path=world_path(),
                                     time_scale=self.time_scale)
            self.window.refresh_status()
        self.window.present()


