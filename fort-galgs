    LEAVE_E = 0.15          # energy below which, with nothing near, it goes
    WANDER_PULL = 0.02
    CHARGE_S = 5.0          # seconds to charge a unit of distance
    MAN_GAIN = 0.7          # a man, to a starving bear; less to a fed one
    EFFORT_S = 60.0         # the struggle it reckons a man will cost
    NEAR_D = 0.35           # men this close to a man are his company...
    COMPANY_K = 2.5         # ...each multiplying its dread by this more
    RISK_K = 1.5            # its dread of a man, at no hunger
    NOTICE_K = 0.22         # a man's chance a tick to see a bear coming,
    NOTICE_S = 10.0         # ...times exp(-seconds until it reaches him/this)
    VIGILANCE = (0.5, 0.6)  # his watch with nothing in him, and at work
    REACT_S = 1.5           # from seeing it to the rifle at his shoulder
    AIM_S = 5.0             # ...and from there to a fully aimed shot
    HIT_P = (0.3, 0.6)      # a shot's chance to hit unaimed, and full aim's
    SHOT_DMG = 0.55         # of a bear's health, fully aimed; 0.6 unaimed
    HELP_AIM = 0.4          # a helper's aim, arriving at a run
    HEAR_D = 1.2            # a shot carries this far; a struggle a third
    RUN_K = 0.6             # running, as a share of WALK_S
    EXCHANGE_S = 2.0        # between blows in the close fight
    CLAW_P, CLAW_DMG = 0.4, 0.2
    KNIFE_P, KNIFE_DMG = 0.5, 0.2
    FLEE_AT = 0.35          # health below which a bear breaks off...
    FLEE_HUNGER = 0.6       # ...lowered by this times its hunger
    EAT_S = 120.0
    CARCASS_S = 120.0
    BEAR_HEAL_K = 1 / 3000  # health won back a second with energy > 0.5
    HIDE_PELTS = 4
    BEAR_MEAT = 12
    HIDE_S = SEASON_S       # the hide hangs at his cabin this long
    ALERT_S = SEASON_S / 2  # a killing keeps his flank watchful this long
    ALERT_VIG = 1.6

    def __init__(self, seed=1):
        self.seed = seed
        self.rng = random.Random(seed)
        self.time = 0.0
        self.next_tick = self.TICK_S
        self.season_n = 0
        self.half_n = 0
        self.next_id = 1
        self.trees = self._slots()
        self.colonies = [{"dam": 0, "lodge": 0} for _ in (0, 1)]
        self.beavers = []
        for f in (0, 1):
            for _ in range(3):
                self._beaver(f, 0.7)
        self.empty_since = None
        self.sites = [[{"by": None, "state": "empty", "since": 0.0}
                       for _ in self.SITE_SPOTS] for _ in (0, 1)]
        self.plots = [[{"owner": None, "logs": 0} for _ in self.PLOT_U]
                      for _ in (0, 1)]
        self.trappers = []
        self.graves = []
        self.predators = []
        self.tally = self._fresh_tally()
        for f in (0, 1):
            self._trapper(f, 0, ["plot", f, 0])

    @classmethod
    def _slots(cls):
        """The fixed tree slots, the same in every world: each at (u, v)
        within its zone, u along the flank from its outer edge."""
        trees, j = [], 0
        for f in (0, 1):
            for zone, side, n in cls.SLOTS:
                for _ in range(n):
                    j += 1
                    u = (0.31 + j * 0.7548777) % 1.0
                    trees.append({
                        "f": f, "zone": zone, "side": side,
                        "u": u if f == 0 else 1 - u,
                        "v": (0.17 + j * 0.5698403) % 1.0,
                        "kind": "round" if zone == "bank" or j % 5 in (1, 3)
                        else "pine",
                        "size": (j * 0.618034) % 1.0,
                        "felled": None, "by": None, "pile": 0})
        return trees

    @staticmethod
    def _fresh_tally():
        return {"trapped": 0, "starved": 0, "kits": [0, 0], "deaths": {},
                "arrivals": 0, "pelts": 0, "rails": {"beavers": 0,
                                                     "trappers": 0},
                "bears": {"came": 0, "left": 0, "starved": 0, "slain": 0,
                          "fights": 0, "mauled": 0, "eaten": 0,
                          "robbed": 0},
                "events": []}

    def _trapper(self, f, k, at):
        tr = {"id": self.next_id, "f": f, "plot": k, "health": 1.0,
              "fed": 1.0, "pelts": 0, "meat": 0, "logs": 0, "job": "rest",
              "at": list(at), "to": ["plot", f, k], "t0": self.time,
              "t1": self.time, "t2": self.time, "site": None,
              "tree": None, "carry": None, "fuel": False, "hearth": 0.0,
              "effort": {},
              "effort_prev": {}, "winter": None, "fight": None,
              "alert": None, "hide": None}
        self.next_id += 1
        self.plots[f][k]["owner"] = tr["id"]
        self.trappers.append(tr)
        tr["t1"] = self.time + self.WALK_S * self.distance(at, tr["to"])
        tr["t2"] = tr["t1"] + 2.0
        return tr

    def _bear(self, f, at):
        b = {"id": self.next_id, "f": f, "energy": 0.6, "health": 1.0,
             "job": "wander", "at": list(at), "to": list(at),
             "t0": self.time, "t1": self.time, "t2": self.time,
             "target": None, "fight": None, "blow": None}
        self.next_id += 1
        self.predators.append(b)
        return b

    def _beaver(self, f, cond):
        b = {"id": self.next_id, "f": f, "cond": cond, "job": "lodge",
             "at": ["lodge", f], "to": ["lodge", f], "t0": self.time,
             "t1": self.time, "t2": self.time, "stick": False,
             "tree": None}
        self.next_id += 1
        self.beavers.append(b)
        return b

    # -- the clock --

    def season(self, t=None):
        """0 spring, 1 summer, 2 autumn, 3 winter."""
        return int((self.time if t is None else t) // self.SEASON_S) % 4

    def year(self):
        return int(self.time // self.YEAR_S) + 1

    def season_t(self):
        """How far into this season, 0..1."""
        return self.time % self.SEASON_S / self.SEASON_S

    def season_weights(self, t=None):
        """How much each season shows, summing to 1: one alone for most of
        a season, easing into the next over its last BLEND_S."""
        t = self.time if t is None else t
        s = self.season(t)
        u = min(1.0, max(0.0, (t % self.SEASON_S - self.SEASON_S
                               + self.BLEND_S) / self.BLEND_S))
        k = u * u * (3 - 2 * u)
        w = [0.0] * 4
        w[s] += 1 - k
        w[(s + 1) % 4] += k
        return w

    def cold(self):
        return self.season_weights()[3]

    def urgency(self):
        """How pressing shelter is, 0 in spring to 1 by winter."""
        s = self.season()
        return (0.0, self.URGENCY[0],
                self.URGENCY[1] + (1 - self.URGENCY[1]) * self.season_t(),
                1.0)[s]

    # -- places --

    def tree_state(self, i, t=None):
        """"tree", "stump" or "sapling"."""
        felled = self.trees[i]["felled"]
        if felled is None:
            return "tree"
        age = (self.time if t is None else t) - felled
        if age >= self.REGROW_S:
            return "tree"
        return "stump" if age < self.REGROW_S * self.STUMP_K else "sapling"

    def growth(self, i):
        """How grown a sapling is, 0..1."""
        felled = self.trees[i]["felled"]
        if felled is None:
            return 1.0
        k = self.STUMP_K
        return min(1.0, max(0.0, ((self.time - felled) / self.REGROW_S - k)
                            / (1 - k)))

    def _standing(self, i):
        tr = self.trees[i]
        if tr["felled"] is not None and \
                self.time - tr["felled"] >= self.REGROW_S:
            tr["felled"], tr["by"], tr["pile"] = None, None, 0
        return tr["felled"] is None

    def place_u(self, place):
        """Where a place lies across the picture, 0..1, and which side of
        the river (1 near, -1 far, 0 in it)."""
        kind = place[0]
        if kind == "tree":
            tr = self.trees[place[1]]
            return self._flank_u(tr["f"], tr["u"]), tr["side"]
        if kind == "dam":
            return self.DAM_U[place[1]], 0
        if kind == "lodge":
            return self.DAM_U[place[1]] - self.POND_LEN * 0.45, 0
        if kind == "swim":
            return place[2], 0
        if kind == "plot":
            return self._flank_u(place[1], self.PLOT_U[place[2]]), 1
        if kind == "site":
            side, u = self.SITE_SPOTS[place[2]]
            return self._flank_u(place[1], u), side
        if kind == "edge":
            return (0.0 if place[1] == 0 else 1.0), 1
        if kind == "den":
            u = self.DEN_U
            return self._flank_u(place[1], u if place[1] == 0 else 1 - u), 1
        return 0.5, 0

    @staticmethod
    def _flank_u(f, u):
        return 0.03 + 0.27 * u if f == 0 else 0.70 + 0.27 * u

    def distance(self, a, b):
        (ua, sa), (ub, sb) = self.place_u(a), self.place_u(b)
        return 3 * abs(ua - ub) + 0.3 * abs(sa - sb)

    def _send(self, a, to, job, work, speed):
        """Set actor a off to place to, to spend work seconds there at job
        once it arrives, speed seconds to the unit of distance."""
        a["at"] = a["to"]
        a["to"] = list(to)
        a["job"] = job
        a["t0"] = self.time
        a["t1"] = self.time + max(1.0, speed * self.distance(a["at"], to))
        a["t2"] = a["t1"] + work

    # -- the river's works --

    def dam_k(self, f):
        return min(1.0, self.colonies[f]["dam"] / self.DAM_STICKS)

    def lodge_k(self, f):
        return min(1.0, self.colonies[f]["lodge"] / self.LODGE_STICKS)

    def _sticks_wanted(self, f):
        c = self.colonies[f]
        want = self.DAM_STICKS - c["dam"]
        if c["dam"] >= self.DAM_STICKS / 2:
            want += self.LODGE_STICKS - c["lodge"]
        return want

    # -- stepping --

    def advance(self, dt):
        """Move the clock on dt seconds, deciding at every tick crossed."""
        end = self.time + max(0.0, dt)
        while self.next_tick <= end:
            self.time = self.next_tick
            self.next_tick += self.TICK_S
            self._tick()
        self.time = end

    run = advance

    def _tick(self):
        n = int(self.time // self.SEASON_S)
        if n != self.season_n:
            self.season_n = n
            self._season_turn()
        half = int(self.time // (self.SEASON_S / 2))
        if half != self.half_n:
            self.half_n = half
            if half % 8 == 1:
                self._births()
        self._advance_predators()
        self._advance_beavers()
        self._catches()
        self._advance_trappers()
        self._drifters()
        self._rails()
        if self.graves and self.time - self.graves[0]["t"] >= self.GRAVE_S:
            self.graves.pop(0)

    # -- bears --

    def _advance_predators(self):
        cold = self.cold()
        self._bear_arrivals(cold)
        tally = self.tally["bears"]
        for b in list(self.predators):
            job, arrived = b["job"], self.time >= b["t1"]
            if job == "dead":
                if self.time >= b["t2"]:
                    self.predators.remove(b)
                continue
            asleep = job == "den" and arrived
            b["energy"] -= (self.DEN_DRAIN if asleep else self.BEAR_DRAIN) \
                * self.TICK_S
            if b["energy"] <= 0:
                self._unhook(b)
                self.predators.remove(b)
                tally["starved"] += 1
                continue
            if b["energy"] > 0.5 and job != "fight":
                b["health"] = min(1.0, b["health"]
                                  + self.BEAR_HEAL_K * self.TICK_S)
            if job == "leave" and arrived:
                self.predators.remove(b)
                tally["left"] += 1
                continue
            if job == "stalk":
                self._stalk_tick(b, cold)
                continue
            if job == "fight":
                self._fight_tick(b, cold)
                continue
            if job == "eat" and arrived:
                tr = next((tr for tr in self.trappers if tr["to"] == b["to"]
                           and tr["fight"] is None
                           and self.time >= tr["t1"]), None)
                if tr is not None:
                    # He walks up on it over its kill: he sees it, and
                    # it does not let him go.
                    self._stalk(b, tr)
                    self._fight_start(b, tr, self.HELP_AIM)
                    continue
            if job == "hunt" and arrived and self.time < b["t2"]:
                self._bear_hunt(b)
            if cold >= 0.5 and job != "den" or asleep and cold < 0.5 \
                    or self.time >= b["t2"]:
                self._bear_done(b)
                self._bear_next(b, cold)

    def _offer(self, f):
        """What flank f holds for a bear, beyond the fish."""
        caught = sum(st["state"] == "caught" for st in self.sites[f])
        men = [tr for tr in self.trappers if tr["f"] == f]
        meat = sum(tr["meat"] for tr in men)
        return (sum(b["f"] == f for b in self.beavers) / self.BEAVER_REF
                + caught / 2 + meat / (4 * self.MEAT_PER_BEAVER)
                + 0.3 * len(men)) * (1 + self.FISH_K[self.season()])

    def _bear_arrivals(self, cold):
        if len(self.predators) >= self.BEARS_MAX or cold >= 0.5:
            return
        held = {b["f"] for b in self.predators}
        free = [f for f in (0, 1) if f not in held]
        if not free:
            return
        f = max(free, key=self._offer)
        p = self.BEAR_ARRIVE_K * self._offer(f) * self.TICK_S / self.SEASON_S
        if self.rng.random() < p:
            self._bear(f, ["edge", f])
            self.tally["bears"]["came"] += 1

    def _bear_hunt(self, b):
        """Waiting at the bank: a beaver may come within reach."""
        out = self._flank_beavers(b["f"])
        p = self.BEAR_CATCH_K * self.TICK_S * len(out) / self.BEAVER_REF
        if out and self.rng.random() < p:
            self.beavers.remove(min(out, key=lambda x: x["cond"]))
            self.tally["bears"]["eaten"] += 1
            self._feed(b, self.BEAVER_GAIN)
            b["t2"] = self.time

    def _feed(self, b, gain):
        b["energy"] = min(1.0, b["energy"] + gain)

    def _bear_done(self, b):
        job, to = b["job"], b["to"]
        if self.time < b["t2"]:
            return  # called away before it finished
        if job == "fish":
            self._feed(b, self.FISH_GAIN * self.FISH_K[self.season()])
        elif job == "steal":
            site = self.sites[to[1]][to[2]]
            if site["state"] == "caught":
                site.update(state="empty", by=None, since=self.time)
                self.tally["bears"]["eaten"] += 1
                self._feed(b, self.BEAVER_GAIN)
        elif job == "eat":
            self._feed(b, self.MAN_GAIN)
        elif job == "raid":
            owner = self._owner(to)
            if owner is not None and owner["meat"] > 0 \
                    and self._far(owner, to):
                take = min(owner["meat"], self.RAID_MEAT)
                owner["meat"] -= take
                self.tally["bears"]["robbed"] += 1
                self._feed(b, take * self.MEAT_GAIN)

    def _owner(self, plot):
        oid = self.plots[plot[1]][plot[2]]["owner"]
        return next((tr for tr in self.trappers if tr["id"] == oid), None)

    def _where(self, a):
        """The place an actor is at, or last left."""
        return a["to"] if self.time >= a["t1"] else a["at"]

    def _far(self, tr, place):
        return self.distance(self._where(tr), place) >= self.RAID_FAR

    def _man(self, mid):
        return next((tr for tr in self.trappers if tr["id"] == mid), None)

    def _company(self, f, place, but):
        """The other men of flank f about place."""
        return sum(tr["f"] == f and tr is not but
                   and self.distance(tr["to"], place) <= self.NEAR_D
                   for tr in self.trappers)

    def _vigilance(self, tr):
        """How watchful he is, 1 fed and idle."""
        none, busy = self.VIGILANCE
        v = none + (1 - none) * tr["fed"]
        if self.time >= tr["t1"] and tr["job"] not in ("rest", "fight"):
            v *= busy
        if self._alert(tr):
            v *= self.ALERT_VIG
        return v

    def _alert(self, tr):
        return tr["alert"] is not None and \
            self.time - tr["alert"] < self.ALERT_S

    def _sheltered(self, tr):
        plot = self.plots[tr["f"]][tr["plot"]]
        return tr["job"] == "shelter" and self.time >= tr["t1"] \
            and plot["logs"] >= self.CABIN_LOGS / 2

    def _stalk(self, b, tr):
        b["target"] = tr["id"]
        b["fight"] = {"target": tr["id"], "t0": self.time,
                      "company": self._company(b["f"], tr["to"], tr),
                      "wary": self._alert(tr),
                      "saw": None, "contact": None, "shot": None,
                      "hit": False, "help": 0, "next": None, "dmg": {},
                      "dead": []}
        self._send(b, tr["to"], "stalk", 0.0, self.CHARGE_S)

    def _stalk_tick(self, b, cold):
        """Closing on its man: he may see it coming."""
        tr = self._man(b["target"])
        if tr is None or cold >= 0.5 or tr["fight"] is None \
                and tr["to"] != b["to"]:
            self._call_off(b, cold)
            return
        contact = max(b["t1"], tr["t1"])
        if self.time >= contact:
            self._fight_start(b, tr)
            return
        if tr["fight"] is None:
            p = self.NOTICE_K * self._vigilance(tr) * math.exp(
                -(contact - self.time) / self.NOTICE_S)
            if self.rng.random() < p:
                b["fight"]["saw"] = self.time
                tr["fight"] = {"bear": b["id"], "saw": self.time,
                               "shot": None, "help": False}

    def _fighters(self, b):
        return [tr for tr in self.trappers if tr["fight"] is not None
                and tr["fight"]["bear"] == b["id"]]

    def _unhook(self, b):
        """Its men go back to what they were about, or, if they were
        fighting it, home."""
        for tr in self._fighters(b):
            tr["fight"] = None
            if tr["job"] == "fight":
                self._go(tr, ["plot", tr["f"], tr["plot"]], "rest",
                         self.rng.uniform(3.0, 8.0))
        b["target"], b["fight"] = None, None

    def _drop_errand(self, tr):
        """He leaves what he was about; a trap he meant to set is free."""
        if tr["job"] == "set" and tr["site"] is not None:
            st = self.sites[tr["f"]][tr["site"]]
            if st["by"] == tr["id"] and st["state"] == "empty":
                st["by"] = None
        tr["site"], tr["tree"], tr["fuel"] = None, None, False

    def _fight_start(self, b, tr, aim=None):
        """It reaches its man: his shot, if he has one, then the close
        fight."""
        fight = b["fight"]
        fight["contact"] = self.time
        fight["next"] = self.time + self.EXCHANGE_S
        b["job"] = "fight"
        if tr["fight"] is None:
            tr["fight"] = {"bear": b["id"], "saw": None, "shot": None,
                           "help": False}
        self._drop_errand(tr)
        tr["job"] = "fight"
        saw = tr["fight"]["saw"]
        if aim is None and saw is not None:
            aim = min(1.0, max(0.0, (self.time - saw - self.REACT_S)
                               / self.AIM_S))
        if aim is not None:
            fight["shot"] = self.time
            fight["hit"] = self._shoot(tr, b, aim)
        self._call_help(b)
        self._fight_over(b)

    def _shoot(self, tr, b, aim):
        tr["fight"]["shot"] = self.time
        if self.rng.random() >= self.HIT_P[0] + self.HIT_P[1] * aim:
            return False
        self._hurt_bear(b, tr, self.SHOT_DMG * (0.6 + 0.4 * aim)
                        * self.rng.uniform(0.7, 1.3))
        return True

    def _hurt_bear(self, b, tr, dmg):
        b["health"] -= dmg
        hurt = b["fight"]["dmg"]
        hurt[str(tr["id"])] = hurt.get(str(tr["id"]), 0.0) + dmg
        b["blow"] = {"t": self.time, "on": "bear", "id": b["id"]}

    def _call_help(self, b):
        """The men of its flank in earshot come running."""
        fight = b["fight"]
        hear = self.HEAR_D if fight["shot"] is not None else self.HEAR_D / 3
        for tr in self.trappers:
            if tr["f"] != b["f"] or tr["fight"] is not None or \
                    self.distance(self._where(tr), b["to"]) > hear:
                continue
            self._drop_errand(tr)
            tr["to"] = self._where(tr)
            tr["fight"] = {"bear": b["id"], "saw": None, "shot": None,
                           "help": True}
            self._send(tr, b["to"], "fight", 0.0, self.WALK_S * self.RUN_K)
            fight["help"] += 1

    def _fight_tick(self, b, cold):
        """An exchange of blows every EXCHANGE_S, helpers firing as they
        come up."""
        fight = b["fight"]
        if cold >= 0.5:
            self._fight_end(b, "fled")
            return
        men = self._fighters(b)
        here = [tr for tr in men if self.time >= tr["t1"]]
        for tr in here:
            if tr["fight"]["shot"] is None and tr["fight"]["help"]:
                self._shoot(tr, b, self.HELP_AIM)
                if self._fight_over(b):
                    return
        if self._fight_over(b):
            return
        self._call_help(b)
        if not here or self.time < fight["next"]:
            return
        fight["next"] = self.time + self.EXCHANGE_S
        tid = fight["target"]
        man = min(here, key=lambda tr: tr["id"] != tid)
        if self.rng.random() < self.CLAW_P * b["health"] * (
                0.6 + 0.4 * b["energy"]):
            man["health"] -= self.CLAW_DMG * self.rng.uniform(0.7, 1.3)
            b["blow"] = {"t": self.time, "on": "man", "id": man["id"]}
            if man["health"] <= 0:
                fight["dead"].append(man["id"])
                self.tally["bears"]["mauled"] += 1
                here.remove(man)
                self.die(man, "bear")
        for tr in here:
            if self.rng.random() < self.KNIFE_P * tr["health"] * (
                    0.5 + 0.5 * tr["fed"]):
                self._hurt_bear(b, tr, self.KNIFE_DMG
                                * self.rng.uniform(0.7, 1.3))
        self._fight_over(b)

    def _beaten(self, b):
        """Too hurt to fight on; the hungrier, the more it takes."""
        hunger = 1 - b["energy"]
        return b["health"] < self.FLEE_AT * (1 - self.FLEE_HUNGER * hunger)

    def _fight_over(self, b):
        """Ends the fight if the bear is dead or has had enough, or no
        man is left at it or coming."""
        if b["health"] <= 0:
            self._fight_end(b, "slain")
            return True
        if not self._fighters(b):
            self._fight_end(b, "over")
            return True
        if self._beaten(b):
            self._fight_end(b, "fled")
            return True
        return False

    def _fight_end(self, b, how):
        fight = b["fight"]
        if how == "slain":
            self._spoils(b)
        self.tally["events"].append({
            "kind": "fight", "bear": b["id"], "f": b["f"],
            "target": fight["target"], "company": fight["company"],
            "wary": fight["wary"],
            "saw": fight["saw"] is not None,
            "shot": fight["shot"] is not None, "hit": fight["hit"],
            "help": fight["help"], "won": not fight["dead"],
            "slain": how == "slain", "fled": how == "fled",
            "dead": len(fight["dead"]), "t0": fight["t0"], "t": self.time})
        tally = self.tally["bears"]
        tally["fights"] += 1
        tally["slain"] += how == "slain"
        self._unhook(b)
        if how == "slain":
            b.update(job="dead", t1=self.time, t2=self.time + self.CARCASS_S)
        elif how == "fled":
            self._send(b, ["den", b["f"]], "flee", 60.0, self.CHARGE_S)
        elif fight["dead"]:
            self._send(b, b["to"], "eat", self.EAT_S, self.BEAR_WALK_S)
        else:
            b["t2"] = self.time
            self._bear_next(b, self.cold())

    def _spoils(self, b):
        """The hide to whoever hurt it most, the meat shared out."""
        here = [tr for tr in self._fighters(b) if self.time >= tr["t1"]]
        if not here:
            return
        hurt = b["fight"]["dmg"]
        ids = list(hurt)
        victor = max(here, key=lambda tr: (
            hurt.get(str(tr["id"]), 0.0),
            -ids.index(str(tr["id"])) if str(tr["id"]) in ids else -99))
        victor["pelts"] += self.HIDE_PELTS
        victor["hide"] = self.time
        share = self.BEAR_MEAT // len(here)
        for tr in here:
            tr["meat"] += share
        victor["meat"] += self.BEAR_MEAT - share * len(here)

    def _call_off(self, b, cold):
        """It gives up on its man; he goes back to what he was about."""
        self._unhook(b)
        b["t2"] = self.time
        self._bear_next(b, cold)

    def _bear_next(self, b, cold):
        """It weighs what each errand would gain it a minute, and goes."""
        f = b["f"]
        jit = self.rng.uniform
        walk = self.BEAR_WALK_S
        if cold >= 0.5:
            self._send(b, ["den", f], "den", self.SEASON_S, walk)
            return
        if b["energy"] < self.LEAVE_E and self._offer(f) < self.WANDER_PULL:
            self._send(b, ["edge", f], "leave", 0.0, walk)
            return
        hunger = 1 - b["energy"]
        here = b["to"]

        def rate(gain, place, work, speed=walk):
            # A full belly is the cap: what it cannot eat is worth nothing.
            mins = (speed * self.distance(here, place) + work) / 60
            return min(gain, hunger) / max(mins, 1 / 60)

        options = []
        fish = self.FISH_GAIN * self.FISH_K[self.season()]
        for k, st in enumerate(self.sites[f]):
            place = ["site", f, k]
            if fish > 0:
                options.append((rate(fish, place, self.FISH_S), place,
                                "fish", self.FISH_S))
            if st["state"] == "caught":
                options.append((rate(self.BEAVER_GAIN, place, self.STEAL_S),
                                place, "steal", self.STEAL_S))
        out = len(self._flank_beavers(f))
        bank = next((i for i in self._bank_trees(f, b)
                     if self._standing(i)), None)
        if out and bank is not None:
            p = 1 - math.exp(-self.BEAR_CATCH_K * out / self.BEAVER_REF
                             * self.HUNT_S)
            place = ["tree", bank]
            options.append((rate(self.BEAVER_GAIN * p, place, self.HUNT_S),
                            place, "hunt", self.HUNT_S))
        for k, plot in enumerate(self.plots[f]):
            place = ["plot", f, k]
            owner = self._owner(place)
            if owner is not None and owner["meat"] > 0 \
                    and self._far(owner, place):
                take = min(owner["meat"], self.RAID_MEAT)
                options.append((rate(take * self.MEAT_GAIN, place,
                                     self.RAID_S),
                                place, "raid", self.RAID_S))
        for tr in [] if self._beaten(b) else self.trappers:
            if tr["f"] != f or tr["fight"] is not None \
                    or self._sheltered(tr):
                continue
            mins = (self.CHARGE_S * self.distance(here, tr["to"])
                    + self.EFFORT_S) / 60
            dread = self.RISK_K * (1 - hunger) ** 2 * (
                1 + self.COMPANY_K * self._company(f, tr["to"], tr))
            options.append((self.MAN_GAIN * (0.2 + hunger) / mins - dread,
                            tr, "stalk", 0.0))
        woods = [i for i, slot in enumerate(self.trees)
                 if slot["f"] == f and slot["zone"] == "woods"]
        options.append((self.WANDER_PULL, ["tree", self.rng.choice(woods)],
                        "wander", jit(20.0, 60.0)))
        _, place, job, work = max(options,
                                  key=lambda o: o[0] * jit(0.85, 1.15))
        if job == "stalk":
            self._stalk(b, place)
        else:
            self._send(b, place, job, work, walk)

    def _season_turn(self):
        self.tally = self._fresh_tally()
        season = self.season()
        if season == 0:
            for c in self.colonies:
                c["dam"] = max(0, c["dam"] - self.FLOOD_STICKS[0])
                c["lodge"] = max(0, c["lodge"] - self.FLOOD_STICKS[1])
        for row in self.plots:
            for plot in row:
                rot = (plot["owner"] is None) + (self.THAW_LOGS
                                                 if season == 0 else 0)
                plot["logs"] = max(0, plot["logs"] - rot)
        for tr in self.trappers:
            tr["effort_prev"], tr["effort"] = tr["effort"], {}
            win = tr["winter"]
            if season == 3:
                prev = tr["effort_prev"]
                busy = sum(prev.values())
                tr["winter"] = {
                    "start": tr["health"], "low": tr["health"],
                    "share": prev.get("trap", 0.0) / busy if busy else 0.0,
                    "ready": self.plots[tr["f"]][tr["plot"]]["logs"]
                    >= self.CABIN_LOGS}
            elif season == 0 and win is not None:
                self._winter_over(tr, win["start"] - win["low"])
                tr["winter"] = None
        if season == 0:
            self._arrivals()

    def _winter_over(self, tr, loss):
        win = tr["winter"]
        self.tally["events"].append(
            {"kind": "winter", "id": tr["id"], "share": win["share"],
             "ready": win["ready"], "loss": loss})

    # -- beavers --

    def _advance_beavers(self):
        cold = self.cold()
        dead = []
        for b in self.beavers:
            drain = self.COND_DRAIN * self.TICK_S
            if cold > 0:
                drain *= 1 + cold * (self.WINTER_DRAIN
                                     * (1.5 - self.dam_k(b["f"])) - 1)
            b["cond"] -= drain
            if b["cond"] <= 0:
                dead.append(b)
                continue
            if self.time >= b["t2"]:
                self._beaver_done(b)
                self._beaver_next(b, cold)
        for b in dead:
            self.beavers.remove(b)
            self.tally["starved"] += 1

    def _beaver_done(self, b):
        job, c = b["job"], self.colonies[b["f"]]
        tree = b["to"][1] if b["to"][0] == "tree" else None
        tr = self.trees[tree] if tree is not None else None
        if job == "cut" and self._standing(tree):
            tr.update(felled=self.time, by="beaver",
                      pile=self.STICKS_PER_TREE)
        elif job == "fetch" and tr["pile"] > 0:
            tr["pile"] -= 1
            b["stick"] = True
        elif job == "haul" and b["stick"]:
            b["stick"] = False
            if c["dam"] < self.DAM_STICKS:
                c["dam"] += 1
            elif c["lodge"] < self.LODGE_STICKS:
                c["lodge"] += 1
        elif job == "feed":
            if tr is None:
                gain = self.WEED_GAIN
            elif self._standing(tree):
                gain = self.FEED_GAIN
            else:
                gain = self.FEED_GAIN * 0.5 * self.growth(tree)
            b["cond"] = min(1.0, b["cond"] + gain)
        b["tree"] = None

    def _bank_trees(self, f, b):
        """Flank f's bank slots, nearest b's lodge first."""
        home = ["lodge", f]
        return sorted((i for i, tr in enumerate(self.trees)
                       if tr["f"] == f and tr["zone"] == "bank"),
                      key=lambda i: self.distance(home, ["tree", i]))

    def _beaver_next(self, b, cold):
        f = b["f"]
        jit = self.rng.uniform
        if b["stick"]:
            dest = "dam" if self.colonies[f]["dam"] < self.DAM_STICKS \
                else "lodge"
            self._send(b, [dest, f], "haul", self.HAUL_S, self.SWIM_S)
            return
        if cold > 0.5:
            self._send(b, ["lodge", f], "lodge", 30.0, self.SWIM_S)
            return
        taken = {o["tree"] for o in self.beavers if o is not b}
        trees = [i for i in self._bank_trees(f, b) if i not in taken]
        hunger = 1 - b["cond"]
        food = next((i for i in trees if self.tree_state(i) == "tree"),
                    None)
        if food is None:
            food = next((i for i in trees
                         if self.tree_state(i) == "sapling"), None)
        # Spring is for fattening up: the kits come from what is spare.
        fatten = self.SPRING_APPETITE * self.season_weights()[0] * hunger
        scores = {"feed": (2.0 * hunger * hunger + 0.05 + fatten)
                  * jit(0.85, 1.15),
                  "lodge": self.LODGE_REST * jit(0.85, 1.15),
                  "swim": 0.25 * jit(0.85, 1.15)}
        want = self._sticks_wanted(f)
        pile = next((i for i in self._bank_trees(f, b)
                     if self.trees[i]["pile"] > 0), None)
        fell = next((i for i in trees if self._standing(i)), None)
        if want > 0 and (pile is not None or fell is not None):
            scores["work"] = 0.9 * min(1.0, 0.4 + want / 4) * b["cond"] \
                * jit(0.85, 1.15)
        pick = max(scores, key=scores.get)
        if pick == "feed":
            if food is None:
                self._send(b, ["lodge", f], "feed", self.FEED_S,
                           self.SWIM_S)
            else:
                b["tree"] = food
                self._send(b, ["tree", food], "feed", self.FEED_S,
                           self.SWIM_S)
        elif pick == "work" and pile is not None:
            b["tree"] = pile
            self._send(b, ["tree", pile], "fetch", self.FETCH_S,
                       self.SWIM_S)
        elif pick == "work":
            b["tree"] = fell
            self._send(b, ["tree", fell], "cut", self.CUT_S, self.SWIM_S)
        elif pick == "swim":
            lo, hi = (0.04, 0.42) if f == 0 else (0.58, 0.96)
            self._send(b, ["swim", f, round(jit(lo, hi), 3)], "swim",
                       jit(4.0, 10.0), self.SWIM_S)
        else:
            self._send(b, ["lodge", f], "lodge", jit(15.0, 40.0),
                       self.SWIM_S)

    def _births(self):
        """Mid-spring: kits from each colony's surplus, as far as its
        lodge has room."""
        for f in (0, 1):
            mine = [b for b in self.beavers if b["f"] == f]
            room = int(self.LODGE_CAP * self.lodge_k(f)) - len(mine)
            surplus = sum(max(0.0, b["cond"] - 0.5) for b in mine)
            kits = max(0, min(room, int(surplus / self.KIT_COST + 1e-9),
                              self.BEAVER_MAX - len(self.beavers)))
            for _ in range(kits):
                mother = max(mine, key=lambda b: b["cond"])
                mother["cond"] -= self.KIT_COST
                self._beaver(f, self.KIT_COND)
            self.tally["kits"][f] += kits
            self.tally["events"].append(
                {"kind": "kits", "f": f, "n": kits,
                 "lodge": self.lodge_k(f)})
        for f in (0, 1):
            here = [b for b in self.beavers if b["f"] == f]
            there = [b for b in self.beavers if b["f"] != f]
            if not here and len(there) >= 4:
                # The young of a crowded colony strike out downriver.
                for b in sorted(there, key=lambda b: b["cond"])[:2]:
                    b["f"] = f
                    b["stick"], b["tree"] = False, None
                    self._send(b, ["lodge", f], "lodge", 10.0, self.SWIM_S)

    def _rails(self):
        if self.beavers:
            self.empty_since = None
            return
        if self.empty_since is None:
            self.empty_since = self.time
        elif self.time - self.empty_since >= self.RESTOCK_S:
            c = self.colonies
            f = 1 if c[1]["dam"] > c[0]["dam"] else 0
            for _ in range(2):
                self._beaver(f, 0.7)
            self.empty_since = None
            self.tally["rails"]["beavers"] += 1

    # -- trappers --

    def _flank_beavers(self, f):
        """f's beavers out of the lodge, where a trap can take them."""
        return [b for b in self.beavers if b["f"] == f
                and not (b["job"] == "lodge" and self.time >= b["t1"])]

    def _catches(self):
        ice = self.cold()
        if ice >= 1:
            return
        for f in (0, 1):
            for site in self.sites[f]:
                if site["state"] != "set" or \
                        self.time - site["since"] >= self.BAIT_S:
                    continue
                out = self._flank_beavers(f)
                p = self.CATCH_K * self.TICK_S * len(out) / self.BEAVER_REF
                if out and self.rng.random() < p * (1 - ice):
                    victim = min(out, key=lambda b: b["cond"])
                    self.beavers.remove(victim)
                    site["state"], site["since"] = "caught", self.time
                    self.tally["trapped"] += 1

    def _advance_trappers(self):
        cold = self.cold()
        dt = self.TICK_S
        dead = []
        for tr in self.trappers:
            tr["fed"] = max(0.0, tr["fed"] - self.FED_DRAIN * dt)
            arrived = self.time >= tr["t1"]
            shelter = 0.0
            if arrived and tr["job"] == "shelter":
                plot = self.plots[tr["f"]][tr["plot"]]
                shelter = min(1.0, plot["logs"] / self.CABIN_LOGS)
                if cold > 0 and tr["logs"] > 0:
                    tr["hearth"] += dt
                    if tr["hearth"] >= self.HEARTH_S:
                        tr["hearth"] -= self.HEARTH_S
                        tr["logs"] -= 1
                else:
                    shelter *= 1 - self.COLD_HEARTH
            elif arrived and tr["job"] == "fire":
                shelter = self.FIRE_WARMTH
            chill = self.COLD_K * cold * (1 - shelter) * dt
            starve = self.HUNGER_K * dt if tr["fed"] <= 0 else 0.0
            tr["health"] -= chill + starve
            if chill + starve == 0 and tr["fed"] > 0.3:
                tr["health"] = min(1.0, tr["health"] + self.HEAL_K * dt)
            if tr["winter"] is not None:
                tr["winter"]["low"] = min(tr["winter"]["low"],
                                          tr["health"])
            if tr["health"] <= 0:
                dead.append((tr, "hunger" if starve > chill else "cold"))
                continue
            if tr["fight"] is not None:
                continue  # the bear's turn decides what he does
            if self.time >= tr["t2"]:
                self._trapper_done(tr)
                self._trapper_next(tr, cold)
        for tr, cause in dead:
            self.die(tr, cause)

    def _trapper_done(self, tr):
        job = tr["job"]
        f = tr["f"]
        plot = self.plots[f][tr["plot"]]
        site = self.sites[f][tr["site"]] if tr["site"] is not None \
            else None
        if job == "set" and site is not None \
                and site["state"] != "caught":
            site["state"], site["since"] = "set", self.time
        elif job == "check" and site is not None \
                and site["state"] != "caught":
            # A stale trap is lifted, not rebaited: else whoever set the
            # sites first would hold them forever and the rest starve.
            site.update(state="empty", by=None, since=self.time)
        elif job == "collect" and site is not None:
            if site["state"] == "caught":
                tr["carry"] = "beaver"
            site.update(state="empty", by=None, since=self.time)
        elif job == "stash" and tr["carry"] == "beaver":
            tr["pelts"] += 1
            tr["meat"] += self.MEAT_PER_BEAVER
            self.tally["pelts"] += 1
        elif job == "chop" and self._standing(tr["tree"]):
            self.trees[tr["tree"]].update(felled=self.time, by="trapper",
                                          pile=0)
            tr["logs"] += self.LOGS_PER_TREE
        elif job == "build" and tr["logs"] > 0 \
                and plot["logs"] < self.CABIN_LOGS:
            tr["logs"] -= 1
            plot["logs"] += 1
        elif job == "fire" and tr["meat"] > 0:
            tr["meat"] -= 1
            tr["fed"] = 1.0
            if tr["fuel"]:
                tr["logs"] = max(0, tr["logs"] - 1)
        if job == "stash":
            tr["carry"] = None
        if job != "set":
            tr["site"] = None
        tr["tree"], tr["fuel"] = None, False

    def _chop_tree(self, tr):
        """The nearest standing tree on his flank nobody is bound for,
        woods before banks."""
        home = ["plot", tr["f"], tr["plot"]]
        taken = {o["tree"] for o in self.trappers + self.beavers
                 if o is not tr}
        best = None
        for i, slot in enumerate(self.trees):
            if slot["f"] != tr["f"] or i in taken or slot["felled"] \
                    is not None and not self._standing(i):
                continue
            key = (slot["zone"] != "woods",
                   self.distance(home, ["tree", i]))
            if best is None or key < best[0]:
                best = (key, i)
        return None if best is None else best[1]

    def _trapper_next(self, tr, cold):
        """He weighs his needs and does the most pressing thing."""
        f, k = tr["f"], tr["plot"]
        home = ["plot", f, k]
        plot = self.plots[f][k]
        jit = self.rng.uniform
        if tr["carry"] == "beaver":
            self._go(tr, home, "stash", self.STASH_S)
            return
        hunger = 1 - tr["fed"]
        ice = cold
        urgency = self.urgency()
        sites = self.sites[f]
        caught = [j for j, st in enumerate(sites)
                  if st["by"] == tr["id"] and st["state"] == "caught"]
        free = [j for j, st in enumerate(sites) if st["by"] is None]
        stale = [j for j, st in enumerate(sites) if st["by"] == tr["id"]
                 and st["state"] == "set"
                 and self.time - st["since"] >= self.BAIT_S]
        beavers = sum(b["f"] == f for b in self.beavers)
        trap = (self.TRAP_BASE + beavers / self.BEAVER_REF) * (1 - ice) \
            * (1 + 2 * hunger)
        scores = {"rest": self.REST_PULL}
        if caught:
            scores["collect"] = 1 + trap
        if free and ice < 0.9:
            scores["set"] = trap
        if stale and ice < 0.9:
            scores["check"] = trap * 1.1
        if tr["meat"] >= 1:
            scores["fire"] = 3 * hunger * hunger
        unbuilt = self.CABIN_LOGS - plot["logs"]
        need = unbuilt + self.WINTER_LOGS - tr["logs"]
        tree = None
        if need > 0:
            tree = self._chop_tree(tr)
            if tree is not None:
                scores["chop"] = min(1.0, need / 8) * (0.15 + urgency)
                if tr["meat"] >= 1 and tr["logs"] == 0:
                    scores["chop"] += 2 * hunger
        if tr["logs"] >= 1 and unbuilt > 0:
            scores["build"] = (0.15 + urgency) * 1.2
        if plot["logs"] >= self.CABIN_LOGS / 2:
            scores["shelter"] = 2 * cold * plot["logs"] / self.CABIN_LOGS
        for key in scores:
            scores[key] *= jit(0.85, 1.15)
        pick = max(scores, key=scores.get)
        if pick == "collect":
            tr["site"] = caught[0]
            self._go(tr, ["site", f, caught[0]], "collect", self.COLLECT_S)
        elif pick == "check":
            tr["site"] = stale[0]
            self._go(tr, ["site", f, stale[0]], "check", self.SET_S)
        elif pick == "set":
            j = self.rng.choice(free)
            sites[j]["by"] = tr["id"]
            tr["site"] = j
            self._go(tr, ["site", f, j], "set", self.SET_S)
        elif pick == "fire":
            tr["fuel"] = tr["logs"] > 0
            self._go(tr, home, "fire",
                     self.FIRE_S * (1 if tr["fuel"] else 2))
        elif pick == "chop":
            tr["tree"] = tree
            self._go(tr, ["tree", tree], "chop",
                     self.CHOP_S * self.LOGS_PER_TREE)
        elif pick == "build":
            self._go(tr, home, "build", self.BUILD_S)
        elif pick == "shelter":
            self._go(tr, home, "shelter", self.SHELTER_S)
        else:
            self._go(tr, self._idle_spot(tr), "rest", jit(3.0, 8.0))

    def _idle_spot(self, tr):
        """Home; or, watchful after a killing, the nearest neighbour's."""
        home = ["plot", tr["f"], tr["plot"]]
        if not self._alert(tr):
            return home
        near = [["plot", o["f"], o["plot"]] for o in self.trappers
                if o["f"] == tr["f"] and o is not tr]
        return min(near, key=lambda p: self.distance(home, p),
                   default=home)

    EFFORT = {"set": "trap", "check": "trap", "collect": "trap",
              "stash": "trap"}

    def _go(self, tr, to, job, work):
        self._send(tr, to, job, work, self.WALK_S)
        key = self.EFFORT.get(job, job)
        tr["effort"][key] = tr["effort"].get(key, 0.0) + tr["t2"] - \
            self.time

    def die(self, tr, cause):
        """He falls where he is; the nearest survivor takes his goods."""
        self.trappers.remove(tr)
        here = tr["to"] if self.time >= tr["t1"] else tr["at"]
        self.graves.append({"place": list(here), "t": self.time,
                            "id": tr["id"]})
        for st in self.sites[tr["f"]]:
            if st["by"] == tr["id"]:
                st.update(by=None, state="empty", since=self.time)
        self.plots[tr["f"]][tr["plot"]]["owner"] = None
        deaths = self.tally["deaths"]
        deaths[cause] = deaths.get(cause, 0) + 1
        if cause == "bear":
            for o in self.trappers:
                if o["f"] == tr["f"]:
                    o["alert"] = self.time
        if tr["winter"] is not None:
            self._winter_over(tr, 1.0)
        event = {"kind": "death", "id": tr["id"], "cause": cause,
                 "claimant": None, "moved": 0, "before": 0, "after": 0}
        self.tally["events"].append(event)
        heir = self._inherit(tr)
        if heir is not None:
            event.update(claimant=heir[0], moved=heir[1], before=heir[2],
                         after=heir[3])

    @staticmethod
    def stores(tr):
        return tr["pelts"] + tr["meat"] + tr["logs"]

    def _inherit(self, dead):
        if not self.trappers:
            return None
        heir = min(self.trappers, key=lambda o: (
            o["f"] != dead["f"], abs(self.PLOT_U[o["plot"]]
                                     - self.PLOT_U[dead["plot"]])
            if o["f"] == dead["f"] else 0, o["logs"] + o["meat"]))
        before = self.stores(heir)
        for key in ("pelts", "meat", "logs"):
            heir[key] += dead[key]
        theirs = self.plots[dead["f"]][dead["plot"]]
        mine = self.plots[heir["f"]][heir["plot"]]
        # One in a fight takes the goods but cannot stop to move house.
        if theirs["logs"] > mine["logs"] and heir["fight"] is None:
            mine["owner"] = None
            theirs["owner"] = heir["id"]
            moved = heir["f"] != dead["f"]
            heir["f"], heir["plot"] = dead["f"], dead["plot"]
            heir["site"] = None
            if moved:
                # No dry route crosses the grove: he drops his errand
                # and comes in from his new flank's edge, as newcomers do.
                heir["tree"], heir["fuel"] = None, False
                heir["to"] = ["edge", dead["f"]]
                self._go(heir, ["plot", dead["f"], dead["plot"]], "rest",
                         1.0)
            for row in self.sites:
                for st in row:
                    if st["by"] == heir["id"]:
                        st.update(by=None, state="empty", since=self.time)
        return heir["id"], self.stores(dead), before, self.stores(heir)

    def _free_plots(self):
        return [(f, k) for f in (0, 1) for k in range(len(self.PLOT_U))
                if self.plots[f][k]["owner"] is None]

    def _drifters(self):
        """Summer and autumn: now and then a lone newcomer, likelier the
        more plots stand free (as its square), the more beavers there
        are and the further winter is off."""
        if self.season() not in (1, 2) or self.cold() >= 0.5:
            return
        short = min(len(self._free_plots()),
                    self.TRAPPERS_MAX - len(self.trappers))
        if short <= 0:
            return
        p = self.DRIFT_K * short ** 2 * len(self.beavers) \
            / self.BEAVER_REF * (1 - self.urgency()) \
            * self.TICK_S / self.SEASON_S
        if p > 0 and self.rng.random() < p:
            self._arrivals(1)

    def _arrivals(self, n=None):
        """Newcomers into free plots: n of them, or in spring as many as
        the beavers draw."""
        free = self._free_plots()
        if n is None:
            x = self.ARRIVE_K * len(self.beavers) / self.BEAVER_REF
            n = int(x) + (self.rng.random() < x % 1)
            if not self.trappers and n == 0:
                n = 1
                self.tally["rails"]["trappers"] += 1
        n = min(n, len(free), self.TRAPPERS_MAX - len(self.trappers))
        for _ in range(n):
            per = [sum(tr["f"] == f for tr in self.trappers) for f in (0, 1)]
            f, k = max(free, key=lambda p: (self.plots[p[0]][p[1]]["logs"],
                                            -per[p[0]], -p[0]))
            free.remove((f, k))
            self._trapper(f, k, ["edge", f])
            self.tally["arrivals"] += 1

    # -- reading it --

    def stats(self):
        c = self.colonies
        return {
            "season": self.season(), "year": self.year(),
            "beavers": len(self.beavers),
            "dams": sum(x["dam"] >= self.DAM_STICKS for x in c),
            "dam_sticks": [x["dam"] for x in c],
            "lodges": sum(x["lodge"] >= self.LODGE_STICKS for x in c),
            "trees": sum(self.tree_state(i) == "tree"
                         for i in range(len(self.trees))),
            "trappers": len(self.trappers),
            "bears": sum(b["job"] != "dead" for b in self.predators),
            "cabins": sum(p["logs"] >= self.CABIN_LOGS
                          for row in self.plots for p in row),
            "pelts": sum(tr["pelts"] for tr in self.trappers),
            "effort": {tr["id"]: dict(tr["effort"])
                       for tr in self.trappers},
            "tally": json.loads(json.dumps(self.tally)),
        }

    # -- saving --

    STATE = ("seed", "time", "next_tick", "season_n", "half_n", "next_id",
             "trees", "colonies", "beavers", "empty_since", "sites",
             "plots", "trappers", "graves", "predators", "tally")

    def to_dict(self):
        d = {k: copy.deepcopy(getattr(self, k)) for k in self.STATE}
        v, state, gauss = self.rng.getstate()
        d.update(version=self.VERSION, rng=[v, list(state), gauss])
        return d

    @classmethod
    def from_dict(cls, d):
        """The world d describes; raises on anything not of this schema."""
        if not isinstance(d, dict) or d.get("version") != cls.VERSION:
            raise ValueError("not this world's schema")
        w = cls(d["seed"])
        for k in cls.STATE:
            setattr(w, k, copy.deepcopy(d[k]))
        if len(w.trees) != len(cls._slots()) or len(w.colonies) != 2:
            raise ValueError("not this valley")
        v, state, gauss = d["rng"]
        w.rng.setstate((v, tuple(state), gauss))
        w._check()
        return w

    GROWS = ("beavers", "trappers", "graves", "predators", "events")

    def _check(self):
        """Raise ValueError unless every field a fresh world has is here,
        of the same kind, and every place and index is one this valley
        has: the right version alone does not make a file sound."""
        fresh = World(0)
        grave = {"place": ["plot", 0, 0], "t": 0.0, "id": 0}
        protos = {"beavers": fresh.beavers[0], "trappers": fresh.trappers[0],
                  "graves": grave, "predators": fresh._bear(0, ["edge", 0])}

        def bad(why):
            raise ValueError("not this world's state: " + why)

        def num(v, lo=-math.inf, hi=math.inf):
            return isinstance(v, (int, float)) and not isinstance(v, bool) \
                and math.isfinite(v) and lo <= v <= hi

        def idx(v, n, none=True):
            return v is None and none or isinstance(v, int) and \
                not isinstance(v, bool) and 0 <= v < n

        def place(p):
            n = {"tree": (2, len(self.trees)), "dam": (2, 2),
                 "lodge": (2, 2), "swim": (3, 2), "plot": (3, 2),
                 "site": (3, 2), "edge": (2, 2), "den": (2, 2)}
            if not isinstance(p, list) or not p or p[0] not in n \
                    or len(p) != n[p[0]][0] or not idx(p[1], n[p[0]][1],
                                                       False):
                return False
            if p[0] == "swim":
                return num(p[2], 0, 1)
            if p[0] in ("plot", "site"):
                k = len(self.PLOT_U if p[0] == "plot" else self.SITE_SPOTS)
                return idx(p[2], k, False)
            return True

        def like(v, t, key=""):
            if key in ("at", "to", "place"):
                return place(v)
            if t is None or key in ("owner", "by", "felled", "site",
                                     "tree", "carry", "winter", "target",
                                     "fight", "blow", "alert", "hide"):
                # Each of these may be empty; the ones it matters for are
                # checked on their own below.
                return v is None or isinstance(v, (str, dict)) or num(v)
            if isinstance(t, bool):
                return isinstance(v, bool)
            if isinstance(t, (int, float)):
                return num(v)
            if isinstance(t, str):
                return isinstance(v, str)
            if isinstance(t, dict):
                return isinstance(v, dict) and all(
                    k in v and like(v[k], t[k], k) for k in t)
            if not isinstance(v, list):
                return False
            if key in self.GROWS:
                proto = protos.get(key)
                return proto is None or all(like(x, proto) for x in v)
            return len(v) == len(t) and all(
                like(x, y, key) for x, y in zip(v, t))

        for k in self.STATE:
            if not like(getattr(self, k), getattr(fresh, k), k):
                bad(k)
        if not (num(self.time, 0) and num(self.next_tick)
                and self.time < self.next_tick <= self.time + self.TICK_S):
            bad("clock")
        trees = len(self.trees)
        for a in self.beavers + self.trappers:
            if not (idx(a["f"], 2, False) and idx(a["tree"], trees)):
                bad("an actor's whereabouts")
        if any(b["job"] not in ("lodge", "feed", "cut", "haul", "fetch",
                                "swim") for b in self.beavers):
            bad("a beaver's job")
        fight = {"target": 0, "t0": 0.0, "company": 0, "wary": False,
                 "saw": None, "contact": None, "shot": None, "hit": False,
                 "help": 0, "next": None, "dmg": {}, "dead": []}
        for b in self.predators:
            f = b["fight"]
            if f is not None and not (
                    like(f, fight) and all(num(f[k]) for k in (
                        "saw", "contact", "shot", "next") if f[k] is not None)
                    and all(num(x) for x in f["dmg"].values())
                    and all(num(x) for x in f["dead"])):
                bad("a bear's fight")
            if not (idx(b["f"], 2, False) and num(b["energy"])
                    and num(b["health"])
                    and b["job"] in ("wander", "fish", "hunt", "steal",
                                     "raid", "stalk", "fight", "eat", "flee",
                                     "den", "leave", "dead")):
                bad("a bear")
        if any(st["state"] not in ("empty", "set", "caught")
               for row in self.sites for st in row):
            bad("a trap")
        for tr in self.trappers:
            win = tr["winter"]
            if not (tr["job"] in ("rest", "set", "check", "collect", "stash",
                                  "chop", "build", "fire", "shelter",
                                  "fight")
                    and all(num(x) for x in list(tr["effort"].values())
                            + list(tr["effort_prev"].values()))
                    and idx(tr["plot"], len(self.PLOT_U), False)
                    and idx(tr["site"], len(self.SITE_SPOTS))
                    and tr["carry"] in (None, "beaver", "log")
                    and all(tr[k] is None or num(tr[k])
                            for k in ("alert", "hide"))
                    and (tr["fight"] is None or like(tr["fight"], {
                        "bear": 0, "saw": None, "shot": None,
                        "help": False}))
                    and (win is None or like(win, {
                        "start": 0.0, "low": 0.0, "share": 0.0,
                        "ready": False}))):
                bad("a trapper")
        for slot in self.trees:
            if not (slot["felled"] is None or num(slot["felled"])):
                bad("a tree")


def world_path():
    """Where the valley is kept between runs."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "fort-galgs", "world.json")


def load_world(path):
    """The world saved at path, or a fresh one if there is none to be had:
    missing, unreadable, not JSON, of another schema, or one that will not
    run a season on. Never raises."""
    try:
        with open(path) as fh:
            d = json.load(fh)
        trial = World.from_dict(d)
        trial.run(World.SEASON_S)
        json.dumps(trial.stats())
        json.dumps(trial.to_dict())
        return World.from_dict(d)
    except Exception:  # anything wrong with the file means a fresh valley
        return World(random.randrange(2 ** 31))


def save_world(world, path):
    """Write the world to path whole or not at all."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(world.to_dict(), fh, separators=(",", ":"))
    os.replace(tmp, path)


# --------------------------------------------------------------------------
# The picture: the chip, with the fort's cores fenced off
# --------------------------------------------------------------------------

class Siege:
    """The redcoats' siege of the fort, apart from any picture of it.

    Redcoats set out from the barracks in the far corners and march down
    their trails, take cover behind a boulder when fired on, queue at the
    wall and beat on it; the two tower sentries pick whom to shoot, the
    walker's bugle calls one to fire, and a sentry with men at the foot of
    his wall calls for the fort's gun, whose ball takes them all. Nothing
    here draws, and nothing is in pixels: a redcoat's place on his trail is
    his distance d, or the screen fraction p that goes with it. Like World,
    it runs headless; CpuView advances it each frame and draws from it.

    The picture tells it a few facts that only its geometry can know:
    boulders[side] (a boulder stands beside that trail), has_walker (room
    on the wall for him to walk), and, as arguments, whether he is busy
    shooting at a boat. In return it takes men stepping ashore from a boat
    (land) and lets the view run the boats in the middle of a frame (the
    afloat hook of advance). Randomness is the seeded rng, so far unused:
    today's siege runs on fixed cycles.
    """

    MARCH_FAR = 6.0     # a new redcoat is this many times farther than...
    MARCH_NEAR = 1.0    # ...one at the near end of the trail
    MARCH_S = 26.0      # seconds to walk the whole trail
    ENGAGE_P = 0.5      # how far down the trail a sentry opens fire
    FALL_S = 1.6        # a shot redcoat topples and fades over this long
    FLEE_S = 3.5        # a riderless horse is off the picture within this
    DOOR_GAP = 0.3      # how far one must march before the next comes out
    DOOR_OPEN_S = 1.2   # the barracks door stands open this long for each
    CALLED_MAX = 16     # most a barracks will hold on call
    FILE = ("foot",) * 3
    WAVE = ("horse", "horse", "horse", "cannon")
    PACE = {"foot": 1.0, "horse": 2.6, "cannon": 0.45}
    HP = {"foot": 1, "horse": 1, "cannon": 5}
    WAVE_EVERY = (75.0, 105.0, 90.0)
    COVER_P = 0.64      # where on the trail a boulder offers cover
    HIDE_S = 9.5        # how long a man crouches behind it, at least...
    LULL_S = 5.0        # ...and until he has not been shot at for this long
    AT_WALL = 2         # how many beat on the wall at once
    QUEUE_P = 0.08      # trail between each in the queue behind them

    # The call for relief, in seconds from the tower sentry's first note:
    # the walker hears it, runs to the gun, cranks it up and fires, then
    # runs back while the ball flies.
    HEARD_AT = 0.6
    RUN_S = 1.0
    WHEEL_AT = HEARD_AT + RUN_S
    WHEEL_S = 1.2
    CRANK_AT = WHEEL_AT + WHEEL_S
    FIRE_AT = CRANK_AT + 1.2
    FLIGHT_S = 1.4
    RELIEF_LEN = FIRE_AT + FLIGHT_S + 1.0
    GUN_POST = (0.2, 0.8)   # where on the wall walk he wheels it, per side
    BLAST_P = 0.85      # the blast takes queued redcoats this near the wall

    # What the redcoats at the foot of a side wall do to it, as a fraction
    # of its whole strength: a man on foot or a horseman per second as he
    # pounds, a cannon per ball (it fires every BOOM_EVERY seconds).
    HURT_PER_S = {"foot": 0.0035, "horse": 0.006}
    HURT_PER_BALL = 0.045
    BOOM_EVERY = 4.0

    # Lulls, hunger and meals. A lull is QUIET_S seconds with no redcoat
    # beyond CLOSE_P of the trail, on either side. Hunger runs 0..1 for
    # each of the three men (the two tower sentries, 0 and 1, and the
    # walker, 2); it slows his drill and his work by up to HUNGER_SLOW.
    CLOSE_P = 0.5
    QUIET_S = 3.0
    HUNGER_SLOW = 0.5
    HUNGER_S = 2400.0   # seconds on the wall to go from fed to starving...
    HEAVY_S = 300.0     # ...and doing heavy work
    MEAL_S = 80.0       # seconds to eat his fill from starving
    EAT_AT = 0.2        # hungry enough to sit down to a meal at this
    FED = 0.03          # and he gets up again of his own accord at this
    STARVING = 0.8      # too faint to go down and mend
    SIT_S = 0.9         # sitting down
    RISE_S = 1.1        # and getting up again, which is not instant
    PATROL_LEG_S = 9.0  # the walker takes this long from one tower to the next

    # Mending. Only the walker goes down, in a lull, for a wall weaker
    # than MEND_BELOW (the weakest first) and only while he is not
    # starving; with no walker, the sentry on that side does. A ladder
    # goes over the outside of the wall: lowered, climbed, used, climbed
    # again and hauled up, each of which takes real time at fed pace.
    MEND_BELOW = 0.85
    MEND_PER_S = 0.012  # of a wall's whole strength
    LOWER_S = 2.5
    HAUL_S = 2.5
    CLIMB_S = 2.6
    WALK_S = 8.0        # the walker takes this long to cross the wall walk
    LADDER_X = (0.03, 0.97)  # along the wall walk, the ladder at each wall
    CATCH_MARGIN = 0.5  # spare seconds he wants over the nearest redcoat
    MEND_FED = 0.3      # a man at his meal who has a wall to mend gets up at this
    HEAVY = ("lower", "descend", "mend", "ascend", "haul", "run", "hide",
             "home", "raise")

    # Caught outside. Three hiding rocks stand in the woods outside each
    # side wall, 1 to 3 each farther from the fort, at ground distance g
    # from the foot of the wall (0). Redcoats on their trail are as far
    # from the foot as G_SPAN times the trail still ahead of them.
    G_SPAN = 3.0
    RUN_S = 1.5         # seconds to run one rock's distance, fed
    HOME_S = 2.2        # and to walk it
    RAISE_ALONE_S = 10.0
    HIDE_MIN_S = 6.0    # he stays behind a rock at least this long
    POT_EVERY = (None, 6.0, 20.0, None)  # seconds between his shots, by rock
    POT_HIT = (None, 0.5, 0.3, None)
    POT_RANGE = 1.25    # from his rock, in g, his rifle reaches
    DRIVE_RANGE = 1.0   # and a musket
    DRIVE_CHANCE = 0.25 # per second, that a redcoat in range goes after him
    DRIVERS_MAX = 2
    CLOSE_G = 0.4       # a redcoat this near his rock drives him back
    PIN_SHOTS = 3       # as do this many shots on his rock...
    PIN_WINDOW = 15.0   # ...in this many seconds
    VOLLEY_RATE = 1.5   # a redcoat's drill runs this much faster than a sentry's

    DRILL_LEN = 4.6     # from kneeling to the last of the smoke
    SHOT_AT = 2.0       # he fires this far into it

    BUGLE_LEN = 2.0     # from raising the bugle to lowering it
    BUGLE_HEARD = 1.2   # the tower sentry starts his drill this far in

    def __init__(self, seed=1):
        self.rng = random.Random(seed)    # not drawn on yet
        self.phase = 0.0                  # its own clock, moved by tick()
        self.boulders = [True, True]      # one beside each trail, if laid
        self.has_walker = True            # room on the wall for him to walk
        self.drill_start = [None, None]   # phase each tower sentry knelt
        self.drill_target = [None, None]  # the redcoat he is aiming at
        self.drill_fired = [False, False]
        self.redcoats = []
        self.spawned = 0
        self.spawn_in = 1.0
        self.called = [[], []]            # kinds waiting at each barracks
        self.pending_call = None          # (side, phase, wait) of a lone click
        self.wave_in = 45.0
        self.waves = 0
        self.relief = None                # a tower's call for the gun
        self.gun_at = 0.5                 # along the wall walk, 0..1
        self.bugle_at = None              # phase the walker last sounded
        self.chipped = [None, None]       # phase a shot last struck each rock
        self.wall = [1.0, 1.0]            # each side wall's strength, 0..1
        self.quiet_since = None           # phase the last redcoat left range
        self.men = [self._new_man("post"), self._new_man("post"),
                    self._new_man("patrol")]
        self.patrol_u = 0.0               # the walker's patrol, 0..2
        # The fort's one ladder: stowed on the wall walk ("up"), or leaning
        # on the outside of a wall ("standing", ext of its length hung
        # down, 0..1), or ("falling", "fallen") on the grass.
        self.ladder = {"side": 0, "state": "up", "ext": 0.0, "t0": 0.0,
                       "raised": 0.0}
        self.rock_chip = [[None] * 4 for _ in (0, 1)]  # phase each was hit
        self.tally = {"sent": {"foot": 0, "horse": 0, "cannon": 0},
                      "shot": 0, "reached": 0, "blasted": 0, "calls": 0,
                      "hurt": [0.0, 0.0], "mended": [0.0, 0.0],
                      "breaches": 0, "meals": 0, "eating_s": 0.0,
                      "repairs": 0, "repairs_done": 0, "caught": 0,
                      "out_s": 0.0, "retreats": 0, "rc_shots": 0}

    def _new_man(self, mode):
        """One of the fort's three men: his hunger, what he is at (mode),
        since when, and, at a meal, when he began to get up."""
        return {"hunger": 0.0, "mode": mode, "t0": self.phase, "up": None}

    @staticmethod
    def ramp(tau, a, b):
        u = min(1.0, max(0.0, (tau - a) / (b - a)))
        return u * u * (3 - 2 * u)

    @classmethod
    def trail_p(cls, d):
        """Screen position along the trail, 0 far to 1 near, for a redcoat
        at distance d. Size goes as 1/d, and so does the trail on screen,
        so a steady march seems to speed up as he comes closer."""
        far = 1 / cls.MARCH_FAR
        return (1 / d - far) / (1 / cls.MARCH_NEAR - far)

    @classmethod
    def trail_d(cls, p):
        """The distance at which a redcoat stands at screen position p."""
        far = 1 / cls.MARCH_FAR
        return 1 / (far + p * (1 / cls.MARCH_NEAR - far))

    # -- the clock and the calls ------------------------------------------

    def tick(self, dt):
        """Move the clock on dt seconds; advance() then runs the rules."""
        self.phase += dt

    def run(self, seconds, step=1 / 30):
        """Run the siege on this long, a frame at a time, with no picture."""
        for _ in range(int(seconds / step + 1e-9)):
            self.tick(step)
            self.advance(step)

    def call(self, side, kinds):
        q = self.called[side]
        q.extend(kinds[:max(0, self.CALLED_MAX - len(q))])

    def click_barracks(self, side, n, wait):
        """A click on a barracks: a double click calls a wave, a single one
        a file of foot, held until wait seconds have passed with no second
        click, so a double click does not also send the file."""
        if n >= 2:
            self.pending_call = None
            self.call(side, self.WAVE)
        else:
            self.pending_call = (side, self.phase, wait)

    def sound_bugle(self, side, walker_busy=False):
        """The walker sounds his bugle, and the tower sentry on side kneels
        and fires, at a redcoat if one is in sight. Not while he is
        sounding it, working the gun or (walker_busy) shooting at a boat."""
        if self.bugling() or self.relief is not None or walker_busy \
                or self.men[2]["mode"] != "patrol":
            return False
        self.bugle_at = self.phase
        if not self.busy(side):
            self.drill_start[side] = self.phase + self.BUGLE_HEARD
            self.drill_target[side] = None
            self.drill_fired[side] = False
        return True

    # -- the tower sentries -----------------------------------------------

    def drill_t(self, i):
        """Seconds into tower sentry i's drill; negative while he waits on
        the bugle, DRILL_LEN or more once he is done."""
        start = self.drill_start[i]
        return self.DRILL_LEN if start is None else self.phase - start

    def busy(self, i):
        return self.drill_t(i) < self.DRILL_LEN

    def drilling(self, i):
        return 0 <= self.drill_t(i) < self.DRILL_LEN

    def drill(self, i):
        """Tower sentry i kneels, takes aim and fires. Returns (kneel, aim,
        seconds since the shot or -1)."""
        return self.drill_pose(self.drill_t(i))

    @classmethod
    def drill_pose(cls, tau):
        """The same, tau seconds into a drill."""
        kneel = cls.ramp(tau, 0.0, 0.6) - cls.ramp(tau, 3.2, 3.8)
        aim = cls.ramp(tau, 0.4, 1.1) - cls.ramp(tau, 2.8, 3.4)
        shot = tau - cls.SHOT_AT if cls.SHOT_AT <= tau < cls.DRILL_LEN \
            else -1.0
        return kneel, aim, shot

    def bugle_t(self):
        if self.bugle_at is None:
            return self.BUGLE_LEN
        return self.phase - self.bugle_at

    def bugling(self):
        return self.bugle_t() < self.BUGLE_LEN

    # -- lulls, hunger and meals --------------------------------------------

    def in_range(self):
        """Some redcoat is close to a wall: within the sentries' range."""
        return any(rc["hit"] is None and self.trail_p(rc["d"]) >= self.CLOSE_P
                   for rc in self.redcoats)

    def lull(self):
        """THE LULL: no redcoat close to either wall for QUIET_S seconds.
        Whatever a man does only in the quiet asks this."""
        return self.quiet_since is not None \
            and self.phase - self.quiet_since >= self.QUIET_S

    def pace(self, i):
        """How fast man i works, 1 fed and HUNGER_SLOW less starving."""
        return 1.0 - self.HUNGER_SLOW * self.men[i]["hunger"]

    def sit(self, i):
        """How far man i has sat down to eat, 0..1; he is not eating until
        it is 1, and is on his feet again when it is 0."""
        m = self.men[i]
        if m["mode"] != "eat":
            return 0.0
        if m["up"] is None:
            return self.ramp(self.phase - m["t0"], 0.0, self.SIT_S)
        return 1.0 - self.ramp(self.phase - m["up"], 0.0, self.RISE_S)

    def eating(self, i):
        return self.men[i]["mode"] == "eat" and self.men[i]["up"] is None \
            and self.phase - self.men[i]["t0"] >= self.SIT_S

    def _sit_down(self, i):
        m = self.men[i]
        m.update(mode="eat", t0=self.phase, up=None)
        self.tally["meals"] += 1

    def _meal(self, i, dt, stay):
        """Man i at his meal: eating while stay, getting up when not;
        True once he is on his feet again, and free to go back to work."""
        m = self.men[i]
        if m["up"] is None:
            if self.eating(i):
                m["hunger"] = max(0.0, m["hunger"] - dt / self.MEAL_S)
                self.tally["eating_s"] += dt
            if not stay or m["hunger"] <= self.FED:
                m["up"] = self.phase
        elif self.phase - m["up"] >= self.RISE_S:
            m["up"] = None
            return True
        return False

    def out(self, i):
        """Man i is off the walls, and not walking, shooting or ringing
        them: on the ground outside, or on the ladder."""
        return self.men[i]["mode"] in ("descend", "mend", "ascend", "run",
                                       "hide", "home", "raise")

    def _wall_to_mend(self):
        """The most damaged side wall, if it is damaged enough to go down
        for; else None."""
        side = 0 if self.wall[0] <= self.wall[1] else 1
        return side if self.wall[side] < self.MEND_BELOW else None

    def _time_to_foot(self, side):
        """Seconds until the nearest redcoat on side is at the foot of
        its wall, by the pace he is marching now; 0 if one is there."""
        speed = (self.MARCH_FAR - self.MARCH_NEAR) / self.MARCH_S
        best = math.inf
        for rc in self.redcoats:
            if rc["side"] != side or rc["hit"] is not None:
                continue
            if rc["at_wall"] is not None:
                return 0.0
            if rc.get("hid") is None:
                best = min(best, (rc["d"] - self.MARCH_NEAR)
                           / (speed * self.PACE[rc["kind"]]))
        return best

    def _start_mending(self, i, side):
        """Man i, in a lull, sets out to mend the wall on side."""
        m = self.men[i]
        m.update(side=side, t0=self.phase, h=1.0, g=0.0)
        self.ladder.update(side=side, state="standing", ext=0.0)
        m["x"] = self.walker_x()[0] if i == 2 else None
        m["mode"] = "to_wall" if i == 2 else "lower"
        self.tally["repairs"] += 1

    def _home_post(self, i):
        """Man i is back at his place: the patrol, or his tower."""
        m = self.men[i]
        if i == 2:
            x = m["x"] if m.get("x") is not None else self.walker_x()[0]
            pos = math.acos(1.0 - 2.0 * min(1.0, max(0.0, x))) / math.pi
            self.patrol_u = pos if x < 0.5 else 2.0 - pos
            m["mode"] = "patrol"
        else:
            m["mode"] = "post"
        m["x"], m["up"] = None, None

    def _ladder_work(self, i, dt):
        """Man i mending: from the wall walk down the ladder, at the
        wall's foot, and back up with the ladder after him."""
        m = self.men[i]
        side, lad, pace = m["side"], self.ladder, self.pace(i)
        mode = m["mode"]
        close = self.in_range()
        if mode == "to_wall":
            goal = self.LADDER_X[side]
            step = dt * pace / self.WALK_S
            m["x"] += max(-step, min(step, goal - m["x"]))
            if close:
                self._home_post(i)
            elif abs(goal - m["x"]) < 1e-9:
                m["mode"] = "lower"
        elif mode == "lower":
            lad["ext"] = min(1.0, lad["ext"] + dt * pace / self.LOWER_S)
            if close:
                m["mode"] = "haul"
            elif lad["ext"] >= 1.0:
                m["mode"] = "descend"
        elif mode == "descend":
            m["h"] = max(0.0, m["h"] - dt * pace / self.CLIMB_S)
            if close:
                self._ladder_alarm(i)
            elif m["h"] <= 0.0:
                m["mode"] = "mend"
        elif mode == "mend":
            if self.wall[side] >= 1.0:
                self.tally["repairs_done"] += 1
                self._ladder_alarm(i)
            elif close:
                self._ladder_alarm(i)
            else:
                self.mend(side, dt * pace * self.MEND_PER_S)
        elif mode == "ascend":
            m["h"] = min(1.0, m["h"] + dt * pace / self.CLIMB_S)
            if m["h"] >= 1.0:
                m["mode"] = "haul"
        elif mode == "haul":
            lad["ext"] = max(0.0, lad["ext"] - dt * pace / self.HAUL_S)
            if lad["ext"] <= 0.0:
                lad["state"] = "up"
                self._home_post(i)

    def ground_g(self, rc):
        """How far from the foot of its wall, in rock distances, a redcoat
        is on his trail."""
        return (1.0 - self.trail_p(rc["d"])) * self.G_SPAN

    def _time_needed(self, i):
        """Seconds man i needs to be up on the wall again with the ladder
        under him, from where he is, at his pace."""
        m, lad = self.men[i], self.ladder
        t = 0.0
        if m["mode"] in ("home", "run"):
            t += m["g"] * self.HOME_S
        if lad["state"] in ("fallen", "falling") and m["mode"] != "ascend":
            t += self.RAISE_ALONE_S * (1.0 - lad["raised"])
        h = m["h"] if m["mode"] in ("descend", "ascend", "mend") else 0.0
        return (t + (1.0 - h) * self.CLIMB_S) / self.pace(i)

    def _ladder_alarm(self, i):
        """Man i, on the ladder or below it, is done or has seen redcoats:
        he goes back up if he can reach the ladder and climb it before the
        nearest redcoat reaches the foot of the wall, and if not he breaks
        for the woods, leaving the ladder where it stands."""
        m = self.men[i]
        if self.wall[m["side"]] >= 1.0 or self._time_needed(i) \
                + self.CATCH_MARGIN < self._time_to_foot(m["side"]):
            if m["mode"] in ("home", "raise"):
                m["mode"] = "home"   # carries on to the ladder
            else:
                m["mode"] = "ascend"
            return
        self._break_for_woods(i)

    def _break_for_woods(self, i):
        m = self.men[i]
        self.tally["caught"] += 1
        self.ladder["raised"] = 0.0
        m.update(mode="run", rock=min(3, max(1, math.ceil(m["g"] - 1e-9))),
                 t0=self.phase, h=0.0, up=None, pinned=[], shot_t=None)

    def _rock_g(self, k):
        return float(k)

    def _advance_ground(self, i, dt):
        """Man i out in the grass: running for the woods, behind a rock
        taking pot shots, walking home, or raising the ladder alone."""
        m, lad, pace = self.men[i], self.ladder, self.pace(i)
        side, mode = m["side"], m["mode"]
        close = self.in_range()
        if mode == "run":
            goal = self._rock_g(m["rock"])
            m["g"] = min(goal, m["g"] + dt * pace / self.RUN_S)
            if m["g"] >= goal:
                m.update(mode="hide", t0=self.phase, shot_t=None,
                         pinned=[], next_shot=self.phase + self._pot_wait(m))
        elif mode == "hide":
            self._hide(i, dt)
        elif mode == "home":
            if close and m["g"] > 0.0:
                self._ladder_alarm(i)
            if m["mode"] != "home":
                return
            m["g"] = max(0.0, m["g"] - dt * pace / self.HOME_S)
            if m["g"] <= 0.0:
                m["mode"] = "raise" if lad["state"] in ("fallen", "falling") \
                    else "ascend"
                m["h"] = 0.0
        elif mode == "raise":
            if close:
                self._ladder_alarm(i)
                if m["mode"] != "raise":
                    return
            if lad["state"] == "falling":
                return
            lad["raised"] = min(1.0, lad["raised"]
                                + dt * pace / self.RAISE_ALONE_S)
            if lad["raised"] >= 1.0:
                lad.update(state="standing", ext=1.0, raised=0.0)
                m.update(mode="ascend", h=0.0)

    def _pot_wait(self, m):
        every = self.POT_EVERY[m["rock"]]
        return math.inf if every is None else every * (
            0.6 + 0.8 * self.rng.random())

    def _hide(self, i, dt):
        """Behind a rock: crouched, rising now and then to take a pot shot
        at a redcoat on his side, and driven back by fire or by a redcoat
        close on him. Home in a lull."""
        m = self.men[i]
        side, k, pace = m["side"], m["rock"], self.pace(i)
        m["pinned"] = [t for t in m["pinned"]
                       if self.phase - t < self.PIN_WINDOW]
        foes = [rc for rc in self.redcoats if rc["side"] == side
                and rc["hit"] is None]
        crowded = any(abs(self.ground_g(rc) - k) <= self.CLOSE_G
                      for rc in foes if rc["kind"] != "cannon")
        if k < 3 and (len(m["pinned"]) >= self.PIN_SHOTS or crowded):
            self.tally["retreats"] += 1
            m.update(mode="run", rock=k + 1, t0=self.phase, pinned=[],
                     shot_t=None)
            self._call_off(side)
            return
        if m["shot_t"] is not None:
            m["shot_t"] += dt * pace
            if m["shot_t"] >= self.SHOT_AT and not m.get("fired"):
                m["fired"] = True
                self._pot_shot(i)
            if m["shot_t"] >= self.DRILL_LEN:
                m["shot_t"] = None
                m["next_shot"] = self.phase + self._pot_wait(m)
            return
        if self.phase >= m["next_shot"] and self.POT_EVERY[k] is not None \
                and self._pot_target(i) is not None:
            m.update(shot_t=0.0, fired=False)
            return
        if self.lull() and self.phase - m["t0"] >= self.HIDE_MIN_S \
                and not m["pinned"]:
            m["mode"] = "home"
            self._call_off(side)

    def _call_off(self, side):
        """The redcoats who left the trail to drive him off go back to it."""
        for rc in self.redcoats:
            if rc["side"] == side:
                rc.pop("drive", None)

    def _pot_target(self, i):
        m = self.men[i]
        best, at = None, math.inf
        for rc in self.redcoats:
            if rc["side"] != m["side"] or rc["hit"] is not None \
                    or rc.get("hid") is not None:
                continue
            gap = abs(self.ground_g(rc) - m["rock"])
            if gap <= self.POT_RANGE and gap < at:
                best, at = rc, gap
        return best

    def _pot_shot(self, i):
        m = self.men[i]
        rc = self._pot_target(i)
        if rc is None or self.rng.random() >= self.POT_HIT[m["rock"]]:
            return
        rc["hp"] -= 1
        rc["struck"] = self.phase
        if rc["hp"] <= 0:
            rc["hit"] = self.phase
            self.tally["shot"] += 1

    def _advance_drivers(self):
        """A redcoat near his rock may leave the trail to drive him off:
        he kneels and fires at the rock, and keeps on while the man is
        there, until he has fallen back or the redcoat is shot."""
        for i in (0, 1, 2):
            m = self.men[i]
            if m["mode"] != "hide" or m["rock"] >= 3:
                continue
            side, k = m["side"], m["rock"]
            drivers = [rc for rc in self.redcoats if rc["side"] == side
                       and rc["hit"] is None and rc.get("drive")]
            for rc in self.redcoats:
                if len(drivers) >= self.DRIVERS_MAX:
                    break
                if rc["side"] == side and rc["hit"] is None \
                        and rc["kind"] == "foot" and rc["at_wall"] is None \
                        and rc.get("hid") is None and not rc.get("drive") \
                        and abs(self.ground_g(rc) - k) <= self.DRIVE_RANGE \
                        and self.rng.random() < self.DRIVE_CHANCE / 30.0:
                    rc["drive"] = {"t0": self.phase + self.rng.random(),
                                   "born": self.phase, "rock": k,
                                   "fired": False}
                    drivers.append(rc)
            for rc in drivers:
                d = rc["drive"]
                tau = (self.phase - d["t0"]) * self.VOLLEY_RATE
                if tau >= self.DRILL_LEN:
                    d.update(t0=self.phase + 0.3 + self.rng.random() * 0.6,
                             fired=False)
                elif tau >= self.SHOT_AT and not d["fired"]:
                    d["fired"] = True
                    self.tally["rc_shots"] += 1
                    self.rock_chip[side][k] = self.phase
                    m["pinned"].append(self.phase)

    def hide_pose(self, i):
        """Man i behind his rock: (how far ducked down behind it, kneel,
        aim, seconds since his shot or -1)."""
        t = self.men[i].get("shot_t")
        if t is None:
            return 1.0, 1.0, 0.0, -1.0
        _, aim, shot = self.drill_pose(t)
        duck = 1.0 - self.ramp(t, 0.0, 0.7) \
            + self.ramp(t, self.DRILL_LEN - 1.0, self.DRILL_LEN - 0.3)
        return min(1.0, max(0.0, duck)), 1.0, aim, shot

    def volley(self, rc):
        """A redcoat who has left the trail for his man's rock: (kneel,
        aim, seconds since his shot or -1)."""
        d = rc.get("drive")
        if not d:
            return 0.0, 0.0, -1.0
        tau = (self.phase - d["t0"]) * self.VOLLEY_RATE
        kneel, aim, shot = self.drill_pose(max(0.0, tau))
        return kneel, aim, shot / self.VOLLEY_RATE if shot >= 0 else -1.0

    def _advance_men(self, dt, walker_busy):
        """Hunger, the walker's patrol, and what each man does in a lull."""
        if self.in_range():
            self.quiet_since = None
        elif self.quiet_since is None:
            self.quiet_since = self.phase
        for m in self.men:
            if m["mode"] != "eat":
                m["hunger"] = min(1.0, m["hunger"] + dt / (
                    self.HEAVY_S if m["mode"] in self.HEAVY
                    else self.HUNGER_S))
        for i, m in enumerate(self.men):
            if m["mode"] in ("to_wall", "lower", "descend", "mend",
                             "ascend", "haul"):
                self._ladder_work(i, dt)
            elif m["mode"] in ("run", "hide", "home", "raise"):
                self._advance_ground(i, dt)
            if self.out(i):
                self.tally["out_s"] += dt
        self._advance_drivers()
        if not self.has_walker:
            # No room on the wall for him: the sentry on a damaged side
            # goes down instead, if he has nothing at his rifle.
            side = self._wall_to_mend()
            if side is not None and self.lull() \
                    and self.men[side]["mode"] == "post" \
                    and not self.busy(side) \
                    and self.men[side]["hunger"] < self.STARVING \
                    and self.ladder["state"] == "up" \
                    and self.relief is None:
                self._start_mending(side, side)
            return
        # The walker's patrol goes on while he is on the wall and not at
        # his bugle, the gun or a shot at a boat.
        walker = self.men[2]
        free = not (self.bugling() or self.relief is not None or walker_busy)
        if walker["mode"] == "patrol" and free:
            self.patrol_u = (self.patrol_u + dt / self.PATROL_LEG_S) % 2.0
            side = self._wall_to_mend()
            if self.lull() and side is not None \
                    and walker["hunger"] < self.STARVING \
                    and self.ladder["state"] == "up":
                self._start_mending(2, side)
            elif self.lull() and walker["hunger"] >= self.EAT_AT:
                self._sit_down(2)
        elif walker["mode"] == "eat":
            if self._meal(2, dt, not self.in_range() and not (
                    self._wall_to_mend() is not None
                    and walker["hunger"] <= self.MEND_FED)):
                walker["mode"] = "patrol"

    def walker_x(self):
        """Where the walker stands on the wall walk, 0 at the west tower
        to 1 at the east, and the way he faces (the way he is walking,
        or outward when he is at a wall's ladder)."""
        m = self.men[2]
        if m["mode"] in ("to_wall", "lower", "haul", "descend", "ascend",
                         "mend"):
            x = m["x"] if m["mode"] == "to_wall" \
                else self.LADDER_X[m["side"]]
            goal = self.LADDER_X[m["side"]]
            return x, (1 if goal > x else -1) if m["mode"] == "to_wall" \
                else (-1 if m["side"] == 0 else 1)
        u = self.patrol_u
        pos = u if u < 1.0 else 2.0 - u
        return 0.5 - 0.5 * math.cos(pos * math.pi), 1 if u < 1.0 else -1

    # -- the gun ----------------------------------------------------------

    def relief_t(self):
        r = self.relief
        return None if r is None else self.phase - r["t0"]

    def calling(self, i):
        """Tower sentry i is blowing his horn for the gun."""
        t = self.relief_t()
        return t is not None and self.relief["side"] == i \
            and t < self.BUGLE_LEN

    def gun_frac(self):
        """Where the fort's gun stands, as a fraction of the wall walk."""
        r = self.relief
        if r is None:
            return self.gun_at
        k = self.ramp(self.phase - r["t0"], self.WHEEL_AT,
                      self.WHEEL_AT + self.WHEEL_S)
        return r["from"] + (self.GUN_POST[r["side"]] - r["from"]) * k

    def _advance_relief(self, walker_busy):
        """A tower sentry with redcoats at the foot of his wall calls for
        the gun; when the ball lands, it takes them all."""
        r = self.relief
        if r is None:
            # Called while the walker shoots at a boat, it waits for him.
            if not self.has_walker or self.bugling() or walker_busy \
                    or self.men[2]["mode"] != "patrol":
                return
            for i in (0, 1):
                if not self.busy(i) and any(
                        rc["side"] == i and rc["hit"] is None
                        and self.at_wall(rc) for rc in self.redcoats):
                    self.relief = {"side": i, "t0": self.phase,
                                   "landed": False, "from": self.gun_at}
                    self.tally["calls"] += 1
                    return
            return
        t = self.phase - r["t0"]
        if not r["landed"] and t >= self.FIRE_AT + self.FLIGHT_S:
            r["landed"] = True
            for rc in self.redcoats:
                if rc["side"] == r["side"] and rc["hit"] is None and (
                        self.at_wall(rc)
                        or self.trail_p(rc["d"]) >= self.BLAST_P):
                    rc["hp"] = 0
                    rc["hit"] = self.phase
                    self.tally["blasted"] += 1
        if t >= self.RELIEF_LEN:
            self.gun_at = self.GUN_POST[r["side"]]
            self.relief = None

    # -- the walls --------------------------------------------------------

    def breached(self, side):
        """The wall on side has no strength left: there is a gap."""
        return self.wall[side] <= 0.0

    def hurt(self, side, amount):
        """The wall on side takes a blow."""
        before = self.wall[side]
        self.wall[side] = max(0.0, before - amount)
        self.tally["hurt"][side] += before - self.wall[side]
        if before > 0.0 and self.wall[side] <= 0.0:
            self.tally["breaches"] += 1

    def mend(self, side, amount):
        """The wall on side is made stronger."""
        before = self.wall[side]
        self.wall[side] = min(1.0, before + amount)
        self.tally["mended"][side] += self.wall[side] - before

    def wait_at_breach(self, rc):
        """THE BREACH: a redcoat at the foot of a wall with a gap in it.
        For now he waits there and does nothing more; what a breach lets
        him do is for the next round to say, here."""

    def _pound(self, dt):
        """Redcoats at the wall's foot beat on it; a cannon fires into the
        logs. A breached wall takes nothing more."""
        for rc in self.redcoats:
            if rc["hit"] is not None or not self.at_wall(rc):
                continue
            side = rc["side"]
            if self.breached(side):
                self.wait_at_breach(rc)
            elif rc["kind"] == "cannon":
                due = int((self.phase - rc["at_wall"]) / self.BOOM_EVERY) + 1
                while rc.get("booms", 0) < due:
                    rc["booms"] = rc.get("booms", 0) + 1
                    self.hurt(side, self.HURT_PER_BALL)
            else:
                self.hurt(side, self.HURT_PER_S[rc["kind"]] * dt)

    # -- the redcoats -----------------------------------------------------

    def at_wall(self, rc):
        """At the wall itself, rather than waiting in the queue behind."""
        return rc["at_wall"] is not None and rc["slot"] < self.AT_WALL

    def cover(self, rc):
        """How far a redcoat has stepped off the trail behind his boulder,
        0..1: he ducks in quickly and steps out again more slowly."""
        if "rock" not in rc or not self.boulders[rc["rock"]]:
            return 0.0
        if rc["hid"] is not None:
            return self.ramp(self.phase - rc["hid"], 0.0, 0.35)
        return 1.0 - self.ramp(self.phase - rc["rose"], 0.0, 0.6)

    def door_open(self, i):
        """Someone has just come out of barracks i (not off a boat)."""
        return any(rc["side"] == i and not rc.get("boat")
                   and self.phase - rc["born"] < self.DOOR_OPEN_S
                   for rc in self.redcoats)

    def send(self, side, kind, d=None, boat=None):
        """A redcoat sets out from the barracks on trail side, or, given d
        and a place to hop from, steps ashore from a boat there."""
        self.redcoats.append({"side": side, "d": d or self.MARCH_FAR,
                              "hit": None, "n": self.spawned,
                              "born": self.phase, "kind": kind,
                              "hp": self.HP[kind], "struck": None,
                              "at_wall": None, "slot": 0, "boat": boat})
        self.spawned += 1
        self.tally["sent"][kind] += 1

    def land(self, side, d, bow):
        """A man from a boat steps ashore on trail side at distance d, to
        hop from bow, wherever the view has it."""
        self.send(side, "foot", d, bow)

    def advance(self, dt, walker_busy=False, afloat=None):
        """Step the siege dt seconds: the gun, the redcoats' march, the
        barracks' calls and the sentries choosing whom to shoot. The
        clock is moved first, by tick(). walker_busy says he is shooting
        at a boat; afloat, if given, is called between the barracks' calls
        and the new arrivals, to run the boats and let men land from them."""
        self._advance_relief(walker_busy)
        self._pound(dt)
        speed = (self.MARCH_FAR - self.MARCH_NEAR) / self.MARCH_S
        for side in (0, 1):
            # Two at a time beat on the wall; the rest wait in a queue back
            # up the trail, and all of it shuffles forward when a place at
            # the wall comes free.
            halted = [rc for rc in self.redcoats if rc["side"] == side
                      and rc["hit"] is None and rc["at_wall"] is not None]
            front = {rc["slot"] for rc in halted if rc["slot"] < self.AT_WALL}
            if len(front) < self.AT_WALL:
                for rc in halted:
                    if rc["slot"] >= self.AT_WALL:
                        rc["at_wall"] = None
                halted = [rc for rc in halted if rc["at_wall"] is not None]
            moving = sorted((rc for rc in self.redcoats
                             if rc["side"] == side and rc["hit"] is None
                             and rc["at_wall"] is None),
                            key=lambda rc: rc["d"])
            rock = self.boulders[side]
            nearest = min((rc for rc in self.redcoats if rc["side"] == side
                           and rc["hit"] is None), key=lambda rc: rc["d"],
                          default=None)
            for rc in moving:
                if rc.get("drive"):
                    continue    # he has left the trail for the woods
                if rc.get("hid") is not None:
                    # Not until the fire on him slackens: under steady fire
                    # he stays down until the third shot finds him.
                    if self.phase - rc["hid"] < self.HIDE_S or \
                            self.phase - rc["shot_at"] < self.LULL_S:
                        continue
                    rc["hid"], rc["rose"] = None, self.phase
                was = self.trail_p(rc["d"])
                rc["d"] = max(self.MARCH_NEAR,
                              rc["d"] - speed * self.PACE[rc["kind"]] * dt)
                # A man on foot who reaches the boulder with a rifle on him
                # drops behind it, once.
                if rock and rc["kind"] == "foot" and "rock" not in rc \
                        and was < self.COVER_P <= self.trail_p(rc["d"]) \
                        and (self.drill_target[side] is rc
                             or rc is nearest) \
                        and not any(o.get("hid") is not None
                                    and o["side"] == side
                                    and o["hit"] is None
                                    for o in self.redcoats):
                    rc.update(d=self.trail_d(self.COVER_P), hid=self.phase,
                              rock=side, ducked=0, shot_at=self.phase)
                    continue
                k = len(halted)
                stop = 1.0 if k < self.AT_WALL \
                    else 1.0 - self.QUEUE_P * (k - self.AT_WALL + 1)
                if self.trail_p(rc["d"]) >= stop - 1e-9:
                    rc["at_wall"] = self.phase
                    taken = {o["slot"] for o in halted}
                    rc["slot"] = min(set(range(k + 1)) - taken) \
                        if k < self.AT_WALL else k
                    halted.append(rc)
                    if rc["slot"] < self.AT_WALL and not rc.get("reached"):
                        rc["reached"] = True
                        self.tally["reached"] += 1
        self.redcoats = [rc for rc in self.redcoats if rc["hit"] is None
                         or self.phase - rc["hit"] < (
                             self.FLEE_S if rc["kind"] == "horse"
                             else self.FALL_S)]

        if self.pending_call is not None and \
                self.phase - self.pending_call[1] > self.pending_call[2]:
            self.call(self.pending_call[0], self.FILE)
            self.pending_call = None
        self.wave_in -= dt
        if self.wave_in <= 0:
            self.call(self.waves % 2, self.WAVE)
            self.wave_in = self.WAVE_EVERY[self.waves % 3]
            self.waves += 1

        def door_clear(side):
            return all(rc["d"] < self.MARCH_FAR - self.DOOR_GAP
                       for rc in self.redcoats if rc["side"] == side)

        for side in (0, 1):
            if self.called[side] and door_clear(side):
                self.send(side, self.called[side].pop(0))

        if afloat is not None:
            afloat()
        self.spawn_in -= dt
        if self.spawn_in <= 0:
            n = self.spawned
            side = (0, 1, 1, 0, 1, 0, 0, 1)[n % 8]
            marching = sum(rc["side"] == side and rc["hit"] is None
                           for rc in self.redcoats)
            if marching < 2 and door_clear(side):
                self.send(side, "foot")
                self.spawn_in = (6.0, 4.5, 7.5, 5.0)[n % 4]
            else:
                self.spawn_in = 1.0

        self._advance_men(dt, walker_busy)
        for i in (0, 1):
            targets = [rc for rc in self.redcoats
                       if rc["side"] == i and rc["hit"] is None]
            nearest = min(targets, key=lambda rc: rc["d"], default=None)
            man = self.men[i]
            if man["mode"] not in ("post", "eat"):
                continue  # he is at the ladder, or below it
            if man["mode"] == "eat":
                # He never leaves his post; he sits where he stands, and
                # stands up first if called to his rifle.
                if self._meal(i, dt, not self.in_range()
                              and not self.busy(i)):
                    man["mode"] = "post"
                elif self.busy(i):
                    self.drill_start[i] = max(
                        self.drill_start[i], (man["up"] or self.phase)
                        + self.RISE_S)
                continue
            if not self.busy(i) and self.lull() \
                    and man["hunger"] >= self.EAT_AT:
                self._sit_down(i)
                continue
            if not self.busy(i):
                self.drill_target[i] = None
                if self.calling(i):
                    continue  # his hands are on the horn
                # He fires on men in the open before one behind a rock.
                near = [rc for rc in targets
                        if self.trail_p(rc["d"]) >= self.ENGAGE_P]
                open_ = [rc for rc in near if rc.get("hid") is None]
                pick = min(open_ or near, key=lambda rc: rc["d"],
                           default=None)
                if pick:
                    self.drill_start[i] = self.phase
                    self.drill_target[i] = pick
                    self.drill_fired[i] = False
                continue
            tau = self.drill_t(i)
            target = self.drill_target[i]
            if target is None and 0 <= tau < self.SHOT_AT:
                # Called by the bugle: he takes whoever is closest.
                self.drill_target[i] = target = nearest
            if tau >= self.SHOT_AT and not self.drill_fired[i]:
                self.drill_fired[i] = True
                if target is not None and target["hit"] is None \
                        and target.get("hid") is not None:
                    # Behind the boulder, only every third shot finds him.
                    target["ducked"] += 1
                    target["shot_at"] = self.phase
                    if target["ducked"] % 3:
                        if self.boulders[target["rock"]]:
                            self.chipped[target["rock"]] = self.phase
                        continue
                if target is not None and target["hit"] is None:
                    target["hp"] -= 1
                    target["struck"] = self.phase
                    if target["hp"] <= 0:
                        target["hit"] = self.phase
                        self.tally["shot"] += 1
        # A hungry man's drill drags: each second of it is a little longer.
        for i in (0, 1):
            start = self.drill_start[i]
            if start is not None and self.phase - start < self.DRILL_LEN:
                self.drill_start[i] = start + dt * (1.0 - self.pace(i))


class CpuView(Gtk.DrawingArea):
    """Every physical core as a tile, each of its threads a live load bar.

    The chip sits in open country with a river running across it, in a
    valley that lives on its own (World): the seasons turn over the whole
    picture, beavers fell trees along the banks and build dams and
    lodges, and trappers trap them, chop and build cabins, cook at their
    fires and sit out the winter, or die of it; bears fish, den up and
    now and then fight a trapper, drawn shot, blood and all, in the idle
    picture only. The world runs on whether the fort is up or down; this
    view only draws it.

    While the fort is up, the reserved cores stand inside a log stockade,
    embers rising in their orange tiles; mountain men watch from its
    towers and walk its wall, redcoats march on it down trails from
    barracks in the far corners or come down the river in boats, take
    cover behind boulders, and the sentries and the fort's gun see them
    off. Most boats row on by, and the one walking the wall takes shots at
    them as they pass; now and then one puts its men ashore at a ford. The
    river still shows the beavers' dams, ponds and lodges, and the beavers
    swimming. While it is down, a grove grows there instead and those
    cores look like every other; around it are the valley's woods, the
    trappers at their work, their cabins, caches and graves, loose horses
    grazing, and a small almanac of the season in the corner. Which state
    it is in never depends on telling orange from blue.
    """

    COLS = 5

    def __init__(self):
        super().__init__(content_height=400, hexpand=True, vexpand=True)
        self.cores = []
        self.reserved = set()
        self.on = False
        self.loads = {}       # cpu -> target load
        self.shown = {}       # cpu -> displayed load, eased toward target
        self.phase = 0.0
        self.last_draw = -1.0
        self._t0 = None
        self.siege = Siege(seed=7)        # the rules; this view draws them
        self.siege.boulders = [False, False]  # none laid until drawn
        self.siege.has_walker = False
        self.gun_facing = 1
        self.stains = []                  # (x, y, size, phase) of the fallen
        self.barracks_box = [None, None]  # (x0, y0, x1, y1) as last drawn
        self.trails = None                # each side's trail, as last drawn
        self.redcoat_s = 14.0             # a redcoat's size at the near end
        self.walker_at = None             # (x, feet) as last drawn
        self.sentries_at = None           # (towers, floor, size) as drawn
        self.potshot = None               # his shot at a boat, if taking one
        self.potshot_after = 0.0          # siege time he may next shoot
        self.overboard = []               # men shot out of the boats
        self.fort_box = None              # (x0, y0, x1, y1) as last drawn
        self.fort_geo = None              # the stockade's measures, as drawn
        self.river = None                 # its course, as last laid out
        self.fords = [None, None]         # p where each trail crosses it
        self.rocks = [None, None]         # each trail's cover, as last laid
        self.hrocks = [[], []]            # each side's three hiding rocks
        self.hrocks_key = None
        self.scenery = None               # the siege's woods, per size
        self.boats = []                   # bateaux of redcoats on the river
        self.boat_in = 30.0
        self.boats_sent = 0
        self.rng = random.Random(7)       # the horses' only source of chance
        self.wild = None                  # the idle scene's layout, per size
        self.horses = []
        self.world = World(seed=7)
        self.time_scale = 1.0             # world seconds per real second
        self.current = 0.0                # how far the glints have drifted
        self.world_at = None              # monotonic s the world last ran
        self.look = self._season_look()   # the season's colours, per frame
        self.set_draw_func(self._draw)
        self.add_tick_callback(self._on_tick)
        click = Gtk.GestureClick()
        click.connect("pressed", self._on_click)
        self.add_controller(click)
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        self.add_controller(motion)

    def set_state(self, cores, reserved, on):
        self.cores = cores
        self.reserved = set(reserved)
        if not on:
            # Standing down sends everyone home; the next siege starts fresh.
            self.boats = []
            self.potshot = None
            self.overboard = []
            self.potshot_after = 0.0
            self.stains = []
            old, self.siege = self.siege, Siege(seed=7)
            self.siege.boulders = old.boulders
            self.siege.has_walker = old.has_walker
        self.on = on
        self.queue_draw()

    def set_world(self, world):
        self.world = world
        self.wild = None  # its places are laid out afresh
        self.look = self._season_look()

    CATCH_UP_MAX = 10.0  # most real seconds one catch-up makes good

    def catch_up(self, now):
        """Run the world on to real time now (monotonic seconds) if the
        picture has stopped ticking: hidden, minimised, or another page
        showing. A long gap, like a suspend, counts for only a little."""
        if self.world_at is not None and now - self.world_at > 1.0:
            gap = min(now - self.world_at, self.CATCH_UP_MAX)
            self.world.advance(gap * self.time_scale)
        if self.world_at is None or now - self.world_at > 1.0:
            self.world_at = now

    def set_loads(self, loads):
        self.loads = loads

    def _on_tick(self, widget, clock):
        now = clock.get_frame_time()
        if self._t0 is None:
            self._t0 = now
        prev = self.phase
        self.phase = (now - self._t0) / 1_000_000.0
        dt = max(0.0, self.phase - prev)
        self._advance(min(dt, 0.1), dt)
        self.world_at = GLib.get_monotonic_time() / 1_000_000.0
        # Frame-rate independent easing: the same glide at 30 Hz or 144 Hz.
        k = 1.0 - math.exp(-dt * 7.0)
        for cpu, target in self.loads.items():
            cur = self.shown.get(cpu, target)
            self.shown[cpu] = cur + (target - cur) * k

        root = widget.get_root()
        focused = root is not None and root.is_active()
        if focused or self.phase - self.last_draw >= IDLE_REDRAW_S:
            self.last_draw = self.phase
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    @staticmethod
    def _in_box(box, x, y):
        return box is not None and box[0] <= x <= box[2] \
            and box[1] <= y <= box[3]

    def _on_fort(self, x, y):
        return self._in_box(self.fort_box, x, y)

    def _barracks_at(self, x, y):
        for i, box in enumerate(self.barracks_box):
            if self._in_box(box, x, y):
                return i
        return None

    def _on_river(self, x, y):
        r = self.river
        return r is not None and abs(y - self._river_y(x)) <= \
            self._river_half(x) + r["half"] * 0.35 + 1

    def _on_motion(self, _ctl, x, y):
        hot = self._on_fort(x, y) or self._barracks_at(x, y) is not None \
            or (self.on and self._on_river(x, y))
        self.set_cursor_from_name("pointer" if hot else None)

    def _on_click(self, _gesture, n, x, y):
        """A click on a barracks sends out a file of redcoats, a double
        click a wave of cavalry and a cannon. One on the fort has the walker
        sound his bugle the way he faces, and the tower sentry on that side
        kneels and fires, at a redcoat if one is in sight. One on the river
        sends a boatload of redcoats down it, to the nearer ford."""
        i = self._barracks_at(x, y)
        if i is not None:
            self.siege.click_barracks(i, n, self._double_click_s())
            return
        if not self._on_fort(x, y):
            if self.on and self._on_river(x, y):
                self._launch_boat(0 if x < self.river["w"] / 2 else 1)
            return
        self.siege.sound_bugle(1 if self.siege.walker_x()[1] > 0 else 0,
                               self.potshot is not None)

    def _double_click_s(self):
        settings = self.get_settings()
        ms = settings.props.gtk_double_click_time if settings else 400
        return ms / 1000.0

    def _advance(self, dt, elapsed=None):
        """Step the scene: the walker's halts, and the siege, which runs
        the redcoats, the sentries and the gun while the fort is up. The
        valley's clock runs on whether the fort is up or down. elapsed is
        how long the clock really moved, if a stalled frame is stepped by
        only dt."""
        self.world.advance(dt * self.time_scale)
        # The current slows under the winter ice.
        self.current += dt * 0.035 * (1 - 0.7 * self.look["winter"])
        siege = self.siege
        if self.on:
            siege.tick(dt if elapsed is None else elapsed)
        if not self.on:
            if self.wild is not None:
                self._advance_horses(dt)
            return
        siege.advance(dt, self.potshot is not None,
                      lambda: self._advance_afloat(dt))

    def _advance_afloat(self, dt):
        """Between the barracks' calls and the new arrivals: the walker's
        shots at the boats, and the boats themselves."""
        self._advance_potshot(dt)
        self._advance_boats(dt)

    # -- the boats --------------------------------------------------------

    BOAT_MEN = 4        # a steersman and three at the oars
    BOAT_EVERY = (110.0, 140.0)
    BOATS_MAX = 2       # most afloat at once
    LAND_GAP_S = 1.4    # between one man stepping ashore and the next
    ASHORE_S = 0.6      # a man takes this long to step from the bow
    LAND_EVERY = 5      # one boat in this many puts in; the rest row by
    CREW_X = (-64, 45, 8, -28)  # the steersman, then the oars, in the model

    def _launch_boat(self, side):
        """Put a boat in at the upstream edge, bound for side's ford, or
        the other if side's trail does not cross the river."""
        if len(self.boats) >= self.BOATS_MAX:
            return False
        if self.fords[side] is None:
            side = 1 - side
            if self.fords[side] is None:
                return False
        lands = self.boats_sent % self.LAND_EVERY == self.LAND_EVERY - 1
        self.boats.append({"side": side, "x": -self._boat_m(side) * 0.9,
                           "men": self.BOAT_MEN, "landed": None,
                           "next_at": 0.0, "left": None, "adrift": None,
                           "lands": lands, "n": self.boats_sent})
        self.boats_sent += 1
        return True

    def _boat_m(self, side):
        """The size of a man in a boat bound for side's ford: as big as he
        will be stepping ashore there."""
        p = self.fords[side] if self.fords[side] is not None else 0.5
        return self.redcoat_s * self._depth_scale(p)

    def _boat_stop(self, b):
        """Where the boat's middle comes to rest, its bow just short of
        the ford's stones; None if it is not putting in at a ford."""
        p = self.fords[b["side"]]
        if p is None or self.trails is None or not b["lands"] \
                or b["men"] == 0:
            return None
        x = self._bezier(self.trails[b["side"]], p)[0]
        stones = self.redcoat_s * 0.5 * self._depth_scale(p) * 0.9
        return x - stones - self._boat_m(b["side"]) * 0.9

    def _landing_p(self, side):
        """Where on the trail a man from the boat steps ashore: the far
        bank, just up the trail from the ford's stones."""
        p = self.fords[side]
        if p is None:
            return 0.0
        mud = self.river["half"] * 0.35 + 1
        for k in range(60):
            q = max(0.0, p - k * 0.005)
            x, y = self._bezier(self.trails[side], q)
            if y <= self._river_edge(x, -1) - mud or q == 0.0:
                return q
        return q

    def _boat_at(self, b):
        """The boat's waterline (x, y) and how far it has pulled in toward
        the far bank, 0..1."""
        m = self._boat_m(b["side"])
        stop = self._boat_stop(b)
        if b["left"] is not None:
            pull = 1.0 - self._ramp(self.siege.phase - b["left"], 0.0, 2.5)
        elif b["adrift"] is not None:
            t, pull = b["adrift"]
            pull *= 1.0 - self._ramp(self.siege.phase - t, 0.0, 2.5)
        elif stop is None:
            pull = 0.0
        else:
            pull = 1.0 - min(1.0, max(0.0, (stop - b["x"]) / (2.5 * m)))
            pull = pull * pull * (3 - 2 * pull)
        x = b["x"]
        y = self._river_y(x) + self._river_half(x) * (0.1 - 0.55 * pull)
        return x, y, pull

    def _bow(self, b):
        x, y, _ = self._boat_at(b)
        return x + self._boat_m(b["side"]) * 0.75, y

    def _aboard(self, b, k):
        """Where the k-th of the boat's crew sits: (x, waterline)."""
        x, y, _ = self._boat_at(b)
        return x + self.CREW_X[k] * self._boat_m(b["side"]) / 100, y

    def _advance_boats(self, dt):
        """Boats come down the river now and then, alternating fords. Most
        row on past both and away; one in a few pulls in at its ford, its
        men step ashore onto the trail one by one, and the empty boat
        drifts on downstream. One whose crew is shot drifts off too."""
        if self.trails is None or self.river is None:
            return
        self.boat_in -= dt
        if self.boat_in <= 0:
            if self._launch_boat(self.boats_sent % 2):
                self.boat_in = self.BOAT_EVERY[self.boats_sent % 2]
            else:
                self.boat_in = 5.0
        for b in self.boats:
            m = self._boat_m(b["side"])
            v = self.redcoat_s * 0.45
            stop = self._boat_stop(b)
            if b["landed"] is None and stop is not None:
                # Easing in to the bank as it nears the ford.
                v *= max(0.2, min(1.0, (stop - b["x"]) / m))
                b["x"] = min(stop, b["x"] + v * dt)
                if b["x"] >= stop - 0.5:
                    b["landed"] = self.siege.phase
                    b["next_at"] = self.siege.phase + 0.5
            elif b["landed"] is not None and b["men"] > 0:
                if self.siege.phase >= b["next_at"]:
                    self.siege.land(b["side"], Siege.trail_d(
                        self._landing_p(b["side"])), self._bow(b))
                    b["men"] -= 1
                    b["next_at"] += self.LAND_GAP_S
                    if b["men"] == 0:
                        b["left"] = self.siege.phase
            else:
                if b["left"] is not None:
                    v *= 0.3 + 0.7 * self._ramp(self.siege.phase - b["left"],
                                                0.0, 3.0)
                elif b["adrift"] is not None:
                    v *= 0.6
                b["x"] += v * dt
        self.boats = [b for b in self.boats
                      if b["x"] < self.river["w"] + 2 * self._boat_m(
                          b["side"])]
        for f in self.overboard:
            if f["at"] is None and self.siege.phase - f["t0"] >= self.SLUMP_S:
                f["at"] = self._aboard(f["boat"], f["slot"])
        self.overboard = [f for f in self.overboard
                          if self.siege.phase - f["t0"] < self.STAIN_S]

    # -- the walker's shots at the boats ----------------------------------

    POTSHOT_REST = 6.0  # seconds he patrols, at least, between his shots
    SLUMP_S = 0.4       # a man shot in a boat slumps this long...
    OVER_S = 0.5        # ...then goes over the side and under

    def _advance_potshot(self, dt):
        """On patrol, the walker now and then halts to shoot at the nearest
        boat still carrying redcoats down the river; his every shot takes
        a man out of it."""
        ps = self.potshot
        if ps is None:
            if not self.siege.has_walker or self.walker_at is None \
                    or self.siege.men[2]["mode"] != "patrol" \
                    or self.siege.bugling() or self.siege.relief is not None \
                    or self.siege.phase < self.potshot_after:
                return
            wx, wy = self.walker_at
            # Only a boat whose man to be hit will still be in sight when
            # he fires and goes over: no boat rows faster than full speed.
            ahead = self.redcoat_s * 0.45 * (Siege.SHOT_AT + self.SLUMP_S)
            afloat = [b for b in self.boats if b["men"] > 0
                      and b["landed"] is None and 0 <= b["x"]
                      and self._aboard(b, b["men"] - 1)[0] + ahead
                      <= self.river["w"]]
            afloat = [b for b in afloat if self._clear_shot(b)]
            b = min(afloat, key=lambda b: math.hypot(
                b["x"] - wx, self._boat_at(b)[1] - wy), default=None)
            if b is not None:
                self.potshot = {"t0": self.siege.phase, "boat": b,
                                "fired": False, "tau": 0.0}
            return
        # A hungry man's shot drags like his drill.
        ps["tau"] += dt * self.siege.pace(2)
        tau = ps["tau"]
        if tau >= Siege.SHOT_AT and not ps["fired"]:
            ps["fired"] = True
            self._shoot_aboard(ps["boat"])
        if tau >= Siege.DRILL_LEN:
            self.potshot = None
            self.potshot_after = self.siege.phase + self.POTSHOT_REST

    def _clear_shot(self, b):
        """Whether the walker's line of fire at b, as he draws it, passes
        over both tower sentries, their rifles and all, rather than
        through one of them."""
        if self.sentries_at is None:
            return True
        towers, floor, s = self.sentries_at
        wx, wy = self.walker_at
        mx, my = wx, wy - s * 0.92 * 0.52
        bx, by, _ = self._boat_at(b)
        by -= self._boat_m(b["side"]) * 0.3
        for tx in towers:
            for x in (tx - s * 0.5, tx + s * 0.5):
                if min(mx, bx) <= x <= max(mx, bx) and bx != mx:
                    y = my + (by - my) * (x - mx) / (bx - mx)
                    if y > floor - s * 1.4:
                        return False
        return True

    def _shoot_aboard(self, b):
        """One of the boat's crew is hit and goes over the side."""
        if b["men"] <= 0 or not any(o is b for o in self.boats):
            return
        pull = self._boat_at(b)[2]
        b["men"] -= 1
        self.overboard.append({"boat": b, "slot": b["men"], "s":
                               self._boat_m(b["side"]), "t0": self.siege.phase,
                               "at": None, "n": b["n"] * 4 + b["men"]})
        if b["men"] == 0:
            if b["landed"] is None:
                b["adrift"] = (self.siege.phase, pull)
            else:
                b["left"] = self.siege.phase

    @staticmethod
    def _bateau(cr, x, y, s, men, stroke, tilt, flag):
        """A flat-bottomed bateau, bow to the right, sitting on the water at
        (x, y), in the 100-unit model of the men aboard: a steersman at the
        stern and up to three at the oars, who face him as they row. stroke
        is the phase of their stroke; with nobody aboard the oars lie
        shipped and the bow rides a little high. flag is the phase of the
        ensign's flutter."""
        cr.save()
        cr.translate(x, y)
        cr.scale(s / 100.0, s / 100.0)
        cr.rotate(tilt - (0.04 if men == 0 else 0.0))
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        rowers = [(px, -1) for px in CpuView.CREW_X[1:]][:max(0, men - 1)]
        crew = ([(CpuView.CREW_X[0], 1)] if men > 0 else []) + rowers
        # The ensign at the stern.
        cr.set_source_rgb(*STEEL_RGB)
        cr.set_line_width(1.6)
        cr.move_to(-84, -20)
        cr.line_to(-88, -58)
        cr.stroke()
        wave = math.sin(flag) * 3
        cr.set_source_rgb(*COAT_RGB)
        cr.move_to(-88, -58)
        cr.curve_to(-96, -60 + wave, -104, -54 - wave, -110, -56 + wave)
        cr.line_to(-108, -44 + wave)
        cr.curve_to(-102, -42 - wave, -96, -48 + wave, -87, -46)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*KIT_RGB)
        cr.set_line_width(1.4)
        cr.move_to(-88, -52)
        cr.line_to(-109, -50 + wave)
        cr.stroke()
        # Men from the waist up, seated below the gunwale.
        for px, face in crew:
            cr.save()
            cr.translate(px, 32)
            cr.scale(face, 1)
            CpuView._rc_upper(cr)
            cr.restore()
        # The hull: raked bow and stern, a pale strake under the gunwale.
        cr.move_to(-92, -24)
        cr.curve_to(-80, -14, -60, -12, 0, -12)
        cr.curve_to(60, -12, 80, -14, 94, -26)
        cr.line_to(72, 5)
        cr.line_to(-70, 5)
        cr.close_path()
        cr.set_source_rgb(*HULL_RGB)
        cr.fill_preserve()
        cr.set_source_rgb(*SEAM_RGB)
        cr.set_line_width(1.5)
        cr.stroke()
        cr.set_source_rgb(*HULL_HI_RGB)
        cr.set_line_width(2.5)
        cr.move_to(-86, -18)
        cr.curve_to(-70, -9, -50, -8, 0, -8)
        cr.curve_to(50, -8, 72, -9, 88, -20)
        cr.stroke()
        cr.set_source_rgba(*WATER_HI_RGB, 0.6)
        cr.set_line_width(1.6)
        cr.move_to(-74, 4)
        cr.line_to(76, 4)
        cr.stroke()
        if men == 0:
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.set_line_width(3)
            for k in range(3):
                cr.move_to(-50 + k * 6, -15 - k * 2)
                cr.line_to(56 + k * 4, -15 - k * 2)
            cr.stroke()
        for k, (px, face) in enumerate(crew):
            if face > 0:
                # The steersman's long oar, trailing astern.
                cr.set_source_rgb(*RIFLE_WOOD_RGB)
                cr.set_line_width(3)
                cr.move_to(px + 8, -20)
                cr.line_to(-112, 6)
                cr.stroke()
                hand = (px + 8, -20)
            else:
                # Feathered back above the water, then pulled through it.
                ang = stroke + k * 0.15
                blade = (px + 34 + 22 * math.cos(ang),
                         4 if math.sin(ang) > 0 else -8)
                pivot = (px + 12, -13)
                hand = (pivot[0] - (blade[0] - pivot[0]) * 0.35,
                        pivot[1] - (blade[1] - pivot[1]) * 0.35 - 8)
                cr.set_source_rgb(*RIFLE_WOOD_RGB)
                cr.set_line_width(3)
                cr.move_to(*hand)
                cr.line_to(*blade)
                cr.stroke()
                cr.save()
                cr.translate(*blade)
                cr.rotate(math.atan2(blade[1] - hand[1], blade[0] - hand[0]))
                cr.scale(9, 3)
                cr.arc(0, 0, 1, 0, 2 * math.pi)
                cr.restore()
                cr.fill()
                if blade[1] > 0:
                    cr.set_source_rgba(1, 1, 1, 0.6)
                    cr.arc(blade[0] - 8, 1, 3, 0, 2 * math.pi)
                    cr.fill()
            cr.set_source_rgb(*COAT_RGB)
            cr.set_line_width(6)
            cr.move_to(px + face * 3, -2)
            cr.line_to(*hand)
            cr.stroke()
            cr.set_source_rgb(*SKIN_RGB)
            cr.arc(*hand, 3, 0, 2 * math.pi)
            cr.fill()
        cr.restore()

    def _draw_boats(self, cr):
        for f in self.overboard:
            self._draw_splash(cr, f)
        for b in self.boats:
            x, y, pull = self._boat_at(b)
            m = self._boat_m(b["side"])
            slope = self._river_y(x + 6) - self._river_y(x - 6)
            rowing = b["landed"] is None and pull < 0.9
            stroke = self.phase * 3.2 + b["n"] if rowing else 1.6
            if b["landed"] is None or b["men"] == 0:
                # A wake spreading behind.
                cr.set_source_rgba(*WATER_HI_RGB, 0.35)
                cr.set_line_width(1.2)
                for side in (-1, 1):
                    cr.move_to(x - m * 0.8, y + m * 0.02)
                    cr.line_to(x - m * 1.8, y + side * m * 0.12)
                cr.stroke()
            self._bateau(cr, x, y, m, b["men"], stroke,
                         math.atan2(slope, 12), self.phase * 4 + b["n"])
        for f in self.overboard:
            self._draw_overboard(cr, f)

    def _overboard_at(self, f):
        """Where the shot man sits, or sat: (x, waterline)."""
        return f["at"] or self._aboard(f["boat"], f["slot"])

    def _draw_overboard(self, cr, f):
        """The man slumps where he sat, then tips forward over the near
        gunwale, in front of the hull, and down into the water."""
        e = self.siege.phase - f["t0"]
        over = self._ramp(e, self.SLUMP_S, self.SLUMP_S + self.OVER_S)
        if over >= 1.0:
            return
        x, y = self._overboard_at(f)
        face = 1 if f["slot"] == 0 else -1
        cr.save()
        cr.translate(x, y)
        cr.scale(f["s"] / 100.0, f["s"] / 100.0)
        # Below the gunwale while he sits, below the water once over it.
        cr.rectangle(-300, -300, 600, 288 + 30 * over)
        cr.clip()
        cr.translate(face * 14 * over, 32 + 62 * over * over)
        cr.translate(0, -42)
        cr.rotate(face * (0.45 * self._ramp(e, 0.0, self.SLUMP_S)
                          + 1.1 * over))
        cr.translate(0, 42)
        cr.scale(face, 1)
        self._rc_upper(cr)
        cr.restore()

    def _draw_splash(self, cr, f):
        """Where he went in: a splash, rings and a little blood spreading
        on the water and drifting downstream."""
        if f["at"] is None:
            return
        e = self.siege.phase - f["t0"] - self.SLUMP_S - self.OVER_S * 0.6
        if e < 0:
            return
        x, y = f["at"]
        m = f["s"]
        face = 1 if f["slot"] == 0 else -1
        x += face * m * 0.14 + m * 0.12 * e
        y += m * 0.3
        fade = 1.0 - max(0.0, e - self.STAIN_S * 0.5) / (self.STAIN_S * 0.4)
        if fade > 0:
            cr.save()
            cr.translate(x, y)
            cr.scale(1.0, 0.3)
            cr.arc(0, 0, m * 0.3 * min(1.0, 0.3 + e * 0.6), 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgba(*BLOOD_RGB, 0.55 * fade)
            cr.fill()
        if e < 1.5:
            cr.set_source_rgba(*WATER_HI_RGB, 0.7 * (1 - e / 1.5))
            cr.set_line_width(max(0.6, m * 0.02))
            for k in range(2):
                r = m * (0.15 + 0.35 * e) * (1 - 0.35 * k)
                cr.save()
                cr.translate(x, y)
                cr.scale(1.0, 0.3)
                cr.arc(0, 0, r, 0, 2 * math.pi)
                cr.restore()
                cr.stroke()
        if e < 0.8:
            cr.set_source_rgba(*WATER_HI_RGB, 0.85 * (1 - e / 0.8))
            for k in range(7):
                a = -math.pi * (0.15 + 0.7 * k / 6)
                v = m * (0.5 + 0.2 * ((k + f["n"]) % 3))
                cr.arc(x + math.cos(a) * v * e,
                       y + math.sin(a) * v * e + m * 2.0 * e * e,
                       max(0.6, m * 0.035), 0, 2 * math.pi)
                cr.fill()

    # -- helpers ----------------------------------------------------------

    @staticmethod
    def _glow(cr, x, y, radius, rgb, alpha):
        if radius <= 0 or alpha <= 0:
            return
        grad = cairo.RadialGradient(x, y, 0, x, y, radius)
        grad.add_color_stop_rgba(0.0, *rgb, alpha)
        grad.add_color_stop_rgba(0.5, *rgb, alpha * 0.3)
        grad.add_color_stop_rgba(1.0, *rgb, 0.0)
        cr.set_source(grad)
        cr.arc(x, y, radius, 0, 2 * math.pi)
        cr.fill()

    @staticmethod
    def _rounded(cr, x, y, w, h, r):
        r = min(r, w / 2, h / 2)
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    @staticmethod
    def _text(cr, x, y, text, size, alpha, bold=False, align="center"):
        """Text with its baseline at y, centred on x or starting there;
        returns how far it runs."""
        cr.select_font_face("Cantarell", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold
                            else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        ext = cr.text_extents(text)
        left = x - ext.x_bearing if align == "left" \
            else x - ext.width / 2 - ext.x_bearing
        cr.move_to(left, y)
        cr.set_source_rgba(1, 1, 1, alpha)
        cr.show_text(text)
        return ext.x_advance

    # -- the fort ---------------------------------------------------------

    @staticmethod
    def _stake(cr, x, bottom, w, top, pointed):
        """One upright log, sharpened or flat, with a highlight and seam."""
        tip = w * 0.6 if pointed else 0.0
        cr.move_to(x, bottom)
        cr.line_to(x, top + tip)
        if pointed:
            cr.line_to(x + w / 2, top)
        cr.line_to(x + w, top + tip)
        cr.line_to(x + w, bottom)
        cr.close_path()
        cr.set_source_rgb(*WOOD_RGB)
        cr.fill_preserve()
        cr.set_source_rgb(*SEAM_RGB)
        cr.set_line_width(max(0.8, w * 0.08))
        cr.stroke()
        cr.set_source_rgba(*WOOD_HI_RGB, 0.8)
        cr.rectangle(x + w * 0.18, top + tip + w * 0.2, w * 0.16,
                     max(0.0, bottom - top - tip - w * 0.4))
        cr.fill()

    def _wall(self, cr, x0, x1, bottom, top, stake_w, pointed):
        n = max(1, round((x1 - x0) / stake_w))
        w = (x1 - x0) / n
        for i in range(n):
            # Every other stake a little taller, like hand-cut logs.
            lift = stake_w * 0.25 if (i % 2 and pointed) else 0.0
            self._stake(cr, x0 + i * w, bottom, w, top - lift, pointed)

    WALL_PIECES = 10    # logs stacked up each of a side wall's two columns

    @classmethod
    def _wall_piece_state(cls, strength, j, col):
        """How the log j up from the foot of a side wall's column col (0
        the outer one) stands at this strength: 0 whole, 1 splintered
        and shortened, 2 leaning, 3 fallen. Blows land low and outside
        first, so the damage creeps up the wall."""
        hit = ((j * 7 + col * 3 + 1) * 0.618034) % 1.0
        rank = 0.55 * j / (cls.WALL_PIECES - 1) + 0.35 * hit + 0.1 * col
        u = (1.0 - strength) * 1.1 - rank * 0.75
        return 0 if u <= 0 else 1 if u < 0.18 else 2 if u < 0.45 else 3

    def _side_wall(self, cr, side, x, wall, top, bottom):
        """A side wall, seen end-on as a column of two stacks of logs. As
        it is hurt, logs splinter and shorten, then lean, then fall,
        leaving a gap; it reads by shape, not by colour."""
        strength = self.siege.wall[side]
        n = self.WALL_PIECES
        w = wall / 2
        sh = (bottom - top) / n
        fallen = 0
        for col in (1, 0):
            cx = x + (col if side == 0 else 1 - col) * w
            for j in range(n):
                state = self._wall_piece_state(strength, j, col)
                y1 = bottom - j * sh
                if state == 3:
                    fallen += 1
                    continue
                cr.save()
                h = sh * (1.0, 0.8, 0.68)[state]
                if state == 2:
                    lean = (0.5 if (j + col) % 2 else -0.4)
                    cr.translate(cx + w / 2, y1)
                    cr.rotate(lean)
                    cr.translate(-(cx + w / 2), -y1)
                cr.move_to(cx, y1)
                if state == 0:
                    cr.line_to(cx, y1 - h)
                    if j == n - 1:
                        cr.line_to(cx + w / 2, y1 - h - w * 0.6)
                    cr.line_to(cx + w, y1 - h)
                else:
                    # A ragged break across the top.
                    cr.line_to(cx, y1 - h)
                    for k in range(1, 5):
                        cr.line_to(cx + w * k / 4, y1 - h
                                   - (w * 0.45 if k % 2 else 0.0)
                                   + (w * 0.15 if j % 2 else 0.0))
                cr.line_to(cx + w, y1)
                cr.close_path()
                cr.set_source_rgb(*WOOD_RGB)
                cr.fill_preserve()
                cr.set_source_rgb(*SEAM_RGB)
                cr.set_line_width(max(0.8, w * 0.08))
                cr.stroke()
                cr.set_source_rgba(*WOOD_HI_RGB, 0.8)
                cr.rectangle(cx + w * 0.18, y1 - h + w * 0.25, w * 0.16,
                             max(0.0, h - w * 0.5))
                cr.fill()
                cr.restore()
        # The fallen lie in a heap at the foot, a log each.
        for k in range(min(fallen, 8)):
            cr.save()
            cr.translate(x + wall / 2 + (k % 2 - 0.5) * wall * 0.3,
                         bottom - (k // 2 + 0.5) * w * 0.55)
            cr.rotate(0.12 * ((k % 3) - 1))
            self._rounded(cr, -wall * 0.5, -w * 0.25, wall, w * 0.5,
                          w * 0.25)
            cr.set_source_rgb(*WOOD_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(0.8, w * 0.08))
            cr.stroke()
            cr.restore()

    def _blockhouse(self, cr, x, y, w, h):
        """A square log tower; y is its floor, where a sentry stands."""
        logs = 4
        lh = h / logs
        for i in range(logs):
            self._rounded(cr, x - lh * 0.15, y + i * lh, w + lh * 0.3, lh,
                          lh / 2)
            cr.set_source_rgb(*WOOD_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(0.8, lh * 0.1))
            cr.stroke()
        # A loophole for the long rifle.
        cr.set_source_rgb(*SEAM_RGB)
        cr.rectangle(x + w * 0.42, y + lh * 1.3, w * 0.16, lh * 0.5)
        cr.fill()
        cr.rectangle(x - lh * 0.35, y - lh * 0.35, w + lh * 0.7, lh * 0.4)
        cr.set_source_rgb(*WOOD_HI_RGB)
        cr.fill()

    def _gate(self, cr, cx, bottom, top, w):
        """Shut while the fort is up; swung open while it is down."""
        cr.set_source_rgba(0.02, 0.02, 0.05, 0.9)
        cr.rectangle(cx - w / 2, top, w, bottom - top)
        cr.fill()
        half = w / 2
        if self.on:
            for side in (-1, 1):
                x = cx - half if side < 0 else cx
                self._stake(cr, x, bottom, half, top, False)
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(1.2, w * 0.06))
            cr.move_to(cx - half * 0.9, top + (bottom - top) * 0.2)
            cr.line_to(cx + half * 0.9, bottom - (bottom - top) * 0.15)
            cr.move_to(cx + half * 0.9, top + (bottom - top) * 0.2)
            cr.line_to(cx - half * 0.9, bottom - (bottom - top) * 0.15)
            cr.stroke()
        else:
            # Doors swung outward, seen edge-on: two slanted planks.
            for side in (-1, 1):
                hinge = cx + side * half
                cr.move_to(hinge, top)
                cr.line_to(hinge + side * half * 0.45, top + w * 0.15)
                cr.line_to(hinge + side * half * 0.45, bottom + w * 0.15)
                cr.line_to(hinge, bottom)
                cr.close_path()
                cr.set_source_rgb(*WOOD_RGB)
                cr.fill_preserve()
                cr.set_source_rgb(*SEAM_RGB)
                cr.set_line_width(1.0)
                cr.stroke()

    @staticmethod
    def _mountain_man(cr, x, feet, s, facing, step=0.0, shouldered=False,
                      glint=0.0, kneel=0.0, aim=0.0, shot=-1.0, bugle=0.0,
                      toot=-1.0, elev=0.04, beaver=False, axe=0.0,
                      log=False, knife=0.0, sit=0.0, eat=-1.0):
        """A buckskin-clad mountain man with a coonskin cap and a long rifle.

        Drawn in a 100-unit-tall model with the feet at 0; facing is +1 for
        right, -1 for left. The rifle stands taller than he does. kneel and
        aim run 0..1 from standing at ease; shot is the seconds since he
        fired, or negative if he has not. bugle runs 0..1 from his hip to
        his lips, and toot is the seconds since he began to blow it. elev is
        how far above level, in radians, he aims. beaver slings one over
        his shoulder, hanging down his back, and log carries one on it.
        axe above 0 puts an axe in his hands instead, raised behind him at
        1 and swung through at 0, with the rifle slung across his back.
        knife above 0 likewise slings the rifle and puts a knife in his
        near hand, thrust out at 1. sit runs 0..1 as he sits on the
        ground with his rifle stood beside him; eat, once he is sitting, is
        the seconds he has been at his jerky and steaming tin cup.
        """
        cr.save()
        cr.translate(x, feet)
        cr.scale(facing * s / 100.0, s / 100.0)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        drop = 20 * kneel + 30 * sit

        def lerp(a, b, u):
            return (a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u)

        def leg(swing, rgb, front):
            fx = math.sin(swing) * 40
            # Kneeling, the front knee juts forward and the back one rests
            # on the ground with the shin trailing behind.
            knee = lerp((fx / 2, -24), (20, -26) if front else (-4, -5),
                        kneel)
            foot = lerp((fx, -2), (21, -2) if front else (-26, -3), kneel)
            if sit > 0:
                knee = lerp(knee, (22, -22) if front else (14, -20), sit)
                foot = lerp(foot, (30, -2) if front else (22, -2), sit)
            cr.set_source_rgb(*rgb)
            cr.set_line_width(8)
            cr.move_to(0, -46 + drop)
            cr.line_to(*knee)
            cr.line_to(*foot)
            cr.stroke()
            cr.set_source_rgb(*SEAM_RGB)
            cr.save()
            cr.translate(foot[0] + 3, foot[1] + 0.5)
            cr.scale(6, 2.6)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()

        # The long rifle swings from butt-on-the-ground to butt-at-the-
        # shoulder, and kicks back a little when it fires.
        kick = max(0.0, 1.0 - shot / 0.25) if shot >= 0 else 0.0

        def rifle_pose(aim, drop, kick):
            butt = lerp((16, -1), (-2 - 4 * kick, -72 + drop), aim)
            return butt, aim * (math.pi / 2 - elev) - 0.08 * kick

        def along(pose, dist):
            (bx, by), ang = pose
            return bx + math.sin(ang) * dist, by - math.cos(ang) * dist

        pose = rifle_pose(aim, drop, kick)

        def rifle():
            (bx, by), ang = pose
            cr.save()
            cr.translate(bx, by)
            cr.rotate(ang)
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.move_to(-3, 0)
            cr.line_to(3, 0)
            cr.line_to(1.5, -31)
            cr.line_to(-1, -31)
            cr.close_path()
            cr.fill()
            cr.set_source_rgb(*STEEL_RGB)
            cr.set_line_width(2.2)
            cr.move_to(0.2, -31)
            cr.line_to(0.2, -127)
            cr.stroke()
            cr.restore()
            return along(pose, 127)

        def rifle_shouldered():
            # Stock in his hand at the hip, barrel over the shoulder.
            angle = 1.05
            cr.set_source_rgb(*RIFLE_WOOD_RGB)
            cr.save()
            cr.translate(9, -56)
            cr.rotate(angle)
            cr.rectangle(-3, -3, 28, 6)
            cr.fill()
            cr.set_source_rgb(*STEEL_RGB)
            cr.set_line_width(2.2)
            cr.move_to(-2, 0)
            cr.line_to(-82, 0)
            cr.stroke()
            cr.restore()
