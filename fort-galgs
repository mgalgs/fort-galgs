    assert [hp for hp, _, _ in shots] == [1, 1, 0], shots
    assert all(abs(chip - at) < 0.1 for _, chip, at in shots[:2]), shots
    assert rc["hit"] is not None and rc["hid"] is not None, "shot in cover"
    # No boulder beside the trail, no cover.
