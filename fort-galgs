    every = [cpu for core in SAMPLE_STATE["cores"] for cpu in core["cpus"]]
    for reserved, on in ((SAMPLE_STATE["reserved"], True), (every, True),
                         (SAMPLE_STATE["reserved"], False), (every, False)):
        view.set_state(SAMPLE_STATE["cores"], reserved, on)
        for size in ((60, 40), (300, 220), (1, 1)):
            view._draw(view, cr, *size)
            for _ in range(5 * 30):
                view.phase += 1 / 30
                view._advance(1 / 30)
            view._launch_boat(0)
            view._draw(view, cr, *size)
            assert (view.scenery if on else view.wild) is not None, size
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    view._draw(view, cr, 1024, 680)
    trees = list(view.wild["trees"])
    view.phase += 1.0
    view._draw(view, cr, 1024, 680)
    assert trees and view.wild["trees"] == trees, "the woods hold still"
    for x, base, h, kind, i in trees:
        assert not view._in_box(view.wild["grove"], x, base), (x, base)
        assert abs(base - view._river_y(x)) > view._river_half_max(x), \
            (x, base)

    more = envelope((5, 6, 7, 8), 4)
    trapper_tests(view, cr, rows, more)
    bear_tests(view, cr, rows, more)

    # The almanac prints a row a season, headless, touching no state file.
    with tempfile.TemporaryDirectory() as tmp:
        old = os.environ.get("XDG_STATE_HOME")
        os.environ["XDG_STATE_HOME"] = tmp
        try:
            buf = io.StringIO()
            almanac(1, seed=2, out=buf)
            assert parse_args(["--almanac", "3"])["almanac"] == 3
            assert parse_args(["--almanac", "3", "--seed", "5"])["seed"] == 5
        finally:
            if old is None:
                del os.environ["XDG_STATE_HOME"]
            else:
                os.environ["XDG_STATE_HOME"] = old
        assert not os.listdir(tmp), os.listdir(tmp)
    lines = buf.getvalue().splitlines()
    assert len(lines) == 5, lines
    for word in ("season", "beavers", "dams", "lodges", "trappers", "bears",
                 "cabins", "pelts", "trees", "deaths", "arrivals", "fights"):
        assert word in lines[0], word
    assert [ln.split()[0] for ln in lines[1:]] == list(World.SEASONS)

    # The siege report runs headless too: a row a minute and a total, in
    # which redcoats were sent and some were shot.
    buf = io.StringIO()
    siege_report(3, seed=2, out=buf)
    assert parse_args(["--siege", "3"])["siege"] == 3
    assert parse_args(["--siege", "3", "--seed", "5"])["seed"] == 5
    lines = buf.getvalue().splitlines()
    assert len(lines) == 2 + 3 + 1, lines
    assert "no boats" in lines[0]
    for word in ("minute", "sent", "shot", "wall", "blasted", "gun calls"):
        assert word in lines[1], word
    assert [ln.split()[0] for ln in lines[2:]] == ["1", "2", "3", "total"]
    sent, shot = lines[-1].split()[1:3]
    assert sum(map(int, sent.split("/"))) >= 5 and int(shot) >= 1, lines[-1]

    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
    view.boats, view.potshot = [], None
    for facing, phase in ((1, 0.0), (-1, 10.0)):
        view.siege.bugle_at = None
        view.phase = view.siege.phase = phase
        view.siege.patrol_u = 0.3 if facing > 0 else 1.3
        view._draw(view, cr, 1024, 680)
        assert view.siege.walker_x()[1] == facing
        view._on_click(None, 1, 0, 0)  # empty sky
        assert not view.siege.bugling()
        x0, y0, x1, y1 = view.fort_box
        view._on_click(None, 1, (x0 + x1) / 2, (y0 + y1) / 2)
        assert view.siege.bugling(), "a click on the fort sounds the bugle"
        for view.phase in (phase + 0.2, phase + 0.9, phase + 1.8):
            view.siege.phase = view.phase
            view._draw(view, cr, 1024, 680)
        view.phase = view.siege.phase = phase + Siege.BUGLE_HEARD + 2.05
        side = 1 if facing > 0 else 0
        assert view.siege.drill(side)[2] >= 0, "the sentry he faces fires"

    # Some minutes of siege, with no picture: redcoats come, the sentries
    # shoot each one well before he reaches the fort, and nobody is left
    # standing at its foot.
    siege = Siege()
    siege.wave_in = 1e9  # foot alone; the rest come below
    hits, closest, hid = set(), 0.0, False
    for frame in range(150 * 30):
        siege.run(1 / 30)
        for rc in siege.redcoats:
            hid |= rc.get("hid") is not None
            if rc["hit"] is None:
                closest = max(closest, Siege.trail_p(rc["d"]))
            else:
                hits.add(rc["n"])
    assert len(hits) >= 10, hits
    assert hid, "a redcoat under fire takes cover"
    assert closest < 0.9, f"a redcoat got to {closest:.2f} of the trail"
    assert siege.tally["shot"] >= 10 and siege.tally["sent"]["foot"] >= 10
    assert sum(siege.tally["sent"].values()) == siege.spawned
    assert siege.tally["reached"] == 0, "none got to the wall"

    # The same siege drawn: the picture runs the rules and draws what it
    # finds, the redcoats, their blood and the boulders among them.
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
    view.siege.wave_in = view.boat_in = 1e9

    def run(seconds, every=15):
        for frame in range(int(seconds * 30)):
            view.phase += 1 / 30
            view._advance(1 / 30)
            if frame % every == 0:
                view._draw(view, cr, 1024, 680)

    run(60, 15)
    assert view.siege.spawned >= 5 and view.siege.phase > 59, view.siege.phase

    # A click on a barracks sends out a file, once a double click could no
    # longer come; a double click sends a wave and no file.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    before = siege.spawned
    siege.click_barracks(0, 1, 0.4)
    siege.run(0.3)
    assert not siege.called[0], "a lone click waits out the double click"
    siege.run(12)
    assert not siege.called[0] and siege.spawned - before == 3
    siege.click_barracks(0, 1, 0.4)
    siege.click_barracks(0, 2, 0.4)
    assert siege.called[0] == list(Siege.WAVE) and siege.pending_call is None
    cannons = []
    for _ in range(150):
        siege.run(1)
        cannons += [rc for rc in siege.redcoats
                    if rc["kind"] != "foot" and rc not in cannons]
    assert not any("rock" in rc for rc in cannons), "only foot take cover"
    cannons = [rc for rc in cannons if rc["kind"] == "cannon"]
    assert not siege.called[0] and len(cannons) == 1, cannons
    assert cannons[0]["hp"] == 0, "the cannon takes five hits"
    assert not any(rc["kind"] != "foot" for rc in siege.redcoats
                   if rc["hit"] is None), "the sentries see off the wave"
    assert siege.tally["sent"]["horse"] == 3
    assert siege.tally["sent"]["cannon"] == 1
    # The view only translates the click.
    view.siege.pending_call = None
    x0, y0, x1, y1 = view.barracks_box[0]
    mid = ((x0 + x1) / 2, (y0 + y1) / 2)
