class UsageRow(Gtk.Box):
    def __init__(self, icon, title, fort):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.append(Gtk.Image(icon_name=icon, pixel_size=20,
                              valign=Gtk.Align.CENTER))
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1,
                       hexpand=True)
        head = Gtk.Box(spacing=8)
        head.append(Gtk.Label(label=title, xalign=0.0, hexpand=True,
                              css_classes=["gm-row-title"]))
        self.value = Gtk.Label(label="–", xalign=1.0,
                               css_classes=["gm-row-value"])
        head.append(self.value)
        text.append(head)
        self.bar = Gtk.LevelBar(min_value=0.0, max_value=1.0,
                                css_classes=["gm-game" if fort else "gm-rest"])
        # Without this GTK paints high fills with its own warning colours.
        for name in ("low", "high", "full"):
            self.bar.remove_offset_value(name)
        text.append(self.bar)
        self.note = Gtk.Label(label="", xalign=0.0, css_classes=["gm-row-note"])
        text.append(self.note)
        self.append(text)

    def update(self, cpus, total, note):
        self.value.set_label(f"{cpus:4.1f} CPUs")
        self.bar.set_value(min(1.0, cpus / total) if total else 0.0)
        self.note.set_label(note)


