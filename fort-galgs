class FortWindow(Adw.ApplicationWindow):
    def __init__(self, app, state_path=None, time_scale=1.0):
        super().__init__(title="Fort Galgs")
        if app is not None:
            self.set_application(app)
        self.set_default_size(560, 900)
        self.state = None
        self.busy = False
        self.cpus = CpuSampler()
        self.groups = GroupSampler()
        self.app_cpu = GroupSampler()

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=220)
        self.stack.add_named(self._build_loading(), "loading")
        self.stack.add_named(self._build_home(), "home")
        self.stack.add_named(self._build_error(), "error")
        self.view.time_scale = time_scale
        # Without a path (the self-test) the world is never read or kept.
        self.state_path = state_path
        self.save_id = 0
        if state_path:
            self.view.set_world(load_world(state_path))
            self.save_id = GLib.timeout_add_seconds(60, self._save_world)
        self.clock_id = GLib.timeout_add_seconds(1, self._world_clock)

        header = Adw.HeaderBar(css_classes=["flat"])
        header.set_title_widget(Adw.WindowTitle(title="Fort Galgs",
                                                subtitle=os.uname().nodename))
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(self.stack)
        toolbar.add_css_class("gm-root")
        self.set_content(toolbar)

        self.sample_id = GLib.timeout_add(SAMPLE_MS, self._sample)
        self.status_id = GLib.timeout_add_seconds(STATUS_EVERY_S,
                                                  self._poll_status)
        self.connect("close-request", self._on_close)

    def _on_close(self, _win):
        for source in (self.sample_id, self.status_id, self.save_id,
                       self.clock_id):
            if source:
                GLib.source_remove(source)
        self.sample_id = self.status_id = self.save_id = self.clock_id = 0
        self._save_world()
        return False

    def _world_clock(self):
        self.view.catch_up(GLib.get_monotonic_time() / 1_000_000.0)
        return GLib.SOURCE_CONTINUE

    def _save_world(self):
        if self.state_path:
            try:
                save_world(self.view.world, self.state_path)
            except OSError as e:
                print(f"could not keep the valley: {e}", file=sys.stderr)
        return GLib.SOURCE_CONTINUE

