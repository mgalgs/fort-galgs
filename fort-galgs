def self_test():
    """Build every page and draw every state against a real surface.

    Cairo draws that are wrong mostly paint nothing rather than raise, so
    this proves the code paths run, not that the picture looks right.
    """
    Adw.init()
    load_css()
    win = FortWindow(None)
    for name in ("loading", "home", "error"):
        win.stack.set_visible_child_name(name)
        assert win.stack.get_visible_child_name() == name, name

    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, 520, 260)
    cr = cairo.Context(surface)
    for mode in ("on", "off", "partial"):
        for delegated in (True, False):
            for apps in (SAMPLE_STATE["apps"], []):
                st = dict(SAMPLE_STATE, mode=mode, apps=apps,
                          cpuset_delegated=delegated)
                win.apply_state(st)
                win._update_rows()
                win.app_list.set_cpu({})
                assert win.hero.get_label()
                win.view.shown = {c: (c % 7) / 6 for c in range(20)}
                for win.view.phase in (0.0, 0.7, 3.3, 11.3, 13.05, 14.5):
                    win.view._draw(win.view, cr, 520, 260)
    win.view._draw(win.view, cr, 60, 40)  # drives every clamp

    view = win.view
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
    for facing, phase in ((1, 0.0), (-1, 10.0)):
        view.bugle_at = None
        view.phase = phase
        view._draw(view, cr, 1024, 680)
        assert view.walker_facing == facing, (facing, view.walker_facing)
        view._on_click(None, 1, 0, 0)  # empty sky
        assert not view._bugling()
        x0, y0, x1, y1 = view.fort_box
        view._on_click(None, 1, (x0 + x1) / 2, (y0 + y1) / 2)
        assert view._bugling(), "a click on the fort sounds the bugle"
        for view.phase in (phase + 0.2, phase + 0.9, phase + 1.8):
            view._draw(view, cr, 1024, 680)
        view.phase = phase + view.BUGLE_HEARD + 2.05
        side = 1 if facing > 0 else 0
        assert view._drill(side)[2] >= 0, "the sentry he faces fires"

    # Two minutes of siege: redcoats come, the sentries shoot each one well
    # before he reaches the fort, and nobody is left standing at its foot.
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
    view.bugle_at = None
    view.wave_in = 1e9  # foot alone; the waves are tried below

    def run(seconds, every=15):
        for frame in range(int(seconds * 30)):
            view.phase += 1 / 30
            view._advance(1 / 30)
            if frame % every == 0:
                view._draw(view, cr, 1024, 680)

    view.phase, hits, closest = 0.0, set(), 0.0
    for frame in range(120 * 30):
        run(1 / 30, 1 if frame % 15 == 0 else 2)
        for rc in view.redcoats:
            if rc["hit"] is None:
                closest = max(closest, view._trail_p(rc["d"]))
            else:
                hits.add(rc["n"])
    assert len(hits) >= 10, hits
    assert closest < 0.9, f"a redcoat got to {closest:.2f} of the trail"

    # A click on a barracks sends out a file, once a double click could no
    # longer come; a double click sends a wave and no file.
    x0, y0, x1, y1 = view.barracks_box[0]
    mid = ((x0 + x1) / 2, (y0 + y1) / 2)
    before = view.spawned
    view._on_click(None, 1, *mid)
    assert not view.called[0], "a lone click waits out the double click"
    run(12)
    assert not view.called[0] and view.spawned - before >= 3
    view._on_click(None, 1, *mid)
    view._on_click(None, 2, *mid)
    assert view.called[0] == list(view.WAVE) and view.pending_call is None
    cannons = []
    for _ in range(150):
        run(1, 10)
        cannons += [rc for rc in view.redcoats
                    if rc["kind"] == "cannon" and rc not in cannons]
    assert not view.called[0] and len(cannons) == 1, cannons
    assert cannons[0]["hp"] == 0, "the cannon takes five hits"
    assert not any(rc["kind"] != "foot" for rc in view.redcoats
                   if rc["hit"] is None), "the sentries see off the wave"

    # Whoever reaches the wall beats on it, and is drawn doing so.
    for kind in ("foot", "horse", "cannon"):
        view.redcoats.append({"side": 0, "d": 1.05, "hit": None, "n": 99,
                              "born": 0.0, "kind": kind, "hp": 1,
                              "struck": None, "at_wall": None, "slot": 0})
    view.drill_start = [view.phase, view.phase]  # hold fire a moment
    run(1.5, 3)
    assert all(rc["at_wall"] is not None for rc in view.redcoats
               if rc["n"] == 99), "they reach the wall"
    slots = sorted(rc["slot"] for rc in view.redcoats if rc["n"] == 99)
    assert slots == sorted(set(slots)), f"one place each: {slots}"

    # With redcoats at his wall, the tower sentry calls for the gun, and
    # its ball clears them off.
    view.redcoats = [rc for rc in view.redcoats if rc["n"] == 99]
    view.called = [[], []]
    view.spawn_in = view.wave_in = 1e9
    view.drill_start = [None, None]
    view.relief = None
    run(0.2, 1)
    assert view.relief and view.relief["side"] == 0 and view._calling(0)
    run(view.RELIEF_LEN, 3)
    assert view.relief is None
    assert not any(view._at_wall(rc) for rc in view.redcoats
                   if rc["hit"] is None), "the gun clears the wall"
    assert view.gun_at == view.GUN_POST[0], "the gun stays where wheeled"
    assert view.stains, "the fallen leave blood"

    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    assert not view.redcoats and not view.called[0], "standing down clears"

    win.apply_state(SAMPLE_STATE)
    assert win.banner.get_revealed() and win.banner_action is None
    stray = [dict(a, inside=False) if a["always"] else a
             for a in SAMPLE_STATE["apps"]]
    win.apply_state(dict(SAMPLE_STATE, apps=stray))
    assert win.banner.get_revealed() and win.banner_action == "on"
    win.apply_state(dict(SAMPLE_STATE, mode="off"))
    assert not win.banner.get_revealed()
    assert win.toggle_title.get_label() == "Raise the fort"

    groups = group_apps(SAMPLE_STATE["apps"])
    assert any(groups[0]["inside"]), "apps in the fort sort first"
    assert not any(groups[-1]["inside"]), groups[-1]
    rows = win.app_list.rows
    assert len(rows) == len(groups), (len(rows), len(groups))
    assert any(g["always"] for g in groups)
    for row in rows.values():
        assert row.pin.get_sensitive(), row.group["title"]
        assert row.pin.get_active() == row.group["always"]

    lst = win.app_list
    for box in (lst.main, lst.others):
        shown = lst._shown(box)
        if not shown:
            continue  # no .desktop entry for the sample apps on this machine
        busy = shown[-1]
        lst.cpu = {key: 0.0 for key in lst.rows}
        lst.cpu[busy.group["key"]] = 9.0
        lst._sort()
        after = lst._shown(box)
        inside = [any(r.group["inside"]) for r in after]
        assert inside == sorted(inside, reverse=True), "the fort's apps lead"
        assert [r for r in after if any(r.group["inside"])
                == any(busy.group["inside"])][0] is busy, "busiest first"
        win.apply_state(SAMPLE_STATE)
        assert lst._shown(box) == after, "a status read keeps the order"

    loads = win.cpus.sample()
    loads = win.cpus.sample()
    assert all(0.0 <= v <= 1.0 for v in loads.values())
    assert ranges([3, 4, 13, 14]) == "3, 4, 13 and 14"

    win.show_error("t", "body")
    assert win.stack.get_visible_child_name() == "error"
    print("self-test ok: pages build, CSS parses, every state draws")


def snapshot(path):
    """Draw the chip down, then up, into one PNG -- no window is shown.

    Uses this machine's live per-CPU load, so it is a real picture of the
    moment rather than a mock-up.
    """
    view = CpuView()
    sampler = CpuSampler()
    sampler.sample()
    GLib.usleep(400_000)
    view.shown = sampler.sample()
    w, h = 1024, 680  # the window's own shape, at 2x
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w * 2, h)
    cr = cairo.Context(surface)
    bg = cairo.LinearGradient(0, 0, w * 2, h)
    bg.add_color_stop_rgb(0.0, 0.04, 0.06, 0.13)
    bg.add_color_stop_rgb(1.0, 0.05, 0.10, 0.20)
    cr.set_source(bg)
    cr.paint()
    for i, on in enumerate((False, True)):
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], on)
        view.phase = 0.0
        while view.phase < 21.0:  # long enough for a siege to be under way
            view.phase += 1 / 30
            view._advance(1 / 30)
        cr.save()
        cr.translate(i * w, 0)
        view._draw(view, cr, w, h)
        cr.restore()
    surface.write_to_png(path)
    print(f"wrote {path}")


def main():
    args = sys.argv[1:]
    if "--self-test" in args:
        self_test()
        return 0
    if args[:1] == ["--snapshot"] and len(args) == 2:
        snapshot(args[1])
        return 0
    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0
    return FortApp().run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
