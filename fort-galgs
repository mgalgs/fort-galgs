        x = view._bezier(view.trails[side], Siege.COVER_P)[0]
        assert (rock["x"] - x) * rock["inward"] < 0, "beside the trail"
    assert view.siege.boulders == [True, True]

    def foot(n):
        siege.redcoats.append({"side": 0, "d": Siege.trail_d(0.6),
                               "hit": None, "n": n, "born": siege.phase,
                               "kind": "foot", "hp": 1, "struck": None,
                               "at_wall": None, "slot": 0})
        return siege.redcoats[-1]

    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    rc = foot(7)
    siege.run(1.5)
    assert rc["hid"] is not None and rc["d"] == Siege.trail_d(Siege.COVER_P)
    shots = []
    for _ in range(int((3 * Siege.DRILL_LEN + 3) * 30)):
        fired = siege.drill_fired[0]
        siege.run(1 / 30)
        if siege.drill_fired[0] and not fired:
