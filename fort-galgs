    assert view.siege.pending_call and view.siege.pending_call[0] == 0
    view._on_click(None, 2, *mid)
    assert view.siege.called[0][-4:] == list(Siege.WAVE)
    assert view.siege.pending_call is None

    # Whoever reaches the wall beats on it.
    def stand(kind, n=99, d=1.05, at_wall=None, hp=1):
        return {"side": 0, "d": d, "hit": None, "n": n, "born": siege.phase,
                "kind": kind, "hp": hp, "struck": None, "at_wall": at_wall,
                "slot": 0}

    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.redcoats = [stand(kind) for kind in ("foot", "horse", "cannon")]
    siege.drill_start = [siege.phase, siege.phase]  # hold fire a moment
    siege.run(1.5)
    assert all(rc["at_wall"] is not None for rc in siege.redcoats), "wall"
    slots = sorted(rc["slot"] for rc in siege.redcoats)
    assert slots == sorted(set(slots)), f"one place each: {slots}"
    assert siege.tally["reached"] == 2, "two beat on it, one waits"

    # With redcoats at his wall, the tower sentry calls for the gun, and
