def run_backend(args, callback):
    """callback(ok, stdout_and_stderr). Never blocks the main loop."""
    try:
        proc = Gio.Subprocess.new(
            [BACKEND] + args,
            Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
    except GLib.Error as exc:
        callback(False, f"Could not run {BACKEND}: {exc.message}")
        return

    def done(source, result):
        try:
            _, out, _ = source.communicate_utf8_finish(result)
        except GLib.Error as exc:
            callback(False, exc.message)
            return
        callback(source.get_successful(), (out or "").strip())

    proc.communicate_utf8_async(None, None, done)


def ranges(cpus):
    """[3, 4, 13, 14] -> "3, 4, 13 and 14": these get read aloud, roughly."""
    words = [str(c) for c in cpus]
    if len(words) < 2:
        return "".join(words)
    return ", ".join(words[:-1]) + " and " + words[-1]


