            cr.arc(hx, hy, 2, 0, 2 * math.pi)
            cr.fill()

        cr.set_source_rgb(*SEAM_RGB)
        cr.set_line_width(3.5)
        cr.arc(0, -15, 14, 0, 2 * math.pi)
        cr.stroke()
        cr.set_line_width(2)
        for k in range(6):
