# The apps that can go in or out
# --------------------------------------------------------------------------

_desktop_cache = {}


def desktop_info(desktop):
    """The .desktop entry fortctl matched to a scope, or None."""
    if desktop not in _desktop_cache:
        try:
            found = DesktopAppInfo.new(desktop + ".desktop")
        except TypeError:
            found = None
        _desktop_cache[desktop] = found
    return _desktop_cache[desktop]


def group_apps(apps):
    """fortctl's scopes as rows: desktop apps grouped by their .desktop
    entry (an app often holds two scopes), everything else one per scope."""
    groups = {}
    for app in apps:
        desktop = app.get("desktop")
        info = desktop_info(desktop) if desktop else None
        if info is not None:
            key, title, other = "desktop:" + desktop, \
                info.get_display_name(), False
        else:
            key, title, other = "unit:" + app["unit"], app["name"], True
        g = groups.setdefault(key, {
            "key": key, "title": title, "other": other,
            "desktop": desktop if info is not None else None,
            "icon": info.get_icon() if info is not None else None,
            "units": [], "cgroups": [], "inside": [], "always": False,
        })
        g["units"].append(app["unit"])
        g["cgroups"].append(app["cgroup"])
        g["inside"].append(app["inside"])
        g["always"] = g["always"] or app["always"]
        if other:
            g["subtitle"] = app["unit"]
    out = list(groups.values())
    out.sort(key=lambda g: (not any(g["inside"]), g["title"].lower()))
    return out


class AppRow(Gtk.Box):
    """One app: icon, name, where it is, live CPU, a pin that keeps it in
    the fort from now on, and a switch that moves it in or out now."""

    def __init__(self, on_flip, on_pin):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.on_flip = on_flip
        self.on_pin = on_pin
        self.group = None
        self._quiet = False
        self.icon = Gtk.Image(pixel_size=28, valign=Gtk.Align.CENTER)
        self.append(self.icon)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1,
                       hexpand=True, valign=Gtk.Align.CENTER)
        self.title = Gtk.Label(xalign=0.0, css_classes=["gm-row-title"],
                               ellipsize=3)
        self.note = Gtk.Label(xalign=0.0, css_classes=["gm-row-note"],
                              ellipsize=3)
        text.append(self.title)
        text.append(self.note)
        self.append(text)
        self.cpu = Gtk.Label(label="", css_classes=["gm-row-value"],
                             valign=Gtk.Align.CENTER)
        self.append(self.cpu)
        self.spinner = Adw.Spinner(visible=False)
        self.append(self.spinner)
        self.pin = Gtk.ToggleButton(icon_name="view-pin-symbolic",
                                    valign=Gtk.Align.CENTER,
                                    css_classes=["flat", "circular"])
        self.pin.connect("toggled", self._on_pin_toggled)
        self.append(self.pin)
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.switch.connect("state-set", self._on_state_set)
        self.append(self.switch)

    def update(self, group, mode):
        self.group = group
        inside = all(group["inside"])
        partly = any(group["inside"]) and not inside
        if group["icon"] is not None:
            self.icon.set_from_gicon(group["icon"])
        else:
            self.icon.set_from_icon_name("application-x-executable-symbolic")
        self.title.set_label(group["title"])
        if group["always"] and inside:
            note = "always in the fort"
        elif group["always"]:
            note = ("outside; it will be pulled in within seconds"
                    if mode != "off" else "always in the fort while it is up")
        elif inside:
            note = "in the fort"
        elif partly:
            note = "partly in the fort"
        else:
            note = ("fenced with everything else" if mode == "on"
                    else "outside the fort")
        if group.get("subtitle"):
            note += " · " + group["subtitle"]
        self.note.set_label(note)
        self._quiet = True
        self.switch.set_active(inside)
        self.switch.set_state(inside)
        self.pin.set_active(group["always"])
        self._quiet = False
        self._sensitize()
        self.pin.set_visible(group["desktop"] is not None)
        self.pin.set_tooltip_text(
            "Pinned: always in the fort" if group["always"]
            else "Pin: keep it in the fort from now on")
        self.switch.set_tooltip_text(
            "Unpin it to move it out" if group["always"] and inside
            else None)

    def _sensitize(self):
        busy = self.spinner.get_visible()
        g = self.group
        self.switch.set_sensitive(not busy and not (g["always"]
                                                    and all(g["inside"])))
        self.pin.set_sensitive(not busy)

    def set_cpu(self, cpus):
        self.cpu.set_label(f"{cpus:4.1f}" if cpus >= 0.05 else "")

    def set_busy(self, busy):
        self.spinner.set_visible(busy)
        if self.group is not None:
            self._sensitize()

    def _on_pin_toggled(self, button):
        if self._quiet or self.group is None:
            return
        self.on_pin(self, button.get_active())

    def _on_state_set(self, _switch, want):
        if self._quiet or self.group is None:
            return False
        self.on_flip(self, want)
        # Hold the state: the next status read sets it to what is true.
        return True


class AppList(Gtk.Box):
    """Desktop apps first; terminals and other scopes under an expander.

    Apps in the fort lead each list, and within that the busiest come
    first. A row passes the one above it only once its smoothed load leads
    by CPU_SORT_MARGIN, and nothing moves while the pointer is over the
    list, so a row never slides out from under a click.
    """

    CPU_SORT_MARGIN = 0.3   # CPUs
    CPU_EASE = 0.25         # per sample

    def __init__(self, on_flip, on_pin):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.on_flip = on_flip
        self.on_pin = on_pin
        self.rows = {}
        self.cpu = {}       # group key -> smoothed CPUs in use
        self.motion = Gtk.EventControllerMotion()
        self.add_controller(self.motion)
        self.main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.others = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                              spacing=10, margin_top=10)
        self.expander = Gtk.Expander(child=self.others)
        self.empty = Gtk.Label(label="No apps running.", xalign=0.0,
                               css_classes=["gm-row-note"])
        self.append(self.main)
        self.append(self.empty)
        self.append(self.expander)

    def _shown(self, box):
        child, out = box.get_first_child(), []
        while child is not None:
            out.append(child)
            child = child.get_next_sibling()
        return out

    def update(self, groups, mode):
        # Rebuild in the order already on screen, so a status read does not
        # undo the CPU sort; new rows start at the end of their section.
        place = {row.group["key"]: i for i, row in enumerate(
            self._shown(self.main) + self._shown(self.others))}
        groups = sorted(groups, key=lambda g: (
            not any(g["inside"]), place.get(g["key"], len(place))))
        keys = {g["key"] for g in groups}
        for key in list(self.rows):
            if key not in keys:
                row = self.rows.pop(key)
                row.get_parent().remove(row)
                self.cpu.pop(key, None)
        for box in (self.main, self.others):
            while (child := box.get_first_child()) is not None:
                box.remove(child)
        n_other = 0
        for g in groups:
            row = self.rows.get(g["key"])
            if row is None:
                row = self.rows[g["key"]] = AppRow(self.on_flip, self.on_pin)
            row.update(g, mode)
            (self.others if g["other"] else self.main).append(row)
            n_other += g["other"]
        self.empty.set_visible(not any(not g["other"] for g in groups))
        self.expander.set_label(f"Terminals and other scopes ({n_other})")
        self.expander.set_visible(n_other > 0)
        self._sort()

    def sample_paths(self):
        return {cg: cg for row in self.rows.values() if row.group
                for cg in row.group["cgroups"]}

    def set_cpu(self, used):
        for key, row in self.rows.items():
            if row.group:
                now = sum(used.get(cg, 0.0) for cg in row.group["cgroups"])
                row.set_cpu(now)
                was = self.cpu.get(key, now)
                self.cpu[key] = was + (now - was) * self.CPU_EASE
        self._sort()

    def _ahead(self, a, b):
        a_in, b_in = any(a.group["inside"]), any(b.group["inside"])
        if a_in != b_in:
            return a_in
        return (self.cpu.get(a.group["key"], 0.0)
                > self.cpu.get(b.group["key"], 0.0) + self.CPU_SORT_MARGIN)

    def _sort(self):
        if self.motion.get_property("contains-pointer"):
            return
        for box in (self.main, self.others):
            shown = self._shown(box)
            order = []
            for row in shown:
                i = len(order)
                while i > 0 and self._ahead(row, order[i - 1]):
                    i -= 1
                order.insert(i, row)
            if order != shown:
                prev = None
                for row in order:
                    box.reorder_child_after(row, prev)
                    prev = row


