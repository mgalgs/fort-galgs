def envelope(seeds, years):
    """Run each seed's valley for so many years headless, and return one
    row per season per seed: its stats just before the season turns."""
    rows = {}
    for seed in seeds:
        w = World(seed)
        rows[seed] = []
        for n in range(years * 4):
            w.run((n + 1) * World.SEASON_S - 0.5 - w.time)
            rows[seed].append(w.stats())
            w.run(0.5)
    return rows


def fight_sample(seeds, years, arrive=6.0):
    """Run each seed's valley with bears coming arrive times as often, a
    minute at a time, and return every season's events, the men's
    exposure (minutes alone, minutes in company), their watch (total
    vigilance and minutes, calm and then after a killing), and whether
    the rails and the dens held throughout."""
    events, exposure, held = [], [0, 0], True
    watch = [0.0, 0, 0.0, 0]
    for seed in seeds:
        w = World(seed)
        w.BEAR_ARRIVE_K *= arrive
        for n in range(years * 4):
            end = (n + 1) * World.SEASON_S - 0.5
            while w.time < end:
                w.run(min(60.0, end - w.time))
                live = [b for b in w.predators if b["job"] != "dead"]
                held &= len(live) <= w.BEARS_MAX and len(
                    {b["f"] for b in live}) == len(live)
                held &= w.cold() < 1 or all(b["job"] == "den"
                                            for b in live)
                for tr in w.trappers:
                    exposure[w._company(tr["f"], tr["to"], tr) > 0] += 1
                    k = 2 * w._alert(tr)
                    watch[k] += w._vigilance(tr)
                    watch[k + 1] += 1
            events += w.tally["events"]
            w.run(0.5)
    return events, exposure, watch, held


def beaver_tests(view, cr, rows):
    """The trees, the beavers and their works, headless and drawn; rows
    is envelope((1, 2, 3, 4), 4)."""
    w = World(1)
    assert len(w.trees) == 46 and all(w.tree_state(i) == "tree"
                                      for i in range(46))
    assert [sum(b["f"] == f for b in w.beavers) for f in (0, 1)] == [3, 3]
    assert w.colonies == [{"dam": 0, "lodge": 0}] * 2

    # A beaver fells a bank tree into a pile of sticks; the stump comes
    # up a sapling, then a tree.
    b = w.beavers[0]
    i = w._bank_trees(0, b)[0]
    b["tree"] = i
    w._send(b, ["tree", i], "cut", w.CUT_S, w.SWIM_S)
    w.run(b["t2"] - w.time + 1)
    tr = w.trees[i]
    assert tr["by"] == "beaver" and tr["felled"] is not None, tr
    felled = tr["felled"]
    assert w.tree_state(i) == "stump"
    assert w.tree_state(i, felled + w.REGROW_S * 0.5) == "sapling"
    assert w.tree_state(i, felled + w.REGROW_S) == "tree"

    # Kits come in spring from surplus, as far as the lodge has room.
    w = World(2)
    w.beavers = []
    for _ in range(4):
        w._beaver(0, 0.9)
    w._beaver(1, 0.4)
    w._births()
    assert len(w.beavers) == 5, "no lodge, no kits"
    w.colonies[0]["lodge"] = w.LODGE_STICKS
    w._births()
    assert len(w.beavers) == 7 and w.tally["kits"][0] == 2, w.tally
    mothers = round(0.9 - w.KIT_COST, 2)
    assert sorted(round(b["cond"], 2) for b in w.beavers if b["f"] == 0) \
        == sorted([mothers] * 2 + [w.KIT_COND] * 2 + [0.9] * 2)

    # A valley empty of beavers for a season gets a pair from upstream,
    # at the colony with the bigger dam.
    w = World(3)
    w.beavers = []
    w.colonies[1]["dam"] = 5
    w.run(w.RESTOCK_S + 1)
    assert [b["f"] for b in w.beavers] == [1, 1], w.beavers
    assert w.tally["rails"]["beavers"] == 1

    # In winter, the fit ones keep to the lodge.
    w = World(4)
    w.run(3 * w.SEASON_S + 120)
    for b in w.beavers:
        b["cond"] = 1.0
    w.run(w.SEASON_S / 2 - 120)
    assert w.beavers and all(b["job"] == "lodge" for b in w.beavers)
    # ...where no trap can take them, however keen.
    w.trappers, w.CATCH_K, n = [], 1.0, len(w.beavers)
    for row in w.sites:
        for site in row:
            site.update(by=0, state="set", since=w.time)
    w.run(200)
    assert len(w.beavers) == n and w.tally["trapped"] == 0
    assert all(st["state"] == "set" for row in w.sites for st in row)

    # The pond above a finished dam widens the river, never past the most
    # the layout allows for.
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    view.set_world(World(5))
    wide = []
    for sticks in (0, 6, 12):
        for c in view.world.colonies:
            c["dam"] = sticks
        view._draw(view, cr, 1024, 680)
        for k in range(200):
            x = k / 199 * 1024
            assert view._river_half(x) <= view._river_half_max(x) + 1e-9
        wide.append(view._river_half(
            (World.DAM_U[0] - World.POND_LEN / 2) * 1024))
    assert wide[2] > wide[0], wide

    # A swimming beaver dives partway and comes up further on; one at a
    # tree is on the bank in the idle picture, and in the bushes (not
    # drawn) while the fort is up. Both pictures show the works.
    w = view.world
    b = w.beavers[0]
    w._send(b, ["dam", 1], "haul", w.HAUL_S, w.SWIM_S)
    seen = set()
    for k in range(40):
        w.time = b["t0"] + (b["t1"] - b["t0"]) * k / 40
        seen.add(view._beaver_pose(b)[0])
    assert seen == {"swim", "dive", "under"}, seen
    i = w._bank_trees(0, b)[0]
    w._send(b, ["tree", i], "cut", w.CUT_S, w.SWIM_S)
    w.time = b["t1"] + 1
    view._draw(view, cr, 1024, 680)
    assert any(it[2] == view._draw_bank_beaver and it[3][0] is b
               for it in view._wild_items())
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
    view._draw(view, cr, 1024, 680)
    assert not any(kind == "beaver" and args[0] is b
                   for kind, args in view._works_items())
    kinds = {kind for kind, _ in view._works_items()}
    w.colonies[0]["lodge"] = w.LODGE_STICKS
    assert {"dam", "lodge"} <= {kind for kind, _ in view._works_items()}, \
        kinds
    before = w.time
    for _ in range(30 * 30):
        view._advance(1 / 30)
    assert abs(w.time - before - 30) < 1e-6, "the world runs on under siege"
    view._draw(view, cr, 1024, 680)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)

    # Over several seeds and years, without leaning on the rails: dams and
    # lodges go up, the beavers hold on in numbers, and lodges bring kits.
    later = [r for seed in rows for r in rows[seed][4:]]
    for seed, seasons in rows.items():
        first_dam = next(n for n, r in enumerate(seasons) if r["dams"])
        first_lodge = next(n for n, r in enumerate(seasons) if r["lodges"])
        assert first_dam < 8 and first_lodge < 12, (seed, first_dam)
    mean = sum(r["beavers"] for r in later) / len(later)
    assert 3 <= mean <= 12, mean
    assert max(r["beavers"] for s_ in rows.values() for r in s_) <= 12
    rails = sum(r["tally"]["rails"]["beavers"] for s_ in rows.values()
                for r in s_)
    assert rails <= 4, rails
    kits = [e for s_ in rows.values() for r in s_
            for e in r["tally"]["events"] if e["kind"] == "kits"]
    with_lodge = [e["n"] for e in kits if e["lodge"] >= 0.5]
    without = [e["n"] for e in kits if e["lodge"] == 0]
    assert with_lodge and sum(with_lodge) / len(with_lodge) > (
        sum(without) / len(without) if without else 0), kits
    # The same valleys with dams that never hold: the beavers dwindle.
    dammed = undammed = 0
    for seed in (1, 2, 3, 4):
        w = World(seed)
        w.DAM_STICKS = 10 ** 6
        w.run(World.YEAR_S)
        for _ in range(12):
            w.run(World.SEASON_S)
            undammed += len(w.beavers)
        dammed += sum(r["beavers"] for r in rows[seed][4:])
    assert dammed > undammed, (dammed, undammed)


def _set_clock(w, t):
    """Put world w's clock at t as if it had run there."""
    w.time = float(t)
    w.next_tick = math.floor(t) + w.TICK_S
    w.season_n = int(t // w.SEASON_S)
    w.half_n = int(t // (w.SEASON_S / 2))


def trapper_tests(view, cr, rows, more):
    """The trappers' needs, deaths and newcomers, headless and drawn; rows
    is envelope((1, 2, 3, 4), 4) and more envelope((5, 6, 7, 8), 4)."""
    S = World.SEASON_S

    def staged(t, beavers=True):
        w = World(11)
        _set_clock(w, t)
        if not beavers:
            w.beavers = []
            w.RESTOCK_S = 1e9
        for tr in w.trappers:
            tr["t0"] = tr["t1"] = tr["t2"] = w.time
        return w

    def busy_sites(w):
        for row in w.sites:
            for st in row:
                st.update(by=-1)  # all taken, by nobody in particular

    def fell_all(w):
        for slot in w.trees:
            slot["felled"], slot["by"] = w.time, "trapper"

    # He does what he needs most: eats when hungry, chops and builds as
    # winter nears, and shelters in the cold; time spent is tallied.
    w = staged(100)
    tr = w.trappers[0]
    busy_sites(w)
    tr.update(fed=0.2, meat=1, logs=1)
    w._trapper_next(tr, w.cold())
    assert tr["job"] == "fire" and tr["fuel"], tr["job"]
    assert tr["t2"] - tr["t1"] == w.FIRE_S
    w._trapper_done(tr)
    assert (tr["meat"], tr["logs"], tr["fed"]) == (0, 0, 1.0), tr
    tr.update(fed=0.2, meat=1, logs=0)
    fell_all(w)
    w._trapper_next(tr, w.cold())
    assert tr["job"] == "fire" and not tr["fuel"], tr["job"]
    assert tr["t2"] - tr["t1"] == 2 * w.FIRE_S
    w = staged(2.5 * S)
    busy_sites(w)
    tr = w.trappers[0]
    w._trapper_next(tr, w.cold())
    assert tr["job"] == "chop", tr["job"]
    fell_all(w)
    tr["logs"] = 2
    w._trapper_next(tr, w.cold())
    assert tr["job"] == "build", tr["job"]
    w = staged(3.5 * S)
    tr = w.trappers[0]
    w.plots[0][0]["logs"] = w.CABIN_LOGS
    tr["logs"] = 20
    w._trapper_next(tr, w.cold())
    assert tr["job"] == "shelter", tr["job"]
    w = staged(10)
    w.run(S)
    assert all(sum(tr["effort_prev"].values()) > 0 for tr in w.trappers)

    # A set trap takes a beaver out of the water; he collects it and
    # stashes it at his cabin for a pelt and meat.
    w = staged(10)
    w.CATCH_K = 10.0  # a sure catch
    tr = w.trappers[0]
    for b in w.beavers:
        b.update(job="swim", t2=1e9)
    busy_sites(w)
    for st in w.sites[0]:
        st.update(by=None, state="empty")
    w.sites[0][0].update(by=tr["id"], state="set", since=w.time)
    tr.update(job="rest", t2=1e9)
    w.trappers[1]["t2"] = 1e9
    before = sum(b["f"] == 0 for b in w.beavers)
    w.run(1)
    assert w.sites[0][0]["state"] == "caught" and w.tally["trapped"] == 1
    assert sum(b["f"] == 0 for b in w.beavers) == before - 1
    tr["site"] = 0
    w._go(tr, ["site", 0, 0], "collect", w.COLLECT_S)
    w.run(tr["t2"] - w.time + 1)
    assert tr["job"] == "stash" and tr["carry"] == "beaver", tr["job"]
    w.run(tr["t2"] - w.time + 1)
    assert (tr["pelts"], tr["meat"]) == (1, w.MEAT_PER_BEAVER), tr

    # An axe fells the nearest tree for logs, flat to the ground; eight
    # logs laid make a cabin.
    w = staged(10)
    tr = w.trappers[0]
    i = w._chop_tree(tr)
    assert w.trees[i]["zone"] == "woods" and w.trees[i]["f"] == 0
    tr.update(job="chop", tree=i)
    w._trapper_done(tr)
    assert w.trees[i]["by"] == "trapper" and tr["logs"] == w.LOGS_PER_TREE
    assert w.tree_state(i) == "stump"
    tr["logs"] = w.CABIN_LOGS
    for _ in range(w.CABIN_LOGS):
        tr["job"] = "build"
        w._trapper_done(tr)
    assert w.plots[0][0]["logs"] == w.CABIN_LOGS and tr["logs"] == 0
    assert w.stats()["cabins"] == 1

    # Out in the winter with no cabin he dies of the cold, and his grave
    # weathers away; inside a finished one with wood to burn, he is fine.
    w = staged(3 * S + 100, beavers=False)
    cold_one, snug = w.trappers
    w.plots[1][0]["logs"] = w.CABIN_LOGS
    snug["logs"] = 20
    fell_all(w)  # and no wood to start one
    w.run(S - 200)
    assert cold_one not in w.trappers and w.tally["deaths"] == {"cold": 1}
    assert snug in w.trappers and snug["health"] > 0.97, snug["health"]
    assert len(w.graves) == 1
    t = w.graves[0]["t"]
    w.run(t + w.GRAVE_S + 1 - w.time)
    assert all(g["t"] != t for g in w.graves), "gone in two years"

    # With nothing to eat, he starves (by autumn, before any cold).
    w = staged(4 * S + 10, beavers=False)
    busy_sites(w)
    for tr in w.trappers:
        tr.update(fed=0.0, meat=0)
    w.run(1900)
    assert not w.trappers and w.tally["deaths"] == {"hunger": 2}, \
        w.tally["deaths"]

    # Whoever is nearest takes a dead man's goods: his own flank first,
    # else whoever has least; and moves into his cabin if it is further
    # along. With nobody left, the goods are lost and the cabin stands,
    # rotting a log a season while it is empty.
    def heirs(plots, stores):
        w = staged(2 * S + 10)
        w.trappers = []
        for row in w.plots:
            for p in row:
                p["owner"] = None
        for (f, k), (logs, meat) in zip(plots, stores):
            tr = w._trapper(f, k, ["plot", f, k])
            tr.update(logs=logs, meat=meat, pelts=1)
        return w, list(w.trappers)

    w, (dead, near, far) = heirs([(0, 0), (0, 1), (1, 0)],
                                 [(3, 2), (9, 9), (0, 0)])
    w.plots[0][0]["logs"], w.plots[0][1]["logs"] = 5, 2
    w.die(dead, "cold")
    e = w.tally["events"][-1]
    assert e["claimant"] == near["id"] and e["moved"] == 6, e
    assert e["after"] - e["before"] == e["moved"]
    assert (near["f"], near["plot"]) == (0, 0), "he moves in"
    assert w.plots[0][0]["owner"] == near["id"]
    assert w.plots[0][1]["owner"] is None
    w, (dead, other) = heirs([(0, 0), (1, 1)], [(3, 2), (1, 1)])
    w.die(dead, "cold")
    assert w.tally["events"][-1]["claimant"] == other["id"]
    assert (other["f"], other["plot"]) == (1, 1), "his own is as good"
    w, (dead, rich, poor) = heirs([(0, 0), (1, 0), (1, 1)],
                                  [(3, 2), (4, 1), (1, 1)])
    w.die(dead, "hunger")
    assert w.tally["events"][-1]["claimant"] == poor["id"]
    assert poor["logs"] == 4 and poor["meat"] == 3
    # Moving across, he drops his errand on the old flank and comes in
    # from the new one's edge, never through the grove.
    w, (dead, heir) = heirs([(0, 0), (1, 1)], [(0, 0), (0, 0)])
    w.plots[0][0]["logs"] = 6
    heir["tree"] = w._chop_tree(heir)
    w._go(heir, ["tree", heir["tree"]], "chop", w.CHOP_S)
    w.die(dead, "cold")
    assert (heir["f"], heir["plot"]) == (0, 0), "he moves across"
    assert heir["at"] == ["edge", 0] and heir["to"] == ["plot", 0, 0]
    assert heir["tree"] is None and heir["job"] == "rest", heir
    w, (dead,) = heirs([(0, 0)], [(3, 2)])
    w.plots[0][0]["logs"] = 5
    w.die(dead, "cold")
    assert w.tally["events"][-1]["claimant"] is None
    assert w.plots[0][0]["logs"] == 5 and w.plots[0][0]["owner"] is None
    w.RESTOCK_S = 1e9
    w.run(S)
    assert w.plots[0][0]["logs"] == 4, "an empty cabin rots"

    # Newcomers come in spring, more of them the more beavers there are,
    # into the free plot furthest along, walking in from the edge.
    counts = set()
    for seed in range(12):
        w = staged(10)
        w.rng.seed(seed)
        while len(w.beavers) < 9:
            w._beaver(seed % 2, 0.7)
        w._arrivals()
        counts.add(w.tally["arrivals"])
    assert counts == {1, 2}, counts
    w = staged(10, beavers=False)
    w.trappers = []
    for row in w.plots:
        for p in row:
            p["owner"] = None
    w.plots[1][1]["logs"] = 5
    w._arrivals()
    assert w.tally["arrivals"] == 1 and w.tally["rails"]["trappers"] == 1
    tr = w.trappers[0]
    assert (tr["f"], tr["plot"], tr["at"]) == (1, 1, ["edge", 1]), tr

    # Out of spring a lone drifter comes now and then to a short-handed
    # valley, sooner the more plots stand free; never in the winter, nor
    # past TRAPPERS_MAX, nor to a valley without beavers.
    def drift(t, men, beavers=12, k=World.DRIFT_K, seed=0):
        w = staged(t)
        w.DRIFT_K = k
        w.rng.seed(seed)
        while len(w.beavers) < beavers:
            w._beaver(0, 0.7)
        w.beavers = w.beavers[:beavers]
        for tr in w.trappers[men:]:
            w.plots[tr["f"]][tr["plot"]]["owner"] = None
        w.trappers = w.trappers[:men]
        for _ in range(300):
            w._drifters()
        return w

    assert len(drift(S + 10, 1, k=1e3).trappers) == 4
    for t in (1.5 * S + 10, 2 * S + 10):
        assert drift(t, 0, k=1e3).tally["arrivals"] > 0, t
    assert drift(3 * S + 10, 0, k=1e3).tally["arrivals"] == 0
    assert drift(S + 10, 1, beavers=0, k=1e3).tally["arrivals"] == 0
    assert drift(10, 1, k=1e3).tally["arrivals"] == 0, "spring's own"
    came = [sum(drift(S + 10, men, seed=seed).tally["arrivals"] > 0
                for seed in range(40)) for men in (2, 1)]
    assert came[0] < came[1], came

    # Over several seeds and years: the trappers hold on in numbers, some
    # die and some come; they trap harder when beavers are plenty; those
    # who trap through the autumn come out of the winter worse, most but
    # not all winters find the cabins ready, the unready suffer for it,
    # and a death leaves the others richer.
    later = [r for seed in rows for r in rows[seed][4:]]
    every = [r for seed in rows for r in rows[seed]]
    mean = sum(r["trappers"] for r in later) / len(later)
    assert 1 <= mean <= 4, mean
    # ...and over eight, the drifters and the spring keep the valley
    # between half and nearly full, the drifters coming in summer and
    # autumn and never in the winter.
    eight = [r for e in (rows, more) for seed in e for r in e[seed]]
    later8 = [r for r in eight if r["year"] > 1]
    mean = sum(r["trappers"] for r in later8) / len(later8)
    assert 2.5 <= mean <= 3, mean
    assert sum(r["trappers"] == 4 for r in later8) < len(later8) / 2
    drifted = [r["tally"]["arrivals"] for r in eight if r["season"] > 0]
    assert sum(drifted) >= 8 and not any(
        r["tally"]["arrivals"] for r in eight if r["season"] == 3), drifted
    assert max(r["trappers"] for r in every) <= 4
    rails = sum(r["tally"]["rails"]["trappers"] for r in every)
    arrivals = sum(r["tally"]["arrivals"] for r in every)
    deaths = sum(sum(r["tally"]["deaths"].values()) for r in every)
    assert rails <= 4 and deaths >= 1 and arrivals > rails, \
        (rails, arrivals, deaths)
    # Bears have made the beavers-to-trapping link a near tie over four
    # valleys; it is judged over eight.
    shares = []
    for r in every + [r for seed in more for r in more[seed]]:
        if r["season"] == 3:
            continue
        for effort in r["effort"].values():
            busy = sum(effort.values())
            if busy:
                shares.append((r["beavers"], effort.get("trap", 0) / busy))
    mid = sorted(n for n, _ in shares)[len(shares) // 2]
    rich = [k for n, k in shares if n > mid]
    poor = [k for n, k in shares if n <= mid]
    assert sum(rich) / len(rich) > sum(poor) / len(poor), (rich, poor)
    events = [e for r in every for e in r["tally"]["events"]]
    winters = [e for e in events if e["kind"] == "winter"]
    mid = sorted(e["share"] for e in winters)[len(winters) // 2]
    hard = [e["loss"] for e in winters if e["share"] > mid]
    soft = [e["loss"] for e in winters if e["share"] <= mid]
    assert sum(hard) / len(hard) > sum(soft) / len(soft), (hard, soft)
    ready = sum(e["ready"] for e in winters)
    assert 0.6 * len(winters) <= ready < len(winters), (ready, winters)
    cold = [e["loss"] for e in winters if not e["ready"]]
    snug = [e["loss"] for e in winters if e["ready"]]
    assert sum(cold) / len(cold) > sum(snug) / len(snug), (cold, snug)
    # ...and it is the men who trapped hardest through the autumn whose
    # cabins the winter finds unfinished.
    over = [e["ready"] for e in winters if e["share"] > mid]
    under = [e["ready"] for e in winters if e["share"] <= mid]
    assert not all(over) and sum(over) / len(over) < \
        sum(under) / len(under), (over, under)
    heirs = [e for e in events if e["kind"] == "death" and e["claimant"]]
    assert all(e["after"] - e["before"] == e["moved"] for e in heirs)
    assert sum(e["after"] - e["before"] for e in heirs) > 0, heirs

    # Drawn: every job, a cabin at every stage, fire, grave, axe and log.
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    w = World(12)
    w.run(2 * World.YEAR_S + 2 * S)
    view.set_world(w)
    while len(w.trappers) < 2:
        w._arrivals()
    w.graves.append({"place": ["plot", 0, 1], "t": w.time, "id": 0})
    w.graves.append({"place": ["site", 1, 0],
                     "t": w.time - 1.9 * w.YEAR_S, "id": 0})
    tr = w.trappers[0]
    home = ["plot", tr["f"], tr["plot"]]
    jobs = [("set", ["site", tr["f"], 0]), ("check", ["site", tr["f"], 1]),
            ("collect", ["site", tr["f"], 2]), ("stash", home),
            ("chop", ["tree", w._chop_tree(tr) or 0]), ("build", home),
            ("fire", home), ("rest", home), ("shelter", home)]
    for size in ((300, 220), (1024, 680), (560, 420)):
        for job, place in jobs:
            for walking in (True, False):
                tr.update(job=job, at=home, to=place, t0=w.time - 2,
                          t1=w.time + (3 if walking else -1),
                          t2=w.time + 9, carry="beaver")
                view._draw(view, cr, *size)
        for x, y in [p for fl in view.wild["flanks"]
                     for p in [fl["edge"]] + [st["stand"]
                                              for st in fl["sites"]]
                     + [pl[k] for pl in fl["plots"]
                        for k in ("cabin", "fire", "cache", "pile")]
                     if p is not None]:
            assert 0 <= x <= size[0] and 0 <= y <= size[1], (x, y, size)
    for logs in range(w.CABIN_LOGS + 1):
        for smoke in (-1.0, 3.0):
            view._cabin(cr, 100, 100, 40, logs, w.CABIN_LOGS, smoke, 1.0)
    view._campfire(cr, 100, 100, 40, 2.0, cooking=True)
    view._campfire(cr, 100, 100, 40, 2.0, cooking=False, lit=0.0)
    for age in (0.0, 0.5, 0.95):
        view._grave(cr, 100, 100, 40, age)
    for bales in range(view.BALE_MAX + 1):
        view._cache(cr, 100, 100, 40, 3, bales)
    for axe in (0.05, 0.5, 1.0):
        view._mountain_man(cr, 100, 100, 40, 1, axe=axe, kneel=0.5)
    view._mountain_man(cr, 100, 100, 40, -1, shouldered=True, log=True)

    # Four idle minutes at the window's size: the trappers go about their
    # business keeping out of the grove and off the water but for their
    # stepping stones; the horses graze, look up and amble about.
    view.set_world(World(13))
    view._draw(view, cr, 1024, 680)
    s = view.wild["s"]
    assert view.horses, "horses at pasture"
    start = [(hs["x"], hs["y"]) for hs in view.horses]
    grazed, roamed, walked = set(), 0.0, 0
    for frame in range(240 * 30):
        view.phase += 1 / 30
        view._advance(1 / 30)
        if frame % 30 == 0:
            view._draw(view, cr, 1024, 680)
        for hs, (x, y) in zip(view.horses, start):
            grazed.add(hs["graze"])
            roamed = max(roamed, abs(hs["x"] - x))
            x0, y0, x1, y1 = view.wild["pastures"][hs["pasture"]]
            assert x0 <= hs["x"] <= x1 and y0 <= hs["y"] <= y1, hs
        for tr in view.world.trappers:
            at = view._trapper_xy(tr)
            if at is None:
                continue
            x, y, _, walking = at
            walked += walking
            assert not view._in_box(view.wild["grove"], x, y), (x, y)
            if abs(y - view._river_y(x)) < view._river_half(x):
                ford = view.wild["flanks"][tr["f"]]["ford"]
                assert ford and abs(x - ford[0][0]) < s, (x, y)
    assert walked and grazed == {0, 1} and roamed > 0.25 * s, \
        (walked, grazed, roamed)

    # The almanac in the idle picture's corner, not the siege's, nor in
    # one too small for it.
    w = World(14)
    w.run(2 * World.YEAR_S + 10)
    view.set_world(w)
    title, tallies, fights = view._almanac_text()
    assert title == "Spring, year 3" and len(tallies) == 4, title
    calls = []
    view._almanac_text = lambda: calls.append(1) or (title, tallies,
                                                     "2 fights")
    view._draw(view, cr, 1024, 680)
    assert calls, "drawn while the fort is down"
    del calls[:]
    view._draw(view, cr, 60, 40)
    view._draw(view, cr, 300, 220)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
    view._draw(view, cr, 1024, 680)
    assert not calls, "not while it is up, nor where there is no room"
    del view._almanac_text
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)


def bear_tests(view, cr, rows, more):
    """The bears' year, their hunting and their fights, headless and
    drawn; rows and more are as for trapper_tests."""
    S = World.SEASON_S

    def staged(t, seed=21):
        w = World(seed)
        _set_clock(w, t)
        w.BEAR_ARRIVE_K = 0.0  # only the bears a test puts there...
        w.DRIFT_K = 0.0        # ...and the men
        for tr in w.trappers:
            tr["t0"] = tr["t1"] = tr["t2"] = w.time
        return w

    def bare(w):
        w.beavers, w.trappers, w.RESTOCK_S = [], [], 1e9
        for row in w.plots:
            for p in row:
                p["owner"] = None

    # The first cold sends a bear to its den, where it sleeps on little
    # until the thaw wakes it.
    w = staged(3 * S + 100)
    b = w._bear(0, ["edge", 0])
    w.run(10)
    assert b["job"] == "den" and b["to"] == ["den", 0], b
    e = b["energy"]
    w.run(100)
    assert abs(e - b["energy"] - w.DEN_DRAIN * 100) < 1e-6, b["energy"]
    w.run(4 * S + 30 - w.time)
    assert b in w.predators and b["job"] != "den", b

    # With nothing left in it, it starves; low, on a flank with nothing
    # for it, it walks out the way it came.
    w = staged(2 * S + 10)
    w._bear(0, ["edge", 0])["energy"] = 0.01
    w.run(30)
    assert not w.predators and w.tally["bears"]["starved"] == 1
    bare(w)
    b = w._bear(1, ["tree", 30])
    b["energy"] = 0.1
    w.run(2)
    assert b["job"] == "leave" and b["to"] == ["edge", 1], b
    w.run(b["t1"] - w.time + 1)
    assert not w.predators and w.tally["bears"]["left"] == 1

    # What it eats: fish by the season, a beaver at the bank or out of a
    # trap (no pelt for anyone), meals from a cache whose owner is away;
    # never past full.
    w = staged(2 * S + 10)
    b = w._bear(0, ["site", 0, 0])

    def finish(job, to, energy=0.5):
        b.update(job=job, to=to, energy=energy, t1=w.time, t2=w.time)
        w._bear_done(b)
        return b["energy"] - energy

    assert abs(finish("fish", ["site", 0, 0]) - w.FISH_GAIN) < 1e-9
    assert abs(finish("fish", ["site", 0, 0], 0.95) - 0.05) < 1e-9
    w.sites[0][1].update(state="caught", by=w.trappers[0]["id"])
    assert abs(finish("steal", ["site", 0, 1]) - w.BEAVER_GAIN) < 1e-9
    assert w.sites[0][1]["state"] == "empty" and w.sites[0][1]["by"] is None
    assert w.tally["bears"]["eaten"] == 1 and w.tally["trapped"] == 0
    owner = w.trappers[0]
    far = max((i for i, slot in enumerate(w.trees) if slot["f"] == 0),
              key=lambda i: w.distance(["plot", 0, 0], ["tree", i]))
    owner.update(meat=5, to=["tree", far], t1=w.time)
    assert abs(finish("raid", ["plot", 0, 0]) - w.RAID_MEAT * w.MEAT_GAIN) \
        < 1e-9 and owner["meat"] == 5 - w.RAID_MEAT
    owner.update(to=["plot", 0, 0])
    assert finish("raid", ["plot", 0, 0]) == 0, "not with him home"
    assert w.tally["bears"]["robbed"] == 1
    w = staged(3 * S + 450)
    b = w._bear(0, ["site", 0, 0])
    assert finish("fish", ["site", 0, 0]) == 0, "nothing under the ice"
    w = staged(S + 10)
    w.BEAR_CATCH_K = 10.0
    for x in w.beavers:
        x.update(job="swim", t2=1e9)
    n = len(w.beavers)
    i = w._bank_trees(0, None)[0]
    b = w._bear(0, ["tree", i])
    b.update(job="hunt", energy=0.5, t2=w.time + w.HUNT_S)
    w.run(1)
    assert len(w.beavers) == n - 1 and w.tally["bears"]["eaten"] == 1
    assert w.tally["trapped"] == 0 and b["energy"] > 0.79, b

    # Bears come to what a flank offers: none to an empty valley, soon
    # to a rich one; never more than BEARS_MAX, never two on a flank.
    w = staged(10)
    w.BEAR_ARRIVE_K, w.TRAPPERS_MAX = World.BEAR_ARRIVE_K, 0
    bare(w)
    for _ in range(8):
        w.run(S)
        assert not w.predators and w.tally["bears"]["came"] == 0
    def valley(beavers, men):
        w = staged(10)
        w.BEAR_ARRIVE_K = 10 * World.BEAR_ARRIVE_K  # enough to count
        bare(w)
        for k in range(beavers):
            w._beaver(k % 2, 0.7)
        for k in range(men):
            w._trapper(k % 2, k // 2, ["plot", k % 2, k // 2])["meat"] = 8
        return w

    came = []
    for beavers, men in ((12, 4), (2, 1)):
        w = valley(beavers, men)
        n = 0
        for _ in range(3 * 15):  # spring to autumn, sending each one off
            w.run(60)
            n += len(w.predators)
            w.predators = []
        came.append(n)
    assert came[0] > 2 * came[1] > 0, came
    w, most = valley(12, 4), 0
    for _ in range(3 * 4):
        w.run(S / 4)
        most = max(most, len(w.predators))
        assert len({b["f"] for b in w.predators}) == len(w.predators)
    assert most == w.BEARS_MAX, most

    # A hungry bear goes for the man on his own, not the pair; a fed one
    # would sooner fish, and one too hurt to fight goes for nobody.
    def three(seed, hunger, t=10):
        w = staged(t, seed)
        c, a = w.trappers
        w._trapper(1, 1, ["plot", 1, 0])
        for tr, to in zip(w.trappers, (["site", 1, 1], ["plot", 1, 0],
                                       ["plot", 1, 0])):
            tr.update(f=1, to=to, t1=w.time)
        c["plot"] = 1
        b = w._bear(1, ["edge", 1])
        b["energy"] = 1 - hunger
        return w, a, c, b

    for seed in range(5):
        w, a, c, b = three(seed, 0.5)
        w._bear_next(b, w.cold())
        assert b["job"] == "stalk" and b["target"] == c["id"], b
        assert b["fight"]["company"] == 0 and b["to"] == c["to"]
        assert abs(b["t1"] - w.time - w.CHARGE_S
                   * w.distance(["edge", 1], c["to"])) < 1e-9
        w, a, c, b = three(seed, 0.1, 2 * S + 10)
        w._bear_next(b, w.cold())
        assert b["job"] == "fish", b["job"]
        w, a, c, b = three(seed, 0.5)
        c["to"] = a["to"]
        w._bear_next(b, w.cold())
        assert b["job"] != "stalk", "not with company"
        w, a, c, b = three(seed, 0.5)
        b["health"] = w.FLEE_AT * (1 - w.FLEE_HUNGER * 0.5) - 0.01
        w._bear_next(b, w.cold())
        assert b["job"] != "stalk", "not while too hurt to fight"

    # He may see it coming: never if he never looks, at once if he always
    # does; hunger and work dull his watch. If he moves off unseeing, here
    # to his fellows, it lets him go.
    w, a, c, b = three(0, 0.5)
    tr = a
    assert w._vigilance(tr) == 1.0
    tr["fed"] = 0.0
    assert w._vigilance(tr) == w.VIGILANCE[0]
    tr.update(fed=1.0, job="chop", t1=w.time)
    assert w._vigilance(tr) == w.VIGILANCE[1]
    for k, seen in ((0.0, False), (1e9, True)):
        w, a, c, b = three(0, 0.5)
        w.NOTICE_K = k
        w._bear_next(b, w.cold())
        w.run(1)
        assert (c["fight"] is not None) == seen, c["fight"]
        assert (b["fight"]["saw"] is not None) == seen, b["fight"]
    assert c["fight"] == {"bear": b["id"], "saw": w.time, "shot": None,
                          "help": False}
    w, a, c, b = three(0, 0.5)
    w.NOTICE_K = 0.0
    w._bear_next(b, w.cold())
    w._go(c, ["plot", 1, 0], "rest", 5.0)  # to the others
    w.run(1)
    assert b["target"] is None and b["job"] != "stalk", b

    # The fight. One man at his cabin on flank 1, the bear closing; the
    # other flank's man is out of it.
    def duel(**rates):
        w = staged(S + 10)
        w.trappers[0]["t2"] = 1e9
        man = w.trappers[1]
        man.update(to=["plot", 1, 0], t1=w.time, t2=w.time + 1e6,
                   job="rest", meat=0, pelts=0)
        b = w._bear(1, ["edge", 1])
        b["energy"] = 0.3
        w.NOTICE_K, w.HEAR_D = 0.0, 0.0
        for k, v in rates.items():
            setattr(w, k, v)
        w._stalk(b, man)
        return w, man, b

    def fights(w):
        return [e for e in w.tally["events"] if e["kind"] == "fight"]

    # He sees it, and a sure shot drops it before it reaches him: the
    # hide and the meat are his, he goes home, and the carcass lies a
    # while.
    w, man, b = duel(NOTICE_K=1e9, HIT_P=(1.0, 0.0), SHOT_DMG=2.0)
    w.run(b["t1"] - w.time + 1)
    e, = fights(w)
    assert e["saw"] and e["shot"] and e["hit"] and e["slain"] and e["won"]
    assert (e["dead"], e["help"], e["company"]) == (0, 0, 0), e
    assert w.tally["bears"]["fights"] == 1 and w.tally["bears"]["slain"] == 1
    assert b["job"] == "dead" and b["fight"] is None
    assert man["fight"] is None and man["job"] == "rest"
    assert man["pelts"] == w.HIDE_PELTS and man["meat"] == w.BEAR_MEAT
    assert man["hide"] == e["t"] and w.stats()["bears"] == 0
    w.run(w.CARCASS_S)
    assert not w.predators, "the carcass is gone"
    # A miss is his only shot: then it is knife and claws.
    w, man, b = duel(NOTICE_K=1e9, HIT_P=(0.0, 0.0), CLAW_P=0.0,
                     KNIFE_P=0.0)
    w.run(b["t1"] - w.time + 1)
    shot = man["fight"]["shot"]
    assert shot is not None and b["job"] == "fight" and man["job"] == "fight"
    w.run(10)
    assert man["fight"]["shot"] == shot and b["health"] == 1.0
    # Unseen, he gets no shot; claws that always land kill him, and the
    # bear eats; knives that always land kill it in one exchange.
    w, man, b = duel(CLAW_P=1.0, CLAW_DMG=2.0, KNIFE_P=0.0)
    w.run(b["t1"] - w.time + w.EXCHANGE_S + 1)
    e, = fights(w)
    assert man not in w.trappers and w.tally["deaths"] == {"bear": 1}
    assert not e["saw"] and not e["shot"] and e["dead"] == 1 and not e["won"]
    assert w.tally["bears"]["mauled"] == 1
    assert w.graves[-1]["place"] == ["plot", 1, 0]
    assert b["job"] == "eat", b["job"]
    energy = b["energy"]
    w.run(b["t2"] - w.time + 1)
    assert b["energy"] > energy + w.MAN_GAIN - w.BEAR_DRAIN * (
        w.EAT_S + 5), b["energy"]
    w, man, b = duel(KNIFE_P=1.0, KNIFE_DMG=2.0, CLAW_P=0.0)
    w.run(b["t1"] - w.time + w.EXCHANGE_S + 1)
    e, = fights(w)
    assert e["slain"] and not e["shot"] and man["health"] == 1.0, e

    # The shot carries HEAR_D, the struggle a third of it: men in earshot
    # run to help, fire once as they come up, and share the meat.
    for shoot, near, far in ((True, ["site", 1, 1], ["site", 1, 2]),
                             (False, ["site", 1, 0], ["site", 1, 1])):
        w, man, b = duel(NOTICE_K=1e9 if shoot else 0.0, HIT_P=(0.0, 0.0),
                         CLAW_P=0.0, KNIFE_P=0.0)
        w.HEAR_D = 0.5
        helper = w._trapper(1, 1, near)
        idle = w.trappers[0]
        idle.update(f=1, plot=1, at=far, to=far, t1=w.time, t2=1e9)
        helper.update(to=near, t1=w.time, t2=1e9, meat=0)
        w.run(b["t1"] - w.time + 1)
        assert helper["job"] == "fight" and helper["fight"]["help"]
        assert abs(helper["t1"] - helper["t0"] - max(1.0, w.WALK_S * w.RUN_K
                   * w.distance(near, ["plot", 1, 0]))) < 1e-9
        assert idle["fight"] is None and idle["job"] != "fight"
        w.run(helper["t1"] - w.time + 1)
        assert helper["fight"]["shot"] is not None, helper["fight"]
    # (A mid-fight valley, a helper still running, saves and runs on
    # exactly as it would have.)
    w, man, b = duel(NOTICE_K=1e9, HIT_P=(0.0, 0.0))
    w.HEAR_D = 0.5
    helper = w._trapper(1, 1, ["site", 1, 1])
    helper["t1"] = w.time
    w.run(math.ceil(b["t1"]) - w.time + 0.5)
    assert helper["t1"] > w.time and man["fight"] and b["fight"]
    w2 = World.from_dict(json.loads(json.dumps(w.to_dict())))
    assert w2.to_dict() == w.to_dict()
    for k, v in vars(w).items():
        if k.isupper():
            setattr(w2, k, v)  # the rates this test set
    w.run(World.YEAR_S)
    w2.run(World.YEAR_S)
    assert w2.to_dict() == w.to_dict(), "a mid-fight world runs on the same"
    w, man, b = duel(NOTICE_K=1e9, HIT_P=(0.0, 0.0), CLAW_P=0.0,
                     KNIFE_P=1.0, KNIFE_DMG=0.07, FLEE_AT=0.0)
    w.HEAR_D = 0.5
    helper = w._trapper(1, 1, ["site", 1, 1])
    helper.update(t1=w.time, t2=1e9, meat=0, pelts=0)
    w.run(60)
    e, = fights(w)
    assert e["slain"] and e["help"] == 1, e
    assert man["meat"] + helper["meat"] == w.BEAR_MEAT
    assert man["pelts"] == w.HIDE_PELTS and helper["pelts"] == 0, \
        "the hide to the man who did it most harm"

    # A badly hurt bear breaks off for its den; a starving one presses on.
    w, man, b = duel(NOTICE_K=1e9, HIT_P=(0.0, 0.0), CLAW_P=0.0,
                     KNIFE_P=0.0)
    b.update(health=0.2, energy=1.0)
    w.run(b["t1"] - w.time + 1)
    e, = fights(w)
    assert e["fled"] and b["job"] == "flee" and b["to"] == ["den", 1], b
    assert man["fight"] is None
    w, man, b = duel(FLEE_HUNGER=1.0, CLAW_P=0.0, KNIFE_P=0.0)
    b.update(health=0.2, energy=0.01)
    w.run(b["t1"] - w.time + 3 * w.EXCHANGE_S)
    assert b["job"] == "fight" and not fights(w), b["job"]
    # One that got away heals while it is well fed.
    w = staged(S + 10)
    w.trappers = []
    b = w._bear(1, ["den", 1])
    b.update(health=0.3, energy=0.9, job="flee", t2=w.time + 400)
    w.run(300)
    assert abs(b["health"] - 0.3 - w.BEAR_HEAL_K * 300) < 1e-6, b["health"]

    # Walking up on a bear at its kill is a fight of its own.
    w, man, b = duel(CLAW_P=1.0, CLAW_DMG=2.0, KNIFE_P=0.0)
    other = w.trappers[0]
    other.update(f=1, plot=1, to=["plot", 1, 1], t1=w.time, t2=1e9)
    w.run(b["t1"] - w.time + w.EXCHANGE_S + 1)
    assert b["job"] == "eat" and w._alert(other), "his flank is wary"
    w.CLAW_P, w.KNIFE_P, w.KNIFE_DMG = 0.0, 1.0, 2.0
    w._go(other, ["plot", 1, 0], "rest", 30.0)
    w.run(other["t1"] - w.time + w.EXCHANGE_S + 2)
    assert w.tally["bears"]["fights"] == 2 and fights(w)[-1]["slain"]

    # A man killed with a fellow at his side: the fellow, still fighting,
    # takes his goods but not yet his cabin, and the killing leaves the
    # flank watchful, idling in company, until ALERT_S has passed.
    w, man, b = duel(NOTICE_K=1e9, HIT_P=(0.0, 0.0), CLAW_P=1.0,
                     CLAW_DMG=2.0, KNIFE_P=0.0)
    w.HEAR_D = 0.5
    fellow = w._trapper(1, 1, ["plot", 1, 0])
    fellow.update(t1=w.time, t2=1e9)
    man.update(pelts=3, meat=4)
    w.plots[1][0]["logs"], w.plots[1][1]["logs"] = 8, 2
    w.run(b["t1"] - w.time + 1)
    assert fellow["job"] == "fight", fellow["job"]
    w.run(w.EXCHANGE_S + 1)
    death = next(e for e in w.tally["events"] if e["kind"] == "death")
    assert death["cause"] == "bear" and death["claimant"] == fellow["id"]
    assert death["after"] - death["before"] == death["moved"] > 0, death
    assert fellow["plot"] == 1 and fellow["fight"] is not None
    assert fellow["alert"] is not None and w._alert(fellow)
    fellow["fed"] = 1.0
    assert w._vigilance(fellow) == w.ALERT_VIG
    neighbour = w._trapper(1, 0, ["plot", 1, 0])
    assert w._idle_spot(fellow) == ["plot", 1, 0]
    fellow["alert"] = w.time - w.ALERT_S
    assert w._idle_spot(fellow) == ["plot", 1, 1] and neighbour

    # Over many fights in many valleys, at the bears' own choosing: the
    # men win most but far from all; lone men are the ones attacked;
    # a killing sharpens the survivors' watch and fattens their stores;
    # the bears keep to their dens in deep winter and to their rails.
    started = time.monotonic()
    events, exposure, watch, held = fight_sample(range(1, 29), 6, 1.0)
    took = time.monotonic() - started
    assert took < 25, took
    sample = [e for e in events if e["kind"] == "fight"]
    won = sum(e["won"] for e in sample) / len(sample)
    assert len(sample) >= 100 and 0.5 <= won <= 0.8, (len(sample), won)
    lone = sum(e["company"] == 0 for e in sample)
    assert lone / exposure[0] > (len(sample) - lone) / exposure[1], \
        (lone, exposure)
    assert watch[3] and watch[2] / watch[3] > watch[0] / watch[1], watch
    assert held, "a bear out of its den in deep winter, or past a rail"
    heirs = [e for e in events if e["kind"] == "death"
             and e["cause"] == "bear" and e["claimant"]]
    assert all(e["after"] - e["before"] == e["moved"] for e in heirs)
    assert sum(e["moved"] > 0 for e in heirs) >= 1, heirs
    # Drawn, in the idle picture only: a bear at every job and walking to
    # it, a fight from the stalk to the knife, a carcass, a den in snow
    # and a hide at a cabin, at every size, with the fort down and up.
    w, man, b = duel(NOTICE_K=1e9, HIT_P=(0.0, 0.0), CLAW_P=0.0,
                     KNIFE_P=0.0)
    w.HEAR_D = 0.5
    helper = w._trapper(1, 1, ["plot", 1, 1])
    helper["t1"] = w.time
    other = w._bear(0, ["edge", 0])
    man["hide"] = w.time
    view.set_world(w)
    sizes = ((60, 40), (300, 220), (560, 420), (1024, 680))
    places = {"fish": ["site", 0, 0], "steal": ["site", 0, 1],
              "hunt": ["tree", w._bank_trees(0, None)[0]],
              "raid": ["plot", 0, 0], "eat": ["plot", 0, 1],
              "wander": ["tree", 2], "den": ["den", 0], "leave": ["edge", 0],
              "flee": ["den", 0], "dead": ["site", 0, 2]}
    for on in (False, True):
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], on)
        for size in sizes:
            for when in (S + 10, 3 * S + 400):
                w.time = when
                for job, place in places.items() if not on else ():
                    for walking in (True, False):
                        other.update(job=job, at=["edge", 0], to=place,
                                     t0=w.time - 2, t2=w.time + 9,
                                     t1=w.time + (3 if walking else -1))
                        view._draw(view, cr, *size)
            w.time = S + 10
            view._draw(view, cr, *size)
            fl = [] if on else view.wild["flanks"]
            for x, y in [p for f in fl for p in [f["den"]] + [
                    pl["hide"] for pl in f["plots"]] if p is not None]:
                assert 0 <= x <= size[0] and 0 <= y <= size[1], (x, y)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    drawn = set()
    for _ in range(40 * 10):
        w.run(0.1)
        view.phase += 0.1
        drawn.add(b["job"])
        view._draw(view, cr, 560, 420)
        if b["job"] == "fight" and man["fight"]["shot"] is not None:
            b["blow"] = {"t": w.time, "on": "man", "id": man["id"]}
            w.KNIFE_P, w.KNIFE_DMG = 1.0, 0.1
    assert {"stalk", "fight"} <= drawn and b["job"] == "dead", drawn
    assert any(it[2] == view._draw_bear for it in view._wild_items())
    assert any(it[2] == view._draw_hide for it in view._wild_items())
    for pose in ({}, {"step": 0.7}, {"charge": 1.0, "step": -0.5},
                 {"stand": 1.0, "swipe": 1.0}, {"head": 1.0, "fish": True},
                 {"fall": 1.0}):
        view._bear(cr, 100, 100, 40, -1, **pose)
    view._bear(cr, 100, 100, 1, 1)
    for snow in (0.0, 1.0):
        view._den(cr, 100, 100, 40, snow, 2.0, -1)
    view._hide(cr, 100, 100, 40)
    for knife in (0.1, 1.0):
        view._mountain_man(cr, 100, 100, 40, 1, knife=knife)
    # Every size and both fort states, with the bears about.
    for on in (True, False):
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], on)
        for size in ((1, 1), (60, 40), (300, 220)):
            for _ in range(30):
                view.phase += 1 / 30
                view._advance(1 / 30)
            view._draw(view, cr, *size)
    # The almanac counts the bears, and tells of the season's fights.
    other.update(job="wander", t2=w.time + 1e3)
    title, tallies, fights = view._almanac_text()
    assert len(tallies) == 4 and tallies[3] == 1 and fights == \
        "1 fight, 1 bear slain", (tallies, fights)
    w.tally = w._fresh_tally()
    assert view._almanac_text()[2] == ""
    view._draw_almanac(cr, 680)

    # And in the eight valleys the other tests read: fights enough to
    # matter, and neither side has them all its own way (too few fights
    # there to hold a rate to).
    seen = [e for env in (rows, more) for seed in env for r in env[seed]
            for e in r["tally"]["events"] if e["kind"] == "fight"]
    won = sum(e["won"] for e in seen)
    assert len(seen) >= 8 and 0 < won < len(seen), (len(seen), won)


def _quiet_siege(seed=1):
    """A siege with the barracks quiet and the sentries holding fire, for
    staging one situation at a time."""
    siege = Siege(seed)
    siege.wave_in = siege.spawn_in = 1e9
    siege.drill_start = [siege.phase + 1e9, siege.phase + 1e9]
    return siege


def _at_the_foot(siege, kind="foot", side=0, slot=0):
    """Put a redcoat at the foot of side's wall, beating on it."""
    siege.send(side, kind)
    rc = siege.redcoats[-1]
    rc.update(d=Siege.MARCH_NEAR, at_wall=siege.phase, slot=slot)
    return rc


def _until(siege, test, seconds):
    """Run the siege on until test() holds; True if it did in time."""
    for _ in range(int(seconds * 30)):
        if test():
            return True
        siege.run(1 / 30)
    return test()


def _foe(siege, kind="foot", p=0.6, side=0):
    """A redcoat marching on side's trail, at screen position p."""
    siege.send(side, kind)
    rc = siege.redcoats[-1]
    rc["d"] = Siege.trail_d(p)
    return rc


def _walker_out(siege, mode="mend", side=0, i=2):
    """Man i down at the foot of side's wall, the ladder standing."""
    m = siege.men[i]
    m.update(mode=mode, side=side, h=0.0, g=0.0, t0=siege.phase, up=None,
             x=Siege.LADDER_X[side])
    siege.ladder.update(side=side, state="standing", ext=1.0, raised=0.0)
    return m


def _stage_eating(siege):
    for m in siege.men:
        m["hunger"] = 0.7
    siege.run(Siege.QUIET_S + 2.5)


def _stage_walls(strength):
    def stage(siege):
        siege.wall = [strength, strength]
    return stage


def _stage_out(mode, h=0.0, g=0.0, rock=1, fire=False, side=0, wall=0.5,
               ladder="standing"):
    def stage(siege):
        siege.wall = [wall, wall]
        m = _walker_out(siege, mode, side)
        m.update(h=h, g=g, rock=rock, shot_t=None, pinned=[],
                 next_shot=1e9)
        siege.ladder["state"] = ladder
        if fire:
            m["shot_t"] = 2.4
            foe = _foe(siege, "foot", 0.7, side)
            foe["drive"] = {"t0": siege.phase - 1.4 / Siege.VOLLEY_RATE,
                            "born": siege.phase - 3, "rock": rock,
                            "fired": True}
    return stage


# Every state the siege draws that a plain run of it seldom shows, by name.
SIEGE_PICTURES = (
    ("walls-full", _stage_walls(1.0)),
    ("walls-hurt", _stage_walls(0.6)),
    ("walls-badly-hurt", _stage_walls(0.25)),
    ("walls-breached", _stage_walls(0.0)),
    ("men-eating", _stage_eating),
    ("walker-descending", _stage_out("descend", h=0.55)),
    ("walker-mending", _stage_out("mend")),
    ("walker-running", _stage_out("run", g=0.5)),
    ("walker-behind-rock-1", _stage_out("hide", g=1.0, rock=1, fire=True)),
    ("walker-behind-rock-2", _stage_out("hide", g=2.0, rock=2)),
    ("walker-behind-rock-3", _stage_out("hide", g=3.0, rock=3, side=1)),
    ("walker-coming-home", _stage_out("home", g=1.5, rock=1)),
    ("walker-raising-ladder", _stage_out("raise", ladder="fallen")),
)


def siege_pictures(view, size=(900, 560), outdir=None):
    """Draw each state of SIEGE_PICTURES on a fresh siege, a few frames
    apiece so that anything animated moves, and write each as a PNG into
    outdir if one is given. Returns the names drawn."""
    w, h = size
    names = []
    for name, stage in SIEGE_PICTURES:
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
        cr = cairo.Context(surface)
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], True)
        siege = view.siege
        siege.wave_in = siege.spawn_in = view.boat_in = 1e9
        siege.drill_start = [siege.phase + 1e9, siege.phase + 1e9]
        view.phase = siege.phase
        view._draw(view, cr, w, h)
        stage(siege)
        for _ in range(4):
            view.phase += 0.1
            siege.tick(0.1)
            view._draw(view, cr, w, h)
        if outdir:
            surface.write_to_png(os.path.join(outdir, f"{name}.png"))
        names.append(name)
    view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], False)
    return names


def siege_tests(view, cr):
    """The walls, the lulls, the walker's mending and the ladder: staged
    situations, run with Siege alone, and the drawings of each state."""
    # Pounding hurts the wall, a horseman a little more than a man, a
    # cannon most, one side only; a breached wall takes nothing more.
    for kind in ("foot", "horse", "cannon"):
        siege = _quiet_siege()
        _at_the_foot(siege, kind, side=1)
        siege.run(20)
        assert siege.wall[0] == 1.0 and siege.wall[1] < 1.0, (kind, siege.wall)
        siege.redcoats[0]["hp"] = 99
        if kind == "foot":
            foot = 1.0 - siege.wall[1]
        elif kind == "horse":
            assert 1.0 - siege.wall[1] > foot, "a horseman hits harder"
            horse = 1.0 - siege.wall[1]
        else:
            assert 1.0 - siege.wall[1] > horse, "a cannon hits hardest"
    siege = _quiet_siege()
    rc = _at_the_foot(siege, "cannon")
    rc["hp"] = 99
    siege.wall[0] = 0.06
    siege.run(Siege.BOOM_EVERY + 1)
    assert siege.breached(0) and siege.tally["breaches"] == 1, siege.wall
    before = siege.tally["hurt"][0]
    siege.run(30)
    assert siege.wall[0] == 0.0 and siege.tally["hurt"][0] == before
    assert siege.tally["breaches"] == 1, "a breach is counted once"
    assert siege.at_wall(rc), "he waits at the gap"

    # A lull, a few quiet seconds, lets a hungry man sit and eat: each of
    # the two sentries where he stands and the walker on the wall walk,
    # while a fed man goes on watching. Redcoats in range send him back to
    # work, but standing up takes a beat.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.men[0]["hunger"], siege.men[2]["hunger"] = 0.6, 0.6
    siege.run(Siege.QUIET_S - 1)
    assert not siege.lull() and not siege.eating(0), "not yet a lull"
    siege.run(2.5)
    assert siege.lull() and siege.eating(0) and siege.eating(2)
    assert not siege.eating(1), "a fed man does not sit down"
    assert siege.sit(0) == 1.0 and siege.men[0]["mode"] == "eat"
    assert not siege.sound_bugle(0), "no bugle from a man at his meal"
    siege.run(20)
    assert siege.men[0]["hunger"] < 0.6 and siege.tally["meals"] >= 2
    assert siege.tally["eating_s"] > 30
    rc = _at_the_foot(siege)
    rc["d"] = Siege.trail_d(0.6)
    rc["at_wall"] = None
    siege.run(0.3)
    assert siege.men[0]["mode"] == "eat" and 0 < siege.sit(0) < 1, \
        "getting up is not instant"
    siege.run(Siege.RISE_S + 0.2)
    assert siege.men[0]["mode"] == "post" and siege.sit(0) == 0.0
    assert siege.men[2]["mode"] == "patrol"
    siege.run(0.5)
    assert not siege.lull(), "redcoats in range"
    # A hungry man's drill takes longer.
    siege = _quiet_siege()
    siege.drill_start = [siege.phase, siege.phase]
    siege.men[0]["hunger"] = 1.0
    siege.run(Siege.DRILL_LEN + 0.2)
    assert not siege.busy(1) and siege.busy(0), "starving, he is slower"
    assert abs(siege.pace(0) - (1 - Siege.HUNGER_SLOW)) < 1e-9
    siege.run(Siege.DRILL_LEN)
    assert not siege.busy(0)

    # In a lull the walker goes down to mend the most damaged wall: he
    # walks to its end, lowers the ladder over the outside, climbs down and
    # mends, the strength rising as he works. While he is down nobody
    # walks the wall: no bugle, no gun. He climbs back and hauls the
    # ladder up after him when redcoats come into range.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.wall = [1.0, 0.5]
    walker = siege.men[2]
    assert _until(siege, lambda: walker["mode"] == "to_wall", 10), walker
    assert siege.tally["repairs"] == 1 and siege.ladder["side"] == 1
    assert _until(siege, lambda: walker["mode"] == "lower", 20), walker
    assert siege.ladder["state"] == "standing"
    assert _until(siege, lambda: walker["mode"] == "mend", 20), walker
    assert siege.ladder["ext"] == 1.0 and walker["h"] == 0.0
    assert siege.out(2) and not siege.sound_bugle(1), "nobody walks the wall"
    before = siege.wall[1]
    siege.run(10)
    assert siege.wall[1] > before + 0.05 and siege.tally["mended"][1] > 0.05
    assert siege.wall[0] == 1.0
    siege.relief = None
    _at_the_foot(siege, "cannon", side=0)
    siege.redcoats[-1]["hp"] = 99
    siege.run(2)
    assert siege.relief is None, "the gun cannot be worked"
    siege.redcoats = []
    siege.wall[0] = 1.0
    rc = _at_the_foot(siege, "foot", side=0)
    rc["d"], rc["at_wall"] = Siege.trail_d(0.6), None
    assert _until(siege, lambda: walker["mode"] == "ascend", 3), \
        "he sees them come"
    assert _until(siege, lambda: walker["mode"] == "haul", 10)
    assert _until(siege, lambda: walker["mode"] == "patrol", 10)
    assert siege.ladder["state"] == "up" and not siege.out(2)
    assert siege.tally["repairs_done"] == 0, "not finished"
    # Left to it, he finishes the wall and goes back to his patrol.
    siege.redcoats = []
    assert _until(siege, lambda: walker["mode"] == "mend", 40)
    assert _until(siege, lambda: siege.wall[1] >= 1.0, 60)
    assert _until(siege, lambda: walker["mode"] == "haul", 10)
    assert _until(siege, lambda: siege.ladder["state"] == "up", 10)
    assert siege.tally["repairs_done"] == 1 and siege.tally["repairs"] == 2
    assert siege.ladder["state"] == "up" and siege.wall == [1.0, 1.0]
    # A starving man eats first; he does not go down faint.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.wall = [0.5, 1.0]
    walker = siege.men[2]
    walker["hunger"] = 0.9
    siege.run(Siege.QUIET_S + 2)
    assert siege.eating(2) and siege.tally["repairs"] == 0
    # With no room on the wall for a walker, the sentry on that side mends.
    siege = Siege()
    siege.wave_in = siege.spawn_in = 1e9
    siege.has_walker = False
    siege.wall = [1.0, 0.5]
    assert _until(siege, lambda: siege.men[1]["mode"] == "mend", 40)
    assert siege.out(1) and not siege.out(0) and siege.ladder["side"] == 1
    assert _until(siege, lambda: siege.wall[1] >= 1.0, 60)
    assert _until(siege, lambda: siege.men[1]["mode"] == "post", 20)

    # Caught outside: a horseman in range will be at the foot of the wall
    # before he can climb, so he breaks for the woods; the ladder is left
    # standing. A man on foot far enough off, he climbs away from.
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    siege.wall = [0.5, 1.0]
    walker = _walker_out(siege)
    _foe(siege, "horse", 0.55)
    siege.run(0.2)
    assert walker["mode"] == "run" and siege.tally["caught"] == 1, walker
    assert siege.ladder["state"] == "standing" and siege.out(2)
    assert _until(siege, lambda: walker["mode"] == "hide", 10)
    assert walker["rock"] == 1 and walker["g"] == 1.0
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    walker = _walker_out(siege)
    siege.wall = [0.5, 1.0]
    _foe(siege, "foot", 0.52)
    siege.run(0.2)
    assert walker["mode"] == "ascend", "time enough to climb"
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    walker = _walker_out(siege)
    siege.wall = [0.5, 1.0]
    siege.men[2]["hunger"] = 1.0   # starving, slowly
    _foe(siege, "foot", 0.52)
    siege.run(0.2)
    assert walker["mode"] == "run", "a hungry man is caught where a fed one is not"

    # Behind a rock he takes pot shots at redcoats on his side, often from
    # the first, seldom from the second and not at all from the third,
    # which is out of range.
    shots = []
    for k in (1, 2, 3):
        count = 0
        for seed in range(6):
            siege = _quiet_siege(seed)
            walker = _walker_out(siege)
            walker.update(mode="hide", g=float(k), rock=k, shot_t=None,
                          pinned=[], next_shot=siege.phase + 1)
            rc = _foe(siege, "foot", 1.0 - (k + 0.7) / Siege.G_SPAN)
            d, rc["hp"] = rc["d"], 99
            for _ in range(40 * 30):
                rc["d"] = d     # he stands his ground, for the count
                siege.run(1 / 30)
                walker.update(pinned=[], g=float(k), t0=siege.phase)
            count += rc["struck"] is not None
        shots.append(count)
    assert shots[0] > shots[1] > shots[2] == 0, shots

    # Redcoats answer: one leaves the trail and fires at the man's rock,
    # chipping it; enough fire, and he falls back to the next rock. The
    # man who went after him goes back to the trail.
    siege = _quiet_siege(3)
    siege.drill_start = [None, None]
    walker = _walker_out(siege)
    walker.update(mode="hide", g=1.0, rock=1, shot_t=None, pinned=[],
                  next_shot=1e9)
    siege.DRIVE_CHANCE = 600.0  # as good as certain, for the test
    rc = _foe(siege, "foot", 0.43)
    rc["hp"] = 99
    assert _until(siege, lambda: rc.get("drive"), 60), "he goes after him"
    assert _until(siege, lambda: siege.tally["rc_shots"] >= 1, 10)
    assert siege.rock_chip[0][1] is not None, "the rock is struck"
    assert _until(siege, lambda: walker["rock"] == 2, 40), walker
    assert siege.tally["retreats"] == 1 and not rc.get("drive")
    assert walker["mode"] in ("run", "hide") and siege.men[2]["hunger"] > 0
    assert siege.wall[0] == 1.0 or True

    # He comes home in a lull, climbs the ladder and hauls it up.
    siege = _quiet_siege()
    siege.drill_start = [None, None]
    walker = _walker_out(siege)
    walker.update(mode="hide", g=2.0, rock=2, shot_t=None, pinned=[],
                  next_shot=1e9)
    assert _until(siege, lambda: walker["mode"] == "home", 30)
    assert _until(siege, lambda: walker["mode"] == "ascend", 20)
    assert walker["g"] == 0.0
    assert _until(siege, lambda: walker["mode"] == "patrol", 30)
    assert siege.ladder["state"] == "up" and not siege.out(2)
    assert siege.tally["out_s"] > 5

    # A wall reads by shape: more logs down, shorter, leaning, at each
    # level of damage, not only a different shade.
    ladder = [sum(CpuView._wall_piece_state(st, j, c) for j in range(10)
                  for c in (0, 1)) for st in (1.0, 0.8, 0.5, 0.2, 0.0)]
    assert ladder[0] == 0 and ladder == sorted(ladder), ladder
    gone = [sum(CpuView._wall_piece_state(st, j, c) == 3 for j in range(10)
                for c in (0, 1)) for st in (1.0, 0.8, 0.5, 0.2, 0.0)]
    assert gone[0] == gone[1] == 0 and gone[3] > 0 and gone[4] > gone[3], gone
    for strength in (1.0, 0.8, 0.5, 0.2, 0.0):
        view.siege.wall = [strength, 1.0 - strength]
        view._draw(view, cr, 1024, 680)
    view.siege.wall = [1.0, 1.0]

    # A man at his meal, drawn: sentries on their tower floors, the walker
    # on the wall walk.
    view.siege.redcoats = []
    view.siege.spawn_in = view.siege.wave_in = view.boat_in = 1e9
    view.siege.drill_start = [None, None]
    for man in view.siege.men:
        man["hunger"] = 0.7
    for _ in range(int(Siege.QUIET_S * 30) + 40):
        view.phase += 1 / 30
        view._advance(1 / 30)
        view._draw(view, cr, 1024, 680)
    assert all(view.siege.eating(i) for i in range(3)), view.siege.men

