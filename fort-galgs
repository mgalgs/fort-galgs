    assert _until(siege, lambda: siege.wall[1] >= 1.0, 120)
    assert _until(siege, lambda: siege.men[2]["mode"] == "to_roof", 20)
    assert _until(siege, lambda: siege.men[2]["mode"] == "roof", 60)
    assert _until(siege, lambda: siege.roof[0] >= 1.0, 60)
    assert siege.tally["roof_mended"][0] > 0.45
    assert _until(siege, lambda: siege.men[2]["mode"] in ("patrol", "eat", "pot"), 5)

    # A wall reads by shape: more logs down, shorter, leaning, at each
