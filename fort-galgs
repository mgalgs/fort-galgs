# --------------------------------------------------------------------------
# Measuring
# --------------------------------------------------------------------------

class CpuSampler:
    """Per-CPU busy fraction from /proc/stat, as deltas between calls."""

    def __init__(self):
        self.prev = {}

    def sample(self):
        loads = {}
        with open("/proc/stat") as fh:
            for line in fh:
                if not line.startswith("cpu") or line.startswith("cpu "):
                    continue
                parts = line.split()
                cpu = int(parts[0][3:])
                vals = [int(v) for v in parts[1:]]
                idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
                total = sum(vals[:8])  # guest time is already in user
                prev = self.prev.get(cpu)
                self.prev[cpu] = (total, idle)
                if prev and total > prev[0]:
                    busy = 1.0 - (idle - prev[1]) / (total - prev[0])
                    loads[cpu] = min(1.0, max(0.0, busy))
        return loads


class GroupSampler:
    """CPUs' worth of time used per cgroup, from cpu.stat usage_usec."""

    def __init__(self):
        self.prev = {}

    @staticmethod
    def _usage(path):
        try:
            with open(os.path.join(path, "cpu.stat")) as fh:
                for line in fh:
                    if line.startswith("usage_usec "):
                        return int(line.split()[1])
        except (OSError, TypeError):
            pass
        return None

    def sample(self, paths):
        """paths: {name: cgroup dir or None}. Returns {name: cpus used}."""
        now = GLib.get_monotonic_time()
        out = {}
        for name, path in paths.items():
            usage = self._usage(path)
            prev = self.prev.get(name)
            self.prev[name] = (path, now, usage)
            if usage is None or not prev or prev[0] != path or prev[2] is None:
                out[name] = 0.0
                continue
            dt = now - prev[1]
            out[name] = max(0.0, (usage - prev[2]) / dt) if dt > 0 else 0.0
        return out


# --------------------------------------------------------------------------
# The picture: the chip, with the fort's cores fenced off
# --------------------------------------------------------------------------

class CpuView(Gtk.DrawingArea):
    """Every physical core as a tile, each of its threads a live load bar.

    While the fort is up, the reserved cores stand inside a log stockade,
    mountain men watch from its towers and walk its wall, and embers rise
    in the orange tiles. While it is down, a grove of trees and bushes grows
    there instead and those cores look like every other. Which state it is
    in never depends on telling orange from blue.
    """

    COLS = 5

    def __init__(self):
        super().__init__(content_height=340, hexpand=True, vexpand=True)
        self.cores = []
        self.reserved = set()
        self.on = False
        self.loads = {}       # cpu -> target load
        self.shown = {}       # cpu -> displayed load, eased toward target
        self.phase = 0.0
        self.last_draw = -1.0
        self._t0 = None
        self.set_draw_func(self._draw)
        self.add_tick_callback(self._on_tick)

    def set_state(self, cores, reserved, on):
        self.cores = cores
        self.reserved = set(reserved)
        self.on = on
        self.queue_draw()

    def set_loads(self, loads):
        self.loads = loads

    def _on_tick(self, widget, clock):
        now = clock.get_frame_time()
        if self._t0 is None:
            self._t0 = now
        prev = self.phase
        self.phase = (now - self._t0) / 1_000_000.0
        dt = max(0.0, self.phase - prev)
        # Frame-rate independent easing: the same glide at 30 Hz or 144 Hz.
        k = 1.0 - math.exp(-dt * 7.0)
        for cpu, target in self.loads.items():
            cur = self.shown.get(cpu, target)
            self.shown[cpu] = cur + (target - cur) * k

        root = widget.get_root()
        focused = root is not None and root.is_active()
        if focused or self.phase - self.last_draw >= IDLE_REDRAW_S:
            self.last_draw = self.phase
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    # -- helpers ----------------------------------------------------------

    @staticmethod
    def _glow(cr, x, y, radius, rgb, alpha):
        if radius <= 0 or alpha <= 0:
            return
        grad = cairo.RadialGradient(x, y, 0, x, y, radius)
        grad.add_color_stop_rgba(0.0, *rgb, alpha)
        grad.add_color_stop_rgba(0.5, *rgb, alpha * 0.3)
        grad.add_color_stop_rgba(1.0, *rgb, 0.0)
        cr.set_source(grad)
        cr.arc(x, y, radius, 0, 2 * math.pi)
        cr.fill()

    @staticmethod
    def _rounded(cr, x, y, w, h, r):
        r = min(r, w / 2, h / 2)
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    @staticmethod
    def _text(cr, x, y, text, size, alpha, bold=False):
        cr.select_font_face("Cantarell", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold
                            else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        ext = cr.text_extents(text)
        cr.move_to(x - ext.width / 2 - ext.x_bearing, y)
        cr.set_source_rgba(1, 1, 1, alpha)
        cr.show_text(text)

    # -- the fort ---------------------------------------------------------

    @staticmethod
    def _stake(cr, x, bottom, w, top, pointed):
        """One upright log, sharpened or flat, with a highlight and seam."""
        tip = w * 0.6 if pointed else 0.0
        cr.move_to(x, bottom)
        cr.line_to(x, top + tip)
        if pointed:
            cr.line_to(x + w / 2, top)
        cr.line_to(x + w, top + tip)
        cr.line_to(x + w, bottom)
        cr.close_path()
        cr.set_source_rgb(*WOOD_RGB)
        cr.fill_preserve()
        cr.set_source_rgb(*SEAM_RGB)
        cr.set_line_width(max(0.8, w * 0.08))
        cr.stroke()
        cr.set_source_rgba(*WOOD_HI_RGB, 0.8)
        cr.rectangle(x + w * 0.18, top + tip + w * 0.2, w * 0.16,
                     max(0.0, bottom - top - tip - w * 0.4))
        cr.fill()

    def _wall(self, cr, x0, x1, bottom, top, stake_w, pointed):
        n = max(1, round((x1 - x0) / stake_w))
        w = (x1 - x0) / n
        for i in range(n):
            # Every other stake a little taller, like hand-cut logs.
            lift = stake_w * 0.25 if (i % 2 and pointed) else 0.0
            self._stake(cr, x0 + i * w, bottom, w, top - lift, pointed)

    def _blockhouse(self, cr, x, y, w, h):
        """A square log tower; y is its floor, where a sentry stands."""
        logs = 4
        lh = h / logs
        for i in range(logs):
            self._rounded(cr, x - lh * 0.15, y + i * lh, w + lh * 0.3, lh,
                          lh / 2)
            cr.set_source_rgb(*WOOD_RGB)
            cr.fill_preserve()
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(0.8, lh * 0.1))
            cr.stroke()
        # A loophole for the long rifle.
        cr.set_source_rgb(*SEAM_RGB)
        cr.rectangle(x + w * 0.42, y + lh * 1.3, w * 0.16, lh * 0.5)
        cr.fill()
        cr.rectangle(x - lh * 0.35, y - lh * 0.35, w + lh * 0.7, lh * 0.4)
        cr.set_source_rgb(*WOOD_HI_RGB)
        cr.fill()

    def _gate(self, cr, cx, bottom, top, w):
        """Shut while the fort is up; swung open while it is down."""
        cr.set_source_rgba(0.02, 0.02, 0.05, 0.9)
        cr.rectangle(cx - w / 2, top, w, bottom - top)
        cr.fill()
        half = w / 2
        if self.on:
            for side in (-1, 1):
                x = cx - half if side < 0 else cx
                self._stake(cr, x, bottom, half, top, False)
            cr.set_source_rgb(*SEAM_RGB)
            cr.set_line_width(max(1.2, w * 0.06))
            cr.move_to(cx - half * 0.9, top + (bottom - top) * 0.2)
            cr.line_to(cx + half * 0.9, bottom - (bottom - top) * 0.15)
            cr.move_to(cx + half * 0.9, top + (bottom - top) * 0.2)
            cr.line_to(cx - half * 0.9, bottom - (bottom - top) * 0.15)
            cr.stroke()
        else:
            # Doors swung outward, seen edge-on: two slanted planks.
            for side in (-1, 1):
                hinge = cx + side * half
                cr.move_to(hinge, top)
                cr.line_to(hinge + side * half * 0.45, top + w * 0.15)
                cr.line_to(hinge + side * half * 0.45, bottom + w * 0.15)
                cr.line_to(hinge, bottom)
                cr.close_path()
                cr.set_source_rgb(*WOOD_RGB)
                cr.fill_preserve()
                cr.set_source_rgb(*SEAM_RGB)
                cr.set_line_width(1.0)
                cr.stroke()

    @staticmethod
    def _mountain_man(cr, x, feet, s, facing, step=0.0, shouldered=False,
                      glint=0.0):
        """A buckskin-clad mountain man with a coonskin cap and a long rifle.

        Drawn in a 100-unit-tall model with the feet at 0; facing is +1 for
        right, -1 for left. The rifle stands taller than he does.
