class GameModeWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(title="Game Mode")
        if app is not None:
            self.set_application(app)
        self.set_default_size(560, 820)
        self.state = None
        self.busy = False
        self.cpus = CpuSampler()
        self.groups = GroupSampler()

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=220)
        self.stack.add_named(self._build_loading(), "loading")
        self.stack.add_named(self._build_home(), "home")
        self.stack.add_named(self._build_error(), "error")

        header = Adw.HeaderBar(css_classes=["flat"])
        header.set_title_widget(Adw.WindowTitle(title="Game Mode",
                                                subtitle=os.uname().nodename))
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(self.stack)
        toolbar.add_css_class("gm-root")
        self.set_content(toolbar)

        self.sample_id = GLib.timeout_add(SAMPLE_MS, self._sample)
        self.status_id = GLib.timeout_add_seconds(STATUS_EVERY_S,
                                                  self._poll_status)
        self.connect("close-request", self._on_close)

    def _on_close(self, _win):
        for source in (self.sample_id, self.status_id):
            if source:
                GLib.source_remove(source)
        self.sample_id = self.status_id = 0
        return False

    # -- pages ------------------------------------------------------------

    def _build_loading(self):
        page = Adw.StatusPage(title="Reading the CPUs…")
        page.set_child(Adw.Spinner(width_request=48, height_request=48))
        return page

    def _build_home(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=2, margin_bottom=18,
                      margin_start=24, margin_end=24)

        self.view = CpuView()
        box.append(self.view)

        self.hero = Gtk.Label(css_classes=["gm-hero"], wrap=True,
                              justify=Gtk.Justification.CENTER)
        self.sub = Gtk.Label(css_classes=["gm-sub"], wrap=True,
                             justify=Gtk.Justification.CENTER)
        box.append(self.hero)
        box.append(self.sub)

        # At most one banner shows at a time; see _show_banner.
        self.banner = Adw.Banner(revealed=False)
        self.banner.connect("button-clicked", lambda _b: self._banner_action())
        self.banner_action = None
        box.append(self.banner)

        self.toggle = Gtk.Button(css_classes=["gm-big"], margin_top=4)
        face = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER)
        self.toggle_icon = Gtk.Image(pixel_size=30)
        face.append(self.toggle_icon)
        words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                        valign=Gtk.Align.CENTER)
        self.toggle_title = Gtk.Label(xalign=0.0, css_classes=["gm-big"])
        self.toggle_sub = Gtk.Label(xalign=0.0, css_classes=["gm-sub"])
        words.append(self.toggle_title)
        words.append(self.toggle_sub)
        face.append(words)
        self.toggle_spinner = Adw.Spinner(visible=False)
        face.append(self.toggle_spinner)
        self.toggle.set_child(face)
        self.toggle.connect("clicked", lambda _b: self._on_toggle())
        box.append(self.toggle)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                       css_classes=["gm-card"], margin_top=4)
        card.append(Gtk.Label(label="Who is using the CPUs", xalign=0.0,
                              css_classes=["gm-row-note"]))
        self.rows = {
            "game": UsageRow("applications-games-symbolic",
                             "Steam and the game", True),
            "apps": UsageRow("utilities-terminal-symbolic",
                             "Your apps, tests and sandboxes", False),
            "vms": UsageRow("computer-symbolic",
                            "Virtual machines", False),
            "services": UsageRow("system-run-symbolic",
                                 "Services and containers", False),
        }
        for row in self.rows.values():
            card.append(row)
        box.append(card)
        return box

    def _build_error(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16,
                      margin_top=12, margin_bottom=24,
                      margin_start=24, margin_end=24)
        box.append(Gtk.Image(icon_name="dialog-warning-symbolic",
                             pixel_size=56, margin_top=12))
        self.error_title = Gtk.Label(css_classes=["gm-hero"], wrap=True,
                                     justify=Gtk.Justification.CENTER)
        box.append(self.error_title)
        self.error_body = Gtk.Label(css_classes=["gm-log"], xalign=0.0,
                                    wrap=True, selectable=True,
                                    valign=Gtk.Align.START)
        scroller = Gtk.ScrolledWindow(vexpand=True, css_classes=["gm-card"],
                                      hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_child(self.error_body)
        box.append(scroller)
        self.error_back = Gtk.Button(label="Back", css_classes=["pill"],
                                     halign=Gtk.Align.CENTER)
        self.error_back.connect("clicked", lambda _b: self.refresh_status())
        box.append(self.error_back)
        return box

    # -- state ------------------------------------------------------------

    def refresh_status(self, quiet=False):
        if not quiet:
            self.stack.set_visible_child_name("loading")
        run_backend(["status", "--json"], self._got_status)

    def _poll_status(self):
        if not self.busy and self.stack.get_visible_child_name() == "home":
            self.refresh_status(quiet=True)
        return GLib.SOURCE_CONTINUE

    def _got_status(self, ok, text):
        if not ok:
            self.show_error("Could not read Game Mode's state", text)
            return
        try:
            state = json.loads(text)
        except ValueError as exc:
            self.show_error("game-mode-cpus said something unreadable",
                            f"{exc}\n\n{text}")
            return
        self.apply_state(state)
        self.stack.set_visible_child_name("home")

    def apply_state(self, state):
        self.state = state
        mode = state.get("mode", "unknown")
        on = mode == "on"
        reserved = state.get("reserved", [])
        cores = [c["core"] for c in state.get("cores", [])
                 if any(cpu in reserved for cpu in c["cpus"])]
        core_words = ranges(cores)
        total = sum(len(c["cpus"]) for c in state.get("cores", []))
        self.view.set_state(state.get("cores", []), reserved, on)

        if on:
            self.hero.set_label(f"Cores {core_words} are the game's")
            self.sub.set_label(
                f"Everything else is kept off CPUs {ranges(reserved)}. "
                f"The game can still use all {total}.")
        elif mode == "off":
            self.hero.set_label("Game Mode is off")
            self.sub.set_label(f"Everything shares all {total} CPUs. Turn it "
                               f"on to keep cores {core_words} free for the "
                               "game.")
        else:
            self.hero.set_label("Game Mode is half on")
            self.sub.set_label("Some of the fences are up and some are not. "
                               "Turning it on or off puts that right.")

        self._show_banner(state, mode)
        self._set_toggle(on)

    def _show_banner(self, state, mode):
        if mode != "off" and state.get("steam") == "outside":
            self.banner.set_title("Steam started after Game Mode, so it is "
                                  "fenced off with everything else.")
            self.banner.set_button_label("Bring it in")
            self.banner_action = "on"
        elif mode != "off" and not state.get("cpuset_delegated", True):
            self.banner.set_title("Your own apps and tests are not fenced yet. "
                                  "Run systemctl --user daemon-reexec to finish setup.")
            self.banner.set_button_label(None)
            self.banner_action = None
        elif mode == "partial":
            self.banner.set_title("Game Mode is only partly on.")
            self.banner.set_button_label("Turn it on")
            self.banner_action = "on"
        else:
            self.banner.set_revealed(False)
            return
        self.banner.set_revealed(True)

    def _banner_action(self):
        if self.banner_action:
            self._run_toggle(self.banner_action)

    def _set_toggle(self, on):
        for cls in ("gm-on", "gm-off"):
            self.toggle.remove_css_class(cls)
        if on:
            self.toggle.add_css_class("gm-off")
            self.toggle_icon.set_from_icon_name("media-playback-stop-symbolic")
            self.toggle_title.set_label("Turn off Game Mode")
            self.toggle_sub.set_label("Give the cores back")
        else:
            self.toggle.add_css_class("gm-on")
            self.toggle_icon.set_from_icon_name("applications-games-symbolic")
            self.toggle_title.set_label("Turn on Game Mode")
            self.toggle_sub.set_label("Keep the fastest cores for the game")

    # -- toggling ---------------------------------------------------------

    def _on_toggle(self):
        on = (self.state or {}).get("mode") == "on"
        self._run_toggle("off" if on else "on")

    def _run_toggle(self, verb):
        if self.busy:
            return
        self.busy = True
        self.toggle.set_sensitive(False)
        self.toggle_spinner.set_visible(True)

        def done(ok, text):
            self.busy = False
            self.toggle.set_sensitive(True)
            self.toggle_spinner.set_visible(False)
            if not ok:
                self.show_error(f"Could not turn Game Mode {verb}", text)
                return
            self.refresh_status(quiet=True)

        run_backend([verb], done)

    # -- live numbers -----------------------------------------------------

    def _sample(self):
        self.view.set_loads(self.cpus.sample())
        if self.state:
            self._update_rows()
        return GLib.SOURCE_CONTINUE

    def _update_rows(self):
        st = self.state
        cg = st.get("cgroups", {})
        steam_cg = cg.get("steam")
        steam_outside = st.get("steam") == "outside"
        used = self.groups.sample({
            "game": steam_cg if steam_outside else cg.get("game"),
            "apps": cg.get("apps"),
            "background": cg.get("background"),
            "vms": cg.get("vms"),
            "services": cg.get("services"),
        })
        # Steam outside game.slice is still inside app.slice; count it once.
        apps = used["apps"] + used["background"]
        if steam_outside:
            apps = max(0.0, apps - used["game"])

        total = sum(len(c["cpus"]) for c in st.get("cores", []))
        reserved = st.get("reserved", [])
        on = st.get("mode") == "on"
        fence = (f"kept off CPUs {ranges(reserved)}" if on
                 else "free to use every CPU")
        apps_fenced = on and st.get("cpuset_delegated")

        self.rows["game"].update(used["game"], total,
                                 "not running" if st.get("steam") == "none"
                                 else "never fenced" if not steam_outside
                                 else "fenced, outside the game lane"
                                 if on else "free to use every CPU")
        self.rows["apps"].update(apps, total,
                                 fence if apps_fenced or not on
                                 else "not fenced: cpuset is not delegated")
        self.rows["vms"].update(used["vms"], total, fence)
        self.rows["services"].update(used["services"], total, fence)

    # -- errors -----------------------------------------------------------

    def show_error(self, title, body):
        self.busy = False
        self.error_title.set_label(title)
        self.error_body.set_label(body or "No further detail.")
        self.stack.set_visible_child_name("error")
        self.error_back.grab_focus()


def load_css():
    Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
    display = Gdk.Display.get_default()
    if display is None:
        return
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(
        display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


class GameModeApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="io.mgalgs.GameMode")
        self.window = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        load_css()
        # Out of the fenced app.slice, or the animation stutters under
        # exactly the load Game Mode exists for. Failing only costs that.
        run_backend(["adopt", str(os.getpid())],
                    lambda ok, text: ok or print(text, file=sys.stderr))

    def do_activate(self):
        if not self.window:
            self.window = GameModeWindow(self)
            self.window.refresh_status()
        self.window.present()


SAMPLE_STATE = {
    "mode": "on",
    "reserved": [3, 4, 13, 14],
    "cores": [{"core": c, "cpus": [i, i + 10], "max_khz": 4300000}
              for i, c in enumerate([0, 1, 2, 3, 4, 8, 9, 10, 11, 12])],
    "cpuset_delegated": False,
    "steam": "game",
    "cgroups": {"game": None, "steam": None, "apps": None,
                "background": None, "vms": None, "services": None},
}


def self_test():
    """Build every page and draw every state against a real surface.

    Cairo draws that are wrong mostly paint nothing rather than raise, so
    this proves the code paths run, not that the picture looks right.
    """
    Adw.init()
    load_css()
    win = GameModeWindow(None)
    for name in ("loading", "home", "error"):
        win.stack.set_visible_child_name(name)
        assert win.stack.get_visible_child_name() == name, name

    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, 520, 260)
    cr = cairo.Context(surface)
    for mode in ("on", "off", "partial"):
        for steam in ("game", "outside", "none"):
            for delegated in (True, False):
                st = dict(SAMPLE_STATE, mode=mode, steam=steam,
                          cpuset_delegated=delegated)
                win.apply_state(st)
                win._update_rows()
                assert win.hero.get_label()
                win.view.shown = {c: (c % 7) / 6 for c in range(20)}
                for win.view.phase in (0.0, 0.7, 3.3):
                    win.view._draw(win.view, cr, 520, 260)
    win.view._draw(win.view, cr, 60, 40)  # drives every clamp

    win.apply_state(dict(SAMPLE_STATE, mode="on", steam="outside"))
    assert win.banner.get_revealed() and win.banner_action == "on"
    win.apply_state(dict(SAMPLE_STATE, mode="off"))
    assert not win.banner.get_revealed()
    assert win.toggle_title.get_label() == "Turn on Game Mode"

    loads = win.cpus.sample()
    loads = win.cpus.sample()
    assert all(0.0 <= v <= 1.0 for v in loads.values())
    assert ranges([3, 4, 13, 14]) == "3, 4, 13 and 14"

    win.show_error("t", "body")
    assert win.stack.get_visible_child_name() == "error"
    print("self-test ok: pages build, CSS parses, every state draws")


def snapshot(path):
    """Draw the chip off, then on, into one PNG -- no window is shown.

    Uses this machine's live per-CPU load, so it is a real picture of the
    moment rather than a mock-up.
    """
    view = CpuView()
    sampler = CpuSampler()
    sampler.sample()
    GLib.usleep(400_000)
    view.shown = sampler.sample()
    w, h = 1040, 520
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w * 2, h)
    cr = cairo.Context(surface)
    bg = cairo.LinearGradient(0, 0, w * 2, h)
    bg.add_color_stop_rgb(0.0, 0.04, 0.06, 0.13)
    bg.add_color_stop_rgb(1.0, 0.05, 0.10, 0.20)
    cr.set_source(bg)
    cr.paint()
    for i, on in enumerate((False, True)):
        view.set_state(SAMPLE_STATE["cores"], SAMPLE_STATE["reserved"], on)
        view.phase = 1.3
        cr.save()
        cr.translate(i * w, 0)
        view._draw(view, cr, w, h)
        cr.restore()
    surface.write_to_png(path)
    print(f"wrote {path}")


def main():
    args = sys.argv[1:]
    if "--self-test" in args:
        self_test()
        return 0
    if args[:1] == ["--snapshot"] and len(args) == 2:
        snapshot(args[1])
        return 0
    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0
    return GameModeApp().run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
