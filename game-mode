# --------------------------------------------------------------------------
# Measuring
# --------------------------------------------------------------------------

class CpuSampler:
    """Per-CPU busy fraction from /proc/stat, as deltas between calls."""

    def __init__(self):
        self.prev = {}

    def sample(self):
        loads = {}
        with open("/proc/stat") as fh:
            for line in fh:
                if not line.startswith("cpu") or line.startswith("cpu "):
                    continue
                parts = line.split()
                cpu = int(parts[0][3:])
                vals = [int(v) for v in parts[1:]]
                idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
                total = sum(vals[:8])  # guest time is already in user
                prev = self.prev.get(cpu)
                self.prev[cpu] = (total, idle)
                if prev and total > prev[0]:
                    busy = 1.0 - (idle - prev[1]) / (total - prev[0])
                    loads[cpu] = min(1.0, max(0.0, busy))
        return loads


class GroupSampler:
    """CPUs' worth of time used per cgroup, from cpu.stat usage_usec."""

    def __init__(self):
        self.prev = {}

    @staticmethod
    def _usage(path):
        try:
            with open(os.path.join(path, "cpu.stat")) as fh:
                for line in fh:
                    if line.startswith("usage_usec "):
                        return int(line.split()[1])
        except (OSError, TypeError):
            pass
        return None

    def sample(self, paths):
        """paths: {name: cgroup dir or None}. Returns {name: cpus used}."""
        now = GLib.get_monotonic_time()
        out = {}
        for name, path in paths.items():
            usage = self._usage(path)
            prev = self.prev.get(name)
            self.prev[name] = (path, now, usage)
            if usage is None or not prev or prev[0] != path or prev[2] is None:
                out[name] = 0.0
                continue
            dt = now - prev[1]
            out[name] = max(0.0, (usage - prev[2]) / dt) if dt > 0 else 0.0
        return out


# --------------------------------------------------------------------------
# The picture: the chip, with the game's cores fenced off
# --------------------------------------------------------------------------

class CpuView(Gtk.DrawingArea):
    """Every physical core as a tile, each of its threads a live load bar.

    The reserved cores carry a controller glyph and a frame in every state,
    so which ones they are never depends on telling orange from blue. When
    Game Mode is on, the frame becomes a marching shield and sparks rise in
    the reserved tiles; when it is off, the frame is a quiet dashed outline
    -- the same cores, waiting.
    """

    COLS = 5

    def __init__(self):
        super().__init__(content_height=230, hexpand=True, vexpand=True)
        self.cores = []
        self.reserved = set()
        self.on = False
        self.loads = {}       # cpu -> target load
        self.shown = {}       # cpu -> displayed load, eased toward target
        self.phase = 0.0
        self.last_draw = -1.0
        self._t0 = None
        self.set_draw_func(self._draw)
        self.add_tick_callback(self._on_tick)

    def set_state(self, cores, reserved, on):
        self.cores = cores
        self.reserved = set(reserved)
        self.on = on
        self.queue_draw()

    def set_loads(self, loads):
        self.loads = loads

    def _on_tick(self, widget, clock):
        now = clock.get_frame_time()
        if self._t0 is None:
            self._t0 = now
        prev = self.phase
        self.phase = (now - self._t0) / 1_000_000.0
        dt = max(0.0, self.phase - prev)
        # Frame-rate independent easing: the same glide at 30 Hz or 144 Hz.
        k = 1.0 - math.exp(-dt * 7.0)
        for cpu, target in self.loads.items():
            cur = self.shown.get(cpu, target)
            self.shown[cpu] = cur + (target - cur) * k

        root = widget.get_root()
        focused = root is not None and root.is_active()
        if focused or self.phase - self.last_draw >= IDLE_REDRAW_S:
            self.last_draw = self.phase
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    # -- helpers ----------------------------------------------------------

    @staticmethod
    def _glow(cr, x, y, radius, rgb, alpha):
        if radius <= 0 or alpha <= 0:
            return
        grad = cairo.RadialGradient(x, y, 0, x, y, radius)
        grad.add_color_stop_rgba(0.0, *rgb, alpha)
        grad.add_color_stop_rgba(0.5, *rgb, alpha * 0.3)
        grad.add_color_stop_rgba(1.0, *rgb, 0.0)
        cr.set_source(grad)
        cr.arc(x, y, radius, 0, 2 * math.pi)
        cr.fill()

    @staticmethod
    def _rounded(cr, x, y, w, h, r):
        r = min(r, w / 2, h / 2)
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    @staticmethod
    def _text(cr, x, y, text, size, alpha, bold=False):
        cr.select_font_face("Cantarell", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold
                            else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        ext = cr.text_extents(text)
        cr.move_to(x - ext.width / 2 - ext.x_bearing, y)
        cr.set_source_rgba(1, 1, 1, alpha)
        cr.show_text(text)

    @staticmethod
    def _glyph_pad(cr, x, y, s, alpha):
        """A game controller: body, two grips, a d-pad and two buttons."""
        cr.set_source_rgba(1, 1, 1, alpha)
        w, h = s, s * 0.56
        cr.new_sub_path()
        cr.arc(x - w / 2 + h / 2, y, h / 2, math.pi / 2, 3 * math.pi / 2)
        cr.arc(x + w / 2 - h / 2, y, h / 2, -math.pi / 2, math.pi / 2)
        cr.close_path()
        cr.fill()
        cr.set_source_rgba(0.08, 0.08, 0.18, alpha)
        d = h * 0.17
        cx = x - w * 0.24
        cr.rectangle(cx - d * 1.6, y - d / 2, d * 3.2, d)
        cr.rectangle(cx - d / 2, y - d * 1.6, d, d * 3.2)
        cr.fill()
        bx = x + w * 0.24
        cr.arc(bx - d * 0.9, y + d * 0.4, d * 0.62, 0, 2 * math.pi)
        cr.fill()
        cr.arc(bx + d * 0.9, y - d * 0.4, d * 0.62, 0, 2 * math.pi)
        cr.fill()

    # -- the picture ------------------------------------------------------

    def _draw(self, _area, cr, width, height):
        if not self.cores:
            return
        n = len(self.cores)
        cols = min(self.COLS, n)
        rows = math.ceil(n / cols)
        gap = max(10.0, width * 0.025)
        label_h = max(16.0, height * 0.07)
        # Square-ish tiles, as large as the area allows.
        tile_w = min((width - gap * (cols + 1)) / cols,
                     (height - gap * (rows + 1) - label_h * rows) / rows / 1.05)
        tile_w = max(24.0, tile_w)
        tile_h = tile_w * 1.05
        grid_w = cols * tile_w + (cols - 1) * gap
        grid_h = rows * (tile_h + label_h) + (rows - 1) * gap
        x0 = (width - grid_w) / 2
        y0 = (height - grid_h) / 2

        self._draw_die(cr, x0, y0, grid_w, grid_h, gap)

        for i, core in enumerate(self.cores):
            col, row = i % cols, i // cols
            x = x0 + col * (tile_w + gap)
            y = y0 + row * (tile_h + label_h + gap)
            mine = any(c in self.reserved for c in core["cpus"])
            self._draw_tile(cr, x, y, tile_w, tile_h, core, mine)
            label = " · ".join(str(c) for c in core["cpus"])
            self._text(cr, x + tile_w / 2, y + tile_h + label_h * 0.78,
                       label, max(9.0, label_h * 0.6),
                       0.85 if mine else 0.45, bold=mine)

    def _draw_die(self, cr, x, y, w, h, gap):
        """The package outline with pins, so the tiles read as one chip."""
        pad = gap * 0.8
        X, Y, W, H = x - pad, y - pad, w + 2 * pad, h + 2 * pad
        cr.set_line_width(2.0)
        cr.set_source_rgba(*DIM_RGB, 0.18)
        pin = pad * 0.55
        step = max(14.0, W / 24)
        px = X + step / 2
        while px < X + W:
            cr.move_to(px, Y)
            cr.line_to(px, Y - pin)
            cr.move_to(px, Y + H)
            cr.line_to(px, Y + H + pin)
            px += step
        cr.stroke()
        self._rounded(cr, X, Y, W, H, pad)
        grad = cairo.LinearGradient(X, Y, X + W, Y + H)
        grad.add_color_stop_rgba(0.0, 0.16, 0.17, 0.32, 0.55)
        grad.add_color_stop_rgba(1.0, 0.07, 0.09, 0.20, 0.55)
        cr.set_source(grad)
        cr.fill_preserve()
        cr.set_source_rgba(*DIM_RGB, 0.25)
        cr.set_line_width(1.4)
        cr.stroke()

    def _draw_tile(self, cr, x, y, w, h, core, mine):
        pulse = 0.5 + 0.5 * math.sin(self.phase * 2.2)
        live = mine and self.on
        rgb = GAME_RGB if mine else REST_RGB
        r = w * 0.16

        if live:
            self._glow(cr, x + w / 2, y + h / 2, w * (0.95 + 0.12 * pulse),
                       GAME_RGB, 0.30 + 0.12 * pulse)

        self._rounded(cr, x, y, w, h, r)
        cr.set_source_rgba(0.05, 0.06, 0.14, 0.92)
        cr.fill()

        # One bar per thread, filled from the bottom by its live load.
        cpus = core["cpus"]
        inner = w * 0.14
        glyph_h = w * 0.30 if mine else 0.0
        bar_top = y + inner + glyph_h
        bar_h = y + h - inner - bar_top
        bar_gap = w * 0.08
        bar_w = (w - 2 * inner - bar_gap * (len(cpus) - 1)) / len(cpus)
        for j, cpu in enumerate(cpus):
            bx = x + inner + j * (bar_w + bar_gap)
            self._rounded(cr, bx, bar_top, bar_w, bar_h, bar_w * 0.25)
            cr.set_source_rgba(1, 1, 1, 0.06)
            cr.fill()
            load = self.shown.get(cpu, 0.0)
            fill = bar_h * load
            if fill < 1.0:
                continue
            self._rounded(cr, bx, bar_top + bar_h - fill, bar_w, fill,
                          min(bar_w * 0.25, fill / 2))
            grad = cairo.LinearGradient(0, bar_top + bar_h, 0, bar_top)
            if mine:
                grad.add_color_stop_rgba(0.0, *GAME_RGB, 0.95)
                grad.add_color_stop_rgba(1.0, *GAME_HOT_RGB, 0.95)
            else:
                grad.add_color_stop_rgba(0.0, *REST_RGB, 0.85)
                grad.add_color_stop_rgba(1.0, 0.55, 0.45, 1.0, 0.85)
            cr.set_source(grad)
            cr.fill()

        if live:
            self._sparks(cr, x, bar_top, w, bar_h, core["core"])

        if mine:
            self._glyph_pad(cr, x + w / 2, y + inner + glyph_h * 0.42,
                            w * 0.42, 0.95 if live else 0.55)

        # The frame. Its dash pattern, not its colour, is what says "game".
        self._rounded(cr, x, y, w, h, r)
        if mine:
            cr.set_line_width(2.4 if live else 1.6)
            cr.set_dash([7.0, 5.0], -self.phase * 18.0 if live else 0.0)
            cr.set_source_rgba(*rgb, 0.95 if live else 0.55)
        else:
            cr.set_line_width(1.2)
            cr.set_dash([])
            cr.set_source_rgba(*DIM_RGB, 0.22)
        cr.stroke()
        cr.set_dash([])

    def _sparks(self, cr, x, top, w, h, seed):
        """Boost: a few embers rising through the reserved tile."""
        for k in range(4):
            t = (self.phase * 0.55 + k / 4 + seed * 0.37) % 1.0
            sx = x + w * (0.25 + 0.5 * ((k * 0.618 + seed * 0.29) % 1.0))
            sx += math.sin(t * 6.0 + k) * w * 0.04
            sy = top + h * (1.0 - t)
            edge = math.sin(t * math.pi)
            self._glow(cr, sx, sy, w * 0.07, GAME_HOT_RGB, 0.6 * edge)
            cr.set_source_rgba(1, 0.95, 0.85, 0.9 * edge)
            cr.arc(sx, sy, max(1.2, w * 0.012), 0, 2 * math.pi)
            cr.fill()


